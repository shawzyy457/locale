        "member-invites": {
          "title": "Meus convites",
          "items": {
            "invite": {
              "name": "<white>{faction_display_name}",
              "lore": [
                "<gray>Convidado por: </gray>{inviter_name_with_tag}",
                "<gray>Expira em: <white>{remaining_time}",
                "",
                "<gray>Esquerdo: <green>aceitar",
                "<gray>Direito: <red>recusar"
              ]
            }
          },
          "messages": {
            "accepted": "<green>Você entrou na facção {faction_display_name}<green>.",
            "denied": "<yellow>Você recusou o convite de {faction_display_name}<yellow>."
          }
        }
      }
    }
  }
}
