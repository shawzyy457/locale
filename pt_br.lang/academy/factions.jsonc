            }
          }
        },
        // ====================================================================
        //  /facxfac — resposta ao desafio e rendição. Quem MONTA o desafio é a
        //  bússola do spawn; aqui o jogador só responde e acompanha.
        // ====================================================================
        "simulator": {
          "errors": {
            "loading": "<red>Seus dados de facção ainda estão carregando. Tente de novo em instantes.",
            "no-faction": "<red>Você não está em uma facção."
          },
          // /facxfac kit — renova o kit da partida a pedido do jogador. Existe desde 07/08/2026, a
          // pedido do dono: o kit deixou de ser "uma vez por participação" quando o jogador pede.
          "kit": {
            "success": "<green>Kit renovado! <gray>Seu inventário voltou como você o organizou.",
            "errors": {
              "not-in-arena": "<red>Você precisa estar <yellow>dentro da arena</yellow> para renovar o kit.",
              "awaiting-respawn": "<red>Você está esperando para renascer."
            }
          },
          // /facxfac visualizar — abre o desafio num menu de leitura, com as regras que o desafiante
          // definiu e (para quem responde) os botões de aceitar e recusar.
          "view": {
            // Sem `<tag>` literal: o MiniMessage engoliria os sinais como se fossem uma tag de estilo.
            "ambiguous": "<red>Sua facção tem mais de um desafio aberto. <gray>Diga qual: <white>/facxfac visualizar TAG</white>."
          },
          "status": {
            "idle": "<gray>Sua facção não tem desafio pendente nem partida em andamento. <white>Use a bússola do spawn <gray>para desafiar outra facção.",
            "match": [
              "<dark_gray>▪ <white>Invasão Fac x Fac",
              "<gray>Adversário: {opponent_display_name}",
              "<gray>Seu lado: {side_name}",
              "<gray>Fase: {phase_name} <dark_gray>·</dark_gray> <white>{remaining_time} <gray>restantes",
              "<gray>Arena: <white>{arena}"
            ],
            // Os três estados do desafio no `/facxfac`. Todos levam ao MESMO menu de leitura: quem
            // responde encontra ACEITAR/RECUSAR lá dentro, e quem não responde vê só as regras. A tag
            // vai no comando porque a facção pode ter mais de um desafio aberto ao mesmo tempo.
            "request-received": [
              " {faction_display_name} <white>desafiou sua facção <dark_gray>(expira em {expires_in})",
              " <hover:show_text:'<gradient:#FF6F00:#faa825:#FF6F00>Ver as regras da partida e responder'><click:run_command:'/facxfac visualizar {faction_tag}'><gradient:#FF6F00:#faa825:#FF6F00><bold>[VISUALIZAR]</bold></gradient></click></hover>"
            ],
            "request-pending": [
              " <gray>{faction_display_name} <gray>desafiou sua facção — quem responde é o líder (ou os capitães) <dark_gray>({expires_in})",
              " <hover:show_text:'<gradient:#FF6F00:#faa825:#FF6F00>Ver as regras da partida'><click:run_command:'/facxfac visualizar {faction_tag}'><gradient:#FF6F00:#faa825:#FF6F00>[VISUALIZAR]</gradient></click></hover>"
            ],
            "request-sent": [
              " <gray>Desafio enviado para {faction_display_name} <gray>— aguardando resposta <dark_gray>({expires_in})",
              " <hover:show_text:'<gradient:#FF6F00:#faa825:#FF6F00>Ver as regras que você enviou'><click:run_command:'/facxfac visualizar {faction_tag}'><gradient:#FF6F00:#faa825:#FF6F00>[VISUALIZAR]</gradient></click></hover>"
            ]
          }
          // `accept.success`/`deny.success` saíram: o fechamento do desafio já avisa os DOIS quadros, e
          // a confirmação pessoal repetia a mesma frase na linha seguinte (bug visual de 05/08).
        },
        // ====================================================================
        //  /simarena — marcação da arena em jogo (staff). Age SEMPRE sobre a
        //  arena do mundo em que o staff está.
        // ====================================================================
        "simarena": {
          "usage": [
            "<gray>Uso do <white>/simarena</white> (age sobre a arena do mundo em que você está):",
            "<gray>· <white>pos1</white> / <white>pos2</white> <dark_gray>—</dark_gray> marca os cantos da caixa",
            "<gray>· <white>base</white> / <white>cubiculo</white> <dark_gray>—</dark_gray> grava a caixa marcada",
            "<gray>· <white>spawn atacante|defensor</white> <dark_gray>—</dark_gray> grava onde você está",
            "<gray>· <white>atalho base|plataforma|counter</white> <dark_gray>—</dark_gray> grava onde você está",
            "<gray>· <white>borda</white> <dark_gray>—</dark_gray> grava a borda ATUAL do mundo (centro e tamanho)",
            "<gray>· <white>ativar</white> / <white>desativar</white> / <white>info</white> / <white>remover</white>"
          ],
          "errors": {
            "not-arena-world": "<red>O mundo <yellow>{world}</yellow> não é uma arena do Simulator.",
            "unknown-action": "<red>Ação <yellow>{action}</yellow> desconhecida. Use <white>/simarena info</white>.",
            "incomplete-selection": "<red>Marque os dois cantos antes: <white>/simarena pos1</white> e <white>/simarena pos2</white>.",
            "selection-world": "<red>Sua seleção foi feita em outro mundo. Remarque os cantos dentro de <yellow>{world}</yellow>.",
            "unknown-side": "<red>Lado <yellow>{side}</yellow> desconhecido. Use <white>atacante</white> ou <white>defensor</white>.",
            "unknown-shortcut": "<red>Atalho <yellow>{shortcut}</yellow> desconhecido. Use <white>base</white>, <white>plataforma</white> ou <white>counter</white>.",
            "default-border": "<red>Este mundo está com a borda PADRÃO. Defina a borda com <white>/worldborder center</white> e <white>/worldborder set</white> antes de gravá-la na arena."
          },
          "selection": {
            "saved": "<green>Posição <yellow>{position}</yellow> marcada em <white>{x}, {y}, {z}</white>."
          },
          "base": {
            "saved": "<green>Zona da base salva: <white>{zone}</white>."
          },
          "cubicle": {
            "saved": "<green>Cubículo dos spawners salvo: <white>{zone}</white>."
          },
          "spawn": {
            "attacker-saved": "<green>Spawn do atacante salvo em <white>{location}</white>.",
            "defender-saved": "<green>Spawn do defensor salvo em <white>{location}</white>."
          },
          "shortcut": {
            "saved": "<green>Atalho <yellow>{shortcut}</yellow> salvo em <white>{location}</white>."
          },
          "border": {
            "saved": "<green>Borda gravada na arena: centro <white>{center_x}, {center_z}</white>, tamanho <white>{size}</white>. <gray>Ela volta igual a cada restart."
          },
          "enabled": "<green>Arena <yellow>{world}</yellow> ativada — já entra no sorteio de partidas.",
          "disabled": "<yellow>Arena <yellow>{world}</yellow> desativada — não será sorteada até ser reativada.",
          "removed": "<red>Arena <yellow>{world}</yellow> apagada. Toda a marcação dela foi perdida.",
          "info": {
            "body": [
              "<dark_gray>▪ <white>Arena <yellow>{world}</yellow> <dark_gray>·</dark_gray> <gray>{status}",
              "<gray>Zona da base: <white>{base_zone}",
              "<gray>Cubículo: <white>{cubicle}",
              "<gray>Spawn do atacante: <white>{attacker_spawn}",
              "<gray>Spawn do defensor: <white>{defender_spawn}",
              "<gray>Atalhos: <white>{shortcut_base} <dark_gray>·</dark_gray> <white>{shortcut_platform} <dark_gray>·</dark_gray> <white>{shortcut_counter}"
            ],
            "missing": "<red>não marcado",
            "status": {
              "incomplete": "<red>incompleta",
              "ready": "<green>pronta",
              "disabled": "<yellow>desativada"
            }
          }
        },
        // ====================================================================
        //  /base, /plataforma, /counter — atalhos do DEFENSOR, fora de combate.
        //  Ficam sob uma chave própria para não virarem subcomandos soltos do /f.
        // ====================================================================
        // /loja — reposição item a item do kit da partida. Substituiu o /camada, que só repunha end
        // stone nos slots vazios.
                "simulator-stats": {
          "errors": {
            // O placar vive só enquanto o pós-jogo dura: depois disso os números foram embora com o
            // mundo da partida, e dizer isso é melhor que abrir uma tela vazia.
            "no-stats": "<red>Você não tem nenhuma partida recente para ver o placar."
          }
        },
"simulator-shop": {
          "errors": {
            "not-in-arena": "<red>Você precisa estar no mundo da partida para abrir a <yellow>/loja</yellow>.",
            "awaiting-respawn": "<red>Você está esperando para renascer."
          }
        },
        "simulator-shortcut": {
          "errors": {
            "no-match": "<red>Você não está em nenhuma partida do Simulator.",
            "defender-only": "<red>Só a defesa usa os atalhos da base.",
            // Vale para a espera de renascimento E para quem foi eliminado pelo sistema de vidas: nos
            // dois casos o corpo está em modo espectador e não anda pela base.
            "awaiting-respawn": "<red>Você está esperando para renascer.",
            "in-combat": "<red>Você está em combate! Aguarde <yellow>{remaining_time}</yellow>.",
            "not-marked": "<red>O atalho <yellow>{shortcut}</yellow> não está marcado nesta arena."
          },
          "base": {
            "success": "<green>Você foi levado para a <white>base</white>."
          },
          "plataforma": {
            "success": "<green>Você foi levado para a <white>plataforma</white>."
          },
          "counter": {
            "success": "<green>Você foi levado para o <white>counter</white>."
          }
        }
      },
      "views": {
        "items": {
          "member": {
            "name": "{member_name_with_tag}",
            "lore": [
              "<white>Cargo: {member_role}",
              "<white>Treino: <gray>{member_training_points} pontos",
              "<white>Kit: {member_kit_role}",
              "",
              "<gradient:#FF6F00:#faa825:#FF6F00>Esquerdo: <white>Promover",
              "<gradient:#FF6F00:#faa825:#FF6F00>Direito: <white>Rebaixar"
            ],
            // Papel do membro na partida Fac x Fac: define QUAL kit ele recebe ao entrar. Estes são os
            // nomes COM cor, para leitura (a cabeça do quadro de cargos e as mensagens). A lista
            // clicável da setinha usa os nomes sem cor de "member-kit.roles" abaixo. Só o canhão é
            // único por facção — marcar outro tira do anterior.
            "kit-role": {
              "nenhum": "<dark_gray>nenhum <gray>(joga de PvP)",
              "pvp": "<red>PvP",
              "canhao": "<gold>Canhão",
              "tampar": "<aqua>Tampar"
            }
          },
          // A cabeça no quadro de KITS. A lore lista os papéis com a setinha na opção atual — o mesmo
          // desenho do configurador do Fac x Fac (cannonutils.views.invasao-config).
          //
          // ⚠️ {kit_roles} é UMA linha-molde que vira UMA LINHA POR PAPEL: o Java manda uma coleção e o
          // lang expande. Três regras, todas com falha SILENCIOSA:
          //   1. não repita a linha aqui — cada cópia viraria outro bloco de quatro;
          //   2. não coloque duas coleções na mesma linha — com mais de uma o lang desiste de expandir;
          //   3. NUNCA use {kit_roles} no "name" — chave de nome exige um componente só, e com quatro
          //      o item passa a se chamar literalmente o caminho da chave.
          "member-kit": {
            "name": "{member_name_with_tag}",
            "lore": [
              "<gray>Cargo: {member_role}",
              "",
              " <gradient:#FF6F00:#faa825:#FF6F00>Kit na partida:",
              " {kit_roles}",
              "",
              "<yellow>Kit canhão limitado a 1 membro.",
              "",
              "<gradient:#FF6F00:#faa825:#FF6F00>Clique para alterar."
            ],
            // As duas caras de uma linha da lista. A cor mora AQUI, na linha, e por isso os nomes em
            // "roles" abaixo são sem cor — um nome colorido ficaria igual nos dois estados.
            "role-selected": "<dark_gray>▸</dark_gray> {kit_role_name}",
            "role-option": "<dark_gray> ▸ <gray>{kit_role_name}",
            // Nomes SEM cor, só para a lista da setinha — substantivos secos, para as quatro linhas
            // ficarem do mesmo tamanho (é o alinhamento que faz a setinha ser legível). Os nomes
            // coloridos, usados nas mensagens e na cabeça do quadro de cargos, continuam em
            // "member.kit-role" acima.
            //
            // ⚠️ São DOIS mapas com os mesmos ids (os de MemberKitRole): papel novo ou id renomeado
            // exige mexer nos dois, e o que ficar para trás aparece como chave crua na tela.
            "roles": {
              "nenhum": "Nenhum",
              "pvp": "PvP",
              "canhao": "Canhão",
              "tampar": "Tampar"
            }
          },
          // A bandeira do menu principal. Desde 06/08 ela é PERFIL e PORTA: o clique abre o quadro
          // (promover, rebaixar e trocar o kit), papel que era da cabeça do jogador. Sem o pergaminho e
          // sem a cabeça, é o único caminho de menu até lá — por isso a lore precisa convidar ao clique.
          "banner": {
            "name": "<gradient:#FF6F00:#faa825:#FF6F00>{faction_display_name}",
            "lore": [
              "<gray>Confira e configure os membros",
              "<gray>da facção, altere os kits do",
              "<gray>Fac x Fac e customize os kits.",
              "",
              "<gradient:#FF6F00:#faa825:#FF6F00> ▸ <white>Membros: <gray>{faction_members} <dark_gray>/ <gray>{faction_members_online} online",
              "<gradient:#FF6F00:#faa825:#FF6F00> ▸ <white>Invasões: <gray>{faction_invasions_won} vencidas <dark_gray>·</dark_gray> <gray>{faction_invasions_lost} perdidas",
              "",
              "<gradient:#FF6F00:#faa825:#FF6F00>Clique para configurar."
            ]
          }
        },
        "faction-primary": {
          "title": "Facção [{faction_tag}]",
          "items": {
            // Herdou o slot do pergaminho: os convites eram a outra metade dele.
            "invites": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Convites",
              "lore": [ "<gray>Convide jogadores para a facção",
                        "<gray>ou veja convites pendentes.",
                        "",
                        "<gradient:#FF6F00:#faa825:#FF6F00>Clique para acessar."
            ]
            },
            "ranking": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Ranking",
              "lore": [ "<gray>As melhores facções do Academy.",
                        "",
                        "<gradient:#FF6F00:#faa825:#FF6F00>Clique para acessar."  
            ]
            },
            "invasions": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasões",
              "lore": [ "<gray>Confira as invasões em andamento",
                        "<gray>ou veja o histórico de invasões.",
                        "",
                        "<gradient:#FF6F00:#faa825:#FF6F00>Clique para acessar."   
            ]
            },
            "disband": {
              "name": "<red>Desfazer facção",
              "lore": [
                "<gray>Apaga a facção e solta",
                "<gray>todos os membros."
              ]
            },
            "leave": {
              "name": "<red>Sair da facção",
              "lore": [ "<gray>Você deixa de ser membro." ]
            }
          }
        },
        "faction-members": {
          "title": "Membros [{faction_tag}]",
          "items": {
            // ⚠️ NÓ DE TRAVESSIA — APAGAR NA PRÓXIMA LEVA, junto com o bind `cannon-kit` do Java.
            // O menu que está no ar declara name/lore EXPLÍCITOS apontando para cá. Como o jar sobe
            // ANTES do server-menus (ver o aviso no members/list.yml), existe uma janela de jar novo +
            // menu velho: sem este nó o botão apareceria com a chave crua no nome e na lore. O bind de
            // compatibilidade e esta lang têm o mesmo tempo de vida e saem juntos.
            "cannon-kit": {
              "select": {
                "name": "<gradient:#FF6F00:#faa825:#FF6F00>Kits da partida",
                "lore": [ "<gray>Clique para <white>definir os kits<gray>." ]
              }
            },
            // Porta do quadro de kits. Substituiu o "cannon-kit" acima, cujo nome era herança de quando
            // havia um papel só.
            "kits": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Kits da partida",
              "lore": [
                "<gray>Cada membro entra na Invasão Fac x Fac",
                "<gray>com o kit selecionado.",
                "",
                " <gradient:#FF6F00:#faa825:#FF6F00>Kits disponíveis:",
                " <gradient:#FF6F00:#faa825:#FF6F00>- <white>Pvp ",
                " <gradient:#FF6F00:#faa825:#FF6F00>- <white>Canhão ",
                " <gradient:#FF6F00:#faa825:#FF6F00>- <white>Tampar",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para definir os kits."
              ]
            },
            // Único botão do quadro que não age sobre terceiros: abre o kit de quem clicou.
            "kit-layout": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Organização de inventário",
              "lore": [
                "<gray>Escolha em que slot cada item do",
                "<gray>seu kit vai nascer na Invasão Fac x Fac.",
                "",
                "<yellow> Cada membro arruma o",
                "<yellow> próprio inventário.",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para organizar."
              ]
            }
          },
          "messages": {
            "no-kits": "<red>Nenhum kit de partida está configurado neste servidor.",
            "member-promoted": "{player_name_with_tag} <green>foi promovido.</green>",
            "member-demoted": "{player_name_with_tag} <green>foi rebaixado.</green>",
            "member-kicked": "{player_name_with_tag} <green>foi expulso da facção.</green>",
            "leadership-transferred": "<green>A liderança foi transferida para </green>{player_name_with_tag}<green>.</green>"
          }
        },
        // Quadro dos KITS: com que kit cada membro entra na partida. A cabeça de cada um lista os papéis
        // e a setinha marca o atual — esquerdo desce, direito sobe. Saiu do quadro de membros em 07/08.
        "faction-kits": {
          "title": "Kits [{faction_tag}]",
          "messages": {
            "kit-role-set": "<green>O kit de </green>{player_name_with_tag} <green>agora é {kit_role_name}<green>."
          }
        },
        // ------------------------------------------------------------------
        //  STAFF: catálogo de kits do Fac x Fac (/f admin kits)
        //
        //  O catálogo vive no BANCO. A seção 'simulator.kits' do config.yml é só a semente do primeiro
        //  boot — depois disso editar o arquivo não muda mais nada, igual ao /durabilidade.
        // ------------------------------------------------------------------
        // ------------------------------------------------------------------
        //  STAFF: painel das partidas do Fac x Fac (/f admin partidas)
        //
        //  A lista é replicada por Echo e abre em qualquer app. O estado VIVO (vidas, captura,
        //  ejetores) só existe no anfitrião — fora dele a tela diz que não sabe, em vez de mostrar
        //  zero como se fosse dado.
        // ------------------------------------------------------------------
        "admin-matches": {
          "title": "Partidas Fac x Fac ({em_andamento} em andamento)",
          "items": {
            "partida": {
              "name": "{atacante} <gray>x {defensor}",
              "lore": [
                "<gray>Arena: <white>{arena}",
                "<gray>Fase: {fase}",
                "<gray>Duração: <white>{duracao}",
                "",
                "<gray>Atacantes: {atacantes}",
                "<gray>Defensores: {defensores}",
                "",
                "<yellow>Clique para gerenciar<gray>."
              ],
              "finished-lore": [
                "<gray>Arena: <white>{arena}",
                "<gray>Fase: {fase}",
                "<gray>Durou: <white>{duracao}",
                "",
                "<gray>Atacantes: {atacantes}",
                "<gray>Defensores: {defensores}",
                "",
                "<yellow>Clique para ver a ficha<gray>."
              ]
            },
            "empty": {
              "name": "<white>Nenhuma partida",
              "lore": [
                "<gray>Não há partida em andamento",
                "<gray>nem recém-encerrada."
              ]
            }
          },
          "phases": {
            "preparation": "<yellow>preparação",
            "active": "<red>valendo",
            "finished": "<dark_gray>encerrada",
            "unknown": "<dark_gray>desconhecida"
          },
          "roster": {
            "known": "<white>{na_arena}<gray>/<white>{total} <gray>na arena",
            // Fora do anfitrião não dá para contar quem está na arena: o mundo da partida não existe
            // neste app. Dizer só o tamanho do quadro é honesto; "0 na arena" seria mentira.
            "unknown": "<white>{total} <gray>no quadro"
          }
        },
        "admin-match": {
          "title": "Partida: {arena}",
          "items": {
            "info": {
              "name": "<white>Ficha da partida",
              "lore": [
                "{atacante} <gray>x {defensor}",
                "",
                "<gray>Arena: <white>{arena}",
                "<gray>Mundo: <white>{mundo}",
                "<gray>Fase: {fase}",
                "<gray>Duração: <white>{duracao}",
                "",
                "<gray>Atacantes: {atacantes}",
                "<gray>Defensores: {defensores}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Regras do pedido:",
                "<gray>Equipamento: <white>{equipamento}",
                "<gray>Bloco de proteção: <white>{bloco_protecao}",
                "<gray>Estilo da base: <white>{estilo_base}",
                "<gray>Raio da explosão: <white>{raio} <gray>blocos",
                "<gray>Ejetores: <white>{ejetores_ataque} <gray>ataque, <white>{ejetores_defesa} <gray>defesa",
                "<gray>TNT: <white>{tnt_dano} <gray>dano, <white>{tnt_impulso} <gray>impulso",
                "<gray>Núcleo: {nucleo}",
                "<gray>Domínio: {dominio}",
                "",
                "<gray>Ejetores usados: {ejetores_usados}"
              ],
              // No anfitrião os dados vivos existem de verdade; a lore é a mesma, e o que muda é o
              // valor que {vidas} e {ejetores_usados} trazem.
              "host-lore": [
                "{atacante} <gray>x {defensor}",
                "",
                "<gray>Arena: <white>{arena}",
                "<gray>Mundo: <white>{mundo}",
                "<gray>Fase: {fase}",
                "<gray>Duração: <white>{duracao}",
                "",
                "<gray>Atacantes: {atacantes}",
                "<gray>Defensores: {defensores}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Regras do pedido:",
                "<gray>Equipamento: <white>{equipamento}",
                "<gray>Bloco de proteção: <white>{bloco_protecao}",
                "<gray>Estilo da base: <white>{estilo_base}",
                "<gray>Raio da explosão: <white>{raio} <gray>blocos",
                "<gray>Ejetores: <white>{ejetores_ataque} <gray>ataque, <white>{ejetores_defesa} <gray>defesa",
                "<gray>TNT: <white>{tnt_dano} <gray>dano, <white>{tnt_impulso} <gray>impulso",
                "<gray>Núcleo: {nucleo}",
                "<gray>Domínio: {dominio}",
                "",
                "<gray>Ejetores usados: {ejetores_usados}",
                "",
                "<dark_gray>Este app hospeda a partida."
              ]
            },
            "attacker-won": {
              "name": "<red>Encerrar: vitória do atacante",
              "lore": [
                "<gray>Termina a partida dando a vitória",
                "<gray>ao <white>atacante<gray>.",
                "",
                "<gray>Conta no placar das duas facções.",
                "",
                "<red>Irreversível<gray>. Pede confirmação."
              ]
            },
            "defender-won": {
              "name": "<blue>Encerrar: vitória da defesa",
              "lore": [
                "<gray>Termina a partida dando a vitória",
                "<gray>à <white>defesa<gray>.",
                "",
                "<gray>Conta no placar das duas facções.",
                "",
                "<red>Irreversível<gray>. Pede confirmação."
              ]
            },
            "cancel": {
              "name": "<yellow>Encerrar sem vencedor",
              "lore": [
                "<gray>Termina a partida <white>sem vencedor<gray>:",
                "<gray>ninguém ganha, ninguém perde e o",
                "<gray>placar não é tocado.",
                "",
                "<gray>É o caminho da partida travada.",
                "",
                "<red>Irreversível<gray>. Pede confirmação."
              ]
            },
            "teleport": {
              "name": "<aqua>Ir até a arena",
              "lore": [
                "<gray>Leva você ao mundo da partida",
                "<gray>para ver o que está acontecendo.",
                "",
                "<dark_gray>Só no app que hospeda a partida."
              ]
            },
            // MONITORAR é o teleporte com ferramentas: além de ir até lá, a staff ganha a barra, o
            // espectador e as ações sobre os jogadores. Por isso os dois botões convivem — quem só quer
            // dar uma olhada continua tendo um caminho sem entrar no modo de trabalho.
            "monitor": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Monitorar partida",
              "lore": [
                "<gray>Entra na partida como <white>staff<gray>:",
                "<gray>invisível, atravessando parede e",
                "<gray>sem contar para nenhum dos lados.",
                "",
                "<gray>Na sua barra:",
                "<gray>• <white>Ficha<gray> da partida",
                "<gray>• <white>Jogadores<gray> dos dois lados",
                "<gray>• Trocar entre <white>espectador<gray> e <white>criativo",
                "<gray>• <white>Sair<gray> e voltar ao spawn",
                "",
                "<yellow>Clique para começar a monitorar<gray>.",
                "",
                "<dark_gray>De outro app você é levado até lá."
              ]
            },
            "players": {
              "name": "<white>Jogadores da partida",
              "lore": [
                "<gray>Os dois quadros lado a lado: quem",
                "<gray>está vivo, quem caiu, quem espera",
                "<gray>renascer e quanto falta.",
                "",
                "<gray>Abre em <white>qualquer app<gray> — os quadros",
                "<gray>viajam junto com a partida.",
                "",
                "<yellow>Clique para ver a lista<gray>."
              ]
            },
            // A tela das REGRAS. Fica na linha das ferramentas do painel porque ajustar regra não
            // encerra nada — e um botão de ajuste entre os três encerramentos convidaria ao clique
            // errado.
            "rules": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Regras da partida",
              "lore": [
                "<gray>As mesmas regras da ficha, só que",
                "<gray>editáveis com a partida <white>rodando<gray>.",
                "",
                "<gray>Bloco, equipamento, ejetores, dano,",
                "<gray>impulsão, raio, domínio e núcleo.",
                "<gray>O <white>estilo da base<gray> não: ela já está de pé.",
                "",
                "<gray>Cada mudança avisa os <white>dois quadros<gray>.",
                "",
                "<yellow>Clique para abrir<gray>."
              ]
            }
          },
          "phases": {
            "preparation": "<yellow>preparação",
            "active": "<red>valendo",
            "finished": "<dark_gray>encerrada",
            "unknown": "<dark_gray>desconhecida"
          },
          "roster": {
            "known": "<white>{na_arena}<gray>/<white>{total} <gray>na arena",
            "unknown": "<white>{total} <gray>no quadro"
          },
          "labels": {
            "on": "<green>ligado",
            "off": "<dark_gray>desligado",
            "disabled": "<dark_gray>desligadas",
            // Dado que só existe no app que hospeda a partida. Dizer isso é melhor que mostrar zero.
            "host-only": "<dark_gray>só no anfitrião",
            "nucleus": "<white>{percentual}%</white> <gray>({restantes} de {total} de pé)</gray>",
            "ejectors": "<white>{atacante} <gray>ataque, <white>{defensor} <gray>defesa"
          },
          "messages": {
            "teleported": "<green>Você foi levado à arena <yellow>{arena}</yellow>.",
            "world-gone": "<red>O mundo dessa partida não está mais carregado."
          }
        },
        // ------------------------------------------------------------------
        //  STAFF: as regras da partida, editáveis com ela EM CURSO (painel ▸ Regras da partida).
        //
        //  O vocabulário é o do configurador da bússola (`plugins.cannonutils.views.invasao-config`):
        //  mesmos nomes e mesmas lores, para quem conhece aquela tela reconhecer esta. Duas coisas
        //  mudam, e são a razão de a tela existir:
        //    1. o ESTILO DA BASE não é editável — a base já está de pé, e trocar o molde agora não
        //       reconstrói nada; ele aparece só para dizer o que está em campo;
        //    2. cada regra diz QUANDO a mudança passa a valer. Antes da partida a regra é uma escolha;
        //       durante ela é uma troca, e a staff precisa saber o que a troca alcança e o que já passou.
        //
        //  As três regras de TNT (dano, impulsão e raio) vivem aqui mesmo tendo saído do menu do
        //  desafio: elas continuam valendo na partida, só deixaram de ser escolhidas pelo desafiante.
        // ------------------------------------------------------------------
        "admin-match-rules": {
          "title": "Regras: {arena}",
          "items": {
            // Id que este arquivo não conhece (partida aberta por um jar mais novo): a tela diz isso em
            // vez de deixar o slot mudo.
            "unknown": {
              "lore": [
                "<gray>Regra desconhecida por este servidor.",
                "",
                "<dark_gray>A partida foi aberta por uma versão mais nova."
              ]
            },
            "protection-block": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Bloco de proteção",
              "glacite": {
                "lore": [
                  "<gray>O bloco que reveste a parede da base.",
                  "",
                  " <gradient:#FF6F00:#faa825:#FF6F00>▸</gradient> <white>Glacite",
                  " <dark_gray>▸</dark_gray> <gray>Rocha Protetora",
                  " <dark_gray>▸</dark_gray> <gray>Rocha Congelada",
                  " <dark_gray>▸</dark_gray> <gray>Bedrock",
                  "",
                  "<yellow>Clique para alterar<gray>.",
                  "<dark_gray>Vale do próximo kit em diante; a parede de pé não muda."
                ]
              },
              "protective-rock": {
                "lore": [
                  "<gray>O bloco que reveste a parede da base.",
                  "",
                  " <dark_gray>▸</dark_gray> <gray>Glacite",
                  " <gradient:#FF6F00:#faa825:#FF6F00>▸</gradient> <white>Rocha Protetora",
                  " <dark_gray>▸</dark_gray> <gray>Rocha Congelada",
                  " <dark_gray>▸</dark_gray> <gray>Bedrock",
                  "",
                  "<yellow>Clique para alterar<gray>.",
                  "<dark_gray>Vale do próximo kit em diante; a parede de pé não muda."
                ]
              },
              "frozen-rock": {
                "lore": [
                  "<gray>O bloco que reveste a parede da base.",
                  "",
                  " <dark_gray>▸</dark_gray> <gray>Glacite",
                  " <dark_gray>▸</dark_gray> <gray>Rocha Protetora",
                  " <gradient:#FF6F00:#faa825:#FF6F00>▸</gradient> <white>Rocha Congelada",
                  " <dark_gray>▸</dark_gray> <gray>Bedrock",
                  "",
                  "<yellow>Clique para alterar<gray>.",
                  "<dark_gray>Vale do próximo kit em diante; a parede de pé não muda."
                ]
              },
              "bedrock": {
                "lore": [
                  "<gray>O bloco que reveste a parede da base.",
                  "",
                  " <dark_gray>▸</dark_gray> <gray>Glacite",
                  " <dark_gray>▸</dark_gray> <gray>Rocha Protetora",
                  " <dark_gray>▸</dark_gray> <gray>Rocha Congelada",
                  " <gradient:#FF6F00:#faa825:#FF6F00>▸</gradient> <white>Bedrock",
                  "",
                  "<yellow>Clique para alterar<gray>.",
                  "<dark_gray>Vale do próximo kit em diante; a parede de pé não muda."
                ]
              }
            },
            "equipment": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Equipamento",
              "lore": [
                "<gray>O material das peças que o kit entrega.",
                "",
                "<gray>Atual: <white>{equipamento}",
                "",
                "<yellow>Clique para alternar<gray>.",
                "<dark_gray>Quem já recebeu o kit fica com o anterior."
              ]
            },
            "attack-ejectors": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Ejetores do ataque",
              "lore": [
                "<gray>Quantos ejetores o <white>ataque<gray> pode ter",
                "<gray>de pé ao mesmo tempo.",
                "",
                "<gray>Atual: <white>{valor}",
                "",
                "<yellow>Esquerdo <gray>aumenta, <yellow>direito <gray>diminui.",
                "<dark_gray>Baixar o teto não derruba o que já está colocado."
              ]
            },
            "defense-ejectors": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Ejetores da defesa",
              "lore": [
                "<gray>Quantos ejetores a <white>defesa<gray> pode ter",
                "<gray>de pé ao mesmo tempo.",
                "",
                "<gray>Atual: <white>{valor}",
                "",
                "<yellow>Esquerdo <gray>aumenta, <yellow>direito <gray>diminui.",
                "<dark_gray>Baixar o teto não derruba o que já está colocado."
              ]
            },
            "tnt-damage": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Dano da TNT",
              "lore": [
                "<gray>Quanto de durabilidade cada tiro tira",
                "<gray>da <white>primeira camada<gray> da parede.",
                "",
                "<gray>Atual: <white>{valor}",
                "",
                "<yellow>Esquerdo <gray>aumenta, <yellow>direito <gray>diminui.",
                "<dark_gray>Vale do próximo tiro em diante."
              ]
            },
            "tnt-impulse": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Impulsão da TNT",
              "lore": [
                "<gray>A força com que a TNT de impulso",
                "<gray>empurra a de dano no canhão.",
                "",
                "<gray>Atual: <white>{valor}",
                "",
                "<yellow>Esquerdo <gray>aumenta, <yellow>direito <gray>diminui.",
                "<dark_gray>Muda o alcance dos canhões já calibrados."
              ]
            },
            "radius": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Raio da explosão",
              "lore": [
                "<gray>O alcance de cada tiro, em blocos:",
                "<gray>tantos para <white>cima<gray>, para <white>baixo<gray> e para",
                "<gray>cada <white>lado<gray>.",
                "",
                "<gray>Atual: <white>{valor}",
                "",
                "<gray>A <white>1ª camada<gray> da parede leva o dano",
                "<gray>inteiro, a 2ª <white>metade<gray>, a 3ª <white>um quarto<gray>.",
                "",
                "<yellow>Esquerdo <gray>aumenta, <yellow>direito <gray>diminui.",
                "<dark_gray>Vale do próximo tiro em diante."
              ]
            },
            "domination": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Vitória por domínio",
              "disabled": {
                "lore": [
                  "<gray>Sem domínio, o ataque vence ao",
                  "<gray><white>pisar<gray> no cubículo do centro.",
                  "",
                  "<gray>Estado: <dark_gray>desligado",
                  "",
                  "<dark_gray>Fixado na abertura: a invasão guarda esta",
                  "<dark_gray>regra e não a troca com a partida em curso."
                ]
              },
              "enabled": {
                "lore": [
                  "<gray>Com domínio, o ataque precisa <white>segurar",
                  "<gray>o cubículo até a barra encher.",
                  "",
                  "<gray>Estado: <green>ligado",
                  "",
                  "<dark_gray>Fixado na abertura: a invasão guarda esta",
                  "<dark_gray>regra e não a troca com a partida em curso."
                ]
              }
            },
            "nucleus": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Vitória por núcleo",
              "disabled": {
                "lore": [
                  "<gray>Sem núcleo, o centro da base é só",
                  "<gray>o ponto que o ataque precisa alcançar.",
                  "",
                  "<gray>Estado: <dark_gray>desligado",
                  "",
                  "<yellow>Clique para ligar<gray>, <gray>na preparação.",
                  "<dark_gray>Com a partida em campo o botão não age:",
                  "<dark_gray>encher o cubículo taparia o rombo aberto."
                ]
              },
              "enabled": {
                "lore": [
                  "<gray>Com núcleo, o ataque tem de <white>abrir",
                  "<gray>os spawners do centro a canhão.",
                  "",
                  "<gray>Estado: <green>ligado",
                  "",
                  "<yellow>Clique para desligar<gray>, <gray>na preparação.",
                  "<dark_gray>Os spawners já colocados continuam de pé."
                ]
              }
            },
            "base-style": {
              "name": "<white>Estilo da base",
              "traditional": {
                "lore": [
                  "<gray>A base desta partida: <white>Tradicional",
                  "",
                  "<dark_gray>Não é editável: o mapa já foi montado."
                ]
              },
              "square": {
                "lore": [
                  "<gray>A base desta partida: <white>Quadrada",
                  "",
                  "<dark_gray>Não é editável: o mapa já foi montado."
                ]
              },
              "star": {
                "lore": [
                  "<gray>A base desta partida: <white>Estrela",
                  "",
                  "<dark_gray>Não é editável: o mapa já foi montado."
                ]
              }
            },
            "step-plus": {
              "name": "<green>Aumentar",
              "lore": [
                "<gray>Clique para somar <white>1<gray>.",
                "<gray>Com <white>Shift<gray>, soma <white>10<gray>."
              ]
            },
            "step-minus": {
              "name": "<red>Diminuir",
              "lore": [
                "<gray>Clique para tirar <white>1<gray>.",
                "<gray>Com <white>Shift<gray>, tira <white>10<gray>."
              ]
            }
          },
          "messages": {
            "finished": "<red>Essa partida já acabou — não há regra para ajustar."
          }
        },
        "admin-match-confirm": {
          "title": "Encerrar partida ({acao})",
          "items": {
            "atacante": {
              "name": "<red>Vitória do atacante",
              "lore": [
                "{atacante} <gray>x {defensor}",
                "<gray>Arena: <white>{arena}",
                "",
                "<gray>A partida termina agora e a vitória",
                "<gray>vai para o <white>atacante<gray>.",
                "",
                "<red>Isso conta no placar das duas facções."
              ]
            },
            "defensor": {
              "name": "<blue>Vitória da defesa",
              "lore": [
                "{atacante} <gray>x {defensor}",
                "<gray>Arena: <white>{arena}",
                "",
                "<gray>A partida termina agora e a vitória",
                "<gray>vai para a <white>defesa<gray>.",
                "",
                "<red>Isso conta no placar das duas facções."
              ]
            },
            "cancelar": {
              "name": "<yellow>Encerrar sem vencedor",
              "lore": [
                "{atacante} <gray>x {defensor}",
                "<gray>Arena: <white>{arena}",
                "",
                "<gray>A partida termina agora <white>sem vencedor<gray>.",
                "<gray>O placar das facções não é tocado."
              ]
            }
          },
          "messages": {
            "gone": "<red>Essa partida não existe mais.",
            "already-finished": "<red>Essa partida já tinha sido encerrada.",
            // O anfitrião é outro app: o pedido saiu pelo Echo e a confirmação chega quando ele executar.
            "dispatched": "<yellow>Pedido de encerramento (<white>{acao}</white>) enviado ao servidor que hospeda a partida."
          }
        },
        // ====================================================================
        //  Monitoramento da staff — o quadro dos dois lados e a ficha de um jogador.
        // ====================================================================
        //
        // Estas duas telas respondem a pergunta que a ficha da partida NÃO responde: "quem está em campo
        // agora?". É a pergunta de quem foi chamado para julgar uma denúncia no meio da invasão.
        "monitor-players": {
          "title": "{atacante} x {defensor}",
          "items": {
            // A ordem da lista põe na frente quem exige atenção: primeiro quem espera renascer (tem um
            // relógio correndo), depois quem está em campo, e os ausentes por último.
            "player": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                "<gray>Estado: {estado}",
                "<gray>Vida: <red>{vida} ❤",
                "<gray>Onde: {local}",
                "",
                "<gray>Abates: <white>{abates}",
                "<gray>Mortes: <white>{mortes}",
                "",
                "<yellow>Clique para agir sobre ele<gray>."
              ]
            }
          },
          "states": {
            "alive": "<green>em campo",
            "waiting": "<yellow>renascendo <gray>(<white>{restante}<gray>)",
            "eliminated": "<dark_red>eliminado",
            "offline": "<dark_gray>ausente",
            // O jogador não está online: não dá para ler vida nem posição dele. Dizer isso é melhor
            // que mostrar zero como se fosse leitura.
            "unknown": "<dark_gray>—",
            "in-arena": "<green>na arena",
            "outside": "<red>fora da arena"
          }
        },
        "monitor-player": {
          "title": "{jogador_name_with_tag}",
          "items": {
            "head": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                "<gray>O que dá para fazer por ele sem",
                "<gray>sair do monitoramento.",
                "",
                "<dark_gray>Encerrar a partida continua na ficha."
              ]
            },
            "kit": {
              "name": "<green>Devolver o kit",
              "lore": [
                "<gray>Entrega o kit inteiro de novo, do",
                "<gray>jeito que ele receberia ao renascer:",
                "<gray>papel, equipamento e a organização",
                "<gray>que ele mesmo salvou.",
                "",
                "<yellow>Clique para devolver<gray>."
              ]
            },
            "heal": {
              "name": "<light_purple>Curar",
              "lore": [
                "<gray>Vida e fome cheias, e o fogo apagado.",
                "",
                "<gray>É o socorro de quando um bug tirou",
                "<gray>vida de alguém sem motivo.",
                "",
                "<yellow>Clique para curar<gray>."
              ]
            },
            "revive": {
              "name": "<gold>Voltar ao campo agora",
              "lore": [
                "<gray>Traz de volta quem está <yellow>renascendo<gray>,",
                "<gray>sem esperar a contagem terminar.",
                "",
                "<gray>Ele volta ao spawn do lado dele e",
                "<gray>recebe o kit, como no tempo normal.",
                "",
                "<yellow>Clique para trazer de volta<gray>.",
                "",
                "<dark_gray>Só para quem está esperando."
              ]
            },
            "teleport": {
              "name": "<aqua>Ir até ele",
              "lore": [
                "<gray>Leva você até onde ele está agora.",
                "",
                "<yellow>Clique para ir<gray>."
              ]
            }
          },
          "messages": {
            "kit": "<green>Kit devolvido a </green>{jogador_name_with_tag}<green>.</green>",
            "heal": "{jogador_name_with_tag} <green>foi curado.</green>",
            "revive": "{jogador_name_with_tag} <green>voltou ao campo.</green>",
            "teleported": "<green>Você foi levado até </green>{jogador_name_with_tag}<green>.</green>",
            // Vale para as quatro ações: sem o jogador online (ou sem ele esperando, no caso do
            // retorno ao campo) não há o que fazer, e fingir que deu certo seria pior.
            "offline": "<red>Não deu para agir sobre esse jogador agora.",
            // Ir até alguém no meio da invasão exige estar em modo monitor (espectador): fora dele o
            // admin chegaria em campo como alvo.
            "not-monitoring": "<red>Monitore a partida (botão <yellow>Monitorar</yellow> da ficha) para ir até ele."
          }
        },
        "admin-kit-editor": {
          "title": "Kits do Fac x Fac",
          "items": {
            // O NOME desta célula é o do próprio item; só a lore vem daqui.
            "linha": {
              "lore": [
                "<gray>Quantidade: <white>{quantidade}",
                "<gray>Pilhas: <white>{repetir}",
                "<gray>Veste: <white>{equipar}",
                "<gray>Slot: <white>{slot}",
                "<gray>Encantamentos: <white>{encantamentos}",
                "",
                "<yellow>Clique para editar esta linha<gray>."
              ]
            },
            "role": {
              "pvp": { "name": "<white>Papel: <red>PvP" },
              "canhao": { "name": "<white>Papel: <gold>Canhão" },
              "tampar": { "name": "<white>Papel: <aqua>Tampar" },
              "lore": [
                "<gray>Cada papel tem a própria lista",
                "<gray>de itens.",
                "",
                "<yellow>Clique para trocar de papel<gray>."
              ]
            }
          },
          "labels": {
            "yes": "<green>sim",
            "no": "<red>não",
            "anywhere": "<gray>onde couber",
            "none": "<dark_gray>nenhum"
          },
          "messages": {
            "item-added": "<green>{item} <green>entrou no kit de {papel}<green>."
          }
        },
        "admin-kit-item": {
          "title": "Linha do kit",
          "items": {
            "amount": {
              "name": "<white>Quantidade: <yellow>{quantidade}",
              "lore": [
                "<gray>Tamanho de <white>cada pilha</white> entregue.",
                "",
                "<gray>Esquerdo <white>+1<gray>, direito <white>-1",
                "<gray>Shift multiplica por <white>10<gray>."
              ]
            },
            "repeat": {
              "name": "<white>Pilhas: <yellow>{repetir}",
              "lore": [
                "<gray>Quantas pilhas <white>iguais</white> vão para",
                "<gray>o inventário.",
                "",
                "<gray>Esquerdo <white>+1<gray>, direito <white>-1",
                "<gray>Shift multiplica por <white>10<gray>."
              ]
            },
            "equip": {
              "name": "<white>Vestir",
              "yes": {
                "lore": [
                  "<gray>Uma cópia é <white>vestida</white> ao nascer.",
                  "<gray>Só faz sentido em armadura.",
                  "",
                  "<green>Ligado<gray>. Clique para desligar."
                ]
              },
              "no": {
                "lore": [
                  "<gray>Uma cópia é <white>vestida</white> ao nascer.",
                  "<gray>Só faz sentido em armadura.",
                  "",
                  "<red>Desligado<gray>. Clique para ligar."
                ]
              }
            },
            "slot": {
              "name": "<white>Slot: <yellow>{slot}",
              "lore": [
                "<gray>Onde a pilha nasce no inventário.",
                "<gray><white>0–8</white> é a hotbar, <white>9–35</white> o resto.",
                "",
                "<gray>Esquerdo <white>+1<gray>, direito <white>-1",
                "<gray>Shift multiplica por <white>10",
                "<gray>Clique do meio: <white>onde couber<gray>."
              ]
            },
            "delete": {
              "name": "<red>Apagar esta linha",
              "lore": [
                "<gray>Tira o item do kit.",
                "",
                "<red>Clique para apagar<gray>."
              ]
            }
          },
          "labels": {
            "anywhere": "<gray>onde couber"
          },
          "messages": {
            "deleted": "<green>Linha apagada do kit.",
            // A quantidade desta linha é decidida pela PARTIDA (o teto de ejetores do lado do jogador);
            // sobrescrevê-la por um clique de ajuste apagaria uma regra do jogo em silêncio.
            "amount-locked": "<red>A quantidade desta linha vem da partida (<yellow>{marcador}</yellow>) e não se ajusta aqui."
          }
        },
        // Organização de inventário do kit de partida. As três primeiras linhas são os slots 9–35 e a
        // quarta é a hotbar — a mesma geometria da tela do jogo.
        "faction-kit-layout": {
          "title": "Organizar kit: {kit_role_name}",
          "items": {
            // Item de leitura, no canto: qual kit está na tela e como se mexe nele.
            "kit": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Kit de {kit_role_name}",
              "lore": [
                "<gray>Este é o inventário com que você vai",
                "<gray>nascer na Invasão Fac x Fac.",
                "",
                "<gray>Clique num item e depois <white>no destino</white>",
                "<gray>para trocar os dois de lugar.",
                "<gray>Clique nele de novo para <red>cancelar<gray>.",
                "",
                "<gray>A <white>última linha</white> é a sua <white>hotbar<gray>.",
                "<dark_gray>As quantidades são definidas na partida.",
                "<dark_gray>Sua ordem é salva ao fechar."
              ]
            },
            // Item de LEITURA desde 14/08/2026, não mais um seletor. Antes ele alternava entre
            // netherite e diamante, porque cada material era um kit diferente com organização própria.
            // Hoje o kit é um só: o material troca apenas as peças de armadura, as espadas e a picareta,
            // na hora da entrega, e a organização vale para os dois. Não há mais o que escolher aqui — e
            // o jogador precisa saber por quê, senão procura o botão que sumiu.
            "equipment": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Equipamento da partida",
              "lore": [
                "<gray>Netherite ou diamante, escolhido",
                "<gray>no menu <white>Fac x Fac</white> antes do desafio.",
                "",
                "<gray>Só muda o <white>material</white> da armadura,",
                "<gray>das espadas e da picareta.",
                "",
                "<dark_gray>Esta organização vale para os dois."
              ]
            },
            "reset": {
              "name": "<red>Restaurar ordem padrão",
              "lore": [
                "<gray>Devolve este kit à ordem original e",
                "<gray>apaga a sua organização dele.",
                "",
                "<gray>Só afeta o kit que está na tela."
              ]
            },
            // Linha acrescentada à lore da pilha que está esperando destino.
            "cell": {
              "selected": [
                "",
                "<green>» Selecionado <gray>— clique no destino."
              ]
            },
            // Substitutos do desenho: os itens de canhão são registrados pelo cannon-utils só nos apps
            // com mecânica de canhão, e esta tela é aberta no SPAWN. O nome vem daqui para o jogador
            // reconhecer a pilha — dois ejetores lado a lado seriam dois "Dispenser" iguais.
            "custom": {
              "cannon-bedrock-pickaxe": { "name": "<light_purple>Picareta de Bedrock" },
              "cannon-dispenser-normal": { "name": "<red>Ejetor com TNT de dano" },
              "cannon-dispenser-impulse": { "name": "<aqua>Ejetor com TNT de impulsão" },
              "enchanted-golden-apple": { "name": "<gold>Maçã dourada encantada" },
              "protecao": { "name": "<white>Bloco de proteção da partida" },
              "desconhecido": { "name": "<dark_gray>Item indisponível" }
            }
          },
          "messages": {
            "reset": "<green>A ordem deste kit voltou ao padrão."
          }
        },
        "faction-invites": {
          "title": "Convites [{faction_tag}]",
          "items": {
            "empty": {
              "name": "<red>Nenhum convite pendente",
              "lore": [ "<gray>Use o livro para convidar alguém." ]
            },
            "invite": {
              "name": "{player_name_with_tag}",
              "lore": [
                "<gray>Convidado por: </gray>{inviter_name_with_tag}",
                "<gray>Expira em: <white>{remaining_time}",
                "",
                "<gray>Direito: <red>cancelar convite"
              ]
            },
            "invite-button": {
              "name": "<white>Convidar jogador",
              "lore": [ "<gray>Clique e digite o nome no chat." ]
            }
          },
          "messages": {
            "invite-query": "<gray>Digite no chat o nome do jogador que deseja convidar.",
            "invited": "<green>Convite enviado para </green>{player_name_with_tag}<green>.</green>",
            "cancelled": "<yellow>Convite de </yellow>{player_name_with_tag} <yellow>cancelado.</yellow>",
            // Nome DIGITADO de alguém que pode nem existir: sem cargo, logo sem tag. Não troque por _with_tag.
            "player-not-found": "<red>Jogador <yellow>{player_name}</yellow> não encontrado."
          }
        },
        "faction-ranking": {
          "title": "Ranking de facções",
          "categories": {
            "selected": {
              "name": "<green>{ranking_type_name}",
              "lore": [
                "{ranking_type_description}",
                "",
                "<green>▪ Aba selecionada."
              ]
            },
            "unselected": {
              "name": "<white>{ranking_type_name}",
              "lore": [
                "{ranking_type_description}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para ver."
              ]
            }
          },
          "items": {
            "entry": {
              "name": "<color:{ranking_position_color}>#{ranking_position} <white>[{ranking_faction_tag}] {ranking_faction_name}",
              "lore": [ "<gray>Pontuação: <white>{ranking_value}" ]
            }
          }
        },
        "faction-invasions": {
          "title": "Invasões [{faction_tag}]",
          "sides": {
            "attacker": "<red>atacando",
            "defender": "<green>defendendo"
          },
          "items": {
            "pending": {
              "name": "<yellow>Preparação <dark_gray>·</dark_gray> {opponent_display_name}",
              "lore": [
                "<gray>Sua facção está {invasion_side}<gray>.",
                "<gray>Começa em: <white>{remaining_time}",
                "<gray>Alvo: <white>{required_blocks} <gray>blocos"
              ]
            },
            "active": {
              "name": "<red>Em andamento <dark_gray>·</dark_gray> {opponent_display_name}",
              "lore": [
                "<gray>Sua facção está {invasion_side}<gray>.",
                "<gray>Termina em: <white>{remaining_time}",
                "<gray>Progresso: <white>{destroyed_blocks}/{required_blocks} <gray>blocos",
                "<gray>Mortes: <red>{attacker_kills} <gray>× <green>{defender_kills}"
              ]
            },
            "finished": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasão encerrada",
              "lore": [
                "<gray>Confira o resultado e estatísticas",
                "<gray>da invasão.",
                "",
                "<white> Você estava: {invasion_side}<gray>.",
                "<white> Resultado: {invasion_result}",
                "<white> Blocos destruídos: <gray>{destroyed_blocks}",
                "<white> Blocos colocados: <gray>",
                "<white> Abates: <red>{attacker_kills} <gray>× <green>{defender_kills}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00> 1h 35min de invasão."
              ]
            },
            // Partidas do Simulator (Fac x Fac): mesma tela, sem as linhas de placar por blocos —
            // ali a vitória é por cubículo, rendição ou relógio, e "Alvo: 0 blocos" não diria nada.
            "pending-arena": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasão vs {opponent_display_name} ",
              "lore": [
                "<gray>Confira o resultado e estatísticas",
                "<gray>da invasão.",
                "",
                "<white> Você está: {invasion_side}<gray>.",
                "<white> Resultado: {invasion_result}",
                "<white> Blocos destruídos: <gray>{destroyed_blocks}",
                "<white> Blocos colocados: <gray>",
                "<white> Abates: <red>{attacker_kills} <gray>× <green>{defender_kills}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Iniciando..."
              ]
            },
            "active-arena": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasão vs {opponent_display_name}",
              "lore": [
                "<gray>Confira o resultado ou estatísticas",
                "<gray>da invasão.",
                "",
                "<white> Você está: {invasion_side}<gray>.",
                "<white> Resultado: {invasion_result}",
                "<white> Blocos destruídos: <gray>{destroyed_blocks}",
                "<white> Blocos colocados: <gray>",
                "<white> Abates: <red>{attacker_kills} <gray>× <green>{defender_kills}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Em andamento."
              ]
            },
            "finished-arena": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasão vs {opponent_display_name}",
              "lore": [
                "<gray>Confira o resultado e estatísticas",
                "<gray>da invasão.",
                "",
                "<white> Você estava: {invasion_side}<gray>.",
                "<white> Resultado: {invasion_result}",
                "<white> Blocos destruídos: <gray>{destroyed_blocks}",
                "<white> Blocos colocados: <gray>",
                "<white> Abates: <red>{attacker_kills} <gray>× <green>{defender_kills}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>1h 35min de invasão."
              ]
            }
          }
        },
        // ====================================================================
        //  Desafio Fac x Fac em modo LEITURA (`/facxfac visualizar`, e o botão
        //  [VISUALIZAR] do convite).
        //
        //  Quem desafia configura a partida inteira na bússola do spawn; deste
        //  lado nada é editável — as lores dizem o que ficou valendo e os dois
        //  botões respondem. Por isso NENHUMA linha aqui pode terminar em
        //  "clique para alterar", como as do configurador
        //  (`plugins.cannonutils.views.invasao-config`).
        //
        //  Placeholders: requester_tag / requester_display_name,
        //  opponent_tag / opponent_display_name, expires_in,
        //  attack_ejectors, defense_ejectors, tnt_damage, tnt_impulse, lives,
        //  capture_seconds (o tempo de captura do domínio, que é do servidor).
        // ====================================================================
        // Lojinha da partida (/loja): reposição item a item do PRÓPRIO kit, grátis e sem limite.
        // O conteúdo é do Java — cada jogador vê só o kit do papel dele nesta partida.
        // ------------------------------------------------------------------
        //  Placar da partida: os dois quadros lado a lado, atacante à esquerda.
        //  Mostrar só o próprio lado esconderia a metade que explica a derrota.
        // ------------------------------------------------------------------
        "simulator-stats": {
          "title": "Placar da partida",
          "items": {
            "match": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00><bold>A partida",
              "lore": [
                "{atacante} <gray>x {defensor}",
                "",
                "<gray>Vencedor: {vencedor}",
                "<gray>Duração: <white>{duracao}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Ataque",
                "<gray>Abates: <white>{abates_atacante}",
                "<gray>Blocos derrubados: <white>{quebrados_atacante}",
                "<gray>Blocos colocados: <white>{colocados_atacante}",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Defesa",
                "<gray>Abates: <white>{abates_defensor}",
                "<gray>Blocos derrubados: <white>{quebrados_defensor}",
                "<gray>Blocos colocados: <white>{colocados_defensor}"
              ]
            },
            // Uma cabeça por jogador, já na ordem de desempenho — a primeira é o destaque do lado.
            "player": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                "<gray>Abates: <white>{abates} <dark_gray>· <gray>Mortes: <white>{mortes}",
                "<gray>Maior sequência: <white>{sequencia}",
                "<gray>Blocos colocados: <white>{blocos_colocados}"
              ]
            },
            "top-killer": {
              "name": "<gradient:#ff6b6b:#ff2d2d:#ff6b6b><bold>Mais abates",
              "lore": [
                "{jogador_name_with_tag} <gray>por {faccao}",
                "",
                "<gray>Abates: <white>{abates}"
              ],
              "empty-lore": [ "<dark_gray>Ninguém abateu nesta partida." ]
            },
            "top-streak": {
              "name": "<gradient:#ffd34d:#ffb300:#ffd34d><bold>Maior sequência",
              "lore": [
                "{jogador_name_with_tag} <gray>por {faccao}",
                "",
                "<gray>Sequência: <white>{sequencia} <gray>sem morrer"
              ],
              "empty-lore": [ "<dark_gray>Ninguém emendou dois abates." ]
            }
          },
          "labels": {
            "no-winner": "<dark_gray>sem vencedor"
          }
        },
        // ====================================================================
        //  QUADRO DA PARTIDA (/f convocar) — em cima quem está em campo, embaixo quem pode ser
        //  chamado. O clique de cima DISPENSA (de graça, abre vaga) e o de baixo CONVOCA (gasta uma
        //  das três do lado). Só líder e capitães abrem a tela.
        // ====================================================================
        "simulator-roster": {
          "title": "Quadro da partida — {quadro}/{limite}",
          "items": {
            "info": {
              "name": "<aqua>Quadro da partida",
              "lore": [
                "<gray>Em campo: <white>{quadro}<gray>/<white>{limite}",
                "<gray>Vagas livres: <white>{vagas}",
                "<gray>Convocações: <white>{convocacoes}<gray>/<white>{convocacoes_limite}",
                "",
                "<gray>O quadro abriu com quem estava <white>online<gray>.",
                "<gray>Quem entrou depois só joga se for convocado.",
                "",
                "<dark_gray>Dispensar é de graça; convocar gasta uma."
              ]
            },
            // Quem está EM CAMPO. Os ausentes vêm primeiro na lista — são eles que o líder veio trocar.
            "member": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                "<gray>Cargo: {cargo}",
                "<gray>Estado: {estado}",
                "",
                "<red>Clique para dispensar<gray>.",
                "<dark_gray>Ele volta ao spawn e abre uma vaga."
              ],
              // O próprio jogador não pode se dispensar: o quadro ficaria sem quem o comanda.
              "lore-self": [
                "<gray>Cargo: {cargo}",
                "<gray>Estado: {estado}",
                "",
                "<dark_gray>Você não pode dispensar a si mesmo."
              ]
            },
            // Membro da facção que está ONLINE e FORA da partida.
            "candidate": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                "<gray>Cargo: {cargo}",
                "<gray>Está <white>fora<gray> da partida.",
                "",
                "<green>Clique para convocar<gray>.",
                "<dark_gray>Gasta uma convocação do seu lado."
              ]
            },
            "separator": {
              "name": " "
            }
          },
          "states": {
            "in-field": "<green>em campo",
            "offline": "<red>desconectado"
          }
        },
        "simulator-shop": {
          "title": "Reposição — todos os kits",
          "items": {
            // Linha ACRESCENTADA à lore do item real: o nome e a lore dele continuam acima.
            "offer": {
              "lore": [
                "",
                "<gray>Clique para receber <yellow>{amount}<gray>."
              ]
            },
            "info": {
              "name": "<aqua>Reposição da partida",
              "lore": [
                "<gray>Aqui você repõe os itens de <white>todos",
                "<white>os kits<gray> — os do seu kit de",
                "<yellow>{kit_role_name} <gray>vêm primeiro.",
                "",
                "<gray>É de graça e sem limite — clique",
                "<gray>quantas vezes precisar.",
                "",
                "<light_purple>A Box Instantânea <gray>só sai daqui:",
                "<gray>no máximo <white>4 por partida<gray> (do seu",
                "<gray>lado), uma a cada <white>5 minutos<gray>.",
                "",
                "<dark_gray>Só funciona dentro da partida."
              ]
            }
          },
          "messages": {
            // Inventário cheio: a compra é RECUSADA em vez de derramar a pilha no chão. Conta só os 36
            // slots principais — a mão secundária e a armadura não são espaço para o inventário.
            "inventory-full": "<red>Seu inventário está cheio. Abra espaço para pegar esse item.",
            "bought": "<green>Item reposto no seu inventário.",
            "match-over": "<red>A partida acabou.",
            "not-in-arena": "<red>Você saiu do mundo da partida."
          }
        },
        "simulator-request": {
          "title": "Desafio [{requester_tag}] × [{opponent_tag}]",
          // ⚠️ ESPELHO DO CONFIGURADOR. Cada regra abaixo tem o nome e a lore de
          // `plugins.cannonutils.views.invasao-config.items.<mesma regra>`, sem as linhas que
          // pressupõem o clique ("Clique para alterar", "Botão esquerdo ▸ ...") — deste lado nada é
          // editável, e quem diz isso é o item do desafiante. Mexeu lá, espelhe aqui.
          // Só divergem: o nome do LADO (lá é a pergunta feita a quem escolhe, aqui é o seu lado) e os
          // quatro itens que só existem nesta tela — desafiante (pending · not-responder · sent ·
          // closed), desconhecido, aceitar e recusar.
          "items": {
            "challenger": {
              "name": "<white>Desafio de {requester_display_name}",
              "pending": {
                "lore": [
                  "<gray>{requester_display_name} <gray>montou esta partida",
                  "<gray>e desafiou a sua facção.",
                  "",
                  "<gray>Expira em: <white>{expires_in}",
                  "",
                  "<gray>As regras ao lado foram definidas por",
                  "<gray>quem desafiou e <white>não podem ser alteradas<gray>.",
                  "",
                  "<gradient:#FF6F00:#faa825:#FF6F00>Responda nos botões abaixo."
                ]
              },
              "not-responder": {
                "lore": [
                  "<gray>{requester_display_name} <gray>desafiou a sua facção.",
                  "",
                  "<gray>Expira em: <white>{expires_in}",
                  "",
                  "<gray>Quem responde por ele é o <white>líder</white>",
                  "<gray>(ou os <white>capitães</white>, na ausência dele).",
                  "",
                  "<gray>Você pode ver as regras da partida,",
                  "<gray>mas não responder por ela."
                ]
              },
              "sent": {
                "name": "<white>Desafio enviado a {opponent_display_name}",
                "lore": [
                  "<gray>Sua facção desafiou {opponent_display_name}<gray>.",
                  "",
                  "<gray>Expira em: <white>{expires_in}",
                  "",
                  "<gray>Quem responde é o líder (ou os capitães)",
                  "<gray>da facção adversária."
                ]
              },
              "closed": {
                "name": "<red>Desafio encerrado",
                "lore": [
                  "<gray>Este desafio já foi respondido,",
                  "<gray>cancelado ou venceu o prazo.",
                  "",
                  "<gray>As regras seguem à mostra apenas",
                  "<gray>para consulta."
                ]
              }
            },
            "protection-block": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Bloco de proteção</gradient>",
              "glacite": {
                "lore": [
                  "<gray>O bloco que reveste a</gray>",
                  "<gray>parede inteira da base.</gray>",
                  "",
