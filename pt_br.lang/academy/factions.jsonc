{
  "plugins": {
    "factions": {
      // O prefixo é o ÍCONE do cargo (glifo do pacote de textura do academy, pasta
      // `server-visual/academy/ícone/factionrank/`). O mapeamento nome-do-glifo × cargo é o MESMO do
      // servidor de factions — os arquivos vieram de lá para o tab ficar idêntico.
      // ⚠️ Glifo ausente no pacote renderiza "[NULL: nome]" em vermelho: publique a textura ANTES desta lang.
      "roles": {
        "leader": {
          "name": "<gold>Líder",
          "prefix": ""
        },
        "captain": {
          "name": "<yellow>Capitão",
          "prefix": ""
        },
        "member": {
          "name": "<green>Membro",
          "prefix": ""
        },
        "recruit": {
          "name": "<gray>Recruta",
          "prefix": ""
        },
        "none": {
          "name": "<dark_gray>Sem facção",
          "prefix": ""
        }
      },
      // Legenda do /f mapa. Os nomes são os MESMOS do ClaimState do servidor de factions, para quem
      // joga lá ler o mapa daqui sem reaprender. As CORES não moram aqui: são do enum (também iguais).
      // Faltam de propósito os estados que a Academy não tem — as zonas (protegida/guerra/livre/base
      // perdida) e "terra sob ataque", que lá depende de um registro de explosões por chunk.
      "claim-states": {
        "your-position": "Sua Posição",
        "your-claim": "Sua Facção",
        "other-claim": "Outras Facções",
        "invasion-claim": "Terra de Ataque",
        "protected-claim": "Terra em Proteção",
        "free": "Zona Livre",
        "void": "Fora do Mapa"
      },
      "ranking": {
        "types": {
          "members": {
            "name": "<gradient:#FF6F00:#faa825:#FF6F00>Membros",
            "description": [
              "<gray>Facções com o maior",
              "<gray>número de membros."
            ]
          },
          "training": {
            "name": "<gradient:#FF6F00:#faa825:#FF6F00>Treino",
            "description": [
              "<gray>Soma da pontuação de treino",
              "<gray>de canhão dos membros."
            ]
          },
          "invasions": {
            "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasões",
            "description": [
              "<gray>Facções com mais",
              "<gray>invasões vencidas."
            ]
          },
          "general": {
            "name": "<gradient:#FF6F00:#faa825:#FF6F00>Geral",
            "description": [
              "<gray>Nota final somando membros,",
              "<gray>treino e invasões."
            ]
          }
        }
      },
      "nametag": {
        // Segunda linha do nome flutuante. O factions usa , que é do resource
        // pack dele; na Academy vai o coração literal para não depender de ícone inexistente.
        "health": "<color:#F22F46>❤ {health}"
      },
      "invasion": {
        "results": {
          "attacker-won": "<red>Vitória do atacante",
          "defender-won": "<green>Defesa bem-sucedida",
          "tie": "<gray>Cancelada"
        },
        // Bossbar da invasão — MESMAS strings do servidor de factions
        // (plugins.factions.messages.invasion.bossbar de lá), para o visual ser o mesmo nos dois:
        // barra verde e cheia, com o tempo no texto. Uma chave por LADO, mais a preparação e o aviso
        // de inatividade (que aparece empilhado embaixo).
        //
        // ⚠️ A BARRA É INVISÍVEL: o pack do Academy sobrescreve gui/sprites/boss_bar/green_* por PNGs
        // transparentes (os mesmos do pack do factions), então o jogador vê só ESTE TEXTO flutuando —
        // sem moldura e sem preenchimento. Por isso as quatro barras são verdes no Java: mudar a cor de
        // qualquer uma traz a moldura de volta. E por isso o texto precisa se bastar sozinho.
        //
        // Além de {remaining_time}, ficam disponíveis (sem uso no texto padrão, de propósito):
        //   attacker_display_name, defender_display_name, destroyed_blocks, required_blocks
        // — dá para pôr o placar de blocos de volta mexendo só aqui. Na arena (Fac x Fac) não há
        // objetivo por blocos, então lá esses dois últimos não significam nada.
        "bossbar": {
          "attacker": "<red>🗡<bold> Invasão em andamento! </bold><white>Duração:</white> <gray>{remaining_time}",
          "defender": "<color:#F97316>🗡<bold> Defesa em andamento! </bold><white>Duração:</white> <gray>{remaining_time}",
          "preparing": "<red>⏳ <bold>Tempo de preparação! </bold><white>Duração:</white> <gray>{remaining_time}",
          "inactivity": "<yellow>⚠ <bold>Invasão inativa! </bold><white>Encerra em:</white> <gray>{remaining_time}",
          // PRORROGAÇÃO: partida de arena com vitória por domínio segue de pé com o relógio em zero.
          // Continuar mostrando "0s restantes" faria a barra mentir sobre a única coisa que ela diz.
          "attacker-overtime": "<red>⏳<bold> Prorrogação! </bold><white>A partida segue enquanto o ataque segurar o cubículo.",
          "defender-overtime": "<color:#F97316>⏳<bold> Prorrogação! </bold><white>A partida segue enquanto o ataque segurar o cubículo.",
          // AUDIÊNCIA do Fac x Fac (espectador/monitor): mesma informação, sem lado — os textos de
          // atacante/defensor falam da "sua" invasão, e quem assiste não tem uma.
          "spectator": "<gold>👁<bold> Assistindo! </bold><white>Duração:</white> <gray>{remaining_time}",
          "spectator-overtime": "<gold>⏳<bold> Prorrogação! </bold><white>A partida segue enquanto o ataque segurar o cubículo."
        }
      },
      // ======================================================================
      //  Simulator (Invasão Fac x Fac) — a atividade da bússola do spawn.
      // ======================================================================
      "simulator": {
        // Confirmação de uma ação da staff sobre uma partida. Mora aqui, e não na view, porque quem a
        // envia é o app ANFITRIÃO — que pode não ser o app onde o admin clicou.
        "admin": {
          "messages": {
            "action-applied": "<green>Partida encerrada (<yellow>{acao}</yellow>).",
            // Fora do anfitrião a ordem VIAJA pelo Echo e quem executa é o dono da partida — a resposta
            // honesta daqui é "enviada", não "encerrada" (o desfecho os quadros anunciam).
            "action-sent": "<green>Ordem enviada ao servidor da partida (<yellow>{acao}</yellow>).",
            "open-sent": "<green>Ordem de abertura enviada ao servidor das partidas. <gray>Os quadros serão convocados se as duas facções estiverem livres.",
            "rules-applied": "<green>Regras da partida atualizadas.",
            // Mesma razão do `action-sent`: fora do anfitrião a edição VIAJA, e quem aplica é o dono da
            // partida. Prometer "atualizadas" daqui seria mentir quando o pacote se perdesse.
            "rules-sent": "<green>Ordem enviada ao servidor da partida. <gray>As regras novas valem assim que ele aplicar.",
            // Mesma razão do `rules-sent`: a convocação da staff é executada pelo ANFITRIÃO (é lá que o
            // quadro vive e que o jogador é trazido), então daqui só dá para prometer o envio. O
            // resultado — trouxe, ou o alvo está offline / é de outra facção — chega em seguida, pela
            // lang do /f convocar.
            "call-up-sent": "<green>Ordem de convocação enviada ao servidor da partida."
          }
        },
        // MONITORAMENTO: a barra de ferramentas de quem acompanha uma partida por dentro.
        //
        // Mesma gramática do pós-jogo — slots 1, 3, 5 e 9 com vão entre eles — porque é a mesma mão, no
        // mesmo servidor, e a staff não deveria aprender duas disposições. O que muda é o conteúdo: aqui
        // a barra é de trabalho, não de comemoração.
        // ====================================================================
        //  ARQUIBANCADA — /assistir, o jogador comum vendo uma partida.
        //
        //  Não é o monitoramento da staff (bloco `monitor` abaixo): aqui não há ferramenta, criativo
        //  nem ação sobre a partida. Só a câmera, em espectador.
        // ====================================================================
        "spectator": {
          "messages": {
            "started": "Você está assistindo à invasão na arena <white>{arena}</white>. <gray>Use <white>/assistir sair</white> para voltar.",
            "stopped": "Você saiu da arquibancada.",
            "finished": "A partida acabou.",
            "gone": "Essa partida já acabou.",
            "playing": "Você está NESSA partida — jogue-a em vez de assisti-la.",
            // O espectador atravessa parede e vê a base inteira do defensor: assistir ao jogo da própria
            // facção é espionagem, não torcida.
            "own-faction": "Você é de uma das facções em campo e não pode assistir a esta partida.",
            "world-unavailable": "O mundo dessa partida não está carregado aqui."
          }
        },

        "monitor": {
          "items": {
            "overview": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Ficha da partida",
              "lore": [
                "<gray>Arena: <white>{arena}",
                "",
                "<gray>Regras, fase, duração, quadros e",
                "<gray>as ações de encerramento.",
                "",
                "<yellow>Clique para abrir<gray>."
              ]
            },
            "players": {
              "name": "<white>Jogadores <gray>(<white>{jogadores}<gray>)",
              "lore": [
                "<gray>Os dois quadros: quem está vivo,",
                "<gray>quem caiu e quem espera renascer.",
                "",
                "<gray>Dali dá para devolver kit, curar e",
                "<gray>trazer alguém de volta ao campo.",
                "",
                "<yellow>Clique para abrir<gray>."
              ]
            },
            // Um item só para uma decisão só: ele mostra o modo para onde você VAI, não o de agora.
            "mode": {
              "spectator": {
                "name": "<aqua>Entrar em criativo",
                "lore": [
                  "<gray>Você está em <white>espectador<gray>:",
                  "<gray>invisível, atravessando parede e",
                  "<gray>sem interferir na partida.",
                  "",
                  "<yellow>Clique para poder agir<gray>."
                ]
              },
              "creative": {
                "name": "<green>Voltar a espectador",
                "lore": [
                  "<gray>Você está em <white>criativo<gray>: o",
                  "<gray>catálogo inteiro e blocos na mão.",
                  "",
                  "<red>Você aparece para os jogadores<gray>.",
                  "",
                  "<yellow>Clique para observar sem interferir<gray>."
                ]
              }
            },
            "leave": {
              "name": "<red>Sair do monitoramento",
              "lore": [
                "<gray>Devolve o seu modo de jogo e o",
                "<gray>seu inventário, e leva você ao spawn.",
                "",
                "<yellow>Clique para sair<gray>."
              ]
            }
          },
          "messages": {
            // Ensina os comandos porque em ESPECTADOR o cliente não envia clique de item: a barra só
            // responde no criativo, e sem esta linha o admin ficava preso sem saber como alternar/sair.
            "started": "<green>Você começou a monitorar a partida da arena <yellow>{arena}</yellow>. <gray>Use <white>/academy monitor</white> para alternar espectador/criativo e <white>/academy monitor sair</white> para sair.",
            "stopped": "<yellow>Você saiu do monitoramento.",
            "mode-creative": "<green>Modo <yellow>criativo</yellow> — você aparece para os jogadores.",
            "mode-spectator": "<green>Modo <yellow>espectador</yellow> — ninguém vê você.",
            // A partida acabou com o monitor dentro: o mundo vai ser descartado, então ele sai junto.
            "match-over": "<yellow>A partida que você monitorava terminou.",
            "playing": "<red>Você está NESSA partida — jogue-a em vez de monitorá-la.",
            "gone": "<red>Essa partida já acabou."
          },
          "actionbar": "<gradient:#FF6F00:#faa825:#FF6F00>MONITORANDO <dark_gray>| <white>{arena} <dark_gray>| <red>{atacantes} <gray>ataque <dark_gray>| <blue>{defensores} <gray>defesa"
        },
        // BOX INSTANTÂNEA: item de uso único que abre uma sala cúbica com o jogador dentro.
        //
        // NÃO EXISTE DESFAZER — não há //undo, a escrita é direta no mundo. Por isso a lore avisa antes,
        // e por isso as recusas são explícitas: quem gastou a box precisa entender no ato POR QUE ela não
        // saiu, senão vai achar que perdeu o item à toa (ele não é consumido quando é negada).
        "box": {
          "item": {
            "name": "<light_purple>Box Instantânea",
            "lore": [
              "<gray>Clique para abrir uma sala <white>{tamanho}x{tamanho}x{tamanho}",
              "<gray>com chão, paredes e teto de <white>End Stone<gray>.",
              "",
              "<gray>Sai só da <yellow>/loja<gray>, e são <white>4 por partida",
              "<gray>para o seu <white>lado<gray> — uma a cada <white>5 minutos<gray>.",
              "",
              "<gray>Só <white>durante a partida<gray>, e apenas",
              "<gray>dentro do <white>claim da sua facção<gray>.",
              "<gray>O pedaço que cair em claim inimigo <white>não é cavado<gray>.",
              "",
              "<red>Não tem como desfazer."
            ]
          },
          "messages": {
            "done": "<green>Box aberta! <gray>{blocos} bloco(s) alterado(s). <yellow>{restantes}<gray> restante(s) nesta partida.",
            // A box encostou na divisa: o jogador precisa saber que ela saiu MENOR de propósito, e não
            // que o item falhou pela metade.
            "clipped": "<green>Box aberta! <gray>{blocos} bloco(s) alterado(s), <yellow>{restantes}<gray> restante(s). <yellow>Parte dela caiu em claim inimigo e foi preservada."
          },
          "errors": {
            "not-in-arena": "<red>A box só funciona dentro da arena da partida.",
            // ⚠️ 'not-cannon' saiu em 10/08/2026 junto com a exclusividade do kit canhão: a loja passou a
            // vender tudo a todos, e a box com ela. O que segura a box agora é a cota do LADO.
            // Desde 11/08/2026 a box é só do ATAQUE — a loja nem a oferece a quem defende, e esta linha
            // cobre o exemplar que já estava na mão (comprado antes, recebido de um companheiro).
            "attackers-only": "<red>A box instantânea é só para quem está atacando.",
            "limit-reached": "<red>Você já usou suas <yellow>{limite}</yellow> boxes desta partida.",
            "cooling-down": "<red>Aguarde <yellow>{remaining_time}</yellow> para abrir outra box.",
            "awaiting-respawn": "<red>Você não pode usar a box enquanto espera para renascer.",
            "not-own-claim": "<red>Você só pode abrir a box dentro do claim da sua facção.",
            "nothing-to-dig": "<red>Não há nada para cavar aqui — a box não foi gasta.",
            "failed": "<red>Não foi possível abrir a box. Avise a staff."
          }
        },
        // Rótulos curtos usados dentro de outras linhas (o /facxfac monta o status com eles).
        // "spectator" é da AUDIÊNCIA (espectador/monitor): a board da partida o usa no lugar do lado.
        "sides": {
          "attack": "<red>Ataque",
          "defense": "<green>Defesa",
          "spectator": "<gold>Assistindo"
        },
        "phases": {
          "preparation": "<yellow>Preparação",
          "running": "<red>Valendo",
          // Só nas partidas com vitória por domínio: o relógio zerou, mas o ataque segura o cubículo.
          // Sem esta linha o placar mostraria "Valendo · 0s" enquanto a partida continua.
          "overtime": "<color:#ffd34d>Prorrogação"
        },
        // Scoreboard de quem está EM PARTIDA. Uma por simulação: o app roda várias ao mesmo tempo e
        // cada jogador vê a da sessão dele (SimulatorScoreboard, prioridade acima das do cannon-utils —
        // fora da partida a board comum do Academy volta sozinha).
        //
        // Placeholders: arena, side_name, phase_name, remaining_time e, para cada lado,
        //   {attacker|defender}_tag           tag da facção
        //   {attacker|defender}_display_name  "[TAG] Nome"
        //   {attacker|defender}_online        quantos estão EM CAMPO (online e dentro da arena)
        //   {attacker|defender}_roster        tamanho do elenco convocado
        //   {attacker|defender}_kills         abates do lado
        //   {attacker|defender}_marker        "you"/"other" — o destaque do próprio lado
        // ⚠️ 07/08: saiu daqui o bloco "Suas estatísticas" (Abates: 17 / Mortes: 1 / Blocos: 7.000).
        // Eram valores FIXOS no texto, sem placeholder e sem nada no Java que os preenchesse — todo
        // jogador via os mesmos três números inventados. Placar por JOGADOR não existe no Simulator: a
        // invasão conta abates por LADO ({attacker_kills}/{defender_kills}, já mostrados acima) e blocos
        // por partida. Trazer o bloco de volta exige contadores por jogador na sessão, o que é feature
        // nova — não uma linha de lang.
        "scoreboard": {
          // ── O TÍTULO diz onde o jogador está pisando, igual ao placar do factions ──────────────
          // Em terra de ninguém (o campo aberto entre os dois lados) vale a marca da atividade; em
          // território de facção vale o CLAIM, verde no próprio e vermelho no do adversário. É a cor
          // que responde "estou no meu chão ou no dele?" sem o jogador ter que abrir o mapa.
          "title": " <gradient:#FF6F00:#faa825:#FF6F00><bold>ACADEMY FACxFAC</bold></gradient> ",
          // {faction_claim_faction_color} já vem verde ou vermelho do Java — os mesmos nomes de
          // placeholder do factions, para esta linha poder ser copiada de lá sem tradução.
          "title-claim": " <bold>{faction_claim_faction_color}CLAIM [{faction_claim_faction_tag}] ",
          // Marcadores do lado de quem lê. O do adversário é vazio de propósito: só um lado é destacado.
          "you": "<yellow>▸",
          "other": " ",
          "lines": [
            "",
            " <white>Fase: {phase_name}",
            " <white>Tempo: <gray>{remaining_time}",
            "",
            "  <gradient:#FF6F00:#faa825:#FF6F00>Abates Totais:",
            "  <red>🗡 <white>[{attacker_tag}]: <gray>{attacker_kills} <dark_gray>◇ <gray>{attacker_roster}<dark_gray>/<gray>{attacker_online} on.",
            "  <green>🗡 <white>[{defender_tag}]: <gray>{defender_kills} <dark_gray>◇ <gray>{defender_roster}<dark_gray>/<gray>{defender_online} on.",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00>exe.com"
          ]
        },
        // ------------------------------------------------------------------
        //  PÓS-JOGO: a partida acabou e os dois quadros ficam no mapa por um tempo.
        //  Criativo para andar e olhar, sem quebrar nem colocar bloco — o cenário destruído é o
        //  registro da partida. A hotbar tem 1 (resumo), 5 (espectador) e 9 (sair).
        // ------------------------------------------------------------------
        "post-match": {
          "actionbar": "<gray>O mapa fecha em <yellow><bold>{restante}</bold></yellow> <dark_gray>· <gray>slot <white>9</white> para sair agora",
          "messages": {
            "opened": [
              "",
              " <gradient:#FF6F00:#faa825:#FF6F00><bold>FIM DA PARTIDA</bold>",
              " <gray>Você tem <white>{restante}s</white> para andar pelo mapa e ver o estrago.",
              " <gray>Barra: <white>1</white> resumo <dark_gray>· <white>5</white> espectador <dark_gray>· <white>9</white> sair",
              ""
            ],
            "expired": "<gray>O mapa da partida foi fechado. Até a próxima invasão!",
            "spectator-on": "<gray>Modo espectador. <white>Agache</white> para voltar ao criativo.",
            "spectator-off": "<gray>De volta ao criativo."
          },
          "items": {
            "summary": {
              // O nome muda com o resultado: é a primeira coisa que a mão encontra ao acabar a partida.
              "won": { "name": "<gradient:#3ef7aa:#00d97e:#3ef7aa><bold>VITÓRIA</bold>" },
              "lost": { "name": "<gradient:#ff6b6b:#ff2d2d:#ff6b6b><bold>DERROTA</bold>" },
              "lore": [
                "<gray>Sua partida, em números:",
                "",
                "<gray>Abates: <white>{abates}",
                "<gray>Mortes: <white>{mortes}",
                "<gray>Maior sequência: <white>{sequencia}",
                "<gray>Blocos colocados: <white>{blocos_colocados}",
                "<gray>Blocos derrubados pelo seu canhão: <white>{blocos_quebrados}",
                "",
                "<yellow>Clique direito para o placar completo<gray>."
              ]
            },
            "spectator": {
              "off": {
                "name": "<aqua>Modo espectador",
                "lore": [
                  "<gray>Atravesse paredes e veja a base",
                  "<gray>por dentro, como ela ficou.",
                  "",
                  "<yellow>Clique para entrar<gray>."
                ]
              },
              "on": {
                "name": "<aqua>Voltando ao criativo",
                "lore": [
                  "<gray>Você está em modo espectador.",
                  "",
                  "<yellow>Agache</yellow> <gray>para voltar ao criativo.",
                  "<dark_gray>(o item não responde a clique em espectador)"
                ]
              }
            },
            "leave": {
              "name": "<red>Voltar ao spawn",
              "lore": [
                "<gray>Sai do mapa agora, sem esperar.",
                "",
                "<gray>O mapa fecha sozinho em <white>{restante}s<gray>.",
                "",
                "<yellow>Clique para sair<gray>."
              ]
            }
          }
        },
        // ======================================================================
        //  ESPERA DE RENASCIMENTO — quem morre em partida não volta a campo na hora.
        //
        //  Durante a espera (`simulator.renascimento.segundos`) ele fica em modo espectador vendo
        //  PELOS OLHOS de um companheiro VIVO do próprio lado: a mesma posição, a mesma cabeça, o mesmo
        //  giro. Não é sobrevoar o companheiro — o morto não anda, não escolhe o ângulo e não vê nada
        //  além do que o companheiro está vendo. É por isso que o texto fala em "visão de", e não em
        //  "assistindo de perto": prometer câmera livre seria prometer o que não existe mais.
        //
        //  A CONTAGEM ocupa a action bar — esta linha era do kill feed, que saiu de cena para dar
        //  lugar a ela.
        //
        //  ⚠️ Em modo espectador o cliente 1.21 NÃO envia clique no ar: só clique EM CIMA de alguém e
        //  as teclas de movimento chegam ao servidor. Por isso os controles são clique esquerdo no
        //  jogador (ou tecla D) para avançar e SHIFT (ou tecla A) para voltar — e por isso `controls`
        //  precisa dizer isso ao jogador, senão ele fica clicando no ar sem entender.
        //
        //  Placeholders:
        //    {remaining}            o que falta da espera, já formatado ("28s")
        //    {remaining_seconds}    o mesmo, só o número (para o título grande da reta final)
        //    {target_name_with_tag} de quem é a visão (tag do cargo + nick)
        //    {index}/{total}        posição do companheiro na roda
        // ======================================================================
        "respawn": {
          // A action bar. Reenviada de segundo em segundo pelo relógio da partida — ela apaga sozinha.
          "actionbar": {
            "watching": "<red>Renascendo em <bold>{remaining}</bold> <dark_gray>· <red>Visão de: {target_name_with_tag} <dark_gray>[{index}/{total}]",
            // Sem ninguém vivo para assistir. Desde 07/08 ele NÃO fica mais numa caixa: espera parado
            // no ponto exato em que vai voltar, e a linha diz isso — antes ela só dizia o que faltava.
            "alone": "<red>Renascendo em <bold>{remaining}</bold> <dark_gray>· <red>Nenhum companheiro vivo"
          },
          // Reta final da contagem, no meio da tela e com som (últimos 5s). A action bar sozinha é uma
          // linha fina que some e divide espaço com o resto da partida — o dono pediu a contagem clara.
          // O subtítulo muda conforme haja ou não alguém para assistir.
          "countdown": {
            "title": "<gradient:#FF6F00:#faa825:#FF6F00><bold>Renascendo em {remaining_seconds}</bold>",
            "subtitle": "<white>Voltando dentro de instantes!",
            "subtitle-alone": "<white>Você renascerá nesse lugar."
          },
          // Dita UMA vez, na primeira visão desta espera. A primeira linha diz o que está acontecendo
          // (a tela mudou de dono, e sem aviso isso parece travamento); a segunda, como trocar de
          // companheiro. Andar não está na lista de propósito: quem espera não anda.
          "controls": [
            "<yellow>Você caiu. <gray>Você está vendo pelos olhos de {target_name_with_tag} <dark_gray>[{index}/{total}]",
            "<gray>Clique <white>esquerdo em um jogador</white> ou <white>D</white> para avançar <dark_gray>· <white>SHIFT</white> ou <white>A</white> para voltar."
          ],
          "switched": [
            "<green>Agora você vê pelos olhos de {target_name_with_tag} <dark_gray>[{index}/{total}]"
          ],
          // Sai por INFO (som e cor de aviso, não de recusa): não é erro do jogador, é o estado do
          // time. Ele fica parado no ponto em que volta até alguém do lado dele estar de pé.
          "no-targets": [
            "<yellow>Nenhum companheiro vivo para assistir. <gray>Espere aqui até renascer."
          ],
          "revived": [
            "<green>Você voltou para a partida!"
          ]
        },
        "messages": {
          // O bloco do desafio segue o MESMO desenho do pedido de teleporte do cannoning
          // (`plugins.cannonutils.messages.tpa.send.target`): linhas soltas, respiro em volta e o botão
          // clicável embaixo. Texto corrido com o comando no meio ficava ilegível no chat.
          //
          // Desde 07/08 o convite NÃO responde direto do chat: quem desafia configura a partida inteira
          // no menu da bússola, e aceitar sem ver o que foi configurado era decidir no escuro. O botão
          // abre `/facxfac visualizar <tag>` — a mesma tela, em modo leitura, com ACEITAR e RECUSAR lá
          // dentro. A tag viaja no botão porque a facção pode ter mais de um desafio pendente.
          "request": {
            "received": [
              " <gradient:#FF6F00:#faa825:#FF6F00><bold>{requester_display_name} desafiou a sua facção!",
              "",
              " <gray>A sua facção foi desafiada para uma <white>Invasão Fac x Fac<gray>.",
              " <gray>O pedido expira em <white>{expires_in}</white>.",
              "",
              " <hover:show_text:'<gradient:#FF6F00:#faa825:#FF6F00>Ver as regras da partida e responder'><click:run_command:'/facxfac visualizar {requester_tag}'><gradient:#FF6F00:#faa825:#FF6F00><bold>Clique AQUI para visualizar.</bold></gradient></click></hover>",
              ""
            ],
            "sent": [
              "Desafio enviado para {opponent_display_name}<white>. <gray>Expira em <white>{expires_in}</white>."
            ],
            "accepted": [
              "Desafio aceito! <gray>Preparando a arena da partida."
            ],
            "denied": [
              "O desafio entre {requester_display_name} <white>e {opponent_display_name} <white>foi recusado."
            ],
            "expired": [
              "O desafio entre {requester_display_name} <white>e {opponent_display_name} <white>expirou."
            ],
            "cancelled": [
              "O desafio entre {requester_display_name} <white>e {opponent_display_name} <white>foi cancelado."
            ],
            "no-arena": [
              "O desafio foi aceito, mas <color:#ff2d2d>não há arena livre</color> agora. <gray>Tentem de novo quando uma partida terminar."
            ]
          },
          "match": {
              // Encerramento pela STAFF. Duas chaves porque o placar muda: "ended" declara vencedor
              // e conta a invasão; "cancelled" não toca no histórico de ninguém.
              "admin-ended": "<yellow>A partida foi encerrada pela staff. Vitória de {winner_display_name}<yellow>.</yellow>",
              "admin-cancelled": "<yellow>A partida foi encerrada pela staff, sem vencedor.</yellow>",
              // Regra trocada pela staff com a partida rodando (painel ▸ Regras da partida). Os dois
              // quadros recebem a MESMA linha ao mesmo tempo: uma regra que muda no meio muda o que
              // cada lado está calculando, e saber disso pelo adversário seria pior.
              "rules-changed": "<yellow>A staff alterou as regras da partida: <white>{mudancas}</white>.</yellow>",
              // Linha PRÓPRIA, enviada logo depois de qualquer desfecho. Uma só, para todos os quinze.
              "stats-button": [
                " <hover:show_text:'<gradient:#FF6F00:#faa825:#FF6F00>Abates, mortes, sequências e blocos dos dois quadros'><click:run_command:'/facxfac placar'><gradient:#FF6F00:#faa825:#FF6F00><bold>[VER O PLACAR]</bold></gradient></click></hover>",
                ""
              ],
            // Abertura e encerramento vêm em bloco, com respiro: são os dois momentos em que o jogador
            // precisa parar e ler. O resto da partida fala em uma linha só, com o mesmo ✦ do resto da rede.
            "started": [
              "",
              " <gradient:#FF6F00:#faa825:#FF6F00><bold>INVASÃO FAC X FAC</bold>",
              " {attacker_display_name} <white>vs {defender_display_name}",
              "",
              " <white>Arena: <gray>{arena}",
              " <white>Tempo de Preparação: <gray>{preparation_time}",
              "",
              " <gradient:#FF6F00:#faa825:#FF6F00>Defensores não podem sair da base durante a preparação."
            ],
            "no-arena": [
              "Não há arena livre agora. <gray>Tente de novo quando uma partida terminar."
            ],
            // A cerca é o TERRITÓRIO da defesa: o que barra é pisar na faixa do atacante.
            "locked-in-base": "Durante a preparação você não pode sair do território da sua facção.",
            // Abate no chat da partida — a MESMA linha do servidor de factions, com os mesmos tokens.
            // Vai para o elenco dos dois quadros que está dentro do mundo da partida.
            // Tokens: {victim_name}, {victim_name_with_color}, {victim_name_with_tag} e os mesmos com
            // {killer_...}. O `_with_tag` traz a tag do cargo + o nick nas cores dele.
            "kill": "<gray>☠</gray> {victim_name_with_tag} <gray>foi morto por</gray> {killer_name_with_tag}<gray>.</gray>",
            "ejector-limit": "Seu lado já está no limite de <color:#ff2d2d>{limit}</color> ejetores.",
            "cubicle": [
              "",
              " <gradient:#FF6F00:#faa825:#FF6F00><bold>VITÓRIA DO ATAQUE</bold>",
              " {player_name_with_tag} <gray>entrou no cubículo de {defender_display_name}<gray>.",
              ""
            ],
            // VITÓRIA POR DOMÍNIO (KOTH): a captura do cubículo chegou a 100%. Só existe nas partidas
            // cujo pedido ligou a opção — sem ela, a vitória do ataque continua sendo a `cubicle`.
            "domination": [
              "",
              " <gradient:#FF6F00:#faa825:#FF6F00><bold>CUBÍCULO DOMINADO</bold></gradient>",
              " {attacker_display_name} <gray>capturou o cubículo de {defender_display_name}<gray>.",
              ""
            ],
            // Cancelamento pela staff (`/f admin cancelar-invasao`). Não tem vencedor e não mexe no
            // placar — antes de 07/08 esta linha não existia e os jogadores liam "a defesa segurou".
            "cancelled": [
              "",
              " <color:#ff2d2d><bold>PARTIDA CANCELADA</bold></color>",
              " <gray>Um administrador encerrou esta partida.",
              ""
            ],
            "surrender": [
              "",
              " <color:#ffd34d><bold>RENDIÇÃO</bold></color>",
              " <gray>Vitória de {winner_display_name}<gray>.",
              ""
            ],
            "timeout": [
              "",
              " <color:#3ef7aa><bold>A DEFESA SEGUROU</bold></color>",
              " <gray>O tempo da partida acabou e {defender_display_name} <gray>venceu.",
              ""
            ],
            "walkover": [
              "",
              " <color:#ffd34d><bold>W.O.</bold></color>",
              " {abandoned_display_name} <gray>ficou sem ninguém na arena.",
              " <gray>Vitória de {winner_display_name}<gray>.",
              ""
            ],
            "abandoned-both": [
              "",
              " <color:#ff2d2d><bold>PARTIDA CANCELADA</bold></color>",
              " <gray>Os dois lados ficaram sem ninguém na arena.",
              ""
            ],
            // NÚCLEO: os vidros do centro da base cederam. É o desfecho das partidas que ligaram a
            // "Vitória por Núcleo" — o ataque não venceu por chegar ao centro, e sim por abri-lo.
            "nucleus": [
              "",
              " <color:#ffd34d><bold>NÚCLEO DESTRUÍDO</bold></color>",
              " {attacker_display_name} <gray>derrubou <white>{percentual}%</white> do núcleo de",
              " {defender_display_name}<gray>.",
              ""
            ],
            "faction-gone": [
              "",
              " <color:#ff2d2d><bold>PARTIDA CANCELADA</bold></color>",
              " <gray>Uma das facções deixou de existir.",
              ""
            ]
          },
          "surrender": {
            "opened": "<yellow>Seu líder pediu <bold>rendição</bold>. <gray>Vote com <yellow><click:run_command:'/facxfac sim'>/facxfac sim</click></yellow> ou <yellow><click:run_command:'/facxfac nao'>/facxfac nao</click></yellow> <dark_gray>({votes}/{required} · {remaining_time})",
            "voted": "<gray>Rendição: <white>{votes}/{required}</white> votos <dark_gray>({remaining_time})",
            "failed": "<green>A rendição não foi aprovada. A partida continua."
          },
          // ====================================================================
          //  QUADRO DA PARTIDA — quem está em campo por cada facção.
          //
          //  Entra quem estava ONLINE na abertura, até o teto (`simulator.limite-quadro`, 13). Quem
          //  ficou de fora — e quem loga depois do começo — só entra por CONVOCAÇÃO, e cada lado tem
          //  três na partida inteira. Dispensar é de graça: abre a vaga, mas preenchê-la ainda custa.
          //
          //  As duas primeiras linhas vão para o LADO inteiro (o quadro é assunto do time); a terceira
          //  vai só para quem ficou de fora, e é ela que evita a espera por um teleporte que não vem.
          // ====================================================================
          "roster": {
            "called-up": "{responsavel_name_with_tag} <green>convocou</green> {jogador_name_with_tag} <green>para a partida.</green> <dark_gray>(quadro {quadro}/{limite} · {restantes} convocação(ões) restante(s))",
            "dismissed": "{responsavel_name_with_tag} <yellow>dispensou</yellow> {jogador_name_with_tag} <yellow>da partida.</yellow> <dark_gray>(quadro {quadro}/{limite})",
            "left-out": [
              "",
              " <color:#ffd34d><bold>VOCÊ FICOU FORA DO QUADRO</bold></color>",
              " <gray>A partida começou com <white>{quadro}/{limite}</white> jogadores — entram os que",
              " <gray>estavam <white>online</white> quando ela abriu.",
              " <gray>Peça ao <yellow>líder</yellow> ou a um <yellow>capitão</yellow> para convocar você.",
              ""
            ]
          },
          // ====================================================================
          //  SISTEMA DE VIDAS — o limite de renascimento que a facção escolhe no menu do pedido.
          //
          //  Cada morte cobra uma vida do LADO de quem morreu. Zerou, ninguém daquele lado renasce
          //  mais: quem morre fica em modo espectador até a invasão acabar.
          //
          //  A linha de saldo (`spent`) vai só para o lado que pagou — o adversário não precisa
          //  acompanhar morte a morte. Quando o saldo ZERA os dois lados são avisados, com blocos
          //  separados: para um é a notícia de que acabou, para o outro é a de que cada abate agora
          //  é definitivo.
          // ====================================================================
          //  NÚCLEO — só nas partidas cujo pedido ligou a "Vitória por Núcleo".
          //
          //  Os vidros do centro da base são o coração dela: o ataque vence derrubando o percentual
          //  que o servidor define (`simulator.nucleo.percentual`), e só por EXPLOSÃO. O chat fala nos
          //  MARCOS (10% e 20%), não a cada vidro — um tiro de canhão derruba vários de uma vez.
          //
          //  Placeholders: {percentual} {meta} {restantes} {total}
          // ====================================================================
          "nucleus": {
            "progress": "<yellow>O núcleo da base já perdeu <white>{percentual}%</white> <gray>({restantes} de {total} spawners de pé)</gray>. <gray>O ataque vence com {meta}%.</gray></yellow>",
            "unbreakable": "<red>O núcleo só cai por explosão — nem o ataque nem a defesa o quebram na mão.</red>"
          },
          // ====================================================================
          //  DOMÍNIO DO CUBÍCULO — só nas partidas cujo pedido ligou a "Vitória por Domínio".
          //
          //  O chat fala apenas nas TRANSIÇÕES (começou a capturar, perdeu a maioria, entrou em
          //  prorrogação). O número que muda a cada segundo vive na BOSSBAR — nenhum serviço do
          //  Simulator anuncia por tempo decorrido.
          //
          //  Uma chave por LADO, e não "próprio/inimigo" como nas vidas: quem captura é sempre o
          //  ataque, então o lado já diz tudo.
          //
          //  Placeholders: {capture_percent} {capture_seconds}
          // ====================================================================
          "capture": {
            "started-attacker": "<green>Vocês começaram a <bold>dominar o cubículo</bold>! <gray>Segurem a maioria por <white>{capture_seconds}s</white>.</gray></green>",
            "started-defender": "O inimigo começou a <bold>dominar o cubículo</bold>! <gray>Entrem lá para segurar.",
            "lost-attacker": "<yellow>Vocês perderam a maioria no cubículo. <gray>A captura está voltando <white>({capture_percent}%)</white>.</gray></yellow>",
            "lost-defender": "<green>Vocês retomaram o cubículo! <gray>A captura do inimigo está voltando <white>({capture_percent}%)</white>.</gray></green>",
            "overtime-attacker": [
              "",
              " <color:#ffd34d><bold>PRORROGAÇÃO</bold></color>",
              " <gray>O tempo acabou, mas vocês estão no cubículo.",
              " <gray>A partida continua enquanto houver atacante lá dentro.",
              ""
            ],
            "overtime-defender": [
              "",
              " <color:#ffd34d><bold>PRORROGAÇÃO</bold></color>",
              " <gray>O tempo acabou, mas o inimigo está no cubículo.",
              " <gray>Tirem todos de lá para vencer a partida.",
              ""
            ]
          }
        },
        // Segunda bossbar, empilhada embaixo da barra da invasão (mesmo desenho da de inatividade): só
        // aparece enquanto há captura para mostrar, e só para quem está em partida.
        //
        // ⚠️ VERDE como as outras quatro, pelo mesmo contrato com o pacote de textura: a barra é
        // invisível e o TEXTO é tudo o que o jogador vê. Por isso o progresso vai em NÚMERO, e não em
        // preenchimento — o preenchimento fica fixo em cheio.
        //
        // Placeholders: {capture_percent} {capture_seconds} {attacker_inside} {defender_inside}
        "capture": {
          "bossbar": {
            "attacker": "<color:#3ef7aa>⚑ <bold>Dominando o cubículo! </bold><white>Captura:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})",
            "defender": "<red>⚠ <bold>Cubículo sob ataque! </bold><white>Captura:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})",
            // Quando o ataque perde a maioria a captura DECAI: a barra precisa dizer isso, senão afirma
            // "dominando" ao lado de um número que está caindo.
            "attacker-losing": "<color:#ffd34d>⚑ <bold>Cubículo disputado! </bold><white>Captura:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})",
            "defender-losing": "<color:#3ef7aa>⚑ <bold>Cubículo seguro! </bold><white>Captura do inimigo:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})",
            "attacker-overtime": "<color:#ffd34d>⏳ <bold>Prorrogação! </bold><white>Captura:</white> <gray>{capture_percent}% <white>— segurem o cubículo.",
            "defender-overtime": "<color:#ffd34d>⏳ <bold>Prorrogação! </bold><white>Captura:</white> <gray>{capture_percent}% <white>— tirem o inimigo de lá.",
            // AUDIÊNCIA (espectador/monitor): sem lado, os três estados viram descrição neutra.
            "spectator": "<gold>⚑ <bold>Cubículo em captura! </bold><white>Captura:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})",
            "spectator-losing": "<gold>⚑ <bold>Cubículo disputado! </bold><white>Captura:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})",
            "spectator-overtime": "<gold>⏳ <bold>Prorrogação! </bold><white>Captura:</white> <gray>{capture_percent}% <dark_gray>({attacker_inside}<gray>×<dark_gray>{defender_inside})"
          }
        }
      },
      "results": {
        "create": {
          "already-in-faction": "<red>Você já está em uma facção.",
          "invalid-tag": "<red>A tag precisa ter entre <yellow>{min_tag_length}</yellow> e <yellow>{max_tag_length}</yellow> caracteres, apenas letras e números.",
          "invalid-name": "<red>O nome precisa ter entre <yellow>{min_name_length}</yellow> e <yellow>{max_name_length}</yellow> caracteres.",
          "tag-in-use": "<red>A tag <yellow>{faction_tag}</yellow> já está em uso.",
          "name-in-use": "<red>O nome <yellow>{faction_name}</yellow> já está em uso."
        },
        "member": {
          "not-in-faction": "<red>Você não está em uma facção.",
          "target-not-in-faction": "<red>Esse jogador não é da sua facção.",
          "no-permission": "<red>Só o <yellow>líder</yellow> e os <yellow>capitães</yellow> podem expulsar membros.",
          "same-or-higher-role": "<red>Você não pode fazer isso com alguém de cargo igual ou superior ao seu.",
          "already-top-role": "<red>Esse membro já está no cargo mais alto que você pode conceder.",
          "already-bottom-role": "<red>Esse membro já está no cargo mais baixo.",
          "cannot-target-self": "<red>Você não pode fazer isso consigo mesmo.",
          "leader-must-transfer": "<red>Transfira a liderança (ou desfaça a facção) antes de sair.",
          "faction-full": "<red>A facção está cheia.",
          "already-cannon-kit": "<red>Esse membro já é quem leva o kit canhão da facção."
        },
        "invite": {
          "not-in-faction": "<red>Você não está em uma facção.",
          "no-permission": "<red>Só o <yellow>líder</yellow> e os <yellow>capitães</yellow> podem convidar jogadores.",
          "target-already-in-faction": "<red>Esse jogador já está em uma facção.",
          "target-is-member": "<red>Esse jogador já é da sua facção.",
          "already-invited": "<red>Esse jogador já tem um convite pendente da sua facção.",
          "not-invited": "<red>Não há convite pendente para essa facção.",
          "expired": "<red>Esse convite expirou.",
          "faction-full": "<red>A facção está cheia.",
          "too-many-pending": "<red>A facção já tem convites pendentes demais.",
          "cannot-invite-self": "<red>Você não pode convidar a si mesmo."
        },
        "claim": {
          "disabled": "<red>O território de facção está desativado neste servidor.",
          "world-not-allowed": "<red>Não existe território de facção neste mundo.",
          "not-in-faction": "<red>Você não está em uma facção.",
          "already-claimed-by-you": "<red>Este chunk já é da sua facção.",
          "already-claimed": "<red>Este chunk já pertence a outra facção.",
          "not-claimed": "<red>Este chunk não pertence a ninguém.",
          "not-your-claim": "<red>Este chunk não é da sua facção.",
          "limit-reached": "<red>A facção já atingiu o limite de <yellow>{max_claims}</yellow> chunks.",
          "not-connected": "<red>O chunk precisa encostar em outro que a facção já tenha.",
          "under-invasion": "<red>O território não pode mudar durante uma invasão."
        },
        "invasion": {
          "disabled": "<red>As invasões estão desativadas neste servidor.",
          "not-in-faction": "<red>Você não está em uma facção.",
          "same-faction": "<red>Você não pode invadir a própria facção.",
          "target-not-found": "<red>Facção não encontrada.",
          "target-protected": "<red>{defender_display_name} <red>está protegida no momento.",
          "target-without-claims": "<red>{defender_display_name} <red>não tem território para invadir.",
          "attacker-already-invading": "<red>Sua facção já está em uma invasão.",
          "target-already-under-attack": "<red>Essa facção já está sendo invadida.",
          "not-enough-attackers-online": "<red>Não há membros suficientes da sua facção online."
        },
        // Resultados do Simulator (Fac x Fac): pedido, resposta e rendição.
        "simulator": {
          "disabled": "<red>A Invasão Fac x Fac está desativada no momento.",
          "no-arena-available": "<red>Não há arena livre para uma partida agora.",
          "simulator-offline": "<red>O servidor de partidas está reiniciando. Tente de novo em alguns instantes.",
          "not-in-faction": "<red>Você precisa estar em uma facção para puxar um Fac x Fac.",
          "opponent-required": "<red>Escolha a facção adversária no menu antes de enviar.",
          "opponent-not-found": "<red>Facção adversária não encontrada.",
          "same-faction": "<red>Você não pode desafiar a própria facção.",
          "not-enough-members": "<red>Sua facção não tem membros suficientes para uma partida.",
          "opponent-not-enough-members": "<red>A facção adversária não tem membros suficientes.",
          "no-cannon-kit": "<red>Sua facção precisa definir quem leva o <yellow>kit canhão</yellow> no menu de membros.",
          "opponent-no-cannon-kit": "<red>A facção adversária ainda não definiu quem leva o kit canhão.",
          "opponent-offline": "<red>Ninguém da facção adversária está online. <gray>O desafio só é entregue em mãos.",
          "opponent-leader-offline": "<red>A facção adversária não tem <yellow>líder</yellow> nem <yellow>capitão</yellow> online para responder ao desafio.",
          "already-requested": "<red>Já existe um desafio pendente entre as duas facções.",
          "already-in-match": "<red>Sua facção já está em uma partida.",
          "opponent-in-match": "<red>A facção adversária já está em uma partida.",
          "request-not-found": "<red>Não há desafio pendente para responder.",
          "request-expired": "<red>Esse desafio já expirou.",
          "not-the-opponent": "<red>Só a facção desafiada pode responder a esse desafio.",
          "not-the-responder": "<red>Esse desafio não é seu para responder. <gray>Ele foi entregue ao líder (ou aos capitães, na ausência dele).",
          // Rendição.
          "not-in-match": "<red>Você não está em uma partida.",
          "not-running": "<red>A partida ainda não começou.",
          "not-leader": "<red>Só o líder pode pedir rendição.",
          "already-voting": "<red>Já existe uma votação de rendição em andamento.",
          "no-vote": "<red>Não há votação de rendição aberta.",
          "not-your-vote": "<red>Essa votação não é do seu lado.",
          "already-voted": "<red>Você já votou.",
          "success": "<green>Desafio enviado! <gray>Aguardando a resposta da facção adversária.",
          // Quadro da partida (/f convocar). Nível próprio para não disputar nome com as chaves
          // do desafio acima — 'not-in-match' já existe ali com outro texto.
          "roster": {
            "not-in-match": "<red>Você não está em uma partida.",
            "not-allowed": "<red>Só o <yellow>líder</yellow> e os <yellow>capitães</yellow> mexem no quadro da partida.",
            "disabled": "<red>As convocações estão desativadas nesta partida.",
            "no-callups": "<red>Sua facção já usou todas as convocações desta partida.",
            "roster-full": "<red>O quadro está cheio. <gray>Dispense alguém para abrir vaga.",
            "target-not-member": "<red>Esse jogador não é da sua facção.",
            "target-offline": "<red>Esse jogador não está online.",
            "target-in-match": "<red>Esse jogador já está em uma partida.",
            "target-not-in-roster": "<red>Esse jogador não está no quadro do seu lado.",
            "target-is-self": "<red>Você não pode dispensar a si mesmo."
          }
        }
      },
      "messages": {
        "faction-permissions": {
          "without-permission": "<red>Seu cargo não permite <yellow>{permission_action}</yellow>."
        },
        "faction": {
          // A proteção de território é MUDA desde 05/08 (decisão do dono): a ação bloqueada simplesmente
          // não acontece, sem linha no chat. Por isso não há mais 'not-your-territory' aqui.
          "disbanded": "<red>Sua facção {faction_display_name} <red>foi desfeita.",
          // Chat interno da facção (/c). Formato COPIADO VERBATIM do servidor de factions — é o pedido:
          // quem joga lá tem de reconhecer a linha aqui sem reparar na diferença. Por isso o verde, e não
          // a paleta #ff2d2d da Academy.
          //
          // Os outros quatro placeholders que o código passa ({user_faction_name}, {user_name_with_tag},
          // {user_name_with_color} e {user_role_name}) existem para quem quiser reescrever esta linha.
          "on-member-chat": [
            " <green>[{user_faction_tag}] </green><gray>{user_role_prefix}{user_name}</gray><white>: </white><green>{user_chat_message}</green>"
          ]
        },
        "member": {
          "promoted": "<green>Você foi promovido a {role_name}<green>.",
          "demoted": "<yellow>Você foi rebaixado a {role_name}<yellow>.",
          "leadership-transferred": "<yellow>A liderança da facção {faction_display_name} <yellow>mudou de mãos."
        },
        "invite": {
          "member-joined": "{member_name_with_tag} <green>entrou na facção.</green>"
        },
        "invasion": {
          "started": "<red>Invasão aberta: {attacker_display_name} <red>➜ {defender_display_name}<red>. A preparação começou.",
          "activated": "<red>A invasão contra {defender_display_name} <red>foi ativada!",
          "finished": "<yellow>Invasão encerrada: {attacker_display_name} <yellow>➜ {defender_display_name} <dark_gray>(<white>{destroyed_blocks}/{required_blocks}<dark_gray> blocos)",
          "cancelled": "<gray>A invasão entre {attacker_display_name} <gray>e {defender_display_name} <gray>foi cancelada por um administrador."
        }
      },
      "commands": {
        "faction": {
          "help": [
            "<color:#ff2d2d>Comandos de facção:",
            "<gray>/f <dark_gray>·</dark_gray> /f criar <tag> <nome> <dark_gray>·</dark_gray> /f desfazer <dark_gray>·</dark_gray> /f info [tag]",
            "<gray>/f convidar <jogador> <dark_gray>·</dark_gray> /f entrar <tag> <dark_gray>·</dark_gray> /f recusar <tag> <dark_gray>·</dark_gray> /f convites",
            "<gray>/f membros <dark_gray>·</dark_gray> /f kits <dark_gray>·</dark_gray> /f promover|rebaixar|expulsar|transferir <jogador> <dark_gray>·</dark_gray> /f sair",
            "<gray>/f tag <tag> <dark_gray>·</dark_gray> /f nome <nome>",
            "<gray>/c <mensagem> <dark_gray>·</dark_gray> /f c <mensagem> <dark_gray>(chat interno da facção)</dark_gray>",
            "<gray>/f claim <dark_gray>·</dark_gray> /f desclaim <dark_gray>·</dark_gray> /f mapa",
            "<gray>/f invadir <tag> <dark_gray>·</dark_gray> /f invasoes <dark_gray>·</dark_gray> /f ranking",
