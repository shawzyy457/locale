{
  "plugins": {
    "cannonutils": {
      "commands": {
        "no-plot-permission": "<red>Você só pode usar isso na sua plot (ou onde tiver permissão para construir).",
        "boca": {
          "usage": "<yellow>Uso: <white>/boca <n><yellow> — abre um poço vertical abaixo de você com a boca (<white>{bloco}<yellow>) no fundo.",
          "invalid-amount": "<red>Quantidade inválida: <white>{value}</white>. Informe um número maior que zero.",
          "max": "<red>Você pode abrir no máximo <white>{max}</white> blocos de poço.",
          "world-bottom": "<red>Você já está no fundo do mundo!",
          "done": "<green>Boca aberta com <white>{block}</white> <green>no Y <white>{y}</white>! <gray>{blocks} bloco(s) alterado(s), <white>//undo <gray>desfaz."
        },
        "plataforma": {
          "usage": "<yellow>Uso: <white>/plataforma <raio|chunk><yellow> — cria a plataforma em camadas na sua altura.",
          "invalid-radius": "<red>Raio inválido: <white>{value}</white>. Informe um número ou <white>chunk<red>.",
          "no-layers": "<red>Nenhuma camada configurada para a plataforma. Avise a staff.",
          "too-big": "<red>Operação grande demais: <white>{blocks}</white> blocos (teto: <white>{max}</white>). Reduza o raio.",
          "done": "<green>Plataforma criada com <white>{layers}</white> <green>camada(s)! <gray>{blocks} bloco(s) alterado(s), <white>//undo <gray>desfaz."
        },
        "camada": {
          "usage": "<yellow>Uso: <white>/camada <raio> <comprimento> [bloco]<yellow>, ou <white>/camada regen<yellow>/<white>limpar<yellow>. Padrão: <white>{block} <yellow>a <white>{distance} <yellow>blocos de você.",
          "too-big": "<red>Operação grande demais: <white>{blocks}</white> blocos (teto: <white>{max}</white>). Reduza o raio/comprimento.",
          "no-wall": "<red>Você não tem nenhuma camada para refazer!",
          "regen": "<green>Camada refeita! <gray>{blocks} bloco(s) alterado(s).",
          "no-wall-to-remove": "<red>Você não tem nenhuma camada para remover!",
          "removed": "<green>Camada removida! <gray>{blocks} bloco(s) alterado(s).",
          "invalid-block": "<red>Bloco inválido: <white>{block}</white>.",
          "done": "<green>Camada criada com <white>{block}</white>! <gray>{blocks} bloco(s) alterado(s), <white>//undo <gray>desfaz."
        },
        "canhao": {
          "usage": "<yellow>Uso: <white>/canhao criar <nome> <gray>| <white>colar|publico|privado|remover <nome> <gray>| <white>menu",
          "invalid-name": "<red>Nome inválido! Use apenas letras, números, hífen e underscore (até 32 caracteres).",
          "name-in-use": "<red>Já existe um canhão com esse nome. Escolha outro.",
          "limit": "<red>Você atingiu o limite de <yellow>{max}</yellow> <red>canhões salvos.",
          "no-selection": "<red>Você precisa de uma seleção do WorldEdit para salvar um canhão.",
          "not-enough-dispensers": "<red>Sua seleção precisa de pelo menos <yellow>{min}</yellow> <red>dispensers para virar um canhão.",
          "error": "<red>Ocorreu um erro ao processar o canhão. Tente novamente.",
          "created": "<green>Canhão <yellow>{name}</yellow> <green>salvo! <gray>Tamanho: <white>{size}<gray>.",
          "removed": "<green>Canhão <yellow>{name}</yellow> <green>removido!",
          "published": "<green>Canhão <yellow>{name}</yellow> <green>agora é público.",
          "privated": "<green>Canhão <yellow>{name}</yellow> <green>agora é privado.",
          "not-found": "<red>Canhão <yellow>{name}</yellow> <red>não encontrado.",
          "pasted": "<green>Canhão <yellow>{name}</yellow> <green>colado apontando para onde você está olhando! <gray>Use <white>//undo <gray>para desfazer.",
          // Sem sidecar de cargas e sem dispensers direcionais não dá para saber qual é a frente do canhão:
          // ele é colado como foi salvo e o jogador precisa conferir (ou salvá-lo de novo, com os ejetores cheios).
          "pasted-sem-orientacao": "<yellow>Canhão <white>{name}</white> colado, mas não deu para descobrir a frente dele — confira a direção. <gray>Salve o canhão de novo com os ejetores carregados para ele nascer sempre virado certo. <white>//undo <gray>desfaz.",
          "no-permission": "<red>Você não gerencia este canhão."
        },
        "chunkloader": {
          "given": "<green>Você recebeu um <white>Chunk Loader</white>!",
          "cleared": "<green>Você removeu <yellow>{amount}</yellow> Chunk Loaders!"
        },
        "clock": {
          "usage": "<yellow>Uso: /clock <intervalo> [pulso] <gray>(em segundos).",
          "debug-on": "<green>Debug de temporização do relógio ativado!",
          "debug-off": "<gray>Debug de temporização do relógio desativado.",
          "invalid-number": "<red>Número inválido: <white>{value}</white>.",
          "received": "<green>Você recebeu um <white>Relógio de Redstone</white> <gray>(intervalo <white>{interval}s<gray>, pulso <white>{pulse}s<gray>).</green>"
        },
        "bh": {
          "enabled": "<green>BlockHelper ativado! <gray>Redstone automática em escadas, lajes, vidro e glowstone.</gray>",
          "disabled": "<gray>BlockHelper desativado."
        },
        // O /luz saiu daqui em 2026-07-27: virou a lanterna do essentials (módulo utils →
        // função `lantern`). Os textos foram para cannoning/essentials/utils.jsonc, com OUTRAS
        // chaves (success-enable / success-disable / cannot-use-on-spawn).
        "ntc": {
          "received": "<green>Você recebeu o <white>Node Tick Counter</white>!"
        },
        "tc": {
          "received": "<green>Você recebeu o <white>Tick Counter</white>!"
        },
        "explosionboxes": {
          "ativado": "<green>Visualização de explosões <white>ativada</white>! Só você enxerga as caixas.</green>",
          "desativado": "<green>Visualização de explosões <white>desativada</white>.</green>"
        },
        // Menu direto dos oito kits de ferramenta. /kit e /kits pertencem ao CannonUtils;
        // o módulo de kits do Essentials fica desligado no Cannoning.
        "kit": {
          "invalid-item": "<red>Item inválido. Disponíveis: <white>{items}</white>.</red>",
          "given": "<green>Você recebeu <white>{amount}x</white> <white>{item}</white>.</green>",
          "given-pickaxe": "<green>Você recebeu a <white>Picareta SILK2</white>!</green>",
          "item-unavailable": "<red>Este kit está temporariamente indisponível. Tente novamente em instantes.</red>",
          "clock": {
            "prompt-interval": "Digite o <white>intervalo</white> do relógio em segundos <gray>(ex.: 1.8)</gray>.",
            "prompt-pulse": "Intervalo definido em <white>{interval}s</white>. Agora digite a duração do <white>pulso</white> em segundos, menor que o intervalo <gray>(ex.: 0.2)</gray>.",
            "invalid-number": "<red>Tempo inválido: <white>{value}</white>. Digite um número maior que zero.</red>",
            "invalid-pulse": "<red>O pulso precisa ser menor que o intervalo de <white>{interval}s</white>.</red>"
          }
        },
        "tntfill": {
          "filled": "<green>Ejetores preenchidos: <white>{amount}</white>.</green>",
          "skipped-other": "<gray>Ignorados por terem item que não é TNT: <white>{amount}</white>.</gray>",
          "skipped-no-target": "<gray>Ignorados por não ter tipo definido: <white>{amount}</white>.</gray>",
          "no-worldedit": "<red>O WorldEdit não está instalado neste servidor.</red>",
          "no-selection": "<red>Você não tem uma seleção completa do WorldEdit! Marque as duas posições.</red>",
          "invalid-radius": "<red>Raio inválido: <white>{value}</white>. Informe um número.</red>",
          "usage": [
            "<yellow>/tntfill <impulso|dano> [raio] <dark_gray>-</dark_gray> <gray>enche numa esfera ao seu redor.",
            "<yellow>/tntfill <impulso|dano> we <dark_gray>-</dark_gray> <gray>enche na seleção do WorldEdit.",
            "<yellow>/tntfill <dark_gray>-</dark_gray> <gray>enche os ejetores já tipados por perto."
          ]
        },
        "tntunfill": {
          "emptied": "<green>Ejetores esvaziados: <white>{amount}</white>.</green>",
          "no-worldedit": "<red>O WorldEdit não está instalado neste servidor.</red>",
          "no-selection": "<red>Você não tem uma seleção completa do WorldEdit! Marque as duas posições.</red>",
          "usage": [
            "<yellow>/tntunfill <dark_gray>-</dark_gray> <gray>esvazia os dois tipos, no raio padrão.",
            "<yellow>/tntunfill <impulso|dano> [raio] <dark_gray>-</dark_gray> <gray>esvazia só esse tipo.",
            "<yellow>/tntunfill [impulso|dano] we <dark_gray>-</dark_gray> <gray>esvazia na seleção do WorldEdit."
          ]
        },
        "multidispenser": {
          "usage": "<red>Uso: /multidispenser <quantidade> [pavio] [delay] [prioridade]</red>",
          "prompt-ask": "Digite a quantidade de TNTs por disparo <gray>(máximo <white>{maximo}</white>)</gray>.",
          "prompt-invalid": "<red>Quantidade inválida! Digite um número maior que zero.</red>",
          "given": "<green>Você recebeu um MultiDispenser de <yellow>{amount}</yellow> TNTs! <gray>Pavio <white>{fuse}</white>, delay <white>{delay}</white>, prioridade <white>{priority}</white>."
        },
        "xray": {
          "enabled": "<green>Xray ativado! Só a redstone fica visível. Use <white>/xray <green>de novo para atualizar.",
          "disabled": "<yellow>Xray desativado.</yellow>"
        },
        "dispensercheck": {
          "enabled": "<green>Verificação de ejetores ativada! A cor do vidro mostra quantas vezes cada um disparou.",
          "disabled": "<yellow>Verificação de ejetores desativada.</yellow>"
        },
        "ping": {
          "self": "<yellow>Seu ping é de {ping}<yellow>ms.</yellow>",
          "other": "<yellow>O ping de </yellow>{jogador_name_with_tag} <yellow>é de {ping}<yellow>ms.</yellow>",
          "not-found": "<red>O jogador <yellow>{jogador}</yellow> não está online.</red>",
          "errors": {
            "only-player": "<red>Pelo console você precisa informar o jogador. Uso: /ping <jogador></red>"
          }
        },
        "playerscale": {
          "usage": "<red>Uso: /playerscale <valor|reset|get> [jogador]</red>",
          "player-not-found": "<red>O jogador <yellow>{jogador}</yellow> não está online.</red>",
          "get": "<yellow>A escala de </yellow>{jogador_name_with_tag} <yellow>é <white>{escala}</white>.</yellow>",
          "invalid-number": "<red>Valor inválido: <white>{valor}</white>. Informe um número, <white>reset</white> ou <white>get</white>.</red>",
          "out-of-range": "<red>A escala deve estar entre <white>{minimo}</white> e <white>{maximo}</white>.</red>",
          "set": "<green>Sua escala foi definida para <yellow>{escala}</yellow>!</green>",
          "reset": "<green>Sua escala foi restaurada para <yellow>{escala}</yellow>!</green>",
          "set-other": "<green>Você definiu a escala de </green>{jogador_name_with_tag} <green>para <yellow>{escala}</yellow>!</green>",
          "notified": "<yellow>Sua escala foi alterada para <white>{escala}</white>.</yellow>",
          "errors": {
            "only-player": "<red>Pelo console você precisa informar o jogador. Uso: /playerscale <valor|reset|get> <jogador></red>",
            "no-scale-attribute": "<red>Ocorreu um erro interno. Tente novamente mais tarde.</red>"
          }
        },
        "clearentities": {
          "no-plot": "<red>Você precisa estar dentro de uma plot para usar este comando.</red>",
          "no-permission": "<red>Você não tem permissão para gerenciar esta plot.</red>",
          "none": "<yellow>Não havia nada para limpar nesta plot.</yellow>",
          "header": "<green>Você limpou <white>{total}</white> <green>entidades da sua plot!</green>",
          "line-items": "<dark_gray>▸ <white>Itens: <yellow>{amount}",
          "line-tnt": "<dark_gray>▸ <white>TNT: <yellow>{amount}",
          "line-block": "<dark_gray>▸ <white>{block}: <yellow>{amount}"
        },
        "corner": {
          "usage": "<red>Uso: /corner <quina> — informe um número de 1 a 4.</red>",
          "no-plot": "<red>Você precisa estar dentro de uma plot para usar este comando.</red>",
          "no-permission": "<red>Você não tem permissão para gerenciar esta plot.</red>",
          "teleported": "<green>Você foi teleportado para a quina <yellow>{corner}</yellow> da sua plot!</green>"
        },
        "drops": {
          "no-plot": "<red>Você precisa estar dentro de uma plot para usar este comando.</red>",
          "no-permission": "<red>Você não tem permissão para gerenciar esta plot.</red>",
