              "<dark_gray><strikethrough>                                                  </strikethrough>",
              "<yellow>/kit <gray>(/kits) <dark_gray>-</dark_gray> <gray>abre os 8 kits de ferramentas de canhoneio",
              "",
              "<yellow>/spawn <dark_gray>-</dark_gray> <gray>volta para o spawn do servidor",
              "<yellow>/warps <gray>(/warp) <dark_gray>-</dark_gray> <gray>lista as localizações do servidor",
              "",
              "<yellow>/ping <dark_gray>-</dark_gray> <gray>mostra o seu ping",
              "",
              "<yellow>/fire <dark_gray>-</dark_gray> <gray>interage com o último botão que você usou",
              "<yellow>/lever <dark_gray>-</dark_gray> <gray>interage com a última alavanca que você usou",
              "<yellow>/noteblock <gray>(/nb) <dark_gray>-</dark_gray> <gray>interage com o último noteblock que você usou",
              "<dark_gray><strikethrough>                                                  </strikethrough>",
              "<hover:show_text:'<gray>Clique para abrir <white>Construção'><click:run_command:'/ajuda construcao'><yellow><bold>◂ Anterior</bold></yellow></click></hover>   <gray>{page}<dark_gray>/<white>{total}  <dark_gray>▪ <hover:show_text:'<gray>Clique para abrir <white>Início'><click:run_command:'/ajuda inicio'><gray>Menu</gray></click></hover>   <hover:show_text:'<gray>Clique para abrir <white>Utilidades'><click:run_command:'/ajuda utilidades'><yellow><bold>Próxima ▸</bold></yellow></click></hover>"
            ]
          },
          "utilidades": {
            "display": "Utilidades",
            "body": [
              "<dark_gray><strikethrough>                                                  </strikethrough>",
              "       <color:#ff2d2d><bold>CANNONUTILS</bold></color> <dark_gray>▸</dark_gray> <yellow>{current}</yellow>",
              "<dark_gray><strikethrough>                                                  </strikethrough>",
              "<yellow>/corner <gray><1-4> <dark_gray>-</dark_gray> <gray>teleporta pra uma das quinas da sua plot",
              "<yellow>/clearentities <gray>(/ce) <dark_gray>-</dark_gray> <gray>limpa TNTs e drops da sua plot",
              "<yellow>/chunkloader <gray>[limpar] <dark_gray>-</dark_gray> <gray>dá um carregador de chunks 3x3",
              "    <gray>(<white>limpar<gray> remove todos os que você colocou)",
              "<yellow>/clock <gray><segundos> <pulso> <dark_gray>-</dark_gray> <gray>dá um relógio de redstone que pulsa",
              "<yellow>/playerscale <gray>(/scale, /ps) <dark_gray>-</dark_gray> <gray>aumenta/diminui o seu tamanho",
              "<yellow>/tntfill <gray><impulso|dano> [raio|we] <dark_gray>-</dark_gray> <gray>enche os ejetores próximos",
              "    <gray>(ou na seleção do WorldEdit) com a TNT do tipo escolhido",
              "<yellow>/tntunfill <gray>[raio] <dark_gray>-</dark_gray> <gray>esvazia os ejetores próximos",
              "<yellow>/multidispenser <gray><qtd> [pavio] [delay] [prio] (/md) <dark_gray>-</dark_gray> <gray>ejetor que",
              "    <gray>solta N TNTs; shift + abrir ele (colocado) abre o menu",
              "<yellow>/xray <dark_gray>-</dark_gray> <gray>deixa os blocos próximos invisíveis (menos a redstone)",
              "<yellow>/luz <gray>(/lanterna) <dark_gray>-</dark_gray> <gray>visão noturna liga/desliga",
              "<yellow>/lixeira <dark_gray>-</dark_gray> <gray>abre um inventário descartável",
              "<dark_gray><strikethrough>                                                  </strikethrough>",
              "<hover:show_text:'<gray>Clique para abrir <white>Básicos'><click:run_command:'/ajuda basicos'><yellow><bold>◂ Anterior</bold></yellow></click></hover>   <gray>{page}<dark_gray>/<white>{total}  <dark_gray>▪ <hover:show_text:'<gray>Clique para abrir <white>Início'><click:run_command:'/ajuda inicio'><gray>Menu</gray></click></hover>"
            ]
          }
        }
      }
    }
  }
}
