{
  "plugins": {
    "essentials": {
      "commands": {
        // /luz (lanterna, lantern) — módulo utils → função `lantern`.
        // Substitui o /luz que morava no cannon-utils (setup `light`, apagado em 2026-07-27).
        //
        // ⚠️ As chaves NÃO são as mesmas do comando antigo: lá eram enabled/disabled/not-here;
        // aqui são success-enable/success-disable/cannot-use-on-spawn. A terceira só aparece
        // quando `functions.lantern.active-app-types` limita os app-types — no cannoning a lista
        // está vazia (vale em todo lugar), então ela nunca é enviada. Fica declarada para o caso
        // de alguém restringir depois.
        "lantern": {
          "success-enable": "<green>Luz ativada! <gray>Você enxerga no escuro até desligar com <white>/luz<gray>.",
          "success-disable": "<gray>Luz desativada.",
          "cannot-use-on-spawn": "<red>Você não pode usar a luz aqui."
        },
        // /lixeira (lixo, trash) — inventário descartável. Título é TEXTO CRU.
        "trash": {
          "inventory-title": "Lixeira"
        },
        // /compactar (compact) — no stack da rede este comando só avisa que falta o pet
        // compactador, que o cannoning não tem. Mantido para a resposta ser a mesma da rede.
        "compact": {
          "no-pet": "<red>Utilize uma bancada de trabalho! O compactador automático não existe neste servidor."
        }
      },
      "messages": {
        "inventory-full": "<red>Inventário cheio! Os itens ficaram no chão.",
        // A função que a envia (`crop-break-protection-sneak`) está DESLIGADA no cannoning — a chave
        // fica declarada só para que ligar o toggle não faça o jogador ver a chave crua.
        "crops": {
          "need-sneak": "<red>Você precisa segurar <white>SHIFT<red> para quebrar esta plantação."
        },
        // Recusa do arremesso em combate (`functions.ender-pearl.block-in-combat`, ligado aqui).
        // A pearl NÃO sai da mão e NÃO entra em cooldown — é por isso que a mensagem fala em tentar
        // de novo: o item continua no inventário e o cronômetro não começou.
        "ender-pearl": {
          "blocked-in-combat": "<red>Você não pode usar <white>Ender Pearl<red> em combate! Tente de novo quando sair."
        }
      }
    }
  }
}
