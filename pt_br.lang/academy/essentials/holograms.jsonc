{
  "plugins": {
    "essentials": {
      // Linhas dos hologramas declarados em hologram/config.yml. Cada chave é um ARRAY: uma entrada
      // por linha do holograma, de cima para baixo. String vazia = linha em branco (espaçamento).
      //
      // A chave aqui precisa bater com o 'lang-key' do arquivo hologram/holograms/<id>.yml.
      //
      // As linhas são resolvidas POR VIEWER a cada update (addDynamicLangLines), mas o código passa
      // um Map vazio: só placeholders GLOBAIS do core funcionam aqui. Não invente {chaves} novas.
      //
      // Paleta: vermelho de marca do cannoning = #ff2d2d (não é vermelho de erro).
      "holograms": {
        "welcome": [
          "<gradient:#ff2d2d:#ff7b5c><bold>EXE CANNONING</bold></gradient>",
          "",
          "<white>Monte, teste e ajuste os seus canhões",
          "<white>na sua própria plot, sem limite de tentativas.",
          "",
          "<gray>Use <color:#ff2d2d>/ajuda<gray> para ver tudo o que dá para fazer aqui."
        ],
        "info": [
          "<color:#ff2d2d><bold>COMANDOS ÚTEIS</bold>",
          "",
          "<gray>▸ <white>/ajuda <gray>— lista completa de comandos",
          "<gray>▸ <white>/corner <gray>— vai para o canto da sua plot",
          "<gray>▸ <white>/ce <gray>— limpa as entidades da sua plot"
        ]
      }
    }
  }
}
