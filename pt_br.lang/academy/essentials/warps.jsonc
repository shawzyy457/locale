{
  "plugins": {
    "essentials": {
      "commands": {
        // /warp, /warps, /localizações — WarpsCommand do essentials.
        // Placeholder passado pelo Java: {group} (componente do cargo).
        //
        // ⚠️ A chave mudou de nome no port: o comando do cannon-utils avisava
        // "world-not-available" (ele resolvia o mundo local); o do essentials
        // resolve o APP pelo load balancer e avisa "app-not-available".
        "warps": {
          "app-not-available": "<red>Esta localização não está disponível agora. Tente de novo mais tarde.</red>",
          "minimum-group": "Você precisa ser no mínimo {group} <red>para usar esta localização.</red>"
        },
        // Atalho registrado por warp (WarpImpCommand) — /testes, /torneio, /spawn.
        "warp": {
          "app-not-available": "<red>Esta localização não está disponível agora. Tente de novo mais tarde.</red>"
        }
      },
      "views": {
        // Menu de /warps — WarpsView.
        // O título é texto CRU (é nome de inventário, não passa por MiniMessage).
        // items.0 é o molde de TODO ícone: nome e lore vêm dos placeholders
        // {warp_name}/{warp_description}, resolvidos por warp em plugins.essentials.warps.<id>.
        "warps": {
          "title": "Localizações",
          "items": {
            "0": {
              "name": "{warp_name}",
              "lore": [
                "{warp_description}"
              ]
            }
          }
        }
      },
      // Nome e descrição de cada warp de warp/warps/*.yml. O id da chave = o `id:` do arquivo.
      // Paleta: vermelho de marca do cannoning = #ff2d2d (não é vermelho de erro).
      "warps": {
        // A warp `spawn` é o /spawn do servidor. Fica com slot -1 (fora do menu),
        // então na prática só o nome aparece — em mensagem de erro.
        "spawn": {
          "name": "<color:#ff2d2d>Spawn",
          "description": [
            "<gray>O ponto de encontro do servidor.",
            "",
            "<color:#ff2d2d> ▸ <white>Atalho:<gray> /spawn"
          ]
        },
        "testes": {
          "name": "<color:#ff2d2d>Área de Testes",
          "description": [
            "<gray>Terreno aberto para acertar",
            "<gray>o pavio antes de valer.",
            "",
            "<color:#ff2d2d> Propriedades:",
            "<color:#ff2d2d> ▸ <white>Atalho:<gray> /testes",
            "<color:#ff2d2d> ▸ <white>Chegada:<gray> ponto sorteado",
            "",
            "<color:#ff2d2d>Clique para ir!"
          ]
        },
        // Esta warp NÃO tem atalho próprio: o nome /torneio pertence ao plugin de facções, que abre o
        // menu da copa (por isso o register-commands: false no warp). Ela é alcançada por aqui.
        "torneio": {
          "name": "<color:#ff2d2d>Arena de Torneio",
          "description": [
            "<gray>Onde os campeonatos de",
            "<gray>canhoneio acontecem.",
            "",
            "<color:#ff2d2d> Propriedades:",
            "<color:#ff2d2d> ▸ <white>Requer:<gray> PRO ou superior",
            "",
            "<color:#ff2d2d>Clique para ir!"
          ]
        },
        "plot": {
          "name": "<color:#ff2d2d>Meu Plot",
          "description": [
            "<gray>Volta para o seu terreno,",
            "<gray>onde ficam seus canhões.",
            "",
            "<color:#ff2d2d> Propriedades:",
            "<color:#ff2d2d> ▸ <white>Atalho:<gray> /home",
            "<color:#ff2d2d> ▸ <white>Sem terreno?<gray> use /plot auto",
            "",
            "<color:#ff2d2d>Clique para ir!"
          ]
        }
      }
    }
  }
}
