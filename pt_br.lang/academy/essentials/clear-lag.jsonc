{
  "plugins": {
    "essentials": {
      "commands": {
        // /clearlag (limparlag) — MANAGER+. Antecipa a limpeza do chão.
        //
        // ⚠️ O comando do cannon-utils tinha também os aliases /clearfloor e /cf (ICE-411) e uma
        // chave `already-running`. O comando do essentials não tem nenhum dos dois: ele publica o
        // pedido no Echo e responde sempre a mesma coisa.
        "clearlag": {
          "request-sent": "<green>♼ Limpeza do chão iniciada — a contagem regressiva já está no ar."
        }
      },
      "messages": {
        // Actionbar de todo mundo online. Placeholders vindos do ClearLagEchoListener:
        //   countdown -> DateUtils.formatDuration (ex.: "15 segundos")
        //   count     -> NumberUtil.formatNumber (ex.: "1.284")
        //
        // ⚠️ `count` soma o getAmount() do ItemStack, não a quantidade real do stack drop (que vive
        // na metadata). Com o módulo `stackdrop` ligado o número sai MENOR que a realidade — é só o
        // texto: a limpeza em si apaga tudo.
        "clear-lag": {
          "countdown": "<green>♻ <white>O chão será limpo em <green>{countdown}<white>...",
          "clean": "<green>♻ <white>Foram limpos <green>{count} itens do chão."
        }
      }
    }
  }
}
