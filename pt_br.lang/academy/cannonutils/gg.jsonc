{
  "plugins": {
    "cannonutils": {
      "messages": {
        "gg": {
          // Anúncio da compra aprovada (CannonGGTransactionEchoListener, disparado pelo
          // ShopOrderApprovedPacket que vem da LOJA). Placeholders passados pelo código:
          //   {order_owner_user_name}            -> nome cru do comprador
          //   {order_owner_user_name_with_tag}   -> nome + ícone da tag do cargo
          //   {order_owner_user_name_with_color} -> nome colorido pelo cargo
          // O clique executa /gg (no server-core era /gg pelo chat de facção, que não existe aqui).
          "on-transaction": [
            "",
            " <green><bold>Nova compra confirmada!</bold></green>",
            " <dark_gray>exe.com</dark_gray>",
            "",
            " <green>▰</green> <white>{order_owner_user_name_with_color} <white>acaba de adquirir</white>",
            " <white>um novo item em nossa loja.</white>",
            "",
            " <green>Clique <bold><click:run_command:'/gg'>AQUI</click></bold> para comemorar a compra!</green>",
            ""
          ],
          // Eco de cada /gg durante a janela (CannonGGService#broadcastEcho).
          //   {player_name_with_tag} -> quem comemorou, com a tag do cargo (há também _name e _name_with_color)
          //   {gg}     -> o "GG!" já colorido (Component pronto, NÃO envolver em tag de cor)
          "echo": "{player_name_with_tag} <reset>{gg}"
        }
      },
      "commands": {
        "gg": {
          // Janela fechada: ninguém comprou nada nos últimos segundos.
          "closed": "<red>Não há nenhuma compra para comemorar no momento.</red>",
          // Primeira comemoração da transação — só aqui o gold é creditado. {gold} vem do config.
          "rewarded": "<green>Você comemorou a compra e recebeu <yellow>{gold}</yellow> de Gold!</green>"
        }
      }
    }
  }
}
