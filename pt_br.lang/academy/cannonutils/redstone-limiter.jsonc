{
  "plugins": {
    "cannonutils": {
      "commands": {
        // /redstone <on|off|info|amount <n>|debug> — staff MANAGER+ (GroupCommandRestrict).
        // As chaves 'list.*' da lang original do server-core NÃO foram portadas: o subcomando
        // /redstone list nunca existiu no código, eram chaves órfãs.
        "redstone": {
          "arguments": {
            "action": {
              "name": "on/off/info/amount <valor>/debug",
              "description": "Ação de configuração do limitador de redstone"
            }
          },
          "tick": {
            "on": "<green>Limitador de redstone ativado.</green>",
            "off": "<green>Limitador de redstone desativado.</green>",
            // Placeholders do CannonRedstoneLimiterCommand: {redstone_tick_enabled} (rótulo pronto),
            // {redstone_tick_interval} (ticks da janela), {redstone_tick_amount} (eventos por tick)
            // e {redstone_tick_total} (teto efetivo da janela = amount x interval).
            "info": [
              "<red>Limitador de redstone:</red>",
              " <dark_gray>▸</dark_gray> <white>Estado:</white> <gray>{redstone_tick_enabled}</gray>",
              " <dark_gray>▸</dark_gray> <white>Janela:</white> <gray>{redstone_tick_interval} ticks</gray>",
              " <dark_gray>▸</dark_gray> <white>Eventos por tick:</white> <gray>{redstone_tick_amount}</gray>",
              " <dark_gray>▸</dark_gray> <white>Teto por janela:</white> <gray>{redstone_tick_total}</gray>"
            ],
            "update": "<green>Teto do limitador alterado para <yellow>{redstone_tick_amount}</yellow> eventos por tick <gray>({redstone_tick_total} por janela)</gray>.</green>"
          },
          "debug": {
            "on": "<green>Debug do limitador de redstone ativado.</green>",
            "off": "<green>Debug do limitador de redstone desativado.</green>"
          }
        }
      },
      "messages": {
        "redstone-limiter": {
          // Enviado a quem está no raio 'redstonelimiter.raio-aviso' do bloco removido.
          "too-many-redstone-circuits": "<red>Existem circuitos de redstone demais nesta região.</red>"
        }
      }
    }
  }
}
