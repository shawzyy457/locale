{
  // Treino de canhão: reconstruir um canhão salvo contra o relógio, com molde-fantasma, glow por bloco,
  // nota e ranking. Cor de marca do cannoning = #ff2d2d. Verde/amarelo/vermelho seguem o glow do jogo.
  // Comando único: /treinar (lista, config, ranking, sessão e administração). O treino NASCE do menu do
  // /canhao (shift + clique esquerdo num canhão salvo). Decimais em vírgula (2,4).
  //
  // Estilo (padrão do servidor de factions): chat sem fonte, com a cor dizendo o resultado — <red> para
  // recusa, <green> para conclusão, <yellow> para aviso. A fonte pequena vale para item de menu e HUD.
  "plugins": {
    "cannonutils": {
      "commands": {
        // /treinar — comando único do treino (jogador + administração).
        "treinar": {
          "usage": [
            "<red>Comandos de treino:</red>",
            " <dark_gray>▸</dark_gray> <white>/treinar</white> <gray>- abre a lista de treinos disponíveis</gray>",
            " <dark_gray>▸</dark_gray> <white>/treinar <nome></white> <gray>- configura e inicia um treino</gray>",
            " <dark_gray>▸</dark_gray> <white>/treinar ranking <nome></white> <gray>- abre o ranking do treino</gray>",
            " <dark_gray>▸</dark_gray> <white>/treinar terminar | cancelar</white> <gray>- encerra a sua sessão</gray>"
          ],
          "usage-admin": [
            "<red>Administração de treinos:</red>",
            " <dark_gray>▸</dark_gray> <white>/treinar editar <nome> <opção> <valor></white> <gray>- tempo, cargas, rigor, buffs...</gray>",
            " <dark_gray>▸</dark_gray> <white>/treinar remover <nome></white> <gray>- apaga o treino</gray>",
            "<gray>Para criar ou atualizar um treino, use <white>shift + clique esquerdo</white> em um canhão do <white>/canhao</white>.</gray>"
          ],
          "sem-permissao": "<red>Você não possui permissão para administrar treinos.</red>",
          "nao-encontrado": "<red>Treino <yellow>{nome}</yellow> não encontrado. Veja os disponíveis em <white>/treinar</white>.</red>",
          "nome-invalido": "<red>Nome inválido: <yellow>{nome}</yellow>. Use apenas letras, números, <white>_</white> e <white>-</white> (até 32 caracteres).</red>",
          "canhao-sem-schematic": "<red>O schematic do canhão <yellow>{nome}</yellow> não está mais no disco. Salve o canhão novamente com <white>/canhao criar</white>.</red>",
          "erro": "<red>Não foi possível gerar o treino. Verifique o console.</red>",
          "criado": "<green>Treino <yellow>{nome}</yellow> criado com sucesso! <gray>{total} blocos na estrutura.</gray></green>",
          "atualizado": "<green>Treino <yellow>{nome}</yellow> atualizado com o canhão salvo. <gray>{total} blocos na estrutura.</gray></green>",
          "sem-cargas": "<yellow>O canhão <white>{nome}</white> não possui cargas de TNT guardadas — o treino avaliará apenas a estrutura. <gray>Salve o canhão novamente, com os ejetores cheios, para cobrar as cargas.</gray></yellow>",
          "editado": "<green>Treino <yellow>{nome}</yellow>: <white>{opcao}</white> alterado para <yellow>{valor}</yellow>.</green>",
          "opcao-invalida": "<red>Opção ou valor inválido: <yellow>{opcao}</yellow> = <yellow>{valor}</yellow>.</red>",
          "removido": "<green>Treino <yellow>{nome}</yellow> removido com sucesso!</green>"
        }
      },

      "messages": {
        "treino": {
          // HUD (actionbar) durante a construção: tempo restante + blocos corretos / total.
          "hud": "<red>⏱ <white>{time} <dark_gray>▸</dark_gray> Blocos: <green>{placed}</green><gray>/{total}</gray></white>",

          // Título ao começar.
          "inicio": {
            "title": "<red><bold>Vai!</bold></red>",
            "subtitle": "<gray>{treino} <dark_gray>▸</dark_gray> <white>{tempo}s</white></gray>"
          },

          // Avisos de estado.
          "ja-em-treino": "<red>Você já está em um treino. Use <white>/treinar cancelar</white> para sair.</red>",
          "sem-sessao": "<red>Você não está em nenhum treino.</red>",
          "erro-schematic": "<red>Não foi possível carregar o canhão deste treino. Avise a staff.</red>",
          "sem-plot": "<red>Entre em sua plot com <white>/plot h</white> para treinar.</red>",
          "cancelado": "<yellow>Treino cancelado.</yellow>",
          // Estrutura ficou 100% antes do tempo — o treino encerra sozinho, gravando o tempo real
          // usado (o desempate do recorde). Ver 'terminar-ao-completar' no config.yml.
          "completo": "<green>Canhão concluído! Encerrando o treino...</green>",
          "fora-da-caixa": "<red>Você só pode construir dentro da área do treino.</red>",
          "novo-recorde": "<green>★ Novo recorde! <gray>Sua melhor nota agora é <white>{nota}</white>.</gray></green>",

          // Rótulo flutuante sobre os dispensers do molde: qual carga o ejetor espera.
          "holograma": {
            "impulso": "<gold><bold>Impulso</bold></gold>",
            "dano": "<light_purple><bold>Dano</bold></light_purple>"
          },

          // Resultado no chat (espelha a tela do jogo). Enviado como INFO (várias linhas).
          "resultado": [
            "<red>Fim do treino de <yellow>{treino}</yellow>:</red>",
            " <dark_gray>▸</dark_gray> <white>Corretos:</white> <gray>{corretos}/{total}</gray>",
            " <dark_gray>▸</dark_gray> <white>No lugar errado:</white> <gray>{lugar_errado}</gray>",
            " <dark_gray>▸</dark_gray> <white>Sobrando:</white> <gray>{sobrando}</gray>",
            " <dark_gray>▸</dark_gray> <white>Faltando:</white> <gray>{faltando}</gray>",
            " <dark_gray>▸</dark_gray> <white>Cargas erradas:</white> <gray>{cargas_erradas}</gray>",
            " <dark_gray>▸</dark_gray> <white>Precisão:</white> <gray>{precisao}%</gray>",
            " <dark_gray>▸</dark_gray> <white>Nota:</white> <yellow><bold>{nota}</bold></yellow>"
          ],

          // Título por faixa da nota (§8). {nota} disponível.
          "fim": {
            "perfeito": {
              "title": "<green><bold>Perfeito!</bold></green>",
              "subtitle": "<gray>Nota <white>{nota}</white> — canhão impecável.</gray>"
            },
            "bom": {
              "title": "<green><bold>Muito bom!</bold></green>",
              "subtitle": "<gray>Nota <white>{nota}</white>.</gray>"
            },
            "regular": {
              "title": "<yellow><bold>Quase lá</bold></yellow>",
              "subtitle": "<gray>Nota <white>{nota}</white> — ainda dá para melhorar.</gray>"
            },
            "reprovado": {
              "title": "<red><bold>Reprovado</bold></red>",
              "subtitle": "<gray>Nota <white>{nota}</white> — tente novamente.</gray>"
            }
          }
        }
      },

      "views": {
        "treino": {
          // Confirmação de gerar o treino de um canhão salvo (shift + clique esquerdo no /canhao).
          // Usa a tela padrão do core SEM desvio: o título é o "Confirmação" de
          // plugins.core.views.confirmation.title — por isso não há "title" aqui. Daqui sai só o item
          // central, que é quem diz o que está sendo confirmado.
          "criar": {
            "items": {
              "treino": {
                "name": "<green>Criar treino de {canhao}</green>",
                "lore": [
                  "<gray>O canhão salvo vira um treino que</gray>",
                  "<gray>os jogadores reconstroem contra o tempo.</gray>",
                  "",
                  " <dark_gray>▸</dark_gray> <white>Canhão:</white> <gray>{canhao}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Tamanho:</white> <gray>{tamanho}</gray>",
                  "",
                  "<gray>Nasce privado — publique com</gray>",
                  "<white>/treinar editar {canhao} publico true</white>"
                ]
              }
            }
          },
          // Mesmo fluxo, quando já existe um treino com o nome do canhão. Também sem "title".
          "atualizar": {
            "items": {
              "treino": {
                "name": "<yellow>Atualizar treino de {canhao}</yellow>",
                "lore": [
                  "<gray>Já existe um treino com este nome.</gray>",
                  "<gray>O molde e as cargas serão substituídos</gray>",
                  "<gray>pelo canhão salvo agora.</gray>",
                  "",
                  " <dark_gray>▸</dark_gray> <white>Canhão:</white> <gray>{canhao}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Tamanho:</white> <gray>{tamanho}</gray>",
                  "",
                  "<gray>Tempo, rigor, modos e recordes</gray>",
                  "<gray>permanecem como estão.</gray>"
                ]
              }
            }
          },

          // Menu de /treinar <nome> — o print do usuário.
          "config": {
            "title": "Treinar: {treino}",
            "items": {
              "modo": {
                "guiado": {
                  "name": "<color:#ff2d2d>Modo: Guiado</color>",
                  "lore": [
                    "<gray>O canhão aparece como molde</gray>",
                    "<gray>fantasma para você construir por cima.</gray>",
                    "",
                    "<green>Clique para mudar para Memória.</green>"
                  ]
                },
                "memoria": {
                  "name": "<color:#ff2d2d>Modo: Memória</color>",
                  "lore": [
                    "<gray>Sem molde durante a construção —</gray>",
                    "<gray>apenas uma espiada rápida no início.</gray>",
                    "",
                    "<green>Clique para mudar para Guiado.</green>"
                  ]
                }
              },
              "tempo": {
                "name": "<color:#ff2d2d>Tempo: <white>{tempo}s</white></color>",
                "lore": [
                  "<gray>Quanto tempo você tem para</gray>",
                  "<gray>reconstruir o canhão.</gray>",
                  "",
                  "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>+5s</white>",
                  "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>-5s</white>"
                ]
              },
              "pulo": {
                "on": {
                  "name": "<green>Super-pulo: Ligado</green>",
                  "lore": [
                    "<gray>Pula bem mais alto para alcançar</gray>",
                    "<gray>as partes de cima do canhão.</gray>",
                    "",
                    "<red>Clique para desligar.</red>"
                  ]
                },
                "off": {
                  "name": "<gray>Super-pulo: Desligado</gray>",
                  "lore": [
                    "<gray>Pulo normal.</gray>",
                    "",
                    "<green>Clique para ligar.</green>"
                  ]
                }
              },
              "speed": {
                "name": "<color:#ff2d2d>Velocidade: <white>{speed}</white></color>",
                "lore": [
                  "<gray>Ande mais rápido para montar</gray>",
                  "<gray>o canhão em menos tempo.</gray>",
                  "",
                  "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>+1</white>",
                  "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>-1</white>"
                ]
              },
              "fly": {
                "on": {
                  "name": "<green>Voo: Ligado</green>",
                  "lore": [
                    "<gray>Voe livremente enquanto constrói.</gray>",
                    "",
                    "<red>Clique para desligar.</red>"
                  ]
                },
                "off": {
                  "name": "<gray>Voo: Desligado</gray>",
                  "lore": [
                    "<gray>Sem voo durante o treino.</gray>",
                    "",
                    "<green>Clique para ligar.</green>"
                  ]
                }
              },
              // Substituiu o /treinar limpar: a escolha de guardar ou apagar a construção passou a ser
              // feita ANTES de começar. O padrão é apagar (ver SessionConfig.KEEP_CANNON_DEFAULT).
              "manter": {
                "on": {
                  "name": "<green>Manter o canhão: Sim</green>",
                  "lore": [
                    "<gray>A construção permanece em sua plot</gray>",
                    "<gray>depois que o treino acabar.</gray>",
                    "",
                    "<red>Clique para apagar no fim.</red>"
                  ]
                },
                "off": {
                  "name": "<gray>Manter o canhão: Não</gray>",
                  "lore": [
                    "<gray>A construção e o piso são apagados</gray>",
                    "<gray>assim que o treino acabar.</gray>",
                    "",
                    "<green>Clique para manter no fim.</green>"
                  ]
                }
              },
              "iniciar": {
                "name": "<green>Iniciar treino</green>",
                "lore": [
                  "<gray>Começa a sessão com a</gray>",
                  "<gray>configuração escolhida acima.</gray>",
                  "",
                  "<green>Clique para começar!</green>"
                ]
              }
            }
          },

          // /treinar (sem argumentos) — lista dos treinos disponíveis.
          "lista": {
            "title": "Treinos de Canhão",
            "visibility": {
              "public": "<green>Público</green>",
              "private": "<yellow>Privado</yellow>"
            },
            "items": {
              "treino": {
                "name": "<color:#ff2d2d>{name}</color>",
                "lore": [
                  "<gray>Criado por </gray>{author_name_with_tag}",
                  "",
                  " <dark_gray>▸</dark_gray> <white>Tempo:</white> <gray>{time}s</gray>",
                  " <dark_gray>▸</dark_gray> <white>Blocos:</white> <gray>{target}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Visibilidade:</white> {visibility}",
                  "",
                  "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>Configurar e treinar</white>",
                  "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>Ver o ranking</white>"
                ]
              }
            }
          },

          // Ranking de um treino.
          "ranking": {
            "title": "Ranking: {treino}",
            "items": {
              "record": {
                "name": "<color:#ff2d2d>#{position}</color> {player_name_with_tag}",
                "lore": [
                  " <dark_gray>▸</dark_gray> <white>Nota:</white> <gray>{grade}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Precisão:</white> <gray>{precision}%</gray>",
                  " <dark_gray>▸</dark_gray> <white>Melhor tempo:</white> <gray>{time}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Tentativas:</white> <gray>{attempts}</gray>"
                ]
              }
            }
          }
        }
      }
    }
  }
}
