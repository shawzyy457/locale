{
  "plugins": {
    "cannonutils": {
      // ======================================================================
      //  PvP PRACTICE — os duelos 1x1 do app-type <primário>-practice.
      //
      //  A busca começa na bússola do spawn (ou em /practice) e a fila vive no app da arena, que casa
      //  os pares. TODOS os duelos acontecem nas mesmas duas coordenadas: o que separa um do outro é
      //  a visibilidade por pacote, então cada duelista só enxerga o adversário dele.
      // ======================================================================
      "practice": {
        "messages": {
          // ---- Fila ----
          // O aviso de entrada não precisa mais explicar como acompanhar a espera: a partir daqui a
          // actionbar mostra o cronômetro e a posição até o par fechar (bloco 'hud' abaixo).
          "queue-joined": "Procurando um adversário… <gray>Use <white>/practice</white> (ou a bússola, no spawn) para cancelar.",
          "queue-left": "Você saiu da busca por duelo.",
          "queue-not-waiting": "Você não está procurando duelo.",
          // A staff tirou o jogador da fila pelo painel do /academy admin. Ele pode estar em
          // QUALQUER app: quem avisa é o servidor onde ele está, ao receber o pacote de remoção.
          "queue-removed-by-staff": "Um administrador tirou você da busca por duelo.",
          // Quem está na arquibancada não pode ser casado: viraria duelista e plateia ao mesmo tempo,
          // e a arena separa os dois papéis por pacote. É o espelho da recusa que o /assistir já faz
          // com quem está duelando.
          "queue-while-spectating": "Você está assistindo a um duelo. <gray>Use <white>/assistir sair</white> antes de procurar o seu.",
          // O adversário não apareceu na arena dentro do prazo. Quem chegou não é mandado embora do
          // sistema: ele volta para a busca, no mesmo servidor, sem precisar clicar de novo.
          "queue-requeued": "<gray>Você voltou para a busca por duelo.",

          // ---- Fac x Fac tem prioridade ----
          // O Academy tem duas atividades que disputam o MESMO jogador, e a regra é única: a partida
          // da facção sempre ganha. Ela é um compromisso entre duas facções; o duelo é entre dois
          // jogadores que recomeçam em um minuto.

          // Ele estava procurando duelo quando a facção entrou em campo. A busca é cancelada de
          // verdade (o anfitrião é avisado), e não só neste servidor — senão a adoção o devolveria à
          // fila ao chegar no app da partida, e ele seria casado no meio dela.
          "queue-simulator-callup": "<gray>Sua facção entrou em uma <white>partida Fac x Fac</white>. A busca por duelo foi cancelada — a partida tem prioridade.",
          // Ele tentou entrar na fila (por /practice ou pela bússola) já estando em partida.
          "queue-while-simulator": "Você está em uma <white>partida Fac x Fac</white>. <gray>Termine a partida antes de procurar duelo.",
          // Mesma regra, outra porta: tentar assistir a um duelo estando em partida.
          "spectate-while-simulator": "Você está em uma <white>partida Fac x Fac</white>. <gray>Assista a duelos quando ela acabar.",

          // ---- Arquibancada (/assistir) ----
          // Todos os duelos acontecem nas MESMAS coordenadas, separados por pacote: quem assiste fica
          // vinculado a UMA luta e só enxerga aquela.
          "spectate-started": "Assistindo <white>{primeiro}</white> x <white>{segundo}</white>. <gray>Use <white>/assistir sair</white> para voltar.",
          "spectate-finished": "O duelo acabou.",
          "spectate-gone": "Esse duelo já acabou.",
          "spectate-in-match": "Você está em um duelo — lute em vez de assistir.",
          // O par exato da recusa acima. Assistir procurando duelo colocaria o jogador nos dois papéis
          // ao mesmo tempo, e a arena os separa por pacote: o par fecharia com ele de câmera, e nem
          // ele nem o adversário enxergariam um ao outro. Ninguém é tirado da fila por clicar em
          // "assistir" — a escolha continua sendo dele.
          "spectate-while-queued": "Você está procurando duelo. <gray>Use <white>/practice</white> para cancelar antes de assistir.",
          "already-in-match": "Você já está em um duelo.",
          // O comando é de jogador; do console não há quem enfileirar.
          "player-required": "Este comando só pode ser usado por jogadores.",

          // ---- Travessia ----
          // O app dos duelos está fora do ar (ou em manutenção para o cargo do jogador).
          "arena-unavailable": "A arena de duelos está indisponível agora. Tente de novo em instantes.",
          // Nenhum app de spawn disponível para a volta — o jogador fica na arena até o próximo tento.
          "spawn-unavailable": "Não deu para te levar de volta ao spawn. Use <white>/spawn</white>.",

          // ---- Duelo ----
          "opponent-found": "Adversário encontrado: {opponent_name_with_tag}<gray>. Preparando o duelo…",
          "match-start": "<gradient:#FF6F00:#faa825:#FF6F00>Valendo!</gradient> <gray>Você contra </gray>{opponent_name_with_tag}<gray>.",
          "match-win": "<green>Você venceu</green><gray> o duelo contra </gray>{opponent_name_with_tag}<gray>!</gray>",
          "match-lose": "<red>Você perdeu</red><gray> o duelo para </gray>{opponent_name_with_tag}<gray>.</gray>",

          // Fim de duelo por convocação para o Fac x Fac. Duas linhas próprias, e não o
          // 'match-win'/'match-lose' genéricos: quem venceu precisa entender que o adversário NÃO
          // fugiu (o servidor o levou), e quem foi convocado precisa saber que o duelo acabou — sem
          // esta linha ele simplesmente viaja e some da arena. Mesmo motivo pelo qual 'end.admin'
          // existe em vez de reaproveitar 'end.timeout'.
          "match-win-simulator": "<green>Você venceu</green><gray> o duelo: </gray>{opponent_name_with_tag}<gray> foi convocado para uma partida Fac x Fac.</gray>",
          "match-lose-simulator": "<gray>Seu duelo contra </gray>{opponent_name_with_tag}<gray> foi encerrado: a <white>partida Fac x Fac</white> da sua facção tem prioridade. Boa sorte lá.</gray>",

          // ---- Fins sem vencedor (PracticeEndReason) ----
          // As chaves 'death' e 'quit' existem por completude: nesses casos sempre há um vencedor, e o
          // jogador lê 'match-win'/'match-lose'. Sem elas, um fim inesperado viraria chave crua na tela.
          "end": {
            "death": "O duelo contra {opponent_name_with_tag} acabou.",
            "quit": "O duelo contra {opponent_name_with_tag} acabou.",
            // Mesma completude: a eliminação total é o fim NORMAL da partida de facção (bloco 'team'),
            // e um duelo 1x1 nunca termina por ela.
            "wipeout": "O duelo contra {opponent_name_with_tag} acabou.",
            // A MESMA linha é entregue aos dois, e nem sempre quem faltou foi o adversário — nomear
            // culpado aqui acusa o inocente metade das vezes. Quem chegou lê 'queue-requeued' logo em
            // seguida, e é isso que separa um caso do outro.
            "no-show": "<gray>O duelo foi cancelado: nem todo mundo chegou à arena a tempo.",
            "timeout": "O duelo contra {opponent_name_with_tag} passou do tempo máximo e foi encerrado sem vencedor.",
            // Só por completude, como 'death' e 'quit': os dois fins pelo relógio são da partida Fac x
            // Fac (bloco 'team'), onde o tempo regulamentar tem desempate. Um duelo 1x1 nunca acaba
            // assim — mas sem as chaves, um fim inesperado viraria chave crua na tela.
            "time-alive": "O duelo contra {opponent_name_with_tag} foi encerrado no tempo.",
            "time-health": "O duelo contra {opponent_name_with_tag} foi encerrado no tempo.",
            // Encerramento pelo painel do /academy admin. Motivo próprio, e não 'timeout' reaproveitado:
            // ler "acabou o tempo" numa luta interrompida à mão é o tipo de mentira que vira ticket.
            "admin": "Um administrador encerrou o duelo contra {opponent_name_with_tag}.",
            // Só por completude: o fim por convocação SEMPRE tem vencedor (quem ficou), então o
            // jogador lê 'match-win-simulator'/'match-lose-simulator'. Sem esta chave, um fim sem
            // vencedor por este motivo viraria chave crua na tela.
            "simulator": "<gray>O duelo contra {opponent_name_with_tag} foi encerrado: uma partida Fac x Fac começou."
          },

          // ---- Partida Fac x Fac (o modo de time do practice) ----
          // A MESMA arena e o MESMO kit do 1x1; o que muda é que cada lado são os TITULARES inscritos
          // de uma facção na copa, com o banco cobrindo as vagas de quem faltou. Bloco próprio, e não as linhas do duelo com outro placeholder: ali quem é
          // citado é uma PESSOA e aqui são duas facções — reaproveitar obrigaria a inventar um
          // "adversário" que não existe numa partida de dez contra dez.
          "team": {
            "found": "<gradient:#FF6F00:#faa825:#FF6F00>Sua facção entrou em campo!</gradient> <gray>Preparando <white>[{ally_tag}]</white> contra <white>[{enemy_tag}]</white>…",
            // A CONVOCAÇÃO, contada aos dois quadros antes do primeiro golpe. Quem entra são os
            // titulares inscritos que estão no servidor da arena; cada titular que faltou abre uma vaga,
            // e as vagas são cobertas pelos reservas na ordem da escalação. Sobrando vaga sem reserva
            // para cobrir, o lado entra desfalcado e a partida acontece assim mesmo — por isso o
            // jogador precisa ler quantos faltam: ninguém escolheu este time, e estar em desvantagem
            // numérica não pode ser uma descoberta no meio da luta.
            //   ally_players     -> o elenco dele por nome, na ordem em que foi convocado
            //   ally_called      -> quantos entraram, de {ally_slots} vagas (os titulares da edição)
            //   ally_substitutes -> quantas dessas vagas o banco cobriu
            //   ally_missing     -> quantas ficaram abertas
            // O elenco inimigo sai só na contagem: em treze contra treze, os dois quadros por nome
            // seriam vinte e seis linhas de chat antes de a partida valer.
            "lineup": [
              "<gray>Sua facção <white>[{ally_tag}]</white> <gray>entra com: <white>{ally_players}",
              "<gray>Em campo: <white>{ally_called}</white><gray>/</gray><white>{ally_slots}</white> <dark_gray>▸</dark_gray> <gray>{ally_substitutes} de reserva, {ally_missing} vaga(s) sem cobrir",
              "<gray>Do outro lado, <white>[{enemy_tag}]</white> <gray>entra com <white>{enemy_called}</white> <gray>e {enemy_missing} vaga(s) sem cobrir."
            ],
            "start": "<gradient:#FF6F00:#faa825:#FF6F00>Valendo!</gradient> <white>[{ally_tag}]</white> <gray>contra</gray> <white>[{enemy_tag}]</white><gray>.</gray>",
            // Quem caiu e como ficaram os dois lados. A contagem de vivos é o que substitui a barra de
            // vida do adversário do 1x1: em partida de time, "quantos sobraram" é a medida de quem está
            // ganhando. Vai para todo mundo da partida, inclusive quem já foi eliminado.
            "member-down": "<gray>{player_name} caiu <dark_gray>▸</dark_gray> <white>[{first_tag}]</white> <gray>{first_alive}</gray> <dark_gray>x</dark_gray> <gray>{second_alive}</gray> <white>[{second_tag}]</white>",
            // Morrer não devolve ninguém ao combate: a partida do time dele continua e ele acompanha o
            // resto dela de espectador, sem ser visto por quem ainda luta.
            "eliminated": "<red>Você foi eliminado</red><gray> da partida contra </gray><white>[{enemy_tag}]</white><gray>. Assista ao resto daqui.</gray>",
            // ---- O relógio da partida ----
            // A partida de facção tem TEMPO REGULAMENTAR (practice.duracao-partida-faccao-minutos), e o
            // duelo não: o 1x1 acaba na primeira morte e o teto dele existe só contra partida esquecida.
            // Aqui o relógio é parte do jogo — ele avisa, conta os últimos segundos e DECIDE a partida
            // no estouro.
            "time": {
              // Um aviso por minuto nos cinco últimos. Sai com o placar de vivos junto porque é ele que
              // decide se o tempo acabar: saber que faltam dois minutos sem saber que o lado está um a
              // menos não muda decisão nenhuma, e provocar a decisão é para isso que o aviso existe.
              "warning": "<gold>Faltam {minutes} minuto(s)</gold><gray> de partida <dark_gray>▸</dark_gray> <white>[{first_tag}]</white> <gray>{first_alive}</gray> <dark_gray>x</dark_gray> <gray>{second_alive}</gray> <white>[{second_tag}]</white>",
              // Os dez últimos segundos, um por um. Na ACTIONBAR e não no chat: dez linhas seguidas
              // empurrariam para cima tudo o que a partida disse até aqui, no momento em que o jogador
              // precisa olhar para a arena. Prioridade 200, acima de qualquer outro HUD do Academy.
              "countdown": "<red>⏳ <white>A partida acaba em <red>{seconds}</red></white>",
              // Fim pelo relógio COM vencedor. Uma frase por critério de desempate, e não a vitória
              // genérica: o resultado vira ponto na copa, e "venceu no tempo" sem dizer como é
              // exatamente a lacuna que a staff é chamada a explicar quando alguém contesta.
              //   time-alive  -> acabou o tempo e o lado tinha MAIS GENTE VIVA
              //   time-health -> mesmo número de vivos dos dois lados; decidiu a VIDA SOMADA de quem
              //                  estava de pé
              "win": {
                "time-alive": "<green>Sua facção venceu no tempo!</green> <white>[{ally_tag}]</white> <gray>terminou a partida com mais gente viva que</gray> <white>[{enemy_tag}]</white><gray>.</gray>",
                "time-health": "<green>Sua facção venceu no tempo!</green> <gray>O tempo acabou empatado em vivos, e </gray><white>[{ally_tag}]</white> <gray>terminou com mais vida somada que</gray> <white>[{enemy_tag}]</white><gray>.</gray>"
              },
              "lose": {
                "time-alive": "<red>Sua facção perdeu no tempo.</red> <white>[{enemy_tag}]</white> <gray>terminou a partida com mais gente viva que</gray> <white>[{ally_tag}]</white><gray>.</gray>",
                "time-health": "<red>Sua facção perdeu no tempo.</red> <gray>O tempo acabou empatado em vivos, e </gray><white>[{enemy_tag}]</white> <gray>terminou com mais vida somada que</gray> <white>[{ally_tag}]</white><gray>.</gray>"
              },
              // Empate nos DOIS critérios: mesmo número de vivos e a mesma vida somada. Vai só para quem
              // abriu a partida pelo comando — quem está em campo lê 'end.timeout'. Ninguém em campo
              // pode resolver um resultado que a copa não recebeu: remarcar, lançar à mão ou deixar como
              // está é decisão de quem marcou a partida, e ele precisa saber agora, não no dia em que a
              // classificação for conferida.
              "tie": "<red>A partida <white>[{first_tag}]</white> x <white>[{second_tag}]</white> acabou o tempo EMPATADA</red><gray> em gente viva e em vida somada. Não houve vencedor e nada foi lançado na copa.</gray>"
            },
            "win": "<green>Sua facção venceu!</green> <white>[{ally_tag}]</white> <gray>eliminou</gray> <white>[{enemy_tag}]</white><gray>.</gray>",
            "lose": "<red>Sua facção perdeu.</red> <white>[{enemy_tag}]</white> <gray>eliminou o time de</gray> <white>[{ally_tag}]</white><gray>.</gray>",
            // Fins SEM vencedor. As chaves 'death', 'quit', 'wipeout', 'time-alive' e 'time-health'
            // existem por completude: nesses casos sempre há um lado vencedor, e o jogador lê
            // 'win'/'lose' (ou 'time.win'/'time.lose'). Sem elas, um fim inesperado viraria chave crua
            // na tela.
            "end": {
              "death": "A partida entre [{ally_tag}] e [{enemy_tag}] acabou.",
              "quit": "A partida entre [{ally_tag}] e [{enemy_tag}] acabou.",
              "wipeout": "A partida entre [{ally_tag}] e [{enemy_tag}] acabou.",
              "time-alive": "A partida entre [{ally_tag}] e [{enemy_tag}] acabou no tempo.",
              "time-health": "A partida entre [{ally_tag}] e [{enemy_tag}] acabou no tempo.",
              "no-show": "<gray>A partida contra <white>[{enemy_tag}]</white> foi cancelada: nem todo mundo chegou à arena a tempo.",
              // O ÚNICO fim de partida de facção sem vencedor pelo relógio: o tempo regulamentar acabou
              // com os dois lados no mesmo número de vivos E na mesma vida somada. Não é "passou do
              // tempo máximo" como no duelo — é empate nos dois critérios de desempate, e por isso não
              // há ponto na copa. Quem abriu a partida recebe 'time.tie' junto.
              "timeout": "<gray>A partida contra <white>[{enemy_tag}]</white> acabou <white>empatada</white>: mesmo número de vivos e a mesma vida somada dos dois lados. Sem vencedor.",
              "admin": "<gray>Um administrador encerrou a partida contra <white>[{enemy_tag}]</white>.",
              "simulator": "<gray>A partida contra <white>[{enemy_tag}]</white> foi encerrada: uma partida Fac x Fac de invasão começou."
            }
          },

          // ---- Regra do servidor ----
          "build-denied": "Aqui só vale PvP — a arena não pode ser modificada.",
          // Comandos de saída/teleporte enquanto o duelo corre (practice.comandos-bloqueados).
          "command-denied": "Esse comando não funciona no meio de um duelo."
        },

        // ====================================================================
        //  HUD DA BUSCA (actionbar)
        //
        //  A busca é a única atividade do Academy que o jogador faz ENQUANTO faz outra coisa: ele
        //  clica na bússola no spawn e volta a construir canhão. Sem uma linha permanente, a única
        //  prova de que a busca corre é uma mensagem de chat que já rolou para cima — e aí "a fila
        //  está parada" fica igual a "eu saí da fila sem perceber".
        //
        //  Escrito pelo PracticeQueueHudService, uma vez por segundo, em TODOS os apps. Fonte pequena
        //  como o resto dos HUDs do plugin (ver treino.hud e rescue). Prioridade 5, a mais baixa da
        //  rede: isto é estado de ambiente e cede a barra para qualquer aviso passageiro (contagem do
        //  /home, borda, clear-lag, treino), voltando sozinho quando eles terminam.
        //
        //  O relógio é mm:ss de largura FIXA porque a actionbar é centralizada — um "1m 5s" viraria
        //  "1m 10s" e empurraria a linha inteira para o lado a cada poucos segundos.
        // ====================================================================
        "hud": {
          // O estado normal da espera.
          //   time     -> há quanto tempo ele procura (mm:ss, relógio do próprio servidor)
          //   position -> lugar na fila (1 = o próximo a duelar)
          //   total    -> quantos estão procurando agora
          "queue": "<gold>⏳ <white>Procurando duelo <dark_gray>▸</dark_gray> <gray>{time}</gray> <dark_gray>▸</dark_gray> <white>{position}º</white> <gray>de {total}</gray></white>",

          // O pedido acabou de sair e a fila ainda não confirmou a posição dele. Dura um instante;
          // inventar um número aqui seria mostrar uma posição que muda no segundo seguinte.
          "queue-syncing": "<gold>⏳ <white>Procurando duelo <dark_gray>▸</dark_gray> <gray>{time}</gray> <dark_gray>▸</dark_gray> <gray>confirmando…</gray></white>",

          // O app dos duelos parou de responder (queda, restart ou deploy). O jogador CONTINUA na
          // busca — o servidor dele reafirma o pedido a cada poucos segundos e o casamento volta
          // sozinho quando a arena subir. O aviso existe para ele não desistir achando que travou.
          "queue-stalled": "<red>⏳ <white>Procurando duelo <dark_gray>▸</dark_gray> <gray>{time}</gray> <dark_gray>▸</dark_gray> <red>arena indisponível…</red></white>",

          // Par fechado, jogador ainda atravessando para a arena. Nome sem a tag do cargo de
          // propósito: a actionbar é estreita, e a versão com tag já foi ao chat em 'opponent-found'.
          "match-found": "<green>⏳ <white>Adversário encontrado <dark_gray>▸</dark_gray> <gray>{opponent_name}</gray> <dark_gray>▸</dark_gray> <gray>entrando na arena…</gray></white>",

          // O mesmo instante, na partida Fac x Fac: os dois lados são FACÇÕES, e citar uma pessoa aqui
          // diria a todo o elenco que o adversário dele é o próprio representante — o primeiro escalado
          // do outro lado. Quem é citado são as duas tags, como no resto do bloco 'team'.
          "team-match-found": "<green>⏳ <white>Partida encontrada <dark_gray>▸</dark_gray> <gray>[{ally_tag}] x [{enemy_tag}]</gray> <dark_gray>▸</dark_gray> <gray>entrando na arena…</gray></white>"
        },

        // ====================================================================
        //  PLACAR DO DUELO
        //
        //  Formato de servidor de practice: o mínimo que decide a luta, em largura fixa. O relógio é
        //  mm:ss de propósito (um "1m 5s" mudaria de largura a cada minuto e empurraria a linha).
        //  Placeholders vêm todos do PracticeScoreboard.
        // ====================================================================
        "scoreboard": {
          "title": " <gradient:#FF6F00:#faa825:#FF6F00><bold>ACADEMY PRACTICE</bold></gradient> ",
          "lines": [
            "",
            " <white>Duração: <gray>{duration}",
            "",
            " <gradient:#FF6F00:#faa825:#FF6F00>Adversário:",
            " {opponent_name_with_tag}",
            " <red>❤ <white>Vida: <gray>{opponent_health}",
            " <white>Ping dele: <gray>{opponent_ping}ms",
            "",
            " <white>Seu ping: <gray>{player_ping}ms",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00>exe.com"
          ],
          // Enquanto o adversário atravessa da fila para a arena: sem relógio e sem vida, que ainda
          // não existem. Dizer "00:00" e "0 de vida" de quem está na tela de conexão seria mentira.
          "lines-waiting": [
            "",
            " <gradient:#FF6F00:#faa825:#FF6F00>Preparando o duelo…",
            "",
            " <gradient:#FF6F00:#faa825:#FF6F00>Adversário:",
            " {opponent_name_with_tag}",
            "",
            " <white>Seu ping: <gray>{player_ping}ms",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00>exe.com"
          ]
        }
      },

      // ======================================================================
      //  COMANDOS DO PRACTICE
      //
      //  /practice sem argumento é o interruptor da busca por duelo (as frases dele estão em
      //  practice.messages). O único ramo é o de staff, abaixo.
      // ======================================================================
      "commands": {
        "practice": {
          // O admin digitou de FORA do servidor da arena: a ordem viaja por Echo e quem executa (e
          // responde, nas mesmas chaves de 'faction'/'x1' abaixo) é o app da arena. Estas duas frases
          // são as únicas que só existem nesse caminho.
          "dispatch": {
            // Não pode prometer partida: a arena ainda vai conferir elenco, fila e convocação, e a
            // recusa dela chega nesta mesma tela em seguida.
            "sent": "<gray>Pedido enviado ao servidor da arena: <white>{first}</white> x <white>{second}</white>. <dark_gray>A resposta (abertura ou recusa) chega aqui em instantes.",
            // Conferido ANTES de publicar: com o app dos duelos parado a ordem cairia no vazio e quem
            // operou ficaria esperando uma resposta que nunca vem, no meio do evento.
            "unreachable": "<red>Não foi possível falar com o servidor da arena de duelos. <gray>Confira se o app <white>practice</white> está de pé e tente de novo."
          },

          // /practice faccao <tagA> <tagB> [tipo] — põe duas facções da copa em campo, na mesma arena
          // e com o mesmo kit do 1x1. Sem fila e sem casamento automático: quem marca a hora é a copa.
          "faction": {
            "usage": [
              "<gold>Partida Fac x Fac do practice:",
              "<gray>/practice faccao <tagA> <tagB> [tipo]",
              "<dark_gray>O [tipo] é a chave do evento da copa; só é preciso quando a edição tem mais de um."
            ],
            // O relato da convocação para quem operou. Sai por extenso porque o comando não escolhe
            // ninguém: sem os números, uma partida que abriu 13 x 8 parece igual a uma que abriu cheia.
            "success": [
              "<green>Partida aberta na arena de duelos.",
              "<white>[{first_tag}]</white> <dark_gray>▸</dark_gray> <gray>{first_called}/{first_slots} em campo, {first_substitutes} de reserva, {first_missing} vaga(s) sem cobrir",
              "<white>[{second_tag}]</white> <dark_gray>▸</dark_gray> <gray>{second_called}/{second_slots} em campo, {second_substitutes} de reserva, {second_missing} vaga(s) sem cobrir"
            ],
            "errors": {
              // A arena mora num app só; abrir de outro não teria onde pôr os dois times.
              "not-host": "<red>A partida só pode ser aberta no servidor da arena de duelos.",
              "arena-unavailable": "<red>O mundo da arena não está carregado neste servidor.",
              // Sem o plugin de facções não há copa, e é dela que sai o elenco de cada lado.
              "tournament-unavailable": "<red>A copa não está disponível neste servidor.",
              "no-edition": "<red>Não há nenhuma copa no ar (ou o painel não respondeu). Tente de novo em instantes.",
              "team-not-found": "<red>Nenhuma facção inscrita com a tag <yellow>{detail}</yellow>.",
              "team-not-approved": "<red>A inscrição de <yellow>{detail}</yellow> ainda não foi aprovada na copa.",
              "same-team": "<red>As duas tags são a mesma facção.",
              // Adivinhar o tipo contaminaria a classificação com um evento que ninguém disputou.
              "type-required": "<red>Esta copa tem mais de um tipo de evento. <gray>Escolha um: <white>{detail}",
              "unknown-type": "<red>Tipo de evento desconhecido. <gray>Os desta copa: <white>{detail}",
              "no-roster": "<red>A inscrição de <yellow>{detail}</yellow> não tem ninguém escalado.",
              // Elenco inscrito existe, mas nem titular nem reserva dele pôde entrar: ninguém está
              // conectado no servidor da arena, todos já estão em outra partida, ou foram convocados
              // para um Fac x Fac de invasão. Um lado vazio não é partida.
              "nobody-online": "<red>Ninguém do elenco de <yellow>{detail}</yellow> pôde entrar em campo no servidor da arena."
            }
          },

          // /practice x1 <jogadorA> <jogadorB> [tipo] — o X1 do Presidente da copa: dois jogadores
          // escolhidos a dedo pela staff, na mesma arena e com o mesmo kit do 1x1 da fila.
          "x1": {
            "usage": [
              "<gold>X1 dirigido do practice:",
              "<gray>/practice x1 <jogadorA> <jogadorB> [tipo]",
              "<dark_gray>Os dois precisam estar no servidor da arena. O [tipo] é a chave do evento da copa; o padrão é o do X1."
            ],
            "success": [
              "<green>Duelo aberto na arena de duelos.",
              "<white>{first_name}</white> <dark_gray>▸</dark_gray> <gray>x</gray> <dark_gray>◂</dark_gray> <white>{second_name}"
            ],
            // O duelo ABRIU, mas não vai virar ponto. Decisão do dono: travar o admin no meio do
            // evento seria pior que um X1 sem ponto — o lançamento à mão continua existindo.
            "friendly": {
              "tournament-unavailable": "<yellow>Atenção: a copa não está disponível neste servidor. <gray>Este duelo <white>não</white> vai pontuar.",
              "no-edition": "<yellow>Atenção: não há nenhuma copa no ar (ou o painel não respondeu). <gray>Este duelo <white>não</white> vai pontuar.",
              "not-registered": "<yellow>Atenção: <white>{detail}</white> não está inscrito em nenhuma facção da copa. <gray>Este duelo <white>não</white> vai pontuar.",
              "not-approved": "<yellow>Atenção: a inscrição de <white>{detail}</white> ainda não foi aprovada na copa. <gray>Este duelo <white>não</white> vai pontuar.",
              "same-team": "<yellow>Atenção: os dois jogam por <white>{detail}</white>. <gray>É treino entre companheiros — este duelo <white>não</white> vai pontuar.",
              "unknown-type": "<yellow>Atenção: esta copa não tem esse tipo de evento. <gray>Os desta copa: <white>{detail}</white>. Este duelo <white>não</white> vai pontuar."
            },
            "errors": {
              // A arena mora num app só; abrir de outro não teria onde pôr os dois.
              "not-host": "<red>O duelo só pode ser aberto no servidor da arena de duelos.",
              "arena-unavailable": "<red>O mundo da arena não está carregado neste servidor.",
              // Sem busca na rede de propósito: quem está em outro servidor não pode ser posto nesta arena.
              "player-not-found": "<red>Não há ninguém chamado <yellow>{detail}</yellow> no servidor da arena.",
              "same-player": "<red>Os dois nicks são a mesma pessoa.",
              "already-in-match": "<red><yellow>{detail}</yellow> já está em uma partida.",
              // O casamento da fila o levaria para um segundo duelo no meio deste.
              "in-queue": "<red><yellow>{detail}</yellow> está na fila esperando adversário. <gray>Peça para sair da fila (<white>/practice</white>) e tente de novo.",
              "busy-simulator": "<red><yellow>{detail}</yellow> foi convocado para um Fac x Fac de invasão."
            }
          }
        }
      }
    }
  }
}
