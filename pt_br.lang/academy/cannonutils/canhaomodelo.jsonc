{
  "plugins": {
    "cannonutils": {
      "commands": {
        // /canhaomodelo — peças de exibição: modelo animado do BetterModel colocado no mundo, que roda
        // a animação no clique direito. Comando de staff (permissoes.cannonutils.SHOW_MODEL).
        "canhaomodelo": {
          "usage": [
            "",
            "<red>Peças de exibição:</red>",
            " <dark_gray>▸</dark_gray> <white>/canhaomodelo colocar [modelo]</white> <gray>- coloca uma peça onde você está</gray>",
            " <dark_gray>▸</dark_gray> <white>/canhaomodelo remover</white> <gray>- remove a peça mais próxima</gray>",
            " <dark_gray>▸</dark_gray> <white>/canhaomodelo listar</white> <gray>- conta as peças deste servidor</gray>",
            ""
          ],
          "placed": "<green>Peça colocada com o modelo <yellow>{model}</yellow>. Clique com o botão direito para rodar a animação.</green>",
          "removed": "<green>Peça <yellow>{model}</yellow> removida.</green>",
          // Nenhuma peça perto — o raio é fixo no comando (6 blocos).
          "none-near": "<red>Nenhuma peça de exibição num raio de <yellow>{radius}</yellow> blocos.</red>",
          // O .bbmodel não está na pasta do BetterModel (ou o nome está errado).
          "model-not-found": "<red>O modelo <yellow>{model}</yellow> não existe no BetterModel deste servidor.</red>",
          "list": "<green>Peças de exibição neste servidor: <yellow>{total}</yellow>.</green>"
        }
      }
    }
  }
}
