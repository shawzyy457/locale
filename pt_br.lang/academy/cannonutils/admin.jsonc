{
  "plugins": {
    "cannonutils": {
      // ======================================================================
      //  PAINEL DO ACADEMY — /academy admin
      //
      //  Substitui o /f admin (removido em 10/08/2026), que espalhava o controle da staff dentro do
      //  comando do JOGADOR de facções: o Fac x Fac tinha duas telas escondidas em subcomandos e o PvP
      //  Practice não tinha nenhuma. Aqui as três seções ficam lado a lado.
      //
      //  Estilo: fonte pequena em nome e lore de item, título sem fonte (padrão medido no factions).
      //  Verde = ação segura, vermelho = destrutiva, amarelo = atenção/incompleto.
      // ======================================================================
      "commands": {
        "academy": {
          "errors": {
            "unknown-action": "Ação desconhecida: <white>{action}</white>. Use <white>/academy</white> para abrir o painel.",
            "faction-not-found": "Nenhuma facção com a tag <white>{tag}</white>.",
            "player-not-found": "Nenhum jogador chamado <white>{jogador}</white>.",
            "factions-unavailable": "O plugin de facções não está neste servidor."
          },
          "bypass": {
            "enabled": "Modo administrador <green>ativado</green>. <gray>Você ignora a proteção de território até sair.",
            "disabled": "Modo administrador <red>desativado</red>."
          },
          // /academy monitor [sair] — controles de quem monitora uma partida. Existem como comando
          // porque em ESPECTADOR o cliente não envia clique de item: a barra só responde no criativo.
          "monitor": {
            "not-monitoring": "Você não está monitorando partida nenhuma. <gray>Abra a ficha da partida no painel e clique em <white>Monitorar</white>."
          },
          "disband": {
            "success": "A facção {faccao} <gray>foi desfeita."
          },
          "cancel-invasion": {
            "none": "{faccao} <gray>não está invadindo ninguém.",
            "success": "A invasão de {faccao} <gray>foi encerrada sem vencedor.",
            // O território é destravado aqui, mas o fim da PARTIDA sai no app que a hospeda — e lá a
            // mensagem será a de encerramento por tempo. Sem este aviso, a staff acha que é bug.
            "arena-elsewhere": "A partida de {faccao} <gray>roda em outro servidor: o território foi destravado aqui e o encerramento sai por lá."
          },
          // /academy convocar <nick> <tag> — põe um jogador na partida em curso da facção, FORA da cota
          // de convocações e do teto de quadro (é ferramenta de consertar partida). O resultado em si não
          // vem daqui: a convocação é assíncrona e responde pela lang do /f convocar
          // (plugins.factions.results.simulator-roster), a mesma do líder — os motivos de recusa são os
          // mesmos, e duas redações da mesma verdade só confundiriam a staff.
          "call-up": {
            "dispatched": "Convocando <white>{jogador}</white> <gray>para a partida de {faccao}<gray>...",
            "no-match": "{faccao} <gray>não está em partida nenhuma."
          }
        }
      },

      "views": {
        // ------------------------------------------------------------------
        //  Painel raiz
        // ------------------------------------------------------------------
        "admin": {
          "title": "Academy — Administração",
          "state": {
            "on": "<green>ativado</green>",
            "off": "<red>desativado</red>"
          },
          "messages": {
            "bypass-enabled": "Modo administrador <green>ativado</green>. <gray>Você ignora a proteção de território até sair.",
            "bypass-disabled": "Modo administrador <red>desativado</red>."
          },
          "items": {
            "facxfac": {
              "name": "<red>Fac x Fac</red>",
              "lore": [
                "<gray>Partidas, kits, arenas e abertura</gray>",
                "<gray>de partida entre duas facções.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "practice": {
              "name": "<gold>PvP Practice</gold>",
              "lore": [
                "<gray>Duelos em andamento, fila de espera</gray>",
                "<gray>e a configuração da arena.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "faccoes": {
              "name": "<white>Facções</white>",
              "lore": [
                "<gray>Todas as facções do servidor:</gray>",
                "<gray>desfazer e cancelar invasão.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "modo-admin": {
              "name": "<white>Modo administrador:</white> {modo_admin}",
              "lore": [
                "<gray>Ignora a proteção de território de</gray>",
                "<gray>qualquer facção — construir, quebrar</gray>",
                "<gray>e abrir baú dentro de claim alheio.</gray>",
                "",
                "<dark_gray>▸</dark_gray> <gray>Vale só para você e <white>morre ao sair</white>.</gray>",
                "",
                "<yellow>Clique para alternar</yellow>"
              ]
            },
            "fechar": {
              "name": "<red>Fechar</red>",
              "lore": [ "<gray>Fecha o painel.</gray>" ]
            }
          }
        },

        // ------------------------------------------------------------------
        //  Seção Fac x Fac
        // ------------------------------------------------------------------
        "admin-facxfac": {
          "title": "Administração — Fac x Fac",
          "app": {
            "host": "<green>este servidor hospeda as partidas</green>",
            "remote": "<yellow>as partidas rodam em outro servidor</yellow>"
          },
          "messages": {
            "unavailable": "O Fac x Fac ainda não subiu neste servidor."
          },
          "items": {
            "partidas": {
              "name": "<red>Partidas</red> <dark_gray>({em_andamento} em andamento)</dark_gray>",
              "lore": [
                "<gray>Todas as partidas conhecidas, inclusive</gray>",
                "<gray>as que acabaram de encerrar.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Em andamento:</white> <gray>{em_andamento}</gray>",
                " <dark_gray>▸</dark_gray> <white>No total:</white> <gray>{partidas_total}</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "kits": {
              "name": "<gold>Equipamentos</gold>",
              "lore": [
                "<gray>O catálogo de kits das partidas:</gray>",
                "<gray>criar, editar e remover.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "arenas": {
              "name": "<white>Arenas</white> <dark_gray>({arenas})</dark_gray>",
              "lore": [
                "<gray>Os moldes de base e o que está</gray>",
                "<gray>marcado em cada um.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "abrir": {
              "name": "<green>Abrir partida</green>",
              "lore": [
                "<gray>Monta uma partida entre duas facções</gray>",
                "<gray>sem desafio nem aceite.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <gray>{app}</gray>",
                "",
                "<yellow>Clique para escolher os lados</yellow>"
              ]
            }
          }
        },

        // ------------------------------------------------------------------
        //  Arenas
        // ------------------------------------------------------------------
        "admin-arenas": {
          "title": "Arenas do Fac x Fac ({prontas}/{total})",
          "states": {
            "ready": "<green>pronta</green>",
            "incomplete": "<yellow>falta marcação</yellow>",
            "disabled": "<red>desligada</red>"
          },
          "border": {
            "none": "<red>não gerenciada</red>",
            "set": "<white>{tamanho}</white> <gray>blocos</gray>"
          },
          "items": {
            "arena": {
              "name": "<white>{arena}</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {estado}",
                " <dark_gray>▸</dark_gray> <white>Borda:</white> {borda}",
                "",
                "<yellow>Clique para ver a marcação</yellow>"
              ]
            },
            "vazio": {
              "name": "<red>Nenhuma arena</red>",
              "lore": [
                "<gray>Declare os mundos-molde em</gray>",
                "<white>simulator.arenas</white> <gray>no config.yml.</gray>"
              ]
            }
          }
        },

        "admin-arena": {
          "title": "Arena: {arena}",
          "mark": {
            "set": "<green>marcado</green>",
            "none": "<red>falta marcar</red>",
            "point": "<white>{x}, {y}, {z}</white>"
          },
          "border": {
            "none": "<red>não gerenciada</red>",
            "set": "<white>{centro_x}, {centro_z}</white> <gray>· {tamanho} blocos</gray>"
          },
          "states": {
            "enabled": "<green>ligada</green>",
            "disabled": "<red>desligada</red>"
          },
          "messages": {
            "defender-saved": "Entrada da <white>defesa</white> gravada na sua posição.",
            "attacker-saved": "Entrada do <white>ataque</white> gravada na sua posição.",
            "border-saved": "Borda atual do mundo gravada na arena.",
            "default-border": "Este mundo está com a borda padrão — desenhe uma antes de gravar.",
            "enabled": "Arena <white>{arena}</white> <green>ligada</green>.",
            "disabled": "Arena <white>{arena}</white> <red>desligada</red>.",
            "world-unavailable": "O mundo <white>{arena}</white> não está carregado neste servidor."
          },
          "items": {
            "resumo": {
              "name": "<white>{arena}</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {estado}",
                " <dark_gray>▸</dark_gray> <white>Zona da base:</white> {base}",
                " <dark_gray>▸</dark_gray> <white>Cubículo:</white> {cubiculo}",
                " <dark_gray>▸</dark_gray> <white>Borda:</white> {borda}",
                "",
                "<gray>Zona e cubículo são regiões de dois</gray>",
                "<gray>cantos: marque com</gray> <white>/simarena</white><gray>.</gray>"
              ]
            },
            "entrada-defesa": {
              "name": "<blue>Entrada da defesa</blue>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Agora:</white> {entrada_defesa}",
                "",
                "<gray>Também é o ponto de nascimento do</gray>",
                "<gray>mundo-molde.</gray>",
                "",
                "<yellow>Clique para gravar onde você está</yellow>"
              ]
            },
            "entrada-ataque": {
              "name": "<red>Entrada do ataque</red>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Agora:</white> {entrada_ataque}",
                "",
                "<gray>Vale como ponto fixo; cada partida</gray>",
                "<gray>ainda sorteia a entrada real.</gray>",
                "",
                "<yellow>Clique para gravar onde você está</yellow>"
              ]
            },
            "borda": {
              "name": "<white>Borda</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Gravada:</white> {borda}",
                "",
                "<gray>Grava a borda ATUAL do mundo, para</gray>",
                "<gray>ela sobreviver ao restart.</gray>",
                "",
                "<yellow>Clique para gravar</yellow>"
              ]
            },
            "estado": {
              "name": "<white>Arena:</white> {estado}",
              "lore": [
                "<gray>Arena desligada não entra no sorteio</gray>",
                "<gray>de novas partidas.</gray>",
                "",
                "<yellow>Clique para alternar</yellow>"
              ]
            },
            "ir": {
              "name": "<gold>Ir até a arena</gold>",
              "lore": [
                "<gray>Teleporta você para o molde.</gray>",
                "",
                "<yellow>Clique para ir</yellow>"
              ]
            }
          }
        },

        // ------------------------------------------------------------------
        //  Abrir partida
        // ------------------------------------------------------------------
        "admin-open-match": {
          "title": "Abrir partida",
          "none": "<red>escolher</red>",
          "styles": {
            "traditional": "<white>Tradicional</white>",
            "square": "<white>Quadrada</white>",
            "star": "<white>Estrela</white>"
          },
          "messages": {
            "opening": "Montando a partida: {atacante} <gray>(ataque) contra</gray> {defensor} <gray>(defesa).",
            "refused": "Não deu para abrir: uma das facções já está em partida ou invasão."
          },
          "items": {
            "atacante": {
              "name": "<red>Ataque:</red> {atacante}",
              "lore": [
                "<gray>Quem invade a base.</gray>",
                "",
                "<yellow>Clique para escolher</yellow>"
              ]
            },
            "defensor": {
              "name": "<blue>Defesa:</blue> {defensor}",
              "lore": [
                "<gray>Quem recebe a invasão.</gray>",
                "",
                "<yellow>Clique para escolher</yellow>"
              ]
            },
            "estilo": {
              "name": "<white>Estilo da base:</white> {estilo}",
              "lore": [
                "<gray>Decide qual molde de arena a</gray>",
                "<gray>partida vai copiar.</gray>",
                "",
                "<yellow>Clique para trocar</yellow>"
              ]
            },
            "confirmar": {
              "name": "<green>Abrir a partida</green>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Ataque:</white> {atacante}",
                " <dark_gray>▸</dark_gray> <white>Defesa:</white> {defensor}",
                " <dark_gray>▸</dark_gray> <white>Base:</white> {estilo}",
                "",
                "<gray>As demais regras são as padrão do</gray>",
                "<gray>menu de desafio.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            }
          }
        },

        "admin-faction-picker": {
          "title": "Escolher {lado}",
          "sides": {
            "attacker": "o ataque",
            "defender": "a defesa"
          },
          "states": {
            "free": "<green>livre</green>",
            "busy": "<red>em partida ou invasão</red>",
            "taken": "<yellow>já é o outro lado</yellow>"
          },
          "items": {
            "faccao": {
              "name": "{faccao}",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Tag:</white> <gray>{tag}</gray>",
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {estado}",
                "",
                "<yellow>Clique para escolher</yellow>"
              ],
              "blocked-lore": [
                " <dark_gray>▸</dark_gray> <white>Tag:</white> <gray>{tag}</gray>",
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {estado}",
                "",
                "<red>Não pode entrar nesta partida.</red>"
              ]
            }
          }
        },

        // ------------------------------------------------------------------
        //  Seção PvP Practice
        // ------------------------------------------------------------------
        "admin-practice": {
          "title": "Administração — PvP Practice",
          "app": {
            "host": "<green>este servidor é a arena</green>",
            "remote": "<yellow>a arena fica em outro servidor</yellow>"
          },
          "items": {
            "duelos": {
              "name": "<gold>Duelos</gold> <dark_gray>({duelos} em andamento)</dark_gray>",
              "lore": [
                "<gray>Quem está lutando agora, com vida e</gray>",
                "<gray>ping — e como encerrar.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Em andamento:</white> <gray>{duelos}</gray>",
                " <dark_gray>▸</dark_gray> <white>No total:</white> <gray>{duelos_total}</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "fila": {
              "name": "<white>Fila</white> <dark_gray>({fila} esperando)</dark_gray>",
              "lore": [
                "<gray>Quem está procurando adversário,</gray>",
                "<gray>na ordem de espera.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <gray>{app}</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            },
            "arena": {
              "name": "<white>Arena e kit</white>",
              "lore": [
                "<gray>Mundo, entradas, kit, efeitos e</gray>",
                "<gray>prazos do duelo.</gray>",
                "",
                "<yellow>Clique para abrir</yellow>"
              ]
            }
          }
        },

        "admin-duels": {
          "title": "Duelos ({em_andamento}/{total})",
          "items": {
            "duelo": {
              "name": "<white>{primeiro}</white> <dark_gray>x</dark_gray> <white>{segundo}</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Duração:</white> <gray>{duracao}</gray>",
                "",
                "<yellow>Clique para ver a ficha</yellow>"
              ],
              "finished-lore": [
                " <dark_gray>▸</dark_gray> <white>Duração:</white> <gray>{duracao}</gray>",
                " <dark_gray>▸</dark_gray> <red>Encerrado</red>",
                "",
                "<yellow>Clique para ver a ficha</yellow>"
              ]
            },
            "vazio": {
              "name": "<red>Nenhum duelo</red>",
              "lore": [ "<gray>Ninguém está duelando agora.</gray>" ]
            }
          }
        },

        "admin-duel": {
          "title": "{primeiro} x {segundo}",
          "unknown": "<dark_gray>—</dark_gray>",
          "states": {
            "waiting": "<yellow>esperando os dois chegarem</yellow>",
            "running": "<green>em luta</green>",
            "finished": "<red>encerrado</red>"
          },
          "messages": {
            "finished": "Duelo encerrado. Vitória de {jogador_name_with_tag}<gray>.</gray>",
            "finished-no-winner": "Duelo encerrado sem vencedor.",
            "already-finished": "Este duelo já tinha acabado.",
            "arena-unavailable": "A arena não está carregada neste servidor.",
            "connecting": "Levando você para o servidor dos duelos…"
          },
          "items": {
            "jogador": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Adversário:</white> {adversario_name_with_tag}",
                " <dark_gray>▸</dark_gray> <red>❤</red> <white>Vida:</white> <gray>{vida}</gray>",
                " <dark_gray>▸</dark_gray> <white>Ping:</white> <gray>{ping}</gray>",
                "",
                "<gray>Vida e ping só aparecem para quem</gray>",
                "<gray>está NESTE servidor.</gray>"
              ]
            },
            "vencedor-primeiro": {
              "name": "<green>Vitória de {primeiro}</green>",
              "lore": [
                "<gray>Encerra o duelo entregando a vitória.</gray>",
                "",
                "<yellow>Clique para encerrar</yellow>"
              ]
            },
            "vencedor-segundo": {
              "name": "<green>Vitória de {segundo}</green>",
              "lore": [
                "<gray>Encerra o duelo entregando a vitória.</gray>",
                "",
                "<yellow>Clique para encerrar</yellow>"
              ]
            },
            "sem-vencedor": {
              "name": "<red>Encerrar sem vencedor</red>",
              "lore": [
                "<gray>Interrompe a luta. Ninguém ganha,</gray>",
                "<gray>e os dois voltam ao spawn.</gray>",
                "",
                "<yellow>Clique para encerrar</yellow>"
              ]
            },
            "ir": {
              "name": "<gold>Ir até a arena</gold>",
              "lore": [
                "<gray>Leva você até a luta. Os duelistas</gray>",
                "<gray>não enxergam a staff.</gray>",
                "",
                "<yellow>Clique para ir</yellow>"
              ]
            }
          }
        },

        "admin-queue": {
          "title": "Fila do Practice ({total})",
          "messages": {
            "removed": "{jogador_name_with_tag} <gray>foi tirado da fila.</gray>"
          },
          "items": {
            "jogador": {
              "name": "{jogador_name_with_tag}",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Esperando há:</white> <gray>{espera}</gray>",
                "",
                "<yellow>Clique para tirar da fila</yellow>"
              ]
            },
            "vazio": {
              "name": "<red>Fila vazia</red>",
              "lore": [ "<gray>Ninguém está esperando adversário.</gray>" ]
            },
            // Fora do app dos duelos, uma lista vazia tem dois significados. Este item é o segundo.
            "desconhecida": {
              "name": "<yellow>Fila indisponível aqui</yellow>",
              "lore": [
                "<gray>A fila vive no servidor dos duelos e</gray>",
                "<gray>ainda não chegou nenhum retrato dela.</gray>",
                "",
                "<gray>Ele é publicado a cada mudança —</gray>",
                "<gray>reabra em instantes.</gray>"
              ]
            }
          }
        },

        "admin-practice-setup": {
          "title": "Practice — arena e kit",
          "messages": {
            "reloaded": "Configurações recarregadas. <gray>A seção <white>practice</white> só passa a valer no próximo restart do app.",
            "reload-failed": "Alguma etapa da recarga falhou — veja o console."
          },
          "items": {
            "arena": {
              "name": "<white>Arena</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Mundo:</white> <gray>{mundo}</gray>",
                " <dark_gray>▸</dark_gray> <white>Entrada A:</white> <gray>{entrada_a}</gray>",
                " <dark_gray>▸</dark_gray> <white>Entrada B:</white> <gray>{entrada_b}</gray>",
                "",
                "<gray>Todos os duelos acontecem nestas duas</gray>",
                "<gray>coordenadas, separados por pacote.</gray>"
              ]
            },
            "kit": {
              "name": "<white>Kit e efeitos</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Itens do kit:</white> <gray>{kit}</gray>",
                " <dark_gray>▸</dark_gray> <white>Velocidade:</white> <gray>{velocidade}</gray>",
                " <dark_gray>▸</dark_gray> <white>Força:</white> <gray>{forca}</gray>",
                "",
                "<gray>Nível 0 desliga o efeito.</gray>"
              ]
            },
            "prazos": {
              "name": "<white>Prazos</white>",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Chegada:</white> <gray>{chegada}s</gray>",
                " <dark_gray>▸</dark_gray> <white>Duração máxima:</white> <gray>{duracao} min</gray>",
                " <dark_gray>▸</dark_gray> <white>Pausa no fim:</white> <gray>{fim}s</gray>",
                "",
                "<gray>Duração 0 = sem teto.</gray>"
              ]
            },
            "recarregar": {
              "name": "<gold>Recarregar configurações</gold>",
              "lore": [
                "<gray>Relê o config.yml do cannon-utils e</gray>",
                "<gray>as settings do cannon-plugin.</gray>",
                "",
                "<yellow>⚠</yellow> <gray>A seção <white>practice</white> desta tela só</gray>",
                "<gray>muda no <white>restart</white> do app.</gray>",
                "",
                "<yellow>Clique para recarregar</yellow>"
              ]
            }
          }
        },

        // ------------------------------------------------------------------
        //  Seção Facções
        // ------------------------------------------------------------------
        "admin-factions": {
          "title": "Facções ({total})",
          "states": {
            "free": "<green>livre</green>",
            "busy": "<red>em partida ou invasão</red>"
          },
          "items": {
            "faccao": {
              "name": "{faccao}",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Tag:</white> <gray>{tag}</gray>",
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {estado}",
                "",
                "<yellow>Clique para abrir a ficha</yellow>"
              ]
            },
            "vazio": {
              "name": "<red>Nenhuma facção</red>",
              "lore": [ "<gray>Ninguém criou facção ainda.</gray>" ]
            }
          }
        },

        "admin-faction": {
          "title": "Facção: {tag}",
          "states": {
            "free": "<green>sem invasão</green>",
            "invading": "<red>invadindo agora</red>"
          },
          "items": {
            "faccao": {
              "name": "{faccao}",
              "lore": [
                " <dark_gray>▸</dark_gray> <white>Tag:</white> <gray>{tag}</gray>",
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {estado}"
              ]
            },
            "desfazer": {
              "name": "<red>Desfazer facção</red>",
              "lore": [
                "<gray>Apaga a facção, o território e os</gray>",
                "<gray>vínculos dos membros.</gray>",
                "",
                "<red>Não tem volta.</red>",
                "",
                "<yellow>Clique para confirmar</yellow>"
              ]
            },
            "cancelar-invasao": {
              "name": "<gold>Cancelar invasão</gold>",
              "lore": [
                "<gray>Encerra a invasão em andamento sem</gray>",
                "<gray>vencedor e destrava o território.</gray>",
                "",
                "<yellow>Clique para confirmar</yellow>"
              ]
            }
          }
        },

        // Confirmação das duas ações destrutivas. Sem "title": a tela padrão do core já se chama
        // "Confirmação", e é o item central que diz o que está sendo confirmado.
        "admin-faction-confirm": {
          "messages": {
            "disbanded": "A facção {faccao} <gray>foi desfeita.",
            "invasion-cancelled": "A invasão de {faccao} <gray>foi encerrada sem vencedor.",
            "arena-elsewhere": "A partida de {faccao} <gray>roda em outro servidor: o território foi destravado aqui e o encerramento sai por lá.",
            "no-invasion": "{faccao} <gray>não está invadindo ninguém.",
            "unavailable": "O plugin de facções não está neste servidor."
          },
          "desfazer": {
            "items": {
              "assunto": {
                "name": "<red>Desfazer {faccao}</red>",
                "lore": [
                  "<gray>A facção, o território e os vínculos</gray>",
                  "<gray>dos membros somem.</gray>",
                  "",
                  " <dark_gray>▸</dark_gray> <white>Tag:</white> <gray>{tag}</gray>",
                  "",
                  "<red>Não tem volta.</red>"
                ]
              }
            }
          },
          "cancelar-invasao": {
            "items": {
              "assunto": {
                "name": "<gold>Cancelar a invasão de {faccao}</gold>",
                "lore": [
                  "<gray>A invasão acaba sem vencedor e o</gray>",
                  "<gray>território é destravado.</gray>",
                  "",
                  " <dark_gray>▸</dark_gray> <white>Tag:</white> <gray>{tag}</gray>",
                  "",
                  "<gray>Se for partida de arena, ela é</gray>",
                  "<gray>encerrada com a limpeza completa.</gray>"
                ]
              }
            }
          }
        }
      }
    }
  }
}
