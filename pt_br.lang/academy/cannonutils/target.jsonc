{
  "plugins": {
    "cannonutils": {
      "commands": {
        // /target [jogador] — modo alvo da moderação. Sem argumento (ou repetindo o mesmo jogador),
        // desliga.
        "target": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador a observar. Sem nome, o modo alvo é desligado."
            }
          }
        }
      },
      // ======================================================================
      //  MODO ALVO (/target) — a tela de quem observa passa a ter apenas o investigado, e quem ele
      //  acerta aparece por um instante (`target.duracao-destaque-ticks` do config.yml, 1 segundo).
      //
      //  Placeholders disponíveis em todas as chaves: {target_name}, {target_name_with_color} e
      //  {target_name_with_tag}.
      // ======================================================================
      "target": {
        "messages": {
          // O texto explica as DUAS metades do modo, porque a segunda é o que se está indo ver: o
          // campo vazio é só o meio para enxergar em quem o golpe cai.
          "activated": [
            "<green>Modo alvo ligado em {target_name_with_tag}<green>.</green>",
            "<gray>Só ele aparece na sua tela — quem ele acertar surge por um instante.</gray>"
          ],
          "switched": "<green>Modo alvo agora em {target_name_with_tag}<green>.</green>",
          "deactivated": "<green>Modo alvo desligado. Você voltou a enxergar o servidor inteiro.</green>",
          "not-active": "<red>Você não está observando ninguém. Use <white>/target <jogador><red>.</red>",
          // Esconder e mostrar jogador é pacote, e pacote não atravessa app: o alvo tem de estar no
          // mesmo servidor de quem observa.
          "target-not-here": "<red>{target_name} não está neste servidor — entre no servidor dele para observá-lo.</red>",
          "target-left": "<yellow>{target_name_with_tag}<yellow> saiu do servidor: modo alvo desligado.</yellow>"
        }
      }
    }
  }
}
