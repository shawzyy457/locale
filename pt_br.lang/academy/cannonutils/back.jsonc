{
  "plugins": {
    "cannonutils": {
      "commands": {
        // /back (/voltar) — volta à última localização guardada (morte, troca de servidor, teleporte).
        "back": {
          "errors": {
            "need-location": "<red>Você não possui um local para voltar.</red>",
            // O plot deixou de ser acessível (resetado, ou você foi banido/negado nele).
            "no-access": "<red>Você não possui mais acesso ao local anterior.</red>",
            "unavailable": "<red>O destino não está disponível no momento.</red>"
          },
          "success": "<green>Você voltou para o último local em que estava.</green>",
          "connecting": "<yellow>Levando você de volta ao seu plot...</yellow>"
        }
      }
    }
  }
}
