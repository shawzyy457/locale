{
  "plugins": {
    "cannonutils": {
      "commands": {
        // /home [nome] | /home <jogador>:<home> | /home <jogador> <home>
        "home": {
          "arguments": {
            "name": {
              "name": "nome",
              "description": "Home para onde você quer ir (ou jogador:home)."
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>",
            "not-public": "<red>Esta home não é pública.</red>",
            "cooldown": "<red>Aguarde antes de teleportar novamente.</red>",
            "teleport-pending": "<red>Você já possui um teleporte em andamento.</red>",
            // O plot da home foi resetado, ou você foi banido/negado nele.
            "no-access": "<red>Você não possui acesso ao plot desta home.</red>",
            "unavailable": "<red>O destino não está disponível no momento.</red>"
          },
          "success": "<green>Você foi teleportado para a home <yellow>{home_name}</yellow>.</green>",
          "connecting": "<yellow>Levando você até a home <white>{home_name}</white>...</yellow>",
          "on-teleport-countdown": "<yellow>Teleportando em <white>{home_seconds}s</white>...</yellow>"
        },
        // /homes [jogador]
        "homes": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador cujas homes públicas você quer ver."
            }
          },
          "errors": {
            "no-homes": "<red>O jogador {target_name_with_tag} <red>não possui nenhuma home visível.</red>"
          },
          "list": "<green>Homes de {target_name_with_tag}<green>:</green> <gray>{homes}</gray>"
        },
        // /sethome <nome> (/definirhome)
        "sethome": {
          "arguments": {
            "name": {
              "name": "nome",
              "description": "Nome da home que será criada aqui."
            }
          },
          "errors": {
            "name-too-long": "<red>O nome da home deve ter no máximo <yellow>{home_max_length}</yellow> caracteres.</red>",
            "invalid-characters": "<red>O nome da home contém caracteres inválidos.</red>",
            "already-exists": "<red>Você já possui uma home com o nome <yellow>{home_name}</yellow>.</red>",
            "limit-reached": "<red>Você atingiu o limite de <yellow>{home_limit}</yellow> homes.</red>",
            // Só dentro de um plot onde o jogador pode construir.
            "outside-plot": "<red>Você só pode definir home dentro de um plot em que possa construir.</red>",
            // Dentro da partida a home pode ficar em qualquer lugar, menos no claim do time adversário.
            "enemy-claim": "<red>Você não pode definir home no território do time adversário.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> criada com sucesso!</green>",
          // Home criada DENTRO de uma partida do Fac x Fac: ela some quando a partida acaba, e as homes
          // de sempre voltam sozinhas.
          "success-match": "<green>Home <yellow>{home_name}</yellow> criada — ela vale até o fim desta partida.</green>"
        },
        // /delhome <home> (/deletarhome)
        "delhome": {
          "arguments": {
            "home": {
              "name": "home",
              "description": "Home que será apagada."
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> deletada com sucesso!</green>"
        },
        // /homepublica <home>
        "homepublica": {
          "arguments": {
            "home": {
              "name": "home",
              "description": "Home que ficará pública."
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>",
            "already": "<red>A home <yellow>{home_name}</yellow> já é pública.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> agora é pública!</green>"
        },
        // /homeprivada <home>
        "homeprivada": {
          "arguments": {
            "home": {
              "name": "home",
              "description": "Home que voltará a ser privada."
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>",
            "already": "<red>A home <yellow>{home_name}</yellow> já é privada.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> agora é privada!</green>"
        }
      },
      "messages": {
        "home": {
          // Actionbar: a espera do teleporte foi abortada. HUD leva a fonte pequena.
          "teleport-cancelled-move": "<red>⚠ <white>Teleporte cancelado! Você se moveu.</white>",
          "teleport-cancelled-damage": "<red>⚠ <white>Teleporte cancelado! Você tomou dano.</white>",
          // Retorno das ações do menu de detalhe.
          "views": {
            "icon-updated": "<green>Ícone da home <yellow>{home_name}</yellow> atualizado!</green>",
            "position-moved": "<green>Home <yellow>{home_name}</yellow> movida para a posição <yellow>{home_position}</yellow>.</green>",
            "published": "<green>Home <yellow>{home_name}</yellow> agora é pública!</green>",
            "unpublished": "<green>Home <yellow>{home_name}</yellow> agora é privada!</green>",
            "deleted": "<green>Home <yellow>{home_name}</yellow> deletada com sucesso!</green>"
          }
        }
      },
      "views": {
        // Menu do /home: 28 slots, um por posição.
        "home": {
          "title": "Suas Homes",
          "items": {
            "home": {
              "published": {
                "name": "<color:#3ef7aa>{home_name}</color>",
                "lore": [
                  "",
                  " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{home_position}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Estado:</white> <color:#3ef7aa>Pública</color>",
                  "",
                  "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>Teleportar</white>",
                  "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>Gerenciar</white>"
                ]
              },
              "not-published": {
                "name": "<color:#ff2d2d>{home_name}</color>",
                "lore": [
                  "",
                  " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{home_position}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Estado:</white> <gray>Privada</gray>",
                  "",
                  "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>Teleportar</white>",
                  "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>Gerenciar</white>"
                ]
              }
            },
            "empty": {
              "name": "<gray>Slot disponível</gray>",
              "lore": [
                "<gray>Este slot está disponível para</gray>",
                "<gray>você criar uma nova home.</gray>",
                "",
                "<color:#ff2d2d>Use /sethome no lugar onde</color>",
                "<color:#ff2d2d>você quer a home.</color>"
              ]
            },
            "empty-unavailable": {
              "name": "<dark_gray>Slot bloqueado</dark_gray>",
              "lore": [
                "<gray>Este slot está além do seu</gray>",
                "<gray>limite de homes.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{slot_position}</gray>",
                " <dark_gray>▸</dark_gray> <white>Cargo necessário:</white> <gray>{required_group}</gray>"
              ]
            },
            // Slot bloqueado DENTRO de uma partida: o limite é fixo e igual para todos, então aqui não se
            // fala em cargo — não existe cargo que abra mais.
            "empty-unavailable-match": {
              "name": "<dark_gray>Slot bloqueado</dark_gray>",
              "lore": [
                "<gray>Durante a partida cada jogador</gray>",
                "<gray>possui {home_limit} homes.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{slot_position}</gray>"
              ]
            }
          }
        },
        // Menu de detalhe de uma home.
        "home-detalhe": {
          "title": "Home: {home_name}",
          "items": {
            "icon": {
              "name": "<color:#ff2d2d>Ícone da home</color>",
              "lore": [
                "<gray>É assim que a home aparece</gray>",
                "<gray>na sua lista.</gray>",
                "",
                "<green>Clique em um item do seu</green>",
                "<green>inventário para trocar!</green>"
              ]
            },
            "move": {
              "name": "<color:#ff2d2d>Mover posição</color>",
              "lore": [
                "",
                " <dark_gray>▸</dark_gray> <white>Posição atual:</white> <gray>{home_position}</gray>",
                "",
                "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>Avançar</white>",
                "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>Voltar</white>"
              ]
            },
            "publish": {
              "published": {
                "name": "<color:#3ef7aa>Home pública</color>",
                "lore": [
                  "<gray>Qualquer jogador pode usar</gray>",
                  "<gray>/home seunick:{home_name}</gray>",
                  "",
                  "<red>Clique para tornar privada.</red>"
                ]
              },
              "not-published": {
                "name": "<gray>Home privada</gray>",
                "lore": [
                  "<gray>Somente você pode teleportar</gray>",
                  "<gray>para esta home.</gray>",
                  "",
                  "<green>Clique para tornar pública.</green>"
                ]
              }
            },
            "teleport": {
              "name": "<color:#ff2d2d>Teleportar</color>",
              "lore": [
                "<gray>Vai para esta home agora.</gray>",
                "",
                "<green>Clique para teleportar!</green>"
              ]
            },
            "delete": {
              "name": "<color:#ff2d2d>Apagar home</color>",
              "lore": [
                "<gray>Remove esta home da sua lista.</gray>",
                "<gray>Não é possível desfazer.</gray>",
                "",
                "<red>Clique para apagar.</red>"
              ]
            }
          }
        }
      }
    }
  }
}
