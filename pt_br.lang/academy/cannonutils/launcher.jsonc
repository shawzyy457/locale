{
  "plugins": {
    "cannonutils": {
      "items": {
        // Item do Lançador (CustomItem 'cannon-launcher'). Placeholders vêm de
        // CannonLauncherCustomItem#getDefaultPlaceholders: {launcher_height} e {launcher_cooldown}.
        "launcher": {
          "name": "<color:#ff2d2d>Lançador</color>",
          "lore": [
            "<gray>Arremessa você para o alto e</gray>",
            "<gray>anula o dano da queda.</gray>",
            "",
            " <dark_gray>▸</dark_gray> <white>Altura:</white> <gray>{launcher_height} blocos</gray>",
            " <dark_gray>▸</dark_gray> <white>Recarga:</white> <gray>{launcher_cooldown}</gray>",
            "",
            "<green>Clique para se lançar!</green>"
          ]
        }
      },
      "messages": {
        "launcher": {
          "already-flying": "<red>Você ainda está no ar!</red>",
          // {remaining_time} é formatado pelo DateUtils antes de entrar na mensagem.
          "in-cooldown": "<red>Aguarde <yellow>{remaining_time}</yellow> para usar o Lançador novamente.</red>"
        }
      }
    }
  }
}
