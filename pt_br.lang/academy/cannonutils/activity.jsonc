{
  "plugins": {
    "cannonutils": {
      // Bússola travada na hotbar (CannonActivityCompassItem) + menu "Escolha a atividade!".
      "activity": {
        "item": {
          "name": "<gradient:#FF6F00:#faa825:#FF6F00>Escolha a atividade",
          "lore": [
            "<gray>Escolha o que você",
            "<gray>pretende fazer no",
            "<gray>servidor academy!",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00> Atividades disponíveis:",
            "<gradient:#FF6F00:#faa825:#FF6F00> ▸ <white>Treino defesa;",
            "<gradient:#FF6F00:#faa825:#FF6F00> ▸ <white>Invasão Fac x Fac;",
            "<gradient:#FF6F00:#faa825:#FF6F00> ▸ <white>PvP Practice;",
            "<gradient:#FF6F00:#faa825:#FF6F00> ▸ <white>Cannon Academy;",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00>Uma experiência única,",
            "<gradient:#FF6F00:#faa825:#FF6F00>que você acha apenas",
            "<gradient:#FF6F00:#faa825:#FF6F00>em: <white>exe.com</white>"
          ]
        },
        "messages": {
          // Cannon Academy — CannonActivityService.openCannonAcademy.
          "cannon-academy": "Bem-vindo à sua <color:#FF6F00>Cannon Academy</color><gray>.",
          // As atividades ainda sem destino ligado (hoje só o Treino de defesa).
          "coming-soon": "Essa atividade ainda está sendo preparada. Em breve!",
          // PvP Practice desligado em 'practice.ativado' no config.yml.
          "practice-unavailable": "O PvP Practice está indisponível agora. Avise a staff.",
          // Plugin 'plots' ausente no servidor (o Setup também avisa no log do boot).
          "plots-unavailable": "Os plots estão indisponíveis agora. Avise a staff.",
          // Plot existe mas o mundo dele não pôde ser criado/carregado.
          "plot-unavailable": "Não deu para abrir o seu plot agora. Tente de novo.",
          // Ferramentas de canhão são visíveis em toda a Academy, mas só executam no servidor de plots.
          "plot-only": "Este comando só pode ser usado no servidor de plots. Use <white>/plot h</white> para entrar no seu plot.",
          // Dentro da partida Fac x Fac as ferramentas de bancada ficam de fora: elas furam regras da
          // disputa (reentregar kit, multiplicar TNT, colar canhão pronto).
          "match-blocked": "Este comando não funciona dentro de uma partida Fac x Fac."
        }
      },
      "views": {
        // Layout em server-menus/cannoning/cannonutils/atividade.yml.
        // O nome do bind de cada ingrediente é o segmento da chave aqui embaixo.
        "atividade": {
          "title": "Escolha a atividade!",
          "items": {
            "suporte": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Estamos aqui para você!",
              "lore": [
                "<gray>Temos uma equipe especializada",
                "<gray>em tudo o que você precisar",
                "<gray>dentro desse servidor. Entre",
                "<gray>no nosso discord e tire todas",
                "<gray>as suas dúvidas!",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Converse com a gente em:",
                "<white>discord.gg/exe"
              ]
            },
            "treino-defesa": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Treino de defesa",
              "lore": [
                "<gray>Treine as suas habilidades",
                "<gray>de defesa de base contra",
                "<gray>BOTs e um canhão potente",
                "<gray>que atira sozinho.",
                "",
                " <gradient:#FF6F00:#faa825:#FF6F00>Aprenda com os melhores!",
                " <gray>Entre no nosso discord e",
                " <gray>chame alguém com tag Academy.",
                " <white>discord.gg/exe",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para conectar."
              ]
            },
            "invasao": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Invasão Fac x Fac",
              "lore": [
                "<gray>Enfrente outra facção num",
                "<gray>duelo de facção invasora",
                "<gray>e defensora, tudo totalmente",
                "<gray>customizável.",
                "",
                " <gradient:#FF6F00:#faa825:#FF6F00>Aprenda com os melhores!",
                " <gray>Entre no nosso discord e",
                " <gray>chame alguém com tag Academy.",
                " <white>discord.gg/exe",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para conectar."
              ]
            },
            "pvp-practice": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>PvP Practice",
              "lore": [
                "<gray>Treine o seu pvp de maçã",
                "<gray>dourada em 1v1, ou fac x fac.",
                "",
                " <gradient:#FF6F00:#faa825:#FF6F00>Aprenda com os melhores!",
                " <gray>Entre no nosso discord e",
                " <gray>chame alguém com tag Academy.",
                " <white>discord.gg/exe",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para conectar."
              ]
            },
            "cannon-academy": {
              "name": "<gradient:#FF6F00:#faa825:#FF6F00>Cannon Academy",
              "lore": [
                "<gray>Treine e aprenda novos",
                "<gray>canhões, use ferramentas",
                "<gray>e schematics para facilitar",
                "<gray>todo o processo de aprender.",
                "",
                " <gradient:#FF6F00:#faa825:#FF6F00>Aprenda com os melhores!",
                " <gray>Entre no nosso discord e",
                " <gray>chame alguém com tag Academy.",
                " <white>discord.gg/exe",
                "",
                "<gradient:#FF6F00:#faa825:#FF6F00>Clique para conectar."
              ]
            }
          }
        }
      }
    }
  }
}
