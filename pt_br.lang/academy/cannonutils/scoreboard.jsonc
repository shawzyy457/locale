{
  "plugins": {
    "cannonutils": {
      "scoreboards": {
        "cannoning": {
          // Título fixo (updateTitle = componente único). A seleção é por SERVIDOR:
          // academy-plot usa "lines"; academy-spawn usa "lines-no-plot". Não depende mais do mundo
          // em que o jogador está durante o join.
          // {user_gold_formatted} e {user_group_name_with_color} são placeholders GLOBAIS do core
          // (CoreSpigotPlugin registra via Lang, resolvem por-viewer); {play_time}, {current_date},
          // {current_time}, {server_online} e {player_ping} vêm do provider.
          //
          // ATENÇÃO: {user_group_name_with_color} NÃO é texto — Group.getDisplayName() devolve o
          // ícone > na font EXE:ícone, ou seja, a própria TEXTURA da tag do
          // cargo (mesmo comportamento da scoreboard do lobby). Por isso não envolva em <color:...>
          // nem em : a arte já carrega a cor e o ícone define a própria font.
          "title": " <gradient:#FF6F00:#faa825:#FF6F00><bold>EXE ACADEMY</bold></gradient> ",
          "lines": [
            " <gray>{current_date}</gray> <dark_gray>{current_time}</dark_gray>",
            "",
            " <white>Plot: </white>{plot_owner_name_with_tag}",
            "",
            "  <white>Cargo: {user_group_name_with_color}",
            "  <white>Online: <gray>{server_online}",
            "  <white>Gold: <color:#FFAA00>{user_gold_formatted}",
            "",
            " <gradient:#FF6F00:#faa825:#FF6F00>Jogando há:",
            " <yellow>{play_time}</yellow>",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00>exe.com</gradient>  "
          ],
          "lines-no-plot": [
            " <gray>{current_date}</gray> <dark_gray>{current_time}</dark_gray>",
            "",
            "  <white>Cargo: {user_group_name_with_color}",
            "  <white>Online: <gray>{server_online}",
            "  <white>Gold: <color:#FFAA00>{user_gold_formatted}",
            "",
            " <gradient:#FF6F00:#faa825:#FF6F00>Clique na sua</gradient>",
            " <gradient:#FF6F00:#faa825:#FF6F00>bússola!</gradient>",
            "",
            "<gradient:#FF6F00:#faa825:#FF6F00>exe.com</gradient>"
          ]
        }
      }
    }
  }
}
