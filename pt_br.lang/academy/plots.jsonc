{
  // Estilo (padrão do servidor de factions): chat sem fonte, com a cor dizendo o resultado — <red>
  // recusa, <green> conclusão, <yellow> aviso. Item de menu SEMPRE com a fonte pequena, dado em
  // bullet " ▸ <white>Rótulo:</white> <gray>valor</gray>" e a ação no fim da lore.
  "plugins": {
    "plots": {
      "commands": {
        "plot": {
          "help": [
            "<red>Comandos de plot:</red>",
            " <dark_gray>▸</dark_gray> <white>/plot claim [here] | unclaim confirm | info | list</white>",
            " <dark_gray>▸</dark_gray> <white>/plot home [nome] | sethome [nome] | delhome <nome> | setspawn</white>",
            " <dark_gray>▸</dark_gray> <white>/plot visit <jogador> | leave | setowner <jogador></white>",
            " <dark_gray>▸</dark_gray> <white>/plot trust|add|untrust|remove|coowner|kick <jogador></white>",
            " <dark_gray>▸</dark_gray> <white>/plot deny|undeny|ban|unban <jogador></white>",
            " <dark_gray>▸</dark_gray> <white>/plot flag set|remove|list <flag> [valor]</white>",
            " <dark_gray>▸</dark_gray> <white>/plot manage</white> <gray>- painel de membros, flags e reset</gray>",
            " <dark_gray>▸</dark_gray> <white>/plot reset | bypass</white>",
            " <dark_gray>▸</dark_gray> <white>/plot admin [tp|info|delete|reset <jogador>]</white> <gray>- staff</gray>"
          ],
          "errors": {
            "not-in-plot": "<red>Você não está dentro de nenhuma plot.</red>",
            "not-owner": "<red>Apenas o dono da plot pode fazer isso.</red>",
            "no-role": "<red>Você não possui permissão nesta plot.</red>",
            "no-permission": "<red>Você não possui permissão para usar este comando.</red>",
            "no-plot-owned": "<red>Você não possui nenhuma plot! Use <white>/plot claim</white>.</red>",
            // {player} aqui é o nome DIGITADO de alguém que pode nem existir: sem cargo, sem tag.
            // E o {plot} das outras chaves é o IDENTIFICADOR da plot (o nick do dono), não uma citação
            // do jogador — quem cita o dono com a tag é o {owner_name_with_tag} da ficha. Decisão do
            // dono em 11/08; não troque por _with_tag.
            "player-not-found": "<red>Jogador <yellow>{player}</yellow> não encontrado.</red>",
            "world-unavailable": "<red>O mundo de plots está indisponível no momento. Tente novamente mais tarde.</red>"
          },
          "member-result": {
            "no-permission": "<red>Você não possui permissão para gerenciar este jogador.</red>",
            "cannot-target-self": "<red>Você não pode fazer isso consigo mesmo!</red>",
            "target-is-owner": "<red>Você não pode fazer isso com o dono da plot.</red>",
            "limit-reached": "<red>O limite deste cargo já foi atingido nesta plot.</red>",
            "not-a-member": "<red>Este jogador não é membro da plot.</red>",
            "already-set": "<red>Este jogador já está neste estado.</red>",
            "not-denied": "<red>Este jogador não está negado.</red>",
            "not-banned": "<red>Este jogador não está banido.</red>"
          },
          "claim": {
            "success": "<green>Plot <yellow>{plot}</yellow> reivindicada com sucesso!</green>",
            "limit-reached": "<red>Você atingiu seu limite de <yellow>{limit}</yellow> plot(s).</red>",
            "unavailable": "<red>Não há nenhuma célula livre disponível no momento.</red>",
            "unavailable-here": "<red>Esta célula não pode ser reivindicada: é uma estrada, já possui dono ou está fora do mundo de plots.</red>"
          },
          "unclaim": {
            "confirm": "<red>Isso apagará a plot <yellow>{plot}</yellow> para sempre! Use <white>/plot unclaim confirm</white> para confirmar.</red>",
            "success": "<green>Plot <yellow>{plot}</yellow> liberada com sucesso!</green>"
          },
          "info": {
            "body": [
              "<red>Plot {plot}:</red>",
              " <dark_gray>▸</dark_gray> <white>Dono:</white> {owner_name_with_tag}",
              " <dark_gray>▸</dark_gray> <white>Co-donos:</white> <gray>{coowners}</gray> <dark_gray>·</dark_gray> <white>Confiáveis:</white> <gray>{trusted}</gray> <dark_gray>·</dark_gray> <white>Membros:</white> <gray>{members}</gray>",
              " <dark_gray>▸</dark_gray> <white>Negados:</white> <gray>{denied}</gray> <dark_gray>·</dark_gray> <white>Banidos:</white> <gray>{banned}</gray> <dark_gray>·</dark_gray> <white>Homes:</white> <gray>{homes}</gray>"
            ]
          },
          "list": {
            "body": "<green>Suas plots <gray>({count})</gray>:</green> <gray>{plots}</gray>"
          },
          "home": {
            "success": "<green>Você foi teleportado para a home <yellow>{home}</yellow>!</green>",
            "not-found": "<red>Você não possui nenhuma home com o nome <yellow>{home}</yellow>.</red>"
          },
          "sethome": {
            "success": "<green>Home <yellow>{home}</yellow> criada com sucesso!</green>"
          },
          "delhome": {
            "usage": "<red>Uso: <white>/plot delhome <nome></white></red>",
            "not-found": "<red>Você não possui nenhuma home com o nome <yellow>{home}</yellow>.</red>",
            "success": "<green>Home <yellow>{home}</yellow> deletada com sucesso!</green>"
          },
          "setspawn": {
            "success": "<green>Ponto de entrada da plot definido com sucesso!</green>"
          },
          "visit": {
            "usage": "<red>Uso: <white>/plot visit <jogador></white></red>",
            "no-plot": "<red>O jogador <yellow>{player}</yellow> não possui nenhuma plot.</red>",
            "success": "<green>Você foi teleportado para a plot de {player_name_with_tag}!</green>",
            "banned": "<red>Você está banido desta plot!</red>",
            "not-public": "<red>Esta plot não está aberta para visitas.</red>"
          },
          "trust": {
            "usage": "<red>Uso: <white>/plot trust <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} agora é <white>{role}</white> na sua plot!</green>"
          },
          "add": {
            "usage": "<red>Uso: <white>/plot add <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} agora é <white>{role}</white> na sua plot!</green>"
          },
          "untrust": {
            "usage": "<red>Uso: <white>/plot untrust <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} foi removido da sua plot!</green>"
          },
          "remove": {
            "usage": "<red>Uso: <white>/plot remove <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} foi removido da sua plot!</green>"
          },
          "coowner": {
            "usage": "<red>Uso: <white>/plot coowner add|remove <jogador></white></red>",
            "added": "<green>Jogador {player_name_with_tag} agora é co-dono da sua plot!</green>",
            "removed": "<green>Jogador {player_name_with_tag} não é mais co-dono da sua plot!</green>"
          },
          "leave": {
            "not-member": "<red>Você não é membro desta plot.</red>",
            "owner-cannot-leave": "<red>O dono não pode sair da própria plot! Use <white>/plot setowner <jogador></white> ou <white>/plot unclaim confirm</white>.</red>",
            "success": "<green>Você saiu da plot <yellow>{plot}</yellow>!</green>"
          },
          "setowner": {
            "usage": "<red>Uso: <white>/plot setowner <jogador></white> <gray>(ou /plot setowner accept)</gray></red>",
            "requested": "<green>Pedido de transferência enviado para {player_name_with_tag}!</green>",
            "incoming": "<yellow>{player_name_with_tag} deseja transferir a plot <white>{plot}</white> para você. Use <white>/plot setowner accept</white> para aceitar.</yellow>",
            "no-pending": "<red>Você não possui nenhum pedido de transferência pendente.</red>",
            "expired": "<red>O pedido de transferência não é mais válido.</red>",
            "accepted": "<green>Você agora é o dono da plot <yellow>{plot}</yellow>!</green>"
          },
          "deny": {
            "usage": "<red>Uso: <white>/plot deny <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} foi negado na sua plot!</green>"
          },
          "undeny": {
            "usage": "<red>Uso: <white>/plot undeny <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} não está mais negado na sua plot!</green>"
          },
          "ban": {
            "usage": "<red>Uso: <white>/plot ban <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} foi banido da sua plot!</green>"
          },
          "unban": {
            "usage": "<red>Uso: <white>/plot unban <jogador></white></red>",
            "success": "<green>Jogador {player_name_with_tag} foi desbanido da sua plot!</green>"
          },
          "kick": {
            "usage": "<red>Uso: <white>/plot kick <jogador></white></red>",
            "not-here": "<red>O jogador {player_name_with_tag} não está dentro desta plot.</red>",
            "success": "<green>Jogador {player_name_with_tag} foi expulso da sua plot!</green>"
          },
          "flag": {
            "usage": "<red>Uso: <white>/plot flag set|remove|list <flag> [valor]</white></red>",
            "state": {
              "on": "ativada",
              "off": "desativada"
            },
            "list": "<green>Flags da plot:</green> <gray>{flags}</gray>",
            "unknown": "<red>A flag <yellow>{flag}</yellow> não existe.</red>",
            "invalid-value": "<red>Valor inválido: <yellow>{value}</yellow>. Use <white>true</white> ou <white>false</white>.</red>",
            "set": "<green>Flag <yellow>{flag}</yellow> definida para <white>{value}</white>!</green>",
            "removed": "<green>Flag <yellow>{flag}</yellow> voltou ao valor padrão!</green>"
          },
          "reset": {
            "confirm": "<red>Isso apagará tudo que foi construído na plot <yellow>{plot}</yellow>! Use <white>/plot reset confirm</white> para confirmar.</red>",
            "success": "<green>Plot <yellow>{plot}</yellow> resetada com sucesso!</green>"
          },
          "bypass": {
            "enabled": "<green>Bypass de staff ativado!</green>",
            "disabled": "<red>Bypass de staff desativado!</red>"
          },
          "admin": {
            "usage": "<red>Uso: <white>/plot admin</white> <gray>(liga/desliga o modo)</gray> ou <white>/plot admin <tp|info|delete|reset|fixfloor> <jogador></white></red>",
            "mode": {
              "enabled": "<green>Modo administrador <white>ATIVADO</white>! Você pode construir, quebrar e gerenciar qualquer plot. Use <white>/plot admin</white> novamente para desligar.</green>",
              "disabled": "<red>Modo administrador <white>DESATIVADO</white>! Você voltou a respeitar as permissões das plots.</red>"
            },
            "invalid-key": "<red>Jogador <yellow>{plot}</yellow> não encontrado.</red>",
            "not-claimed": "<red>O jogador <yellow>{plot}</yellow> não possui nenhuma plot.</red>",
            "tp": "<green>Você foi teleportado para a plot de <yellow>{plot}</yellow>!</green>",
            "info": "<green>Plot {plot}:</green> <white>Dono:</white> {owner_name_with_tag} <dark_gray>·</dark_gray> <white>Co-donos:</white> <gray>{coowners}</gray> <dark_gray>·</dark_gray> <white>Membros:</white> <gray>{members}</gray>",
            "delete": "<green>Plot <yellow>{plot}</yellow> apagada com sucesso!</green>",
            "reset": "<green>Plot <yellow>{plot}</yellow> resetada com sucesso!</green>",
            "fixfloor": {
              "started": "<yellow>Reparo do piso de <white>{plot}</white> iniciado: <white>{chunks}</white> chunk(s) a verificar. Você será avisado ao terminar.</yellow>",
              "done": "<green>Reparo do piso de <white>{plot}</white> concluído: <white>{chunks}</white> chunk(s) corrigido(s).</green>",
              "nothing": "<red>O piso de <white>{plot}</white> já está na altura da config — nada a reparar.</red>",
              "already-running": "<red>Já existe um reparo de piso em andamento para <white>{plot}</white>.</red>",
              "aborted": "<red>Reparo do piso de <white>{plot}</white> abortado: mundo descarregado, apagado ou erro. Verifique o console.</red>",
              "cannot-start": "<red>Não foi possível iniciar o reparo do piso de <white>{plot}</white>. Verifique o console.</red>"
            }
          }
        }
      },
      "views": {
        "manage": {
          "title": "Gerenciar Plot",
          "items": {
            "info": {
              "name": "<color:#ff2d2d>Plot <white>{plot_key}</white></color>",
              "lore": [
                "<gray>Informações gerais da</gray>",
                "<gray>sua célula.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Dono:</white> {owner_name_with_tag}",
                " <dark_gray>▸</dark_gray> <white>Membros:</white> <gray>{member_count}</gray>",
                " <dark_gray>▸</dark_gray> <white>Coordenada:</white> <gray>{plot_key}</gray>"
              ]
            },
            "members": {
              "name": "<color:#ff2d2d>Membros</color>",
              "lore": [
                "<gray>Adicione, promova ou remova</gray>",
                "<gray>os membros da sua plot.</gray>",
                "",
                "<green>Clique para abrir!</green>"
              ]
            },
            "flags": {
              "name": "<color:#ff2d2d>Flags</color>",
              "lore": [
                "<gray>Ajuste as permissões e o</gray>",
                "<gray>comportamento da plot.</gray>",
                "",
                "<green>Clique para abrir!</green>"
              ]
            },
            "reset": {
              "name": "<red>Resetar plot</red>",
              "lore": [
                "<gray>Recoloca o template inicial</gray>",
                "<gray>na sua célula.</gray>",
                "",
                "<red>Todas as suas construções</red>",
                "<red>serão apagadas para sempre!</red>",
                "",
                "<red>Clique para resetar.</red>"
              ]
            },
            "transfer": {
              "name": "<color:#ff2d2d>Transferir posse</color>",
              "lore": [
                "<gray>Passe a posse da plot a um</gray>",
                "<gray>co-dono pela tela de membros.</gray>",
                "",
                "<green>Clique para abrir os membros!</green>"
              ]
            }
          },
          "messages": {
            "no-permission": "<red>Você precisa ser co-dono da plot para fazer isso.</red>"
          }
        },
        "flags": {
          "title": "Flags da Plot",
          "state": {
            "on": "<green>ativada</green>",
            "off": "<red>desativada</red>"
          },
          "items": {
            "info": {
              "name": "<color:#ff2d2d>Flags da plot <white>{plot_key}</white></color>",
              "lore": [
                "<gray>Clique em uma flag para</gray>",
                "<gray>alterná-la na sua plot.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Coordenada:</white> <gray>{plot_key}</gray>"
              ]
            },
            "flag": {
              "name": "<white>{flag}</white> <dark_gray>[</dark_gray>{state}<dark_gray>]</dark_gray>",
              "lore": [
                "<gray>Controla o comportamento</gray>",
                "<gray>desta regra na sua plot.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Categoria:</white> <gray>{category}</gray>",
                " <dark_gray>▸</dark_gray> <white>Estado:</white> {state}",
                "",
                "<green>Clique para alternar.</green>"
              ]
            },
            "reset": {
              "name": "<red>Resetar flags</red>",
              "lore": [
                "<gray>Devolve todas as flags da</gray>",
                "<gray>plot ao valor padrão.</gray>",
                "",
                "<red>Clique para resetar.</red>"
              ]
            }
          },
          "messages": {
            "no-permission": "<red>Você precisa ser co-dono da plot para alterar as flags.</red>",
            "reset-done": "<green>Todas as flags da plot voltaram ao padrão!</green>"
          }
        },
        "members": {
          "title": "Membros da Plot",
          "items": {
            "empty": {
              "name": "<red>Nenhum membro</red>",
              "lore": [
                "<gray>Esta plot ainda não possui</gray>",
                "<gray>nenhum membro.</gray>",
                "",
                "<green>Use o botão de adicionar abaixo!</green>"
              ]
            },
            "add": {
              "name": "<green>Adicionar membro</green>",
              "lore": [
                "<gray>Digite no chat o nome do</gray>",
                "<gray>jogador que deseja adicionar.</gray>",
                "",
                "<green>Clique para adicionar!</green>"
              ]
            },
            "member": {
              "name": "{member_name_with_tag} <dark_gray>▸</dark_gray> <white>{role_name}</white>",
              "lore": [
                "<gray>Gerencie o cargo deste</gray>",
                "<gray>membro na sua plot.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Cargo atual:</white> <gray>{role_name}</gray>",
                "",
                "<green>Botão esquerdo</green> <dark_gray>▸</dark_gray> <white>Promover</white>",
                "<yellow>Botão direito</yellow> <dark_gray>▸</dark_gray> <white>Rebaixar</white>",
                "<red>Shift + direito</red> <dark_gray>▸</dark_gray> <white>Remover</white>",
                "<yellow>Shift + esquerdo</yellow> <dark_gray>▸</dark_gray> <white>Transferir posse</white>"
              ]
            }
          },
          "messages": {
            "add-query": "<yellow>Digite no chat o nome do jogador que deseja adicionar à plot.</yellow>",
            "user-not-found": "<red>Jogador <yellow>{name}</yellow> não encontrado.</red>",
            "member-added": "<green>Jogador </green>{member_name_with_tag} <green>adicionado à sua plot!</green>",
            "member-removed": "<green>Membro removido da sua plot!</green>",
            "role-changed": "<green>Cargo alterado para <yellow>{role_name}</yellow>!</green>",
            "owner-transferred": "<green>Posse da plot transferida com sucesso!</green>",
            "results": {
              "no-permission": "<red>Você não possui permissão para gerenciar este jogador.</red>",
              "cannot-target-self": "<red>Você não pode gerenciar a si mesmo! Use <white>/plot leave</white>.</red>",
              "target-is-owner": "<red>O dono da plot não pode ser gerenciado.</red>",
              "already-set": "<red>Este jogador já está neste cargo.</red>",
              "limit-reached": "<red>Você atingiu o limite de jogadores neste cargo.</red>",
              "not-a-member": "<red>Este jogador não é membro da sua plot.</red>",
              "not-denied": "<red>Este jogador não está negado.</red>",
              "not-banned": "<red>Este jogador não está banido.</red>"
            }
          }
        }
      },
      "roles": {
        // Nomes dos papéis (PlotRole.getDisplayName) — usados em mensagens e na tela de membros.
        "owner": "Dono",
        "coowner": "Co-dono",
        "trusted": "Confiável",
        "member": "Membro"
      },
      "flags": {
        "build": "Construir",
        "break": "Quebrar",
        "container": "Baús e containers",
        "crafting": "Bancadas",
        "use": "Usar blocos",
        "sign-edit": "Editar placas",
        "animal-interact": "Interagir com animais",
        "hanging": "Quadros e itens suspensos",
        "vehicle": "Barcos e carrinhos",
        "pvp": "PvP",
        "pve": "PvE",
        "tnt": "TNT",
        "animal-damage": "Dano a animais",
        "item-drop": "Dropar itens",
        "item-pickup": "Coletar itens",
        "invincible": "Invencibilidade",
        "explosion-damage": "Dano de explosão",
        "fire-spread": "Propagação de fogo",
        "mob-spawn": "Nascimento de mobs",
        "ice-form": "Formação de gelo",
        "leaf-decay": "Decomposição de folhas",
        "liquid-flow": "Fluxo de líquidos",
      // Nasce DESLIGADA (a água não quebra), ao contrário do vanilla: um canhão junta água e
      // redstone a meio bloco de distância, e a correnteza levava o pó, o repetidor e o comparador
      // embora no meio da calibragem. Não confundir com "Fluxo de líquidos", que PARA a água.
      "water-breaks-redstone": "Água quebra redstone",
        "redstone": "Redstone",
        "piston": "Pistões",
        "disable-trample": "Proteger plantações",
        "public-visit": "Visita pública",
        "deny-entry": "Bloquear negados",
        "fly": "Voo",
        "guest-gamemode": "Modo de jogo do visitante",
        "chat-isolated": "Chat isolado"
      },
      "flag-categories": {
        "PUBLIC_ACCESS": "Acesso público",
        "COMBAT": "Combate e canhão",
        "ENVIRONMENT": "Ambiente",
        "PLAYER": "Jogador"
      },
      // Fundo de bedrock do plot (PlotBedrockGuardListener): indestrutível para todos, em qualquer
      // gamemode. Só vale para as camadas GERADAS abaixo do piso; bedrock posta pelo jogador acima
      // do piso continua quebrável (inclusive pela Picareta SILK2).
      "bedrock": {
        "unbreakable": "<red>O fundo de bedrock da plot não pode ser quebrado.</red>"
      },
      // Gamemode por mundo (PlotGameModeListener): criativo no plot, survival no spawn. O jogador não
      // troca; a staff (grupo de 'gamemode.grupo-livre' no config.yml) troca normalmente. O treino
      // continua entrando em survival — a trava só recusa troca feita por COMANDO.
      "gamemode": {
        "bloqueado": "<red>O modo de jogo é definido pelo lugar: <white>criativo na sua plot</white>, <white>survival no spawn</white>.</red>"
      },
      "entry": {
        "banned": "<red>Você está banido desta plot e não pode entrar.</red>",
        "denied": "<red>Você está impedido de entrar nesta plot.</red>",
        "border": "<gray>Você entrou em uma <yellow>plot protegida</yellow>.</gray>",
        "title-own": {
          "title": "<gradient:#FF6F00:#faa825><bold>Sua Plot</bold></gradient>",
          "subtitle": "<gray>Bem-vindo de volta!</gray>"
        },
        "title-visit": {
          "title": "<gradient:#FF6F00:#faa825><bold>Plot de {player_name_with_tag}</bold></gradient>",
          "subtitle": "<gray>Use <white>/plot home</white> para voltar.</gray>"
        }
      },
      "reset": {
        "countdown": {
          "title": "<red><bold>{seconds}</bold></red>",
          "subtitle": "<gray>Resetando a plot...</gray>"
        },
        "done": {
          "title": "<green><bold>Plot resetada!</bold></green>",
          "subtitle": "<gray>Tudo voltou ao padrão.</gray>"
        }
      },
      "worldedit": {
        "no-permission": "<red>Você não possui permissão para construir nesta plot.</red>",
        "only-in-plot": "<red>O WorldEdit só funciona dentro de uma plot em que você possa construir.</red>",
        "in-cooldown": "<red>Sua última edição foi pesada! Aguarde <yellow>{remaining_time}</yellow> para usar o WorldEdit novamente.</red>",
        "limit-reached": "<red>Edição interrompida: o limite é de <yellow>{limit}</yellow> blocos por operação. Faça em partes menores.</red>"
      }
    }
  }
}
