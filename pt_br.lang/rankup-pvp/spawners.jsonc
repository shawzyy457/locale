{
    "plugins": {
        "spawners": {
            "items": {
                "spawner": {
                    "name": "{spawner_color}<bold>gerador de {spawner_type}</bold>",
                    "lore": [
                        "<gray>coloque esse gerador em",
                        "<gray>um terreno e comece a",
                        "<gray>lucrar em coins!",
                        "",
                        "<dark_gray> ▸<white> quantia: <gray>{spawner_stack}",
                        "",
                        "{spawner_color}coloque em um terreno."
                    ]
                },
                "spawner-head": {
                    "name": "{head_color}cabeça de {head_type}",
                    "lore": [
                        "",
                        " <white>Quantia:</white> <gray>{head_stack}</gray>",
                        "",
                        "{head_color}clique para armazenar."
                    ]
                }
            },
            "requirements": {
                "spawner-head": {
                    "message": "<gray>{head_amount} cabeças de {head_type}</gray>"
                }
            },
            "views": {
                "spawner": {
                    "title": "gerador de {spawner_type}",
                    "items": {
                        "0": {
                            "name": "<yellow>gerador de {spawner_type}</yellow>",
                            "lore": [
                                "",
                                "<yellow> ▼ Informações:</yellow>",
                                "<white>   Quantia:</white> <gray>x{spawner_stack}</gray>",
                                "<white>   Drop:</white> <gray>{drop_name}</gray>",
                                "",
                                "<white>proprietário:</white> {spawner_owner}"
                            ]
                        },
                        "1": {
                            "name": "<green>permissões</green>",
                            "lore": [
                                "<gray>Confira os jogadores que podem</gray>",
                                "<gray>matar criaturas e vender drops</gray>",
                                "<gray>do seu gerador.</gray>",
                                "",
                                "<green>clique para acessar.</green>"
                            ]
                        }
                    }
                },
                "spawner-friends": {
                    "title": "amigos",
                    "items": {
                        "0": {
                            "name": "{friend_display_name}",
                            "lore": [
                                "<gray>este jogador pode matar e</gray>",
                                "<gray>vender os drops do</gray>",
                                "<gray>seu gerador.</gray>",
                                "",
                                "<red>clique para removê-lo.</red>"
                            ]
                        },
                        "1": {
                            "name": "<green>vaga disponível</green>",
                            "lore": [
                                "<gray>Ao adicionar um jogador ele</gray>",
                                "<gray>poderá matar criaturas do</gray>",
                                "<gray>seu gerador.</gray>",
                                "",
                                "<green>clique para adicionar.</green>"
                            ]
                        }
                    }
                },
                "spawner-head": {
                    "title": "suas cabeças",
                    "items": {
                        "0": {
                            "name": "<yellow>cabeças de {head_type}</yellow>",
                            "lore": [
                                "<gray>Utilize essas cabeças para</gray>",
                                "<gray>liberar geradores.</gray>",
                                "",
                                "<white> quantia:</white> <gray>{head_amount}</gray>",
                                "",
                                "<yellow>clique para recolher.</yellow>"
                            ]
                        }
                    }
                },
                "spawner-shop": {
                    "title": "loja de geradores",
                    "items": {
                        "0": {
                            "name": "<yellow>gerador de {spawner_type}</yellow>",
                            "lore": [
                                "<gray>Coloque em seu terreno para</gray>",
                                "<gray>começar a gerar criaturas.</gray>",
                                "",
                                "<yellow> ▼ Informações:</yellow>",
                                "<white>   custo:</white> <gray>{spawner_price}</gray>",
                                "<white>   drop:</white> <gray>{drop_name}</gray>",
                                "",
                                "<white>Clique</white> <gray>esquerdo</gray> <white>para comprar</white>",
                                "<white>Clique</white> <gray>direito</gray> <white>para mais opções</white>"
                            ]
                        },
                        "1": {
                            "name": "<red>gerador de {spawner_type}</red>",
                            "lore": [
                                "<gray>Coloque em seu terreno para</gray>",
                                "<gray>começar a gerar criaturas.</gray>",
                                "",
                                "<red> ▼ Informações:</red>",
                                "<white>   custo:</white> <gray>{spawner_price}</gray>",
                                "<white>   drop:</white> <gray>{drop_name}</gray>",
                                "",
                                "<red> ▼ requisitos para liberação:</red>",
                                "{spawner_requirements}",
                                "",
                                "<red>gerador bloqueado!</red>"
                            ]
                        },
                        "2": {
                            "name": "<yellow>armazém de cabeças</yellow>",
                            "lore": [
                                "<gray>Aqui você encontra as cabeças</gray>",
                                "<gray>das criaturas que você eliminou.</gray>",
                                "",
                                "<yellow>clique para acessar.</yellow>"
                            ]
                        }
                    }
                }
            }
        }
    }
}