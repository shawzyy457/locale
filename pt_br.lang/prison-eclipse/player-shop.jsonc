{
  "plugins": {
    "player-shop": {
      "sort": {
        "types": {
          "visits": {
            "name": "Visitas"
          },
          "votes": {
            "name": "Votos"
          }
        }
      },
      "commands": {
        "player-shop": {
          "arguments": {
            "target": {
              "name": "nome",
              "description": "Nome do dono da loja que você deseja visitar"
            }
          },
          "shop-closed": "A loja desse jogador não está aberta!"
        }
      },
      "messages": {
        "teleport": {
          "success": "<green>Você foi teleportado para a loja de {player_shop_owner_name}!</green>"
        },
        "views": {
          "player-shop-edit": {
            "state": {
              "need-coordinates-defined": "<red>Você não pode abrir sua loja sem definir a localização!</red>",
              "need-min-group": "<red>Você precisa do vip</red> <gold>{player_shop_min_group_display_name}</gold> <red>ou superior para conseguir abrir uma loja!</red>",
              "changed-success": "<green>Você alterou o estado da sua loja com sucesso!</green>"
            },
            "teleport": {
              "need-coordinates-defined": "<red>Sua loja ainda não tem uma localização definida!</red>"
            },
            "define-coordinates": {
              "success": "<green>Você alterou a localização da sua loja com sucesso!</green>"
            }
          },
          "player-shop-list": {
            "vote": {
              "cannot-vote-own": "<red>Você não pode dar um voto na sua própria loja!</red>",
              "already-voted": "<red>Você já deu um voto nessa loja!</red>",
              "success": "<green>Você deu um upvote na loja de {player_shop_owner_name}!</green>"
            }
          }
        }
      },
      "views": {
        "player-shop-edit": {
          "title": "Gerenciar loja",
          "items": {
            "0": {
              "opened": {
                "name": "<gold>Estado da loja</gold>",
                "lore": [
                  "<gray>Abra ou feche a sua loja</gray>",
                  "<gray>através desse ícone.</gray>",
                  "",
                  "<white>Estado: </white><green>Aberta</green>"
                ]
              },
              "closed": {
                "name": "<gold>Estado da loja</gold>",
                "lore": [
                  "<gray>Abra ou feche a sua loja</gray>",
                  "<gray>através desse ícone.</gray>",
                  "",
                  "<white>Estado: </white><red>Fechada</red>"
                ]
              }
            },
            "1": {
              "name": "<gold>Sua loja</gold>",
              "lore": [
                "",
                " <gold>Informações:</gold>",
                " <gold>│ </gold><white>Visitas: </white><gray>{player_shop_visits}</gray>",
                " <gold>│ </gold><aqua>⬆</aqua><gray>{player_shop_votes}</gray>",
                "",
                "<gold>Clique para teleportar.</gold>"
              ]
            },
            "2": {
              "name": "<gold>Definir localização</gold>",
              "lore": [
                "<gray>Clicando neste ícone, você irá</gray>",
                "<gray>definir a localização da sua loja no</gray>",
                "<gray>bloco que você está.</gray>",
                "",
                "<aqua>Clique para definir a localização.</aqua>"
              ]
            }
          }
        },
        "player-shop-list": {
          "title": "Lojas de jogadores",
          "items": {
            "0": {
              "name": "<red>Nenhuma loja encontrada :/</red>",
              "lore": [
                "<gray>As lojas criadas pelos</gray>",
                "<gray>jogadores estarão aqui.</gray>"
              ]
            },
            "1": {
              "name": "<gold>Sua loja</gold>",
              "lore": [
                "<gray>Gerencie e verifique as</gray>",
                "<gray>informações da sua loja.</gray>",
                "",
                " <gold>Informações</gold>",
                " <gold>│ </gold><white>Visitas: </white><gray>{player_shop_visits}</gray>",
                " <gold>│ </gold><aqua>⬆</aqua><gray>{player_shop_votes}</gray>",
                "",
                "<gold>Clique para gerenciar.</gold>"
              ]
            },
            "2": {
              "sort-type-format": {
                "active": "<aqua>▸ {player_shop_sort_type_name}</aqua>",
                "deactivate": "<dark_gray>{player_shop_sort_type_name}</dark_gray>"
              },
              "name": "<green>Filtro de procura</green>",
              "lore": [
                "<gray>Filtre o modo de procura</gray>",
                "<gray>da forma que preferir.</gray>",
                "",
                " <white>{player_shop_sort_types}</white>",
                "",
                "<aqua>Clique para alterar.</aqua>"
              ]
            },
            "3": {
              "name": "<gold>Loja de {player_shop_owner_name_with_tag}</gold>",
              "lore": [
                "<gray>Esta loja está em </gray><white>{player_shop_position}º</white><gray> lugar</gray>",
                "<gray>no ranking de </gray><white>{player_shop_sort_type_name}.</white>",
                "",
                " <gold>Informações:</gold>",
                " <gold>│ </gold><white>Visitas: </white><gray>{player_shop_visits}</gray>",
                " <gold>│ </gold><aqua>⬆</aqua><gray>{player_shop_votes}</gray>",
                "",
                "<white>Botão esquerdo: </white><gray>Visitar</gray>"
              ]
            }
          }
        }
      }
    }
  }
}
