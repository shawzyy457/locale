{
    "plugins": {
        "cubes": {
            "preferences": {
                "give-notification": {
                    "name": "<aqua>Notificação de fragmentos</aqua>",
                    "lore": [
                        "<gray>Mensagem quando se recebe um</gray>",
                        "<gray>fragmento do <white>/cubos</white>.</gray>"
                    ]
                }
            },
            "items": {
                "cubes-fragment": {
                    "display-name": "<yellow>Fragmento de Cubo</yellow>",
                    "name": "<yellow>Fragmento de Cubo</yellow>",
                    "lore": [
                        "<gray>Teste a sua sorte e se</gray>",
                        "<gray>habilite a ganhar várias</gray>",
                        "<gray>recompensas incríveis!</gray>",
                        "",
                        "<yellow>Clique para ativar e acesse</yellow>",
                        "<white>/cubos</white><yellow> para abrir!</yellow>"
                    ]
                }
            },
            "commands": {
                "cubes": {
                    "give": {
                        "arguments": {
                            "target": {
                                "name": "all / player",
                                "description": "Jogador que irá receber os fragmentos"
                            },
                            "amount": {
                                "name": "quantidade",
                                "description": "Quantidade de fragmentos que você deseja enviar"
                            }
                        },
                        "success-all": "Foram enviadas {cubes_amount} fragmentos para todos os jogadores online",
                        "success-one": "Foram enviadas {cubes_amount} fragmentos para o jogador {cubes_target_name} caso ele esteja online no servidor!"
                    }
                }
            },
            "messages": {
                "fragment-active": "<aqua><bold>WOW!</bold></aqua> <aqua>+❒{amount} fragmento ativado! </aqua><dark_gray>(/cubos)</dark_gray>",
                "fragment-found": "<aqua><bold>WOW!</bold></aqua> <aqua>+❒{amount} fragmento encontrado! </aqua><dark_gray>(/cubos)</dark_gray>",
                "views": {
                    "cubes": {
                        "collect": {
                            "success": "Você coletou {amount} fragmentos.",
                            "no-fragments": "Você não possui fragmentos suficientes."
                        },
                        "open": {
                            "success": "Você coletou um cubo!",
                            "already-opened": "Você já coletou esse cubo!",
                            "no-fragments": "Você não possui fragmentos suficientes."
                        }
                    }
                }
            },
            "views": {
                "cubes-primary": {
                    "title": "Cubos",
                    "items": {
                        "0": {
                            "name": "<yellow>Cubos aleatórios</yellow>",
                            "lore": [
                                "<gray>Sua recompensa está oculta</gray>",
                                "<gray>em um dos mistérios aqui.</gray>",
                                "",
                                "<yellow>▾ Gaste <bold>10</bold> fragmentos para</yellow>",
                                "<yellow> abrir um cubo.</yellow>",
                                "",
                                "<white>Seu saldo de fragmentos: <yellow>{cubes_fragments}"
                            ]
                        },
                        "1": {
                            "name": "<yellow>Fragmento</yellow>",
                            "lore": [
                                "<gray>Clique para recolher os</gray>",
                                "<gray>fragmentos que você possui.</gray>",
                                "<white></white>",
                                "<white>Seu saldo de fragmentos: <yellow>{cubes_fragments}"
                            ]
                        },
                        "2": {
                            "already-opened": {
                                "name": "<red>Cubo resgatado!</red>",
                                "lore": [
                                    "<gray>Este cubo já foi resgatado</gray>",
                                    "<gray>tente abrir outro cubo!</gray>"
                                ]
                            },
                            "allowed": {
                                "name": "<yellow><obfuscated>aaaaaaaaaaaa</obfuscated></yellow>",
                                "lore": [
                                    "<gray>Um item misterioso está oculto aqui.</gray>",
                                    "",
                                    "<white>Requisitos p/ abrir:</white>",
                                    "<yellow>▰ </yellow><white><bold>{cubes_fragments}x </bold>fragmentos.</white>",
                                    "",
                                    "<white>Clique para abrir.</white>"
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}