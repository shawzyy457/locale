      "commands": {
        "pet": {
          "not-allowed-with-shift": "A abertura de inventários com o shift ligado está bloqueada.",
          "not-allowed-while-inventory-open": "Você está em desincronização com o servidor, aguarde e tente novamente."
        }
      },
      "items": {
        "pet": {
          "display-name": "{pet_type_color}{pet_type_name} {pet_type_color}Pet {pet_name}",
          "name": "{pet_type_color}{pet_type_name} {pet_type_color}Pet {pet_name}",
          "lore": [
            "{pet_header_description}",
            "",
            "{pet_type_color}Informações:",
            " <white>Nível: </white><gray>{pet_level}</gray>",
            " <white>Multiplicador: </white><gray>{pet_multiplier}%</gray>",
            " <white>Progresso: {pet_progress_bar} </white><gray>{pet_progress_percent}%</gray>",
            "",
            "{pet_footer_description}"
          ],
          "lore-inventory": [
            "",
            "{pet_type_color}Clique para ativar."
          ]
        },
        "pet-food": {
          "display-name": "Ração para Pet",
          "name": "<yellow>Ração para Pet</yellow>",
          "lore": [
            "<gray>Utilize esta ração para alimentar</gray>",
            "<gray>o seu Pet, o fazendo evoluir.</gray>",
            "",
            "<yellow>Como usar?</yellow>",
            "<white>Alimente o seu pet mirando nele.</white>"
          ]
        }
      },
      "messages": {
        "name-formatted": "{pet_type_color}{pet_name} <gray>[Nvl. {pet_level}]</gray>",
        "storage": {
          "pet-storage-exceeded": "<red>Você atingiu o máximo de companheiros em seu armazém.</red>",
          "pet-storage-success": "<yellow>O seu companheiro foi armazenado, digite /pet para gerenciá-lo.</yellow>"
        },
        "upgrade": {
          "cannot-feed-other-players-pet": "Você não pode alimentar o pet de outros jogadores.",
          "pet-level-max": "Seu pet já está no nível máximo!",
          "pet-level-up": [
            "",
            "<yellow>Seu </yellow><white>Pet {pet_name} </white><yellow>atingiu o </yellow><white>nível {pet_next_level} </white><yellow>e aprimorou o seu bônus!</yellow>",
            ""
          ]
        },
        "views": {
          "pet-select": {
            "pet-removed": "<white><bold>URGH!</bold> O pet <gray>{pet_name}</gray> foi removido do armazém de companheiros.</white>",
            "pet-selected": "<white><bold>WOW!</bold> O pet <gray>{pet_name}</gray> foi equipado.</white>",
            "pet-unselected": "<white><bold>URGH!</bold> O pet <gray>{pet_name}</gray> foi desequipado.</white>"
          }
        }
      },
      "views": {
        "pet-select": {
          "title": "Armazém de companheiros",
          "0": {
            "selected": [
              "",
              "{pet_type_color}Botão esquerdo <dark_gray>➟ </dark_gray><white>Desequipar</white>",
              "{pet_type_color}Botão direito <dark_gray>➟ </dark_gray><white>Recolher</white>"
            ],
            "unselected": [
              "",
              "{pet_type_color}Botão esquerdo <dark_gray>➟ </dark_gray><white>Equipar</white>",
              "{pet_type_color}Botão direito <dark_gray>➟ </dark_gray><white>Recolher</white>"
            ]
          }
        }
      }
    }
  }
}
