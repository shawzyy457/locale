{
    "plugins": {
        "boost": {
            "commands": {
                "boost": {
                    "arguments": {
                        "key": {
                            "name": "chave",
                            "description": "A chave que será definida"
                        },
                        "multiplier": {
                            "name": "multiplicador",
                            "description": "Valor que será multiplicado"
                        }
                    },
                    "success": "<green>Você aplicou o multiplicador</green> <white>{boost_multiplier}x</white> <green>a key</green> <white>{boost_key}</white><green>!</green>"
                }
            }
        }
    }
}