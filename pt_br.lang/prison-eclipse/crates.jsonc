{
  "plugins": {
    "crates": {
      "types": {
        "mining": {
          "name": "<yellow>Chave Mineração</yellow>",
          "description": [
            "<gray>Abra esta chave e encontre</gray>",
            "<gray>diversas recompensas</gray>"
          ]
        },
        "special": {
          "name": "<dark_purple>Chave Especial</dark_purple>",
          "description": [
            "<gray>Abra esta chave e encontre</gray>",
            "<gray>diversas recompensas</gray>"
          ]
        },
        "boss": {
          "name": "<red>Chave Bosses</red>",
          "description": [
            "<gray>Abra esta chave e encontre</gray>",
            "<gray>diversas recompensas</gray>"
          ]
        },
        "farm": {
          "name": "<green>Chave Fazenda</green>",
          "description": [
            "<gray>Abra esta chave e encontre</gray>",
            "<gray>diversas recompensas</gray>"
          ]
        },
        "global": {
          "name": "<blue>Chave Global</blue>",
          "description": [
            "<gray>Abra esta chave e encontre</gray>",
            "<gray>diversas recompensas</gray>"
          ]
        },
        "fishing": {
          "name": "<aqua>Chave Pesca</aqua>",
          "description": [
            "<gray>Abra esta chave e encontre</gray>",
            "<gray>diversas recompensas</gray>"
          ]
        }
      },
      "bags": {
        "common": {
          "name": "<white></white>"
        },
        "rare": {
          "name": "<white></white>"
        },
        "epic": {
          "name": "<white></white>"
        },
        "legendary": {
          "name": "<white></white>"
        },
        "divine": {
          "name": "<white></white>"
        }
      },
      "items": {
        "crates-bag": {
          "name": "{crates_bag_rarity_name} {crates_bag_rarity_color}Bolsa de Armazenamento",
          "display-name": "{crates_bag_rarity_name} {crates_bag_rarity_color}Bolsa de Armazenamento",
          "lore": [
            "<gray>Todas as chaves que você</gray>",
            "<gray>receber em seu inventário</gray>",
            "<gray>serão depositadas diretamente</gray>",
            "<gray>nesta bolsa.</gray>",
            "",
            " {crates_bag_rarity_color}⚝ <white>Tipo:</white> Chaves",
            " {crates_bag_rarity_color}│ <white>Abertura simultânea:</white> <gray>{crates_bag_rarity_open_per_click} Chaves.</gray>"
          ],
          "lore-inventory": [
            "",
            "{crates_bag_rarity_color}Clique para gerenciar."
          ]
        },
        "crates-key": {
          "name": "{crate_name}",
          "display-name": "{crate_name}",
          "lore": [
            "{crate_description}",
            "",
            "<dark_gray>Botão direito p/ armazenar em</dark_gray>",
            "<dark_gray>uma bolsa ou /warp crates."
          ]
        }
      },
      "hooks": {
        "clans": {
          "filter": {
            "crates": {
              "selected": {
                "none": " <yellow>▸ Nenhuma Chave</yellow>",
                "all": " <yellow>▸ Todas as Chaves</yellow>",
                "other": " <yellow>▸ {crate_name_stripped}</yellow>"
              },
              "unselected": {
                "none": " <dark_gray>Nenhuma Chave</dark_gray>",
                "all": " <dark_gray>Todas as Chaves</dark_gray>",
                "other": " <dark_gray>{crate_name_stripped}</dark_gray>"
              }
            },
            "icon": {
              "with-clan": {
                "name": "<gold>Filtro de recebimento</gold>",
                "lore": [
                  "<gray>Configure as chaves que são</gray>",
                  "<gray>enviadas para o </gray><white>banco do clã</white><gray>.</gray>",
                  "",
                  "{crates_lines}",
                  "",
                  "<gold>Clique para alterar.</gold>"
                ]
              },
              "with-out-clan": {
                "name": "<gold>Filtro de recebimento</gold>",
                "lore": [
                  "<gray>Configure as chaves que são</gray>",
                  "<gray>enviadas para o </gray><white>banco do clã</white><gray>.</gray>",
                  "",
                  "<red>Você não está participando de um clã!</red>"
                ]
              }
            },
            "messages": {
              "on-crate-receive": "<yellow>Foram adicionadas </yellow><white>{crates_amount} chaves </white><yellow>ao armazém de seu clã!</yellow>"
            }
          }
        }
      },
      "holograms": {
        "crate-special": [
          "{crate_name}",
          "<gray>Aqui você encontra a sua recompensa!</gray>",
          "",
          "<white>Direito<dark_gray> ▸ <white>abrir sua chave.</white>",
          "<white>Esquerdo<dark_gray> ▸ <white>ver recompensas.</white>"
        ],
        "crate-mining": [
          "{crate_name}",
          "<gray>Aqui você encontra a sua recompensa!</gray>",
          "",
          "<white>Direito<dark_gray> ▸ <white>abrir sua chave.</white>",
          "<white>Esquerdo<dark_gray> ▸ <white>ver recompensas.</white>"
        ],
        "crate-boss": [
          "{crate_name}",
          "<gray>Aqui você encontra a sua recompensa!</gray>",
          "",
          "<white>Direito<dark_gray> ▸ <white>abrir sua chave.</white>",
          "<white>Esquerdo<dark_gray> ▸ <white>ver recompensas.</white>"
        ],
        "crate-fishing": [
          "{crate_name}",
          "<gray>Aqui você encontra a sua recompensa!</gray>",
          "",
          "<white>Direito<dark_gray> ▸ <white>abrir sua chave.</white>",
          "<white>Esquerdo<dark_gray> ▸ <white>ver recompensas.</white>"
        ],
        "crate-global": [
          "{crate_name}",
          "<gray>Aqui você encontra a sua recompensa!</gray>",
          "",
          "<white>Direito<dark_gray> ▸ <white>abrir sua chave.</white>",
          "<white>Esquerdo<dark_gray> ▸ <white>ver recompensas.</white>"
        ],
        "crate-farm": [
          "{crate_name}",
          "<gray>Aqui você encontra a sua recompensa!</gray>",
          "",
          "<white>Direito<dark_gray> ▸ <white>abrir sua chave.</white>",
          "<white>Esquerdo<dark_gray> ▸ <white>ver recompensas.</white>"
        ]
      },
      "preferences": {
        "crates-receive-notification": {
          "name": "<yellow>Notificação de chaves</yellow>",
          "lore": []
        }
      },
      "commands": {
        "crates": {
          "give": {
            "arguments": {
              "type": {
                "name": "tipo",
                "description": "Tipo da chave que será enviada"
              },
              "target": {
                "name": "all / player",
                "description": "Jogador que irá receber as chaves"
              },
              "amount": {
                "name": "quantidade",
                "description": "Quantidade de chaves que você deseja enviar"
              }
            },
            "crate-not-found": "Não foi possivel encontrar nenhuma crate com esse id!",
            "success-all": "Foram enviadas {crates_amount} chaves para todos os jogadores online",
            "success-one": "Foram enviadas {crates_amount} chaves para o jogador {crates_target_name} caso ele esteja online no servidor!"
          }
        }
      },
      "messages": {
        "notifications": {
          "crates-received-bag": "<yellow>Bolsa de Chaves! Você recebeu </yellow><white>{crate_amount} {crate_name_stripped} </white><yellow>em sua bolsa.</yellow>",
          "crates-received-inventory": "<yellow>Você recebeu </yellow><white>{crate_amount} {crate_name_stripped} </white><yellow>em seu inventário.</yellow>"
        },
        "items": {
          "crates-key": {
            "storage-success": "<yellow>Você armazenou </yellow><white>{crate_amount} {crate_name_stripped} </white><yellow>em sua bolsa.</yellow>"
          }
        },
        "open": {
          "need-click-in-block": "Vá até ao spawn ou adquira uma bolsa de chaves para abrir em qualquer lugar!",
          "block": {
            "need-crate-in-hand": "Segure uma chave na mão para abri-la",
            "invalid-crate-type": "Chave errada! Utilize a chave correspondente à crate.",
            "success": "Você abriu <white>{crates_opened_amount}</white> <green>chaves com sucesso!</green>"
          }
        },
        "views": {
          "crates": {
            "clear-filter": "Você limpou todos os filtros existentes com sucesso."
          },
          "crates-bag": {
            "clear-filter": "Você limpou todos os filtros existentes com sucesso.",
            "open": {
              "success": "Você abriu <white>{crates_opened_amount}</white> chaves!",
              "empty": "Você não possui chaves para abrir!"
            },
            "on-bag-storage": {
              "full-storage": "Não foi possivel adicionar as chaves a sua bolsa de chaves, pois ela está cheia!",
              "success-storage": "Você armazenou suas chaves em sua bolsa de chaves.",
              "inventory-empty-crates": "Você não possui chaves para armazenar."
            }
          },
          "crates-bag-filter": {
            "empty": "Você não possui chaves para fazer isso!"
          }
        }
      },
      "views": {
        "crates": {
          "title": "Chaves",
          "items": {
            "0": {
              "name": "<gold>Teleportar</gold>",
              "lore": [
                "<gray>Vá até ao local onde</gray>",
                "<gray>as chaves são abertas</gray>",
                "<white>sem limites</white><gray>.</gray>",
                "",
                "<gold>Clique para ir!</gold>"
              ]
            },
            "1": {
              "name": "<gold>Limpar Filtro</gold>",
              "lore": [
                "<gray>Volte a receber todo o</gray>",
                "<gray>tipo de itens ao limpar</gray>",
                "<gray>o filtro de recompensas.</gray>",
                "",
                "<gold>Clique para limpar!</gold>"
              ]
            },
            "2": {
              "name": "<gold>Funcionamento - Chaves</gold>",
              "lore": [
                "<gold>1.</gold> <gray>As chaves só podem ser abertas</gray>",
                "<gray>no spawn, ou através de uma bolsa</gray>",
                "<gray>de armazenamento.</gray>",
                "",
                "<gold>2.</gold> <gray>No spawn, não existe limite de</gray>",
                "<gray>chaves abertas por vez, já na</gray>",
                "<gray>bolsa, é limitado, porém, pode ser</gray>",
                "<gray>melhorado através do </gray><white>laboratório</white><gray>.</gray>",
                "",
                "<gold>Dúvidas?</gold> <dark_gray>➟</dark_gray> <white>discord.gg/exe</white>"
              ]
            },
            "3": {
              "name": "{crate_name}",
              "lore": [
                "{crate_description}",
                "",
                "<gold>Clique para visualizar!</gold>"
              ]
            }
          }
        },
        "crates-filter": {
          "title": "{crate_name_stripped} | Filtro",
          "items": {
            "0": {
              "not-filtered": {
                "lore": [
                  "",
                  "<yellow>Clique para adicionar ao filtro.</yellow>"
                ]
              },
              "already-filtered": {
                "lore": [
                  "",
                  "<yellow>Clique para remover do filtro.</yellow>"
                ]
              }
            }
          }
        },
        "crates-bag": {
          "title": "Chaves",
          "items": {
            "0": {
              "name": "<gold>Abrir Chaves!</gold>",
              "lore": [
                "<gray>Clique para abrir </gray><white>{crate_bag_open_per_click}</white>",
                "<white>chaves </white><gray>por vez.</gray>",
                "",
                "<gold>Clique para abrir!</gold>"
              ]
            },
            "1": {
              "name": "<gold>Limpar Filtro</gold>",
              "lore": [
                "<gray>Volte a receber todo o</gray>",
                "<gray>tipo de itens ao limpar</gray>",
                "<gray>o filtro de recompensas.</gray>",
                "",
                "<gold>Clique para limpar!</gold>"
              ]
            },
            "2": {
              "name": "<gold>Armazenar Chaves</gold>",
              "lore": [
                "<gray>Clique para armazenar todas</gray>",
                "<gray>as chaves do seu inventário.</gray>",
                "",
                "<gold>Clique para armazenar!</gold>"
              ]
            },
            "3": {
              "name": "{crate_name}",
              "lore": [
                "{crate_description}",
                "",
                "<white>Quantia: </white><gray>{crate_amount}</gray>"
              ]
            }
          }
        },
        "crates-bag-filter": {
          "title": "{crate_name_stripped} | Filtro",
          "items": {
            "0": {
              "name": "<gold>Abrir chaves!</gold>",
              "lore": [
                "<gray>Clique para abrir </gray><white>{crate_bag_open_per_click}</white>",
                "<white>chaves </white><gray>por vez!</gray>",
                "",
                "<gold>Clique para abrir!</gold>"
              ]
            },
            "1": {
              "name": "<gold>Retirar chaves!</gold>",
              "lore": [
                "<gray>Clique para retirar </gray><white>{crate_bag_crates_count}</white>",
                "<white>chaves</white><gray>!</gray>",
