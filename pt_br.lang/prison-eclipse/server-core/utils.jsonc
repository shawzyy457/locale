{
    "plugins": {
        "server-core": {
            "commands": {
                "trash": {
                    "inventory-title": "Lixeira",
                    "chat-message": "Abrindo lixeira virtual..."
                },
                "lantern": {
                    "success-disable": "Você desativou a lanterna.",
                    "success-enable": "Você ativou a lanterna."
                },
                "repair": {
                    "cannot-repair-custom-item": "Você não pode reparar um item customizado.",
                    "cannot-repair-item": "Você não pode reparar este item.",
                    "dont-have-currency-value": "Você precisa de {repair_currency_value_formatted} para conseguir reparar esse item!",
                    "success": "Item reparado com sucesso."
                }
            },
            "messages": {
                "confirm-drop": {
                    "item": "<yellow>Você tem certeza que deseja dropar esse item? Clique novamente para dropar.</yellow>",
                    "tool": "<yellow>Você tem certeza que deseja dropar essa ferramenta? Clique novamente para dropar.</yellow>"
                }
            }
        }
    }
}