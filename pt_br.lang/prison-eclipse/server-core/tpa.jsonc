{
  "plugins": {
    "server-core": {
      "commands": {
        "tpaccept": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que será aceito o tpa."
            }
          },
          "dont-have-request": "<red>Você não possui uma solicitação de teleporte de </red>{tpa_sender_name}<red>.</red>",
          "not-allowed-app": "<red>Você não pode aceitar pedidos de teleporte nesse local.</red>"
        },
        "tpa": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que será enviado o tpa."
            }
          },
          "already-exists": "<red>Você já possui uma solicitação de teleporte para </red>{tpa_target_name}<red>.</red>"
        },
        "tpcancel": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que será cancelado o tpa."
            }
          },
          "dont-have-request": "<red>Você não possui uma solicitação de teleporte de </red>{tpa_target_name}<red>.</red>"
        },
        "tpdeny": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que será negado o tpa."
            }
          },
          "dont-have-request": "<red>Você não possui uma solicitação de teleporte de </red>{tpa_sender_name}<red>.</red>",
          "deny-sender": [
            "<red>O jogador </red>{tpa_target_name_with_tag}<red> negou seu pedido de teleporte.</red>"
          ],
          "deny-target": [
            "<red>Você negou o pedido de teleporte de </red>{tpa_sender_name_with_tag}<red>.</red>"
          ]
        }
      },
      "messages": {
        "tpa": {
          "send": {
            "sender": [
              "<green>Solicitação de teleporte enviada para </green>{tpa_target_name_with_tag}<green>.</green>"
            ],
            "target": [
              "",
              " {tpa_sender_name_with_tag}<yellow> pediu para se teleportar até você.</yellow>",
              "<yellow>Clique</yellow> <hover:show_text:'<green>Concordar</green>'><click:run_command:'/tpaccept {tpa_sender_name}'><green><bold>AQUI</bold></green></click></hover> <yellow>para aceitar e</yellow> <hover:show_text:'<red>Negar</red>'><click:run_command:'/tpdeny {tpa_sender_name}'><red><bold>AQUI</bold></red></click></hover> <yellow>para negar.</yellow>",
              "",
              "<yellow>Este pedido será expirado em </yellow>{tpa_expire_seconds}<yellow> segundos.</yellow>",
              ""
            ]
          },
          "deny": {
            "sender": [
              "<red>O jogador </red>{tpa_target_name_with_tag}<red> negou seu pedido de teleporte.</red>"
            ],
            "target": [
              "<red>Você negou o pedido de teleporte de </red>{tpa_sender_name_with_tag}<red>.</red>"
            ]
          },
          "cancel": {
            "sender": [
              "<red>Pedido de teleporte para </red>{tpa_target_name_with_tag}<red> cancelado.</red>"
            ],
            "target": [
              "<red>Pedido de teleporte de </red>{tpa_sender_name_with_tag}<red> cancelado.</red>"
            ]
          },
          "expired": {
            "sender": [
              "<red>O pedido de teleporte para </red>{tpa_target_name_with_tag}<red> foi expirado.</red>"
            ],
            "target": [
              "<red>O pedido de teleporte de </red>{tpa_sender_name_with_tag}<red> foi expirado.</red>"
            ]
          },
          "accepted": {
            "sender": [
              "<green>Pedido de teleporte para </green>{tpa_target_name_with_tag}<green> aceito.</green>"
            ],
            "target": [
              "<green>Pedido de teleporte de </green>{tpa_sender_name_with_tag}<green> aceito.</green>"
            ]
          }
        }
      }
    }
  }
}
