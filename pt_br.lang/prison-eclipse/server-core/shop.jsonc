            },
            "views": {
                "shop-primary": {
                    "title": "Loja de itens",
                    "items": {
                        "0": {
                            "name": "{shop_category_name}",
                            "lore": [
                                "{shop_category_description}",
                                "",
                                "<green>Clique para acessar!</green>"
                            ]
                        }
                    }
                },
                "shop-category": {
                    "title": "Loja de itens ➟ {shop_category_name}",
                    "items": {
                        "0": {
                            "with-discount": {
                                "can-buy": {
                                    "name": "{shop_category_item_name}",
                                    "lore": [
                                        "",
                                        "<white>Custo:</white> {shop_category_item_cost_formatted}",
                                        "",
                                        " <gray>Você possui o grupo {user_group_tag_with_color}<gray> então",
                                        " <gray>recebe <white>{shop_category_item_cost_discount}%</white> de desconto.</gray>",
                                        "",
                                        "<green>Clique para comprar!</green>"
                                    ]
                                },
                                "cannot-buy": {
                                    "name": "{shop_category_item_name}",
                                    "lore": [
