{
  "plugins": {
    "tutorial": {
      "views": {
        "select-view": {
          "title": "Tutorial",
          "items": {
            "currencies": {
              "name": "<green>Moedas</green>",
              "lore": [
                "<gray>Entenda tudo sobre os</gray>",
                "<gray>tipos de </gray><white>Moedas</white><gray> clicando</gray>",
                "<gray>aqui!</gray>",
                "",
                "<green>Clique para saber mais.</green>"
              ]
            },
            "system": {
              "name": "<gold>Sistemas do Servidor</gold>",
              "lore": [
                "<gray>Dúvidas sobre o sistema?</gray>",
                "<gray>Você achou o lugar perfeito!</gray>",
                "",
                "<gold>Clique para acessar</gold>"
              ]
            },
            "basic-commands": {
              "name": "<yellow>Comandos básicos</yellow>",
              "lore": [
                "<gray>Confira a lista de comandos</gray>",
                "<gray>que você irá necessitar ao</gray>",
                "<gray>longo de toda sua jogatina.</gray>",
                "",
                "<yellow>Clique para acessar</yellow>"
              ]
            }
          }
        },
        "currencies-view": {
          "title": "Moedas",
          "items": {
            "coins": {
              "name": "<green>Coins </green><white>[</white><dark_green>$</dark_green><white>]</white>",
              "lore": [
                "<gray>As coins são uma moeda obtida</gray>",
                "<gray>inicialmente na mina, e também</gray>",
                "<gray>nos spawners.</gray>",
                "<yellow></yellow>",
                "<green><bold>Utilidades ▾</bold></green>",
                "<gray> Adquirir </gray><white>/spawners</white><gray>;</gray>",
                "<gray> Comprar itens no </gray><white>/loja</white><gray>;</gray>",
                "<gray> Conseguir </gray><white>/prestigio</white><gray>;</gray>",
                "<gray> Comprar itens nas </gray><white>/lojas</white><gray>.</gray>",
                "<yellow></yellow>",
                "<green>Psst! A mina é o lugar ideal para</green>",
                "<green>ganhar coins no início!</green>"
              ]
            },
            "sparks": {
              "name": "<gold>Faíscas </gold><white>[</white><gold>⚡</gold><white>]</white>",
              "lore": [
                "<gray>As faíscas são a moeda da</gray>",
                "<gray>zona de </gray><white>/farm</white><gray>.</gray>",
                "<yellow></yellow>",
                "<gold> Com elas, você pode:</gold>",
                "<dark_gray> ► </dark_gray><white>Melhorar a sua farm;</white>",
                "<dark_gray> ► </dark_gray><white>Comprar encant. na /foice;</white>",
                "<dark_gray> ► </dark_gray><white>Aumentar o looting da sua</white>",
                "<dark_gray> </dark_gray><yellow> </yellow><dark_gray> ► </dark_gray><white>/espada</white><gray>.</gray>",
                "<dark_gray> ► </dark_gray><white>Adquirir geradores de faíscas;</white>",
                "<dark_gray> ► </dark_gray><white>Melhorar as suas máquinas</white><gray>.</gray>",
                "<yellow></yellow>",
                "<gold>Os geradores de faíscas são </gold>",
                "<gold>formas de render faíscas de </gold>",
                "<gold>modo automático.</gold>"
              ]
            },
            "tokens": {
              "name": "<light_purple>Tokens </light_purple><white>[</white><light_purple>⛁</light_purple><white>]</white>",
              "lore": [
                "<gray>O token é a moeda focada na</gray>",
                "<white>/mina</white><gray>, você pode comprar os</gray>",
                "<gray>upgrades e encantamentos da</gray>",
                "<gray>sua picareta e mina usando os</gray>",
                "<light_purple>Tokens</light_purple><gray>.</gray>",
                "<yellow></yellow>",
                "<light_purple> ▾</light_purple><gray> Adicionalmente, o ganho de</gray>",
                "<dark_purple> </dark_purple><yellow> </yellow><gray> tokens pode ser maximizado</gray>",
                "<dark_purple> </dark_purple><yellow> </yellow><gray> upando o encantamento da</gray>",
                "<dark_purple> </dark_purple><yellow> </yellow><gray>picareta </gray><white>Tokenator</white><gray>.</gray>",
                "<yellow></yellow>",
                "<white>Boosters e skins de picareta</white>",
                "<white>aumentam o ganho de tokens.</white>"
              ]
            },
            "elixir": {
              "name": "<dark_purple>Elixir </dark_purple><white>[</white><dark_purple>〄</dark_purple><white>]</white>",
              "lore": [
                "<gray>Uma moeda acumulável na</gray>",
                "<gray>picareta, podendo ser</gray>",
                "<gray>utilizada na </gray><white>/minaafk</white><gray>.</gray>",
                "<yellow></yellow>",
                "<dark_purple> ▾</dark_purple><gray> Você pode aumentar o</gray>",
                "<dark_purple> </dark_purple><yellow> </yellow><gray>ganho de </gray><dark_purple>Elixir</dark_purple><gray> evoluindo</gray>",
                "<dark_purple> </dark_purple><yellow> </yellow><gray> o upgrade da mina </gray><dark_purple>Tanque</dark_purple>",
                "<dark_purple> </dark_purple><yellow> </yellow><dark_purple> de Elixir</dark_purple><gray>.</gray>",
                "<yellow></yellow>",
                "<white>A quantia de ganhos na mina</white>",
                "<white>afk é melhorada consoante</white>",
                "<white>o nível e upgrades da sua mina.</white>"
              ]
            },
            "power": {
              "name": "<gold>Poder de Compra </gold><white>[</white><gold>∞</gold><white>]</white>",
              "lore": [
                "<gray>O Poder serve para aumentar</gray>",
                "<gray>o seu limite de compra de</gray>",
                "<gray>geradores por vez.</gray>",
                "<yellow></yellow>",
                "<gold>Adquirido através de uma máquina.</gold>"
              ]
            },
            "pontos": {
              "name": "<dark_gray>Pontos </dark_gray><white>[</white><dark_gray>∴</dark_gray><white>]</white>",
              "lore": [
                "<gray>Os pontos são obtidos após</gray>",
                "<gray>a venda de peixes no </gray><white>/pesca</white><gray>.</gray>",
                "<white></white>",
                "<white>Consiga <bold>VIP's</bold> </white><white>e itens pagos</white>",
                "<white>de uma forma gratuita com os</white>",
                "<white>pontos na loja da pesca!</white>"
              ]
            }
          }
        },
        "basic-commands": {
          "title": "Comandos Básicos",
          "items": {
            "foice": {
              "name": "<yellow>/foice</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>recebe a enxada para farmar</gray>",
                "<gray>na </gray><white>/farm</white><gray>.</gray>"
              ]
            },
            "espada": {
              "name": "<yellow>/espada</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>recebe uma espada de farm</gray>",
                "<gray>para matar mobs do spawner.</gray>"
              ]
            },
            "matadora": {
              "name": "<yellow>/matadora</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>recebe uma espada para matar</gray>",
                "<gray>bosses.</gray>",
                "<white></white>",
                "<red>A HitKill é adquirível no site:</red>",
                "<white>exe.com</white>"
              ]
            },
            "capacete": {
              "name": "<yellow>/capacete</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>recebe um capacete que ao</gray>",
                "<gray>equipar, você recebe mais drops</gray>",
                "<gray>na </gray><white>/farm</white><gray>.</gray>"
              ]
            },
            "on-off": {
              "name": "<yellow>/on & /off</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>esconde ou mostra os players.</gray>"
              ]
            },
            "lixeira": {
              "name": "<yellow>/lixeira</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>pode jogar itens fora.</gray>"
              ]
            },
            "warps": {
              "name": "<yellow>/warps</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>abre um menu de fácil acesso</gray>",
                "<gray>a várias localizações do server.</gray>"
              ]
            },
            "sethome_home": {
              "name": "<yellow>/sethome & /home</yellow>",
              "lore": [
                "<gray>Utilizando esse comando, você</gray>",
                "<gray>consegue setar uma home ou</gray>",
                "<gray>teleportar para uma home já</gray>",
                "<gray>existente.</gray>"
              ]
            }
          }
        },
        "systems": {
          "title": "Sistemas do servidor",
          "items": {
            "mina_privada": {
              "name": "<yellow>Mina Privada </yellow><dark_gray>(/mina)</dark_gray>",
              "lore": [
                "<gray>O local ideal para se iniciar</gray>",
                "<gray>no servidor. Crie a sua mina</gray>",
                "<gray>e inicie a sua jornada!</gray>",
                "",
                "<dark_gray> ▾ </dark_gray><yellow>Funcionalidade da mina:</yellow>",
                "<gray> A mina tem no total 100 níveis,</gray>",
                "<gray> mudando de bloco a cada 5, e</gray>",
                "<gray> aumentando os coins e tokens</gray>",
                "<gray> ao longo desses níveis.</gray>",
                "<gray> Ao longo da mineração, o player</gray>",
                "<gray> pode adquirir upgrades no menu</gray>",
                "<gray> da mina, que têm melhorias visuais</gray>",
                "<gray> em toda a zona de mineração.</gray>",
                "",
                "<yellow>Além de tudo isso, o jogador pode</yellow>",
                "<yellow>utilizar </yellow><white>/prestigio </white><yellow>no nível <bold>100 </bold>e</yellow>",
                "<yellow>aumentar ainda mais os seus lucros.</yellow>"
              ]
            },
            "picareta": {
              "name": "<yellow>Picareta</yellow>",
              "lore": [
                "<gray>Uma picareta exclusiva à</gray>",
                "<gray>zona de mineração.</gray>",
                "",
                "<yellow> Como evoluir?</yellow>",
                "<gray> Clicando botão direito, um</gray>",
                "<gray> menu irá abrir repleto de </gray>",
                "<gray> encantamentos que irão</gray>",
                "<gray> multiplicar os seus lucros.</gray>",
                "",
                "<yellow> Skins de picareta são ótimas</yellow>",
                "<yellow> formas de conseguir vantagem</yellow>",
                "<yellow> sobre os demais jogadores.</yellow>"
              ]
            },
            "farm": {
              "name": "<green>Farm </green><dark_gray>(/farm)</dark_gray>",
              "lore": [
                "<gray>Um mundo dedicado à zona</gray>",
                "<gray>de farm.</gray>",
                "",
                "<green> Funcionamento:</green>",
                "<gray> Digite </gray><white>/foice</white><gray> e inicie a sua</gray>",
                "<gray> colheita. Lembrando, a sua</gray>",
                "<gray> foice e sua farm podem ser</gray>",
                "<gray> melhoradas usando faíscas,</gray>",
                "<gray> a moeda da farm.</gray>",
                "<gray> O NPC presente no início da </gray>",
                "<gray> farm tem tudo o que você</gray>",
                "<gray> precisa de saber sobre as</gray>",
                "<gray> melhorias da farm e armazém.</gray>"
              ]
            },
            "pesca": {
              "name": "<aqua>Pesca </aqua><dark_gray>(/pesca)</dark_gray>",
              "lore": [
                "<gray>Um mundo dedicado à pescaria.</gray>",
                "",
                "<aqua> Como funciona?</aqua>",
                "<gray> Basta atirar a linha da vara até</gray>",
                "<gray> o oceano e você já começa a</gray>",
                "<gray> pescar. Enquanto você pesca, é</gray>",
                "<gray> possível encontrar </gray><white>peixes </white><gray>e</gray>",
                "<gray> </gray><white>pérolas</white><gray>, os</gray>",
                "<gray> peixes podendo ser</gray>",
                "<gray> vendidos por </gray><dark_green>$</dark_green><white>Coins e </white><dark_gray>∴Pontos</dark_gray><gray>, e</gray>",
                "<gray> as pérolas servem para evoluir os</gray>",
                "<white> encantamentos </white><gray>da sua vara.</gray>"
              ]
            },
            "crates": {
              "name": "<yellow>Chaves </yellow><dark_gray>(/crates)</dark_gray>",
              "lore": [
                "<gray>Consiga chaves e adquira itens</gray>",
                "<gray>muito úteis no servidor.</gray>",
                "",
                "<yellow> Como funciona?</yellow>",
                "<gray> Nestas chaves, é possível ganhar</gray>",
                "<white> cheques</white><gray>, </gray><white>bosses </white><gray>e até </gray><white>itens especiais</white>",
                "<gray> de forma totalmente gratuita dentro do</gray>",
                "<gray> servidor. É possível obtê-las, a partir</gray>",
                "<gray> de diversos sistemas, como a </gray><white>fazenda</white><gray>,</gray>",
                "<gray> a </gray><white>mina</white><gray>, a</gray><white>pesca</white><gray>, e até em </gray><white>bosses</white><gray>.</gray>",
                "",
                "<yellow>Estas chaves são a melhor forma de começar</yellow>",
                "<yellow>e evoluir dentro deste servidor.</yellow>"
              ]
            },
            "clans": {
              "name": "<gold>Clãs</gold>",
              "lore": [
                "<gray>Junte-se com seus amigos</gray>",
                "<gray>e caminhem juntos até ao</gray>",
                "<gray>topo!</gray>",
                "",
                "<gray> ➠ </gray><white>/clan criar <tag> <nome></white>",
                "<gold>Todas as permissões do seu</gold>",
                "<gold>clã são configuráveis e você</gold>",
                "<gold>também tem acesso ao baú do</gold>",
                "<gold>clã e armazém de chaves e </gold>",
                "<gold>bosses.</gold>"
              ]
            },
            "cheques": {
              "name": "<green>Cheques </green><dark_gray>(/cheques)</dark_gray>",
              "lore": [
                "<gray>Uma forma diferente de </gray>",
                "<gray>guardar dinheiro!</gray>",
                "",
                "<green> Como eu crio um cheque?</green>",
                "<gray> Acesse o menu de </gray><white>/cheques</white>",
                "<gray> e clique na moeda desejada</gray>",
                "<gray> depois disso, digite a quantia</gray>",
                "<gray> no chat e pronto!</gray>",
                "",
                "<green> Clique direito para ativar.</green>"
              ]
            },
            "bosses": {
              "name": "<gold>Bosses </gold><dark_gray>(/bosses)</dark_gray>",
              "lore": [
                "<gray>Os bosses são monstros</gray>",
                "<gray>de alta recompensa que</gray>",
                "<gray>são conseguidos na maior</gray>",
                "<gray>parte pelas crates.</gray>",
                "",
                "<gold> Como adquirir bosses:</gold>",
                "<dark_gray> ► </dark_gray><white>Conseguindo Crates Boss;</white>",
                "<dark_gray> ► </dark_gray><white>Através dos Kits dos VIP's.</white>",
                "",
                "<gold>Após você amtar o boss, digite</gold>",
                "<white>/bosses</white><gold> e vá em recompensas</gold>",
                "<gold>para coletar os itens.</gold>",
                "",
                "<dark_gray>A sua matadora ganha XP por </dark_gray>",
                "<dark_gray>hit, podendo assim aumentar o </dark_gray>",
                "<dark_gray>dano causado em bosses.</dark_gray>"
              ]
            },
            "spawners": {
              "name": "<green>Spawners </green><dark_gray>(/spawners)</dark_gray>",
              "lore": [
                "<gray>A maior fonte de renda de coins!</gray>",
                "",
                "<green> Como desbloqueio um spawner?</green>",
                "<gray> Para desbloquear um spawner,</gray>",
                "<gray> você necessita de acumular as</gray>",
                "<white> /colecoes </white><gray>do spawner anterior,</gray>",
                "<gray> de acordo com o que o spawner</gray>",
                "<gray> seguinte pede.</gray>",
                "",
                "<green>Todos os spawners têm um tempo</green>",
                "<green>definido até liberarem.</green>"
              ]
            },
            "tempo_online": {
              "name": "<green>Tempo Online </green><dark_gray>(/tempo)</dark_gray>",
              "lore": [
                "<gray>Receba recompensas incríveis</gray>",
                "<gray>apenas por investir tempo no</gray>",
                "<gray>servidor.</gray>",
                "",
                "<green>Eii! As recompensas ficam mais</green>",
                "<green>interessantes com o passar do</green>",
                "<green>tempo...</green>"
              ]
            },
            "loja_de_placas": {
              "name": "<gold>Loja de Placas </gold><dark_gray>(/lojas)</dark_gray>",
              "lore": [
                "<gray>Este sistema permite que os</gray>",
                "<gray>jogadores criem suas lojas</gray>",
                "<gray>em seus terrenos para comprar</gray>",
                "<gray>e vender itens entre si.</gray>",
                "",
                "<yellow> ▾ </yellow><gray>Como fazer a sua <bold>própria</bold> loja?</gray>",
                "<white> 1º Passo: </white><gray>Pegue uma placa;</gray>",
                "<white> 2º Passo: </white><gray>Coloque a placa em um baú;</gray>",
                "<white> 3º Passo: </white><gray>Digite 'Loja' na primeira linha</gray>",
                "<gray>           da placa e feche a placa.</gray>",
                "<dark_gray>Por padrão, sua loja está desativada.</dark_gray>",
                "<dark_gray>Clique com o botão direito na placa</dark_gray>",
                "<dark_gray>para abrir as configurações</dark_gray>",
                "<dark_gray>e mudar o status para 'Aberto'.</dark_gray>"
              ]
            },
            "meta_global": {
              "name": "<green>Meta Global </green><dark_gray>(/metas)</dark_gray>",
              "lore": [
                "<gray>A meta global é concluída quando</gray>",
                "<gray>todos os jogadores se juntarem</gray>",
                "<gray>e alcançarem a meta atual.</gray>",
                "",
                "<green> ▾ </green><gray>A meta global é rotativa, e asua</gray>",
                "<gray>   recompensa é aumentada a cada</gray>",
                "<gray>   vez que cai em algo que já foi</gray>",
                "<gray>   completada anteriormente.</gray>",
                "",
                "<green>As metas variam entre Mineração,</green>",
                "<green>Pesca, Farm, Bosses, Geradores,</green>",
                "<green>Site e Crates.</green>"
              ]
            },
            "leilao": {
              "name": "<yellow>Leilão </yellow><dark_gray>(/leilao)</dark_gray>",
              "lore": [
                "<gray>Crie seus leilões ou leiloe</gray>",
                "<gray>itens dos outros, o player</gray>",
                "<gray>com o maior lance, leva o</gray>",
                "<gray>item!</gray>",
                "",
                "<yellow>Fique atento!</yellow>"
              ]
            },
            "eventos": {
              "name": "<aqua>Eventos</aqua>",
              "lore": [
                "<gray>Onde a diversão acontece! Os</gray>",
                "<gray>eventos são minigames que os</gray>",
                "<gray>players podem participar e ao</gray>",
                "<gray>vencer, eles são premiados.</gray>",
                "",
                "<aqua>Eventos: </aqua><white>Sumô, Fight, Stick rush...</white>"
              ]
            },
            "pets": {
              "name": "<gold>Pets </gold><dark_gray>(/pet e /pets)</dark_gray>",
              "lore": [
                "<gray>Os pets são companheiros que</gray>",
                "<gray>após ativados, dão boosts em</gray>",
                "<gray>vários sistemas: </gray><white>Mineração</white><gray>, </gray><white>PvP</white><gray>,</gray>",
                "<gray> </gray><white>Spawners</white><gray>, </gray><white>Farm</white><gray>, e </gray><white>Pesca</white><gray>.</gray>",
                "",
                "<gold> ▾ </gold><gray>Além disso, os pets evoluem o </gray>",
                "<gray>   multiplicador do booster ao</gray>",
                "<gray>   serem alimentados com ração.</gray>",
                "",
                "<gold>Você pode conseguir pets abrindo</gold>",
                "<gold>ovos e acessando: </gold><white>exe.com</white>"
              ]
            }
          }
        }
      }
    }
  }
}
