{
  "plugins": {
    "server-core": {
      "pet-egg": {
        "types": {
          "common": {
            "name": "<white></white> <green>OVO PET</green>",
            "description": [
              "<gray>Este ovo contém um pet</gray>",
              "<gray>de raridade comum.</gray>"
            ]
          },
          "divine": {
            "name": "<white></white> <dark_red>OVO PET</dark_red>",
            "description": [
              "<gray>Este ovo contém um pet</gray>",
              "<gray>de raridade divina.</gray>"
            ]
          },
          "epic": {
            "name": "<white></white> <dark_purple>OVO PET</dark_purple>",
            "description": [
              "<gray>Este ovo contém um pet</gray>",
              "<gray>de raridade épica.</gray>"
            ]
          },
          "legendary": {
            "name": "<white></white> <gold>OVO PET</gold>",
            "description": [
              "<gray>Este ovo contém um pet</gray>",
              "<gray>de raridade lendária.</gray>"
            ]
          },
          "random": {
            "name": "<yellow>OVO PET ALEATÓRIO</yellow>",
            "description": [
              "<gray>Este ovo contém um pet</gray>",
              "<gray>de raridade aleatória.</gray>"
            ]
          },
          "rare": {
            "name": "<white></white> <aqua>OVO PET</aqua>",
            "description": [
              "<gray>Este ovo contém um pet</gray>",
              "<gray>de raridade raro.</gray>"
            ]
          }
        }
      },
      "items": {
        "pet-egg": {
          "display-name": "{pet_egg_name}",
          "name": "{pet_egg_name}",
          "lore": [
            "{pet_egg_description}"
          ],
          "lore-inventory": [
            "",
            "{pet_egg_color}Clique para abrir!"
          ]
        }
      },
      "messages": {
        "pet-egg": {
          "opened": "<green><bold>WOW!</bold> Você encontrou um</green> {pet_rarity_color}{pet_name} <green>no ovo.</green>"
        }
      }
    }
  }
}
