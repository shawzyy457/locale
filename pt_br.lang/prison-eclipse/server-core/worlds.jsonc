{
    "plugins": {
        "server-core": {
            "worlds": {
                "apocalyptic": {
                    "name": "Mundo Apocalíptico",
                    "description": [
                        "<gray>Lute pela sua vida em",
                        "<gray>um mundo de ruinas",
                        "<gray>dominado por zumbis."
                    ]
                },
                "cemetery": {
                    "name": "Cemitério",
                    "description": [
                        "<gray>Um mundo sombrio, com",
                        "<gray>uma atmosfera de mistério",
                        "<gray>e morte."
                    ]
                },
                "nether": {
                    "name": "Submundo",
                    "description": [
                        "<gray>Um vazio assustador, e por",
                        "<gray>trás disso, o boss final."
                    ]
                },
                "the-end": {
                    "name": "Cemitério",
                    "description": [
                        "<gray>Lute pela sua vida em",
                        "<gray>um mundo de ruinas",
                        "<gray>dominado por zumbis."
                    ]
                }
            },
            "messages": {
                "views": {
                    "server-worlds": {
                        "dont-have-requirements": "Você não tem os requisitos para acessar esse mundo"
                    }
                }
            },
            "views": {
                "server-worlds": {
                    "title": "Mundos",
                    "items": {
                        "0": {
                            "has-requirements": {
                                "name": "{server_world_color}{server_world_name}",
                                "lore": [
                                    "{server_world_description}",
                                    "",
                                    "{server_world_color}Clique para acessar."
                                ]
                            },
                            "dont-have-requirements": {
                                "name": "{server_world_color}{server_world_name}",
                                "lore": [
                                    "{server_world_description}",
                                    "",
                                    " {server_world_color}Requisitos:",
                                    " <dark_gray>▸ <white>{server_world_requirements}",
                                    "",
                                    "{server_world_color}Você não tem os requisitos."
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}