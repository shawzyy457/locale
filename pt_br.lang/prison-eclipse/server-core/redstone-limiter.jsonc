{
    "plugins": {
        "server-core": {
            "commands": {
                "redstone": {
                    "configure": {
                        "arguments": {
                            "option": {
                                "name": "on/off/info/interval [ticks]/amount [value]",
                                "description": ""
                            }
                        },
                        "tick": {
                            "on": "Limitador de redstone ligado.",
                            "off": "Limitador de redstone desligado.",
                            "info": [
                                " <yellow>Estado: {redstone_tick_enabled}</yellow>",
                                " <yellow>Intervalo: {redstone_tick_interval}</yellow>",
                                " <yellow>Quantidade/Intervalo: {redstone_tick_amount}</yellow>"
                            ],
                            "update": "Quantidade de redstone ticks por intervalo alterada para {redstone_tick_amount}."
                        },
                        "debug": {
                            "on": "Debug ligado.",
                            "off": "Debug desligado."
                        }
                    },
                    "list": {
                        "arguments": {
                            "page": {
                                "name": "página",
                                "description": "Página que você deseja visualizar"
                            }
                        },
                        "success-chunk-line": "<gray>#{redstone_chunk_index}</gray> <yellow>{redstone_chunk_use_percent}%</yellow> <green>{redstone_chunk_world} ({redstone_chunk_x},{redstone_chunk_z})</green> <gray>{redstone_chunk_use_count}</gray>",
                        "success": [
                            "",
                            "<gold>---------</gold> <yellow>Redstone Chunks {redstone_list_page}/{redstone_list_max_page}</yellow> <gold>---------</gold>",
                            "",
                            "{redstone_chunks}",
                            ""
                        ]
                    }
                }
            },
            "messages": {
                "redstone-limiter": {
                    "too-many-redstone-circuits": "Muitos circuitos de redstone na mesma região."
                }
            }
        }
    }
}