{
  "plugins": {
    "server-core": {
      "items": {
        "mythic-armory-heal-wand": {
          "display-name": "{wand_rarity_color}{wand_rarity_name_upper_case} {wand_rarity_color}Varinha de Cura",
          "name": "{wand_rarity_color}{wand_rarity_name_upper_case} {wand_rarity_color}Varinha de Cura",
          "lore": [
            "<gray>Uma varinha capaz de curar</gray>",
            "<gray>você mesmo pelo preço de Mana.</gray>",
            "",
            " {wand_rarity_color}Estatísticas:",
            " <dark_gray>▸<red> {wand_health_per_second}❤ Vida por segundo p/ {wand_duration}s</red>",
            " <dark_gray>▸<aqua> {wand_mana}⚝ Mana por uso",
            " <dark_gray>▸<white> {wand_delay}s Tempo de Recarga</white>",
            "",
            "{wand_rarity_color}Clique para utilizar!"
          ]
        },
        "mythic-armory-teleport-wand": {
          "display-name": "{wand_rarity_color}{wand_rarity_name_upper_case} {wand_rarity_color}Varinha de Teleporte",
          "name": "{wand_rarity_color}{wand_rarity_name_upper_case} {wand_rarity_color}Varinha de Teleporte",
          "lore": [
            "<gray>Uma varinha capaz de teleportar</gray>",
            "<gray>você pelo custo de Mana.</gray>",
            "",
            " {wand_rarity_color}Estatísticas:",
            " <dark_gray>▸<aqua> {wand_mana}⚝ Mana por uso",
            " <dark_gray>▸<white> {wand_distance} Blocos por uso</white>",
            "",
            "{wand_rarity_color}Clique para utilizar!"
          ]
        }
      },
      "messages": {
        "items": {
          "wand": {
            "heal": {
              "in-cooldown": "<red>Você precisa aguardar {wand_delay_remaining} para usar novamente.</red>",
              "dont-have-mana": "<red>Você não possui mana para usar novamente.</red>"
            },
            "teleport": {
              "dont-have-mana": "<red>Você não possui mana para usar novamente.</red>"
            }
          }
        },
        "hooks": {
          "mythic-armory": {
            "on-death": [
              "",
              "<red>Você morreu e perdeu <yellow>{death_experience_loss}</yellow> de experiência.</red>",
              ""
            ]
          }
        }
      }
    }
  }
}
