{
    "plugins": {
        "server-core": {
            "commands": {
                "autoclick": {
                    "success-activated": "Auto click ativado!",
                    "success-disabled": "<red>Auto click desativado!</red>"
                },
                "fly": {
                    "not-allowed-in-app": "OPS! Parece que você não pode mudar seu modo de vôo aqui!",
                    "success-disabled": "<red>Modo de vôo desabilitado com sucesso!</red>",
                    "success-disable-with-gamemode": "<red>Modo de vôo desabilitado com sucesso, porém seu vôo não foi desabilitado por você estar no modo criativo ou espectador!</red>",
                    "success-activated": "Modo vôo habilitado com sucesso!"
                },
                "off": {
                    "already-disabled": "Todos os jogadores já estão invisíveis.",
                    "success": "Agora todos os jogadores estão invisíveis."
                },
                "on": {
                    "already-activated": "Você já consegue ver todos os jogadores.",
                    "success": "Agora você consegue ver todos os jogadores."
                }
            }
        }
    }
}