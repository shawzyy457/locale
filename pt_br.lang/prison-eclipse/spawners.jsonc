      "commands": {
        "spawner": {
          "give": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que irá receber o spawner"
              },
              "type": {
                "name": "tipo",
                "description": "Tipo do spawner que o jogador irá receber"
              },
              "amount": {
                "name": "quantidade",
                "description": "Quantidade de spawners que o jogador irá receber"
              }
            },
            "spawner-type-not-found": "Não foi possível encontrar esse tipo de spawner"
          }
        },
        "sell": {
          "in-delay": "Você precisa esperar para vender novamente!",
          "dont-have-drops": "Não existem drops para serem vendidos perto de você!"
        }
      },
      "items": {
        "spawner-artifact": {
          "name": "<green>{spawner_artifact_name_singular}</green>",
          "display-name": "<green>{spawner_artifact_name_singular}</green>",
          "lore": [
            "{spawner_artifact_description}",
            "",
            " <dark_gray>▸ </dark_gray><white>Quantidade: </white><gray>{spawner_artifact_amount}</gray>"
