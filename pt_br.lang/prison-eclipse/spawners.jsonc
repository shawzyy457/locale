          "need-command": "<red>Utilize <white>/vender <red>para vender.</red>",
          "success": "<color:#ff8200>Venda! <white>+{spawner_sell_value_formatted}</white><dark_gray>· </dark_gray><gray>(+{spawner_user_sell_bonus}% {user_group_name_with_color})</gray>"
