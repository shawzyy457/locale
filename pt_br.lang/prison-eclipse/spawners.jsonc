          "lore-inventory": [
            "",
            "<green>Clique para armazenar.</green>"
          ]
        },
        "spawner-multiplier": {
          "name": "{spawner_multiplier_type_color}Multiplicador de Monstros",
          "display-name": "{spawner_multiplier_type_color}Multiplicador de Monstros",
          "lore": [
            "<gray>Aumente o número de {spawner_multiplier_type_name_lower_case}</gray>",
            "<gray>que são gerados por vez no</gray>",
            "<gray>seu <white>gerador de monstros</white>.</gray>",
            "",
