{
    "plugins": {
        "bosses": {
            "types": {
                "zombie": {
                    "name": "<green>BOSS ZUMBI</green>",
                    "stack-display-name": "<green>{boss_amount}x BOSS ZUMBI</green>",
                    "description": [
                        "<gray>Utilize esse boss dentro</gray>",
                        "<gray>do seu terreno.</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível I</gray>"
                    ]
                },
                "skeleton": {
                    "name": "<gray>BOSS ESQUELETO</gray>",
                    "stack-display-name": "<gray>{boss_amount}x BOSS ESQUELETO</gray>",
                    "description": [
                        "<gray>Utilize este boss dentro</gray>",
                        "<gray>do seu terreno.</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível II</gray>"
                    ]
                },
                "guardian": {
                    "name": "<dark_aqua>BOSS GUARDIÃO</dark_aqua>",
                    "stack-display-name": "<dark_aqua>{boss_amount}x BOSS GUARDIÃO</dark_aqua>",
                    "description": [
                        "<gray>Utilize este boss dentro</gray>",
                        "<gray>do seu terreno.</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível III</gray>"
                    ]
                },
                "blaze": {
                    "name": "<gold>BOSS BLAZE</gold>",
                    "stack-display-name": "<gold>{boss_amount}x BOSS BLAZE</gold>",
                    "description": [
                        "<gray>Utilize este boss dentro</gray>",
                        "<gray>do seu terreno.</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível IV</gray>"
                    ]
                },
                "bastet": {
                    "name": "<yellow>BOSS BASTET</yellow>",
                    "stack-display-name": "<yellow>{boss_amount}x BOSS BASTET</yellow>",
                    "description": [
                        "<gray>Utilize este boss dentro</gray>",
                        "<gray>do seu terreno.</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível V</gray>"
                    ]
                },
                "kraken": {
                    "name": "<blue>BOSS KRAKEN</blue>",
                    "stack-display-name": "<blue>{boss_amount}x BOSS KRAKEN</blue>",
                    "description": [
                        "<gray>Utilize este boss dentro</gray>",
                        "<gray>do seu terreno.</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível VI</gray>"
                    ]
                },
                "supreme": {
                    "name": "<dark_red>BOSS SUPREMO</dark_red>",
                    "stack-display-name": "<dark_red>{boss_amount}x BOSS SUPREMO</dark_red>",
                    "description": [
                        "<gray>Um boss um pouco diferente, alguns</gray>",
                        "<gray>alguns o chamam de final boss...</gray>",
                        "",
                        "<white>Raridade: </white><gray>Nível ???</gray>"
                    ]
                }
            },
            "killer": {
                "enchantments": {
                    "damage": {
                        "name": "Dano",
                        "description": [
                            "<gray>Este encantamento de permite</gray>",
                            "<gray>causar mais dano em bosses.</gray>"
                        ]
                    },
                    "unbreakable": {
                        "name": "Inquebrável",
                        "description": [
                            "<gray>Este encantamento aumenta a</gray>",
                            "<gray>durabilidade da matadora.</gray>"
                        ]
                    },
                    "auto-forge": {
                        "name": "Auto Forja",
                        "description": [
                            "<gray>Aumente o quanto a sua espada</gray>",
                            "<gray>se repara automaticamente.</gray>"
                        ]
                    },
                    "critical": {
                        "name": "Crítico",
                        "description": [
                            "<gray>Tenha a chance de causar o</gray>",
                            "<gray>dobro de dano no seu boss.</gray>"
                        ]
                    },
                    "hit-kill": {
                        "name": "Hit Kill",
                        "description": [
                            "<gray>Elimine todos os bosses</gray>",
                            "<gray>com apenas um hit.</gray>"
                        ]
                    },
                    "kill-stack": {
                        "name": "Exterminador",
                        "description": [
                            "<gray>Este encantamento permite matar</gray>",
                            "<gray>mais bosses a cada matada.</gray>"
                        ]
                    }
                }
            },
            "items": {
                "boss-killer-enchantment": {
                    "name": "<gold>{boss_killer_enchantment_name}</gold>",
                    "display-name": "{boss_killer_enchantment_name}",
                    "lore": [
                        "{boss_killer_enchantment_description}"
                    ],
                    "lore-inventory": [
                        "",
                        "<gold>Arraste em uma matadora.</gold>"
                    ]
                },
                "boss-killer": {
                    "name": "<gold>Matadora</gold>",
                    "display-name": "<gold>Matadora</gold>",
                    "lore": [
                        "<gray>Essa espada é utilizada</gray>",
                        "<gray>para matar bosses.</gray>",
                        "",
                        "  <gold>Encantamentos:</gold>",
                        "  <gray>{boss_killer_enchantments}</gray>",
                        "",
                        "  <white>Durabilidade: </white><gray>{boss_killer_actual_durability}/{boss_killer_max_durability}</gray>",
                        "  <gray>{boss_killer_durability_progress_bar} </gray><gray>{boss_killer_durability_progress_percent}%</gray>",
                        "",
                        "<dark_gray>{boss_killer_kill_count} bosses derrotados.</dark_gray>"
                    ]
                },
                "boss-killer-repair": {
                    "name": "<yellow>Reparador de Matadora</yellow>",
                    "display-name": "<yellow>Reparador de Matadora</yellow>",
                    "lore": [
                        "<gray>Utilize este item para reparar</gray>",
                        "<gray>a sua matadora de bosses.</gray>"
                    ]
                },
                "boss": {
                    "name": "{boss_name}",
                    "display-name": "{boss_name}",
                    "lore": [
                        "{boss_description}"
                    ],
                    "lore-inventory": [
                        "<white>Vida: <red>❤{boss_health}</red></white>"
                    ]
                }
            },
            "messages": {
                "on-hit": {
                    "need-killer": "<red>Você precisa utilizar uma matadora para isso!</red>",
                    "killer-break": "<red>Sua matadora está danificada, utilize um reparador para voltar a usá-la.</red>",
                    "actionbar": "<yellow>{boss_stack_display_name} <dark_gray>▸ </dark_gray><white>Vida: <red>❤{boss_health}</red></white>"
                },
                "on-kill": {
                    "chat": "<green>Bosses! Seus itens foram para as recompensas no </green><white>/bosses</white><green>!</green>"
                },
                "items": {
                    "boss-killer-rapair": {
                        "killer-in-max-durability": "<red>Sua matadora já está com a durabilidade completa!</red>"
                    }
                },
                "views": {
                    "boss-killer": {
                        "enchantment": {
                            "already-in-max-level": "<red>Você já está no nível máximo desse encantamento!</red>",
                            "only-applicable-with-book": "<red>Você só pode adquirir esse encantamento em </red><white>site</white><red>.</red>",
                            "dont-have-currency": "<red>Você não possui {boss_killer_enchantment_currency_name_plural} suficientes para adquirir esse encantamento!</red>",
                            "purchased": {
                                "plural": "<green>Você evoluiu {boss_killer_enchantment_level_count} níveis do encantamento </green><white>{boss_killer_enchantment_name}</white><green>!</green>",
                                "singular": "<green>Você evoluiu {boss_killer_enchantment_level_count} nível do encantamento </green><white>{boss_killer_enchantment_name}</white><green>!</green>"
                            }
                        }
                    },
                    "bosses-rewards": {
                        "collect-all": {
                            "empty": "<red>Você não possui itens para coletar!</red>"
                        },
                        "collect-one": {
                            "inventory-full": "<red>Você não pode coletar isso pois seu inventário está cheio!</red>"
                        }
                    },
                    "bosses": {
                        "filter-clear": {
                            "already-empty": "<red>Você já está com os filtros limpos!</red>",
                            "success": "<green>Você limpou os filtros de recompensas com sucesso!</green>"
                        }
                    }
                }
            },
            "views": {
                "bosses-filter": {
                    "title": "{boss_name_stripped} | Filtro",
                    "items": {
                        "0": {
                            "not-filtered": {
                                "lore": [
                                    "",
                                    "<yellow>Clique para adicionar ao filtro.</yellow>"
                                ]
                            },
                            "already-filtered": {
                                "lore": [
                                    "",
                                    "<yellow>Clique para remover do filtro.</yellow>"
                                ]
                            }
                        }
                    }
                },
                "boss-killer": {
                    "title": "Matadora",
                    "items": {
                        "0": {
                            "max-level": {
                                "name": "<gold>{boss_killer_enchantment_name} </gold><dark_gray>/ </dark_gray><gold>{boss_killer_enchantment_actual_level}</gold>",
                                "lore": [
                                    "{boss_killer_enchantment_description}",
                                    "",
                                    "<gray>Você já está no nível máximo!</gray>"
                                ]
                            },
                            "allow-enchantment": {
                                "name": "<gold>{boss_killer_enchantment_name} </gold><dark_gray>/ </dark_gray><red>{boss_killer_enchantment_actual_level} </red><dark_gray>➟ </dark_gray><gold>{boss_killer_enchantment_next_level}</gold>",
                                "lore": [
                                    "{boss_killer_enchantment_description}",
                                    "",
                                    " <white>Custo: {boss_killer_enchantment_currency_formatted_cost}</white>",
                                    " <white>Nível máximo: </white><gray>{boss_killer_enchantment_max_level}</gray>",
                                    "",
                                    "<gold>Opções de evolução:</gold>",
                                    " <dark_gray>▸ </dark_gray><white>Esquerdo: </white><gray>1 Nível</gray>",
                                    " <dark_gray>▸ </dark_gray><white>Direito: </white><gray>50 Níveis</gray>",
                                    " <dark_gray>▸ </dark_gray><white>Botão 'Q': </white><gray>Máximo possível</gray>"
                                ]
                            },
                            "only-book": {
                                "name": "<gold>{boss_killer_enchantment_name} </gold><dark_gray>/ </dark_gray><gold>{boss_killer_enchantment_actual_level}</gold>",
                                "lore": [
                                    "{boss_killer_enchantment_description}",
                                    "",
                                    "<red>Você pode adquirir esse livro</red>",
                                    "<red>em </red><white>site</white><red>!</red>"
                                ]
                            }
                        }
                    }
                },
                "bosses-ranking": {
                    "title": "Ranking de Bosses",
                    "items": {
                        "0": {
                            "name": "<white>Não tem ninguém aqui ainda :/</white>",
                            "lore": [
                                ""
                            ]
                        },
                        "1": {
                            "name": "<white>#{boss_user_ranking_position} {boss_user_name_with_tag}</white>",
                            "lore": [
                                "<white>Bosses eliminados: </white><gold>⚔</gold><gray>{boss_user_ranking_kills}</gray>"
                            ]
                        },
                        "2": {
                            "name": "<white>#{boss_user_ranking_position} {boss_user_name_with_tag}</white>",
                            "lore": [
                                "<white>Bosses eliminados: </white><gold>⚔</gold><gray>{boss_user_ranking_kills}</gray>"
                            ]
                        }
                    }
                },
                "bosses-rewards": {
                    "title": "Recompensas",
                    "items": {
                        "0": {
                            "name": "<red>Sem recompensas disponíveis</red>",
                            "lore": [
                                "<gray>Elimine bosses e colete aqui.</gray>",
                                "<gray>as suas recompensas</gray>"
                            ]
                        },
                        "1": {
                            "name": "<yellow>Recolher tudo</yellow>",
                            "lore": [
                                "<gray>Clique para recolher todas</gray>",
                                "<gray>as recompensas.</gray>"
                            ]
                        },
                        "2": {
                            "name": "<gold>{boss_reward_name} </gold><gray>x{boss_reward_amount}</gray>",
                            "lore": [
                                "",
                                "<yellow>Clique esquerdo para coletar.</yellow>",
                                "<yellow>Clique direito para deletar.</yellow>"
                            ]
                        }
                    }
                },
                "bosses-general": {
                    "title": "Bosses",
                    "items": {
                        "0": {
                            "name": "<gold>TOP Matadores</gold>",
                            "lore": [
                                "<gray>Confira os maiores matadores</gray>",
                                "<gray>de bosses do servidor</gray>",
                                "<gray></gray>",
                                "<gold>Clique para acessar.</gold>"
                            ]
                        },
                        "1": {
                            "name": "<gold>Tipos de Bosses</gold>",
                            "lore": [
                                "<gray>Confira os bosses existentes no</gray>",
                                "<gray>servidor e suas recompensas.</gray>",
                                "<gray></gray>",
                                "<gold>Clique para acessar.</gold>"
                            ]
                        },
                        "2": {
                            "name": "<gold>Recompensas</gold>",
                            "lore": [
                                "<gray>Confira as suas recompensas</gray>",
                                "<gray>adquiridas ao matar bosses.</gray>",
                                "<gray></gray>",
                                "<gold>Clique para gerenciar.</gold>"
                            ]
                        }
                    }
                },
                "bosses": {
                    "title": "Bosses",
                    "items": {
                        "0": {
                            "name": "<yellow>Limpar filtros</yellow>",
                            "lore": [
                                "<gray>Clique para limpar</gray>",
                                "<gray>os filtros de recompensas.</gray>",
                                "",
                                "<yellow>Clique para limpar!</yellow>"
                            ]
                        },
                        "1": {
                            "name": "<gold>{boss_name}</gold>",
                            "lore": [
                                "<gray>{boss_description}</gray>"
                            ]
                        }
                    }
                }
            }
        }
    }
}