      },
      "items": {
        "mystery-box": {
          "display-name": "{mystery_box_name}",
          "name": "{mystery_box_name}",
          "lore": [
            "{mystery_box_description}"
          ]
        }
      },
      "npc": {
        "hologram": [
          "<color:#6e0281>Mestre das Caixas",
          "<white>Abra as caixas de trajes aqui",
          "",
          "<color:#6e0281>Clique para abrir!"
        ]
      },
      "commands": {
        "mystery-box": {
          "give": {
            "arguments": {
              "type": {
                "name": "tipo",
                "description": "Tipo da caixa que será enviada"
              },
              "target": {
                "name": "all / player",
                "description": "Jogador que irá receber as caixas"
              },
              "amount": {
                "name": "quantidade",
                "description": "Quantidade de caixas que você deseja enviar"
              }
            },
            "mystery-box-not-found": "Não foi possivel encontrar nenhuma caixa com esse id!",
            "success-all": "Foram enviadas {mystery_box_amount} caixas para todos os jogadores online",
            "success-one": "Foram enviadas {mystery_box_amount} caixas para o jogador {mystery_box_target_name} caso ele esteja online no servidor!"
          }
        }
      },
      "messages": {
        "animation": {
          "already-running": "<red>Já existe uma caixa misteriosa sendo aberta.</red>"
        }
      },
      "views": {
        "mystery-box-list": {
          "title": "Lista de caixas"
        },
        "mystery-box-preview": {
          "title": "{mystery_box_name_stripped}"
        },
        "mystery-box-npc": {
          "title": "Clique nas caixas que deseja abrir",
          "items": {
            "0": {
              "name": "<green>Mestre das Caixas</green>",
              "lore": [
                "<gray>Este menu permite a abertura de várias caixas</gray>",
                "<gray>simultaneamente, reduzindo o tempo de espera</gray>",
                "<gray>para receber os itens da caixa.</gray>"
              ]
            },
            "1": {
              "name": "<red>Nenhuma caixa colocada!</red>",
              "lore": [
                "<gray>Clique em alguma Caixa do seu</gray>",
                "<gray>inventário para poder abri-la.</gray>"
              ]
            },
            "2": {
              "name": "<green>Abrir todas as caixas!</green>",
              "lore": [
                "<gray>Clique aqui para abrir todas as</gray>",
                "<gray>caixas colocadas de uma vez.</gray>",
                "",
                "<green>Clique para abrir!</green>"
              ]
            }
          }
        }
      }
    }
  }
}