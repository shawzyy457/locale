{
  "plugins": {
    "mystery-box": {
      "types": {
        "booster-box-common": {
          "name": "<white></white> <gradient:#03C400:#04FF00>Caixa de Boosters",
          "description": [
            "<gray>Ao abrir esta caixa misteriosa,",
            "<gray>você recebe um booster de uma",
            "<gray>categoria aleatória",
            "",
            " <gradient:#03C400:#04FF00>Tipos de booster:",
            " <gradient:#03C400:#04FF00>◇<white> Tokens;",
            " <gradient:#03C400:#04FF00>◇<white> Coins;",
            " <gradient:#03C400:#04FF00>◇<white> Faíscas;",
            " <gradient:#03C400:#04FF00>◇<white> Gemas;",
            " <gradient:#03C400:#04FF00>◇<white> Maestria;",
            " <gradient:#03C400:#04FF00>◇<white> Experiência;",
            "",
            "<gradient:#03C400:#04FF00>clique para abrir!"
          ]
