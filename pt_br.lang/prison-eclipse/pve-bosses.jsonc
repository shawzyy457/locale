{
    "plugins": {
        "pve-bosses": {
            "boss": {
                "apocalyptic": {
                    "name": "Elektros, Zumbi Ascendente",
                    "description": [
                        "<gray>Um boss Zumbi eletrificante"
                    ]
                }
            },
            "npc": {
                "apocalyptic": {
                    "hologram": [
                        "<dark_purple>Guardião dos Bosses",
                        "<white>Clique para acessar!"
                    ]
                }
            },
            "shrapnel": {
                "apocalyptic": {
                    "name": "<green>Estilhaço Apocalíptico",
                    "description": [
                        "<gray>Utilize esse estilhaço para",
                        "<gray>invocar o boss do mundo",
                        "<gray>apocalíptico."
                    ]
                }
            },
            "items": {
                "pve-boss-shrapnel": {
                    "display-name": "{pve_boss_shrapnel_color}{pve_boss_shrapnel_name}",
                    "name": "{pve_boss_shrapnel_color}{pve_boss_shrapnel_name}",
                    "lore": [
                        "{pve_boss_shrapnel_description}"
                    ]
                }
            },
            "commands": {
                "party": {
                    "chat": {
                        "arguments": {
                            "message": {
                                "name": "mensagem",
                                "description": "Mensagem que deseja enviar"
                            }
                        },
                        "not-in-party": "Você não está participando de nenhuma party!"
                    },
                    "disband": {
                        "not-in-party": "Você não está participando de nenhuma party!",
                        "not-owner-party": "Somente o dono pode desfazer a party, de você deseja sair digite /party sair",
                        "success": "Você desfez a party com sucesso!"
                    },
                    "invite": {
                        "arguments": {
                            "target": {
                                "name": "jogador",
                                "description": "Jogador que você deseja convidar"
                            }
                        },
                        "not-in-party": "Você não está participando de nenhuma party!",
                        "not-owner-party": "Somente o dono pode chamar outros jogadores para a party!",
                        "already-requested": "Esse jogador já possui um convite para a sua party pendente!",
                        "preferences": {
                            "disabled": {
                                "target": "Esse jogador desativou os convites de party."
                            }
                        },
                        "ignores": {
                            "target": "Esse jogador te adicionou a lista de jogadores ignorados!"
                        },
                        "success-sender": [
                            "<green>Você convidou o jogador {party_invite_target_name_with_tag} para a sua party, ele possui <white>1 minuto</white> para aceitar a solicitação!</green>"
                        ],
                        "success-target": [
                            "",
                            "<dark_purple>[Party]</dark_purple> <white>Você recebeu um convite para entrar na party de {party_invite_owner_name_with_tag}</white>",
                            " <white>Clique <click:run_command:'/party join {party_invite_owner_name}'><yellow><bold>AQUI</bold></yellow></click> para entrar!</white>",
                            ""
                        ]
                    },
                    "join": {
                        "arguments": {
                            "owner": {
                                "name": "jogador",
                                "description": "Jogador que você entrar na party"
                            }
                        },
                        "already-in-party": "Você já está participando de uma party!",
                        "cannot-find-party": "Não foi possivel encontrar a party desse jogador, peça para ele re-enviar!",
                        "dont-have-request": "Você não possui solicitação de party desse jogador!",
                        "dont-have-requirements": "Você não possui todos os requisitos para participar desse boss!",
                        "max-members-party": "A party que você quer entrar já atingiu o limite máximo de membros!",
                        "success": "Você entrou na party com sucesso, utilize <white>/party chat</white> para conversar com os outros membros!"
                    },
                    "kick": {
                        "arguments": {
                            "target": {
                                "name": "jogador",
                                "description": "Jogador que você deseja expulsar"
                            }
                        },
                        "not-in-party": "Você não está participando de nenhuma party!",
                        "not-owner-party": "Somente o dono pode expulsar outros membros da party!",
                        "not-party-member": "Esse jogador não está participando da sua party!",
                        "success": "Você expulsou o jogador com sucesso!"
                    },
                    "leave": {
                        "not-in-party": "Você não está participando de nenhuma party!",
                        "is-owner-party": "Você é o dono da party, utilize <white>/party desfazer</white> para desfazer a party!",
                        "success": "Você saiu da party com sucesso!"
                    }
                }
            },
            "messages": {
                "party": {
                    "members": {
                        "join": "<dark_purple>[Party]</dark_purple> <white>{pve_party_member_name_with_tag} entrou no grupo!</white>",
                        "quit": "<dark_purple>[Party]</dark_purple> <white>{pve_party_member_name_with_tag} saiu do grupo.</white>",
                        "kick": "<dark_purple>[Party]</dark_purple> <white>{pve_party_member_name_with_tag} foi expulso do grupo.</white>"
                    },
                    "disband": "<dark_purple>[Party]</dark_purple> <white>O grupo de {pve_party_owner_name_with_tag} foi desfeito.</white>",
                    "chat": "<dark_purple>[Party]</dark_purple> <white>{pve_party_chat_sender_name_with_tag}: <gray>{pve_party_chat_content}</gray></white>",
                    "settings": {
                        "boss-level-updated": "<dark_purple>[Party]</dark_purple> <white>O nível do boss foi atualizado para {pve_party_boss_level}.</white>",
                        "public": "<dark_purple>[Party]</dark_purple> <white>Seu grupo agora é <green>público</green>. Outros jogadores podem entrar livremente.</white>",
                        "private": "<dark_purple>[Party]</dark_purple> <white>Seu grupo agora é <red>privado</red>. Apenas convidados podem entrar.</white>"
                    },
                    "starting-timer": "<dark_purple>[Party]</dark_purple> <white>A batalha começa em <gold>{pve_party_timer}</gold> segundos!</white>"
                },
                "views": {
                    "pve-boss-party-members": {
                        "member-request": {
                            "conversation": {
                                "query": "Digite o nome do jogador que você deseja convidar para sua party:",
                                "already-in-party": "Esse jogador já está participando de uma party!"
                            }
                        },
                        "party-chat-notification": {
                            "need-a-public-party": "Você deve colocar a sua party como publica para enviar uma solicitação no chat!",
                            "is-in-delay": "Você precisa esperar mais {remaining_time} para enviar outra solicitação!"
                        }
                    }
                }
            },
            "views": {
                "pve-boss-party": {
                    "title": "Invocar {boss_name_stripped}",
                    "items": {
                        "0": {
                            "name": "{pve_party_boss_color}Selecionar nível",
                            "lore": [
                                "<gray>Níveis maiores oferecem</gray>",
                                "<gray>dificuldades e recompensas</gray>",
                                "<gray>superiores.</gray>",
                                "",
                                " {pve_party_boss_color}Selecionar nível:",
                                " {pve_party_boss_level}",
                                "",
                                " {pve_party_boss_color}Clique para alterar!"
                            ],
                            "level-selected-line": "<white>◇ Nível {pve_party_boss_level}</white>",
                            "level-unselected-line": "<dark_gray>Nível {pve_party_boss_level}</dark_gray>"
                        },
                        "1": {
                            "with-requirements": {
                                "name": "{pve_party_boss_color}{pve_party_boss_name}",
                                "lore": [
                                    "{pve_party_boss_description}",
                                    "",
                                    " {pve_party_boss_color}Requisitos para invocar:",
                                    " <dark_gray>◇</dark_gray> <white>{pve_party_boss_requirements}</white>",
                                    "",
                                    "{pve_party_boss_color}Clique para invocar!"
                                ]
                            },
                            "without-requirements": {
                                "name": "{pve_party_boss_color}{pve_party_boss_name}",
                                "lore": [
                                    "{pve_party_boss_description}",
                                    "",
                                    " {pve_party_boss_color}Requisitos para invocar:",
                                    " <dark_gray>◇</dark_gray> <white>{pve_party_boss_requirements}</white>",
                                    "",
                                    "{pve_party_boss_color}Você não possui os requisitos!"
                                ]
                            }
                        },
                        "2": {
                            "name": "{pve_party_boss_color}Sua party",
                            "lore": [
                                "<gray>Escolha quem vai enfrentar</gray>",
                                "<gray>o boss com você!</gray>",
                                "",
                                " {pve_party_boss_color}Membros da party:",
                                " <dark_gray>◇</dark_gray> <white>{pve_party_members}</white>",
                                "",
                                "<green>Clique para gerenciar!"
                            ],
                            "member-line": "{pve_party_member_name_with_tag}"
                        }
                    }
                },
                "pve-boss-party-members": {
                    "title": "Sua party",
                    "items": {
                        "0": {
                            "public": {
                                "name": "<green>Privacidade da Party",
                                "lore": [
                                    "",
                                    " <white>Estado:<green> Pública",
                                    "",
                                    "<green>Clique para alterar!"
                                ]
                            },
                            "private": {
                                "name": "<green>Privacidade da Party",
                                "lore": [
                                    "",
                                    " <white>Estado:<red> Privada",
                                    "",
                                    "<green>Clique para alterar!"
                                ]
                            }
                        },
                        "1": {
                            "name": "<green>Enviar solicitação",
                            "lore": [
                                "<gray>Envie uma solicitação no chat",
                                "<gray>para que outros jogadores",
                                "<gray>entrem na sua party.",
                                "",
                                "<green>Clique para enviar!"
                            ]
                        },
                        "2": {
                            "empty": {
                                "name": "<green>Adicionar jogador!",
                                "lore": [
                                    "<gray>Adicione um jogador para",
                                    "<gray>derrotar o boss com você.",
                                    "",
                                    "<green>Clique para convidar!"
                                ]
                            },
                            "occupied": {
                                "name": "{pve_party_member_name_with_tag}",
                                "lore": []
                            }
                        }
                    }
                }
            }
        }
    }
}