{
  "plugins": {
    "events": {
      "commands": {
        "cancel": {
          "not-running": "<red>O evento </red>{event_name}<red> não está ocorrendo no momento!</red>",
          "requested": "<green>Uma solicitação de cancelamento do evento </green>{event_name}<green> foi enviada com sucesso!</green>"
        },
        "force-start": {
          "not-awaiting": "<red>O evento </red>{event_name}<red> não está iniciando no momento!</red>",
          "requested": "<green>Uma solicitação de início forçado do evento </green>{event_name}<green> foi enviada com sucesso!</green>"
        },
        "join": {
          "not-awaiting": "<red>O evento </red>{event_name}<red> não está iniciando no momento!</red>",
          "always-joined": "<yellow>Você já está participando do evento </yellow>{event_name}<yellow>!</yellow>"
        },
        "start": {
          "arguments": {
            "reward": {
              "name": "recompensa",
              "description": "Recompensa que deseja colocar no evento"
            }
          },
          "running": "<red>O evento </red>{event_name}<red> está ocorrendo no momento!</red>",
          "removing-award": "<yellow>Removendo sua premiação para dar ao vencedor!</yellow>",
          "remove-award-error": "<red>Não foi possível remover sua premiação, operação cancelada!</red>",
          "requested": "<green>Uma solicitação de início do evento </green>{event_name}<green> foi enviada com sucesso!</green>"
        }
      },
      "types": {
        "sumo": {
          "name": "<dark_aqua>Sumô</dark_aqua>",
          "messages": {
            "titles": {
              "init-countdown": {
                "title": "<dark_aqua>Preparem-se</dark_aqua>",
                "subtitle": "<white>O evento será iniciado em breve</white>"
              },
              "next-fight": {
                "title": "<gold><bold>Próxima Luta</bold></gold>",
                "subtitle": "<white>{player_name_1}</white> <gold><bold>x</bold></gold> <white>{player_name_2}</white>"
              }
            },
            "stages": {
              "awaiting": {
                "user-join": "<white>{user_name_with_tag}</white> <yellow>entrou no evento!</yellow> <dark_gray>(#{user_join_position})</dark_gray>",
                "user-quit": "<white>{user_name_with_tag}</white> <yellow>saiu do evento!</yellow> <dark_gray>(#{user_quit_position})</dark_gray>"
              },
              "running": {
                "winner-fight": [
                  "",
                  "<dark_aqua>[Sumô] </dark_aqua><white>{winner_user_name_with_tag}</white> <white>venceu o duelo contra </white><white>{loss_user_name_with_tag}</white><white>!</white>",
                  ""
                ]
              },
              "cancel": {
                "administrator": [
                  "",
                  "<dark_aqua><bold>SUMÔ!</bold></dark_aqua>",
                  "<gray>Evento cancelado, aguarde.</gray>",
                  ""
                ],
                "missing_players": [
                  "",
                  "<dark_aqua>Sumô</dark_aqua>",
                  "<gray>O evento foi cancelado por ausência de jogadores no evento.</gray>",
                  ""
                ]
              }
            },
            "announces": {
              "start": [
                "",
                "<dark_aqua>Evento <bold>Sumô</bold> iniciado!</dark_aqua>",
                "",
                "<white>  Participantes: </white><white>{event_participant_count}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                "",
                "<dark_aqua>Clique </dark_aqua><click:run_command:'/sumo join'><dark_aqua><bold>AQUI</bold></dark_aqua></click><dark_aqua> para participar!</dark_aqua>",
                ""
              ],
              "finish": [
                "",
                "<dark_aqua><bold>Sumô</bold></dark_aqua>",
                "<gray> Evento finalizado, parabéns ao vencedor!</gray>",
                "",
                "<white>  Vencedor: </white><white>{event_owner_user_name_with_tag}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                ""
              ]
            }
          }
        },
        "fight": {
          "name": "<red>Fight</red>",
          "messages": {
            "titles": {
              "init-countdown": {
                "title": "<red>Preparem-se</red>",
                "subtitle": "<white>O evento será iniciado em breve!</white>"
              },
              "next-fight": {
                "title": "<gold><bold>Próxima Luta</bold></gold>",
                "subtitle": "<white>{player_name_1}</white> <gold><bold>x</bold></gold> <white>{player_name_2}</white>"
              }
            },
            "stages": {
              "awaiting": {
                "user-join": "<white>{user_name_with_tag}</white> <yellow>entrou no evento!</yellow> <dark_gray>(#{user_join_position})</dark_gray>",
                "user-quit": "<white>{user_name_with_tag}</white> <yellow>saiu do evento!</yellow> <dark_gray>(#{user_quit_position})</dark_gray>"
              },
              "running": {
                "winner-fight": [
                  "",
                  "<red>[Fight] </red><white>{winner_user_name_with_tag}</white> <white>venceu o duelo contra </white><white>{loss_user_name_with_tag}</white><white>!</white>",
                  ""
                ]
              },
              "cancel": {
                "administrator": [
                  "",
                  "<red><bold>FIGHT!</bold></red>",
                  "<gray>O evento foi cancelado, aguarde.</gray>",
                  ""
                ],
                "missing_players": [
                  "",
                  "<red>Fight</red>",
                  "<gray>O evento foi cancelado por ausência de jogadores no evento.</gray>",
                  ""
                ]
              }
            },
            "announces": {
              "start": [
                "",
                "<red>Evento <bold>Fight</bold> iniciado!</red>",
                "",
                "<white>  Participantes: </white><white>{event_participant_count}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                "",
                "<red>Clique </red><click:run_command:'/fight join'><red><bold>AQUI</bold></red></click><red> para participar!</red>",
                ""
              ],
              "finish": [
                "",
                "<red><bold>Fight</bold></red>",
                "<gray> Evento finalizado, parabéns ao vencedor!</gray>",
                "",
                "<white>  Vencedor: </white><white>{event_owner_user_name_with_tag}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                ""
              ]
            }
          }
        },
        "stick-rush": {
          "name": "<gold>StickRush</gold>",
          "items": {
            "stick": {
              "name": "<yellow>Taco</yellow>",
              "lore": []
            }
          },
          "messages": {
            "titles": {
              "init-countdown": {
                "title": "<gold>Preparem-se</gold>",
                "subtitle": "<white>O evento será iniciado em breve!</white>"
              }
            },
            "stages": {
              "awaiting": {
                "user-join": "<white>{user_name_with_tag}</white> <yellow>entrou no evento!</yellow> <dark_gray>(#{user_join_position})</dark_gray>",
                "user-quit": "<white>{user_name_with_tag}</white> <yellow>saiu do evento!</yellow> <dark_gray>(#{user_quit_position})</dark_gray>"
              },
              "running": {
                "player-death": [
                  "",
                  "<gold>[StickRush] </gold><white>{user_death_name_with_tag}</white> <white>foi eliminado do evento.</white>",
                  ""
                ]
              },
              "cancel": {
                "administrator": [
                  "",
                  "<gold><bold>StickRush!</bold></gold>",
                  "<gray>O evento foi cancelado, aguarde.</gray>",
                  ""
                ],
                "missing_players": [
                  "",
                  "<gold><bold>StickRush!</bold></gold>",
                  "<gray>O evento foi cancelado por ausência de jogadores no evento.</gray>",
                  ""
                ]
              }
            },
            "announces": {
              "start": [
                "",
                "<gold>Evento <bold>StickRush</bold> iniciado!</gold>",
                "",
                "<white>  Participantes: </white><white>{event_participant_count}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                "",
                "<gold>Clique </gold><click:run_command:'/stickrush join'><gold><bold>AQUI</bold></gold></click><gold> para participar!</gold>",
                ""
              ],
              "finish": [
                "",
                "<gold><bold>StickRush</bold></gold>",
                "<gray> Evento finalizado, parabéns ao vencedor!</gray>",
                "",
                "<white>  Vencedor: </white><white>{event_owner_user_name_with_tag}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                ""
              ]
            }
          }
        },
        "race": {
          "name": "<green>Corrida</green>",
          "messages": {
            "stages": {
              "awaiting": {
                "user-join": "<white>{user_name_with_tag}</white> <yellow>entrou no evento!</yellow> <dark_gray>(#{user_join_position})</dark_gray>",
                "user-quit": "<white>{user_name_with_tag}</white> <yellow>saiu do evento!</yellow> <dark_gray>(#{user_quit_position})</dark_gray>"
              },
              "cancel": {
                "administrator": [
                  "",
                  "<green><bold>CORRIDA!</bold></green>",
                  "<gray>O evento foi cancelado, aguarde.</gray>",
                  ""
                ],
                "missing_players": [
                  "",
                  "<green>Corrida</green>",
                  "<gray>O evento foi cancelado por ausência de jogadores no evento.</gray>",
                  ""
                ]
              }
            },
            "announces": {
              "start": [
                "",
                "<green>Evento <bold>corrida</bold> iniciado!</green>",
                "",
                "<white>  Participantes: </white><white>{event_participant_count}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                "",
                "<green>Clique </green><click:run_command:'/race join'><green><bold>AQUI</bold></green></click><green> para participar!</green>",
                ""
              ],
              "finish": [
                "",
                "<green><bold>Corrida</bold></green>",
                "<gray> Evento finalizado, parabéns ao vencedor!</gray>",
                "",
                "<white>  Vencedor: </white><white>{event_owner_user_name_with_tag}</white>",
                "<white>  Prêmio: </white><white>{event_award_name}</white>",
                ""
              ]
            }
          }
        }
      },
      "awards": {
        "setup": {
          "currency": {
            "currency-not-found": "<red>Economia não encontrada!</red>",
            "currency-query": "<yellow>Digite o id da moeda que você deseja selecionar.</yellow>",
            "currency-value-query": "<yellow>Digite o valor que você deseja selecionar</yellow>"
          },
          "item": {
            "item-not-found": "<red>Custom item not found!</red>"
          }
        }
      },
      "messages": {
        "on-command": {
          "not-allowed": "<red>Você não pode executar esse comando enquanto estiver no evento!</red>"
        }
      }
    }
  }
}
