        },
        "sailor": {
          "name": "Marinheiro",
          "description": [
            "<gray>Com este encantamento, você</gray>",
            "<gray>aumenta a chance de ganhar</gray>",
            "<gray>mais que 1 peixe por pescada.</gray>"
          ]
        },
