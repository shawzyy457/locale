{
  "plugins": {
    "skills": {
      "types": {
        "combat": {
          "name": "Combate",
          "description": [
            "<gray>Ganhe XP e aprimore sua maestria</gray>",
            "<gray>matando criaturas no fim.</gray>"
          ]
        },
        "mining": {
          "name": "Mineração",
          "description": [
            "<gray>Ganhe XP e aprimore sua maestria</gray>",
            "<gray>quebrando blocos em sua mina.</gray>"
          ]
        },
        "enchanting": {
          "name": "Encantador",
          "description": [
            "<gray>Ganhe XP e aprimore sua maestria</gray>",
            "<gray>encantando os seus itens.</gray>"
          ]
        },
        "fishing": {
          "name": "Pescador",
          "description": [
            "<gray>Ganhe XP e aprimore sua maestria</gray>",
            "<gray>pescando na área de pesca.</gray>"
          ]
        },
        "farming": {
          "name": "Fazendeiro",
          "description": [
            "<gray>Ganhe XP e aprimore sua maestria</gray>",
            "<gray>quebrando plantações na fazenda.</gray>"
          ]
        }
      },
      "commands": {
        "arguments": {
          "skill": {
            "not-found": "<red>Não foi possível encontrar uma maestria com o id {skill_id}</red>"
          }
        },
        "skill": {
          "add-experience": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que será adicionado a experiência"
              },
              "skill": {
                "name": "skill",
                "description": "Skill que será definida"
              },
              "experience": {
                "name": "experience",
                "description": "Experiência que será adicionada"
              }
            },
            "success": "<green>Experiência definida com sucesso</green>"
          },
          "set-level": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que será definido o nível"
              },
              "skill": {
                "name": "skill",
                "description": "Skill que será definida"
              },
              "level": {
                "name": "level",
                "description": "Level que será definido"
              }
            },
            "success": "<green>Level definido com sucesso</green>"
          }
        }
      },
      "messages": {
        "boss-bar": "<color:#E7CF8A>+{skill_received_experience} ▴ </color><white>{skill_name}</white> <color:#E7CF8A>({skill_level_experience}/{skill_next_level_experience})</color>",
        "level": {
          "on-up": [
            "<green>Você evoluiu sua maestria de <white>{skill_name}</white>, agora você está no nível <white>{skill_level}</white>!</green>"
          ]
        },
        "hooks": {
          "mythic-armory": {
            "requirement": "<white>Nível <bold>{skill_level}</bold> {skill_name}</white>"
          },
          "core": {
            "requirement": "<white>Nível <bold>{skill_level}</bold> {skill_name}</white>"
          }
        }
      },
      "views": {
        "primary": {
          "title": "Maestrias de {user_name}",
          "items": {
            "empty": {
              "name": "<red>Em breve</red>",
              "lore": [
                "<red>Essa maestria será adicionada</red>",
                "<red>em breve!</red>"
              ]
            },
            "0": {
              "name": "{user_name_with_tag}",
              "lore": [
                "",
                " <dark_gray>▸ </dark_gray><white>Nível total: </white><gray>{skill_user_total_level}</gray>",
                " <dark_gray>▸ </dark_gray><white>Posição no ranking: </white><gray>{skill_user_position}º</gray>",
                " <dark_gray>▸ </dark_gray><white>Bônus VIP: </white><gray>{skill_user_vip_bonus}0x</gray>",
                ""
              ]
            },
            "1": {
              "name": "<green>Ranking de Maestrias</green>",
              "lore": [
                "<gray>Veja os jogadores com mais</gray>",
                "<gray>maestria do servidor.</gray>",
                "",
                "<green>Clique para ver o ranking.</green>"
              ]
            },
            "2": {
              "name": "<green>{skill_name}",
              "lore": [
                "{skill_description}",
                "",
                " <green>Informações:</green>",
                " <white>Nível atual: </white><gray>{skill_user_level}</gray>",
                " <white>Progresso: </white>{skill_user_next_level_progress_bar} <gray>{skill_user_next_level_progress_percent}%</gray>",
                "",
                " <green>▾ Bônus de Atributo:</green>",
                "   <gray>{skill_user_attributes}</gray>",
                " ",
                "<green>Clique para saber mais.</green>"
              ]
            }
          }
        },
        "progress": {
          "title": "{skill_name}",
          "items": {
            "0": {
              "name": "<green>{skill_name}</green>",
              "lore": [
                "{skill_description}",
                "",
                " <green>Informações:</green>",
                " <white>Nível atual: </white><gray>{skill_user_level}</gray>",
                " <white>Progresso: </white>{skill_user_next_level_progress_bar} <gray>{skill_user_next_level_progress_percent}%</gray>",
                "",
                " <green>▾ Bônus de Atributo:</green>",
                "   <gray>{skill_user_attributes}</gray>",
                " "
              ]
            },
            "1": {
              "completed": {
                "name": "<green>Nível {skill_level}</green>",
                "lore": [
                  "{skill_description}",
                  "",
                  " <green>▾ Bônus de Atributo:</green>",
                  "   <gray>{skill_level_attributes}</gray>",
                  "",
                  "<green>Nível concluído.</green>"
                ]
              },
              "in-progress": {
                "name": "<yellow>Nível {skill_level}</yellow>",
                "lore": [
                  "{skill_description}",
                  "",
                  " <white>Progresso: </white><yellow>{skill_level_progress_bar} </yellow><gray>{skill_level_progress_percent}%</gray>",
                  "",
                  " <yellow>▾ Bônus de Atributo:</yellow>",
                  "   <gray>{skill_level_attributes}</gray>",
                  "",
                  "<yellow>Em progresso...</yellow>"
                ]
              },
              "blocked": {
                "name": "<red>Nível {skill_level}</red>",
                "lore": [
                  "{skill_description}",
                  "",
                  " <red>▾ Bônus de Atributo:</red>",
                  "   <gray>{skill_level_attributes}</gray>",
                  "",
                  "<red>Nível bloqueado.</red>"
                ]
              }
            }
          }
        },
        "ranking": {
          "title": "Ranking de Maestrias",
          "items": {
            "0": {
              "name": "<red>Em breve</red>",
              "lore": [
                "<red>Essa maestria será adicionada</red>",
                "<red>em breve!</red>"
              ]
            },
            "1": {
              "name": "<yellow>Nível total de Maestria</yellow>",
              "lore": [
                "<gray>Confira os jogadores que possuem</gray>",
                "<gray>o maior nível somado de maestria.</gray>",
                "",
                " <yellow>▾ Ranking total de Maestria:</yellow>",
                " {skill_ranking}",
                "",
                " <white>Sua posição: </white><gray>{skill_user_position}º</gray>"
              ],
              "lore-ranking": "<white>{skill_user_position}º </white>{skill_user_name_with_tag} <dark_gray>▸ </dark_gray><white>{skill_user_level} níveis</white>"
            },
            "2": {
              "name": "<yellow>{skill_name}</yellow>",
              "lore": [
                "<gray>Confira os jogadores com maior</gray>",
                "<gray>nível de maestria em </gray><white>{skill_name}</white><gray>.</gray>",
                "",
                " <yellow>▾ Ranking total de Maestria:</yellow>",
                " {skill_ranking}",
                "",
                " <white>Sua posição: </white><gray>{skill_user_position}º</gray>"
              ],
              "lore-ranking": "<white>{skill_user_position}º </white>{skill_user_name_with_tag} <dark_gray>▸ </dark_gray><white>{skill_user_level} níveis</white>"
            }
          }
        }
      }
    }
  }
}
