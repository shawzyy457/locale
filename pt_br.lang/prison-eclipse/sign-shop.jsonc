{
  "plugins": {
    "sign-shop": {
      "preferences": {
        "empty-storage": {
          "name": "<yellow>Notificação de loja sem estoque</yellow>",
          "lore": [
            "<gray>Notificação de quando a sua loja</gray>",
            "<gray>fica sem estoque e um jogador tenta</gray>",
            "<gray>utiliza-la.</gray>"
          ]
        },
        "sell-or-buy-notification": {
          "name": "<yellow>Notificação de vendas / compras</yellow>",
          "lore": [
            "<gray>Altera as notificações de venda ou</gray>",
            "<gray>compra das suas lojas em seu terreno.</gray>"
          ]
        }
      },
      "sign": {
        "only-buy": [
          "<black>{sign_shop_owner_name}</black>",
          "<dark_green><bold>C </bold></dark_green>{sign_shop_currency_color}{sign_shop_currency_icon}<white>{sign_shop_buy_formatted_value}</white>",
          "<black>{sign_shop_amount}</black>",
          "<black>{sign_shop_item_name_stripped}</black>"
        ],
        "only-sell": [
          "<black>{sign_shop_owner_name}</black>",
          "<dark_red><bold>V </bold></dark_red>{sign_shop_currency_color}{sign_shop_currency_icon}<white>{sign_shop_sell_formatted_value}</white>",
          "<black>{sign_shop_amount}</black>",
          "<black>{sign_shop_item_name_stripped}</black>"
        ],
        "buy-and-sell": [
          "<black>{sign_shop_owner_name}</black>",
          "<dark_green><bold>C </bold></dark_green>{sign_shop_currency_color}{sign_shop_currency_icon}<white>{sign_shop_buy_formatted_value}</white> <dark_red><bold>V </bold></dark_red>{sign_shop_currency_color}{sign_shop_currency_icon}<white>{sign_shop_sell_formatted_value}</white>",
          "<black>{sign_shop_amount}</black>",
          "<black>{sign_shop_item_name_stripped}</black>"
        ]
      },
      "messages": {
        "on-break": {
          "sign-cannot-be-broken": "Você não pode quebrar essa placa pois ela é uma loja!",
          "sign-chest-cannot-be-broken": "Você não pode quebrar esse baú pois ele faz parte de uma loja!"
        },
        "on-create": {
          "sign-must-be-in-front-of-chest": "Você precisa colocar essa placa em um baú para criar a loja!"
        },
        "sign-shop": {
          "not-open": "Essa loja não está aberta no momento!",
          "in-delay": "Esse loja acabou de ser alterada, você precisa esperar mais {remaining_time} para poder utiliza-lá.",
          "has-storage-viewer": "Você não pode comprar ou vender nessa loja enquanto o estoque está aberto!"
        },
        "sell": {
          "not-allowed": "Essa loja não está aceitando vendas!",
          "not-enough-items": "Você não possui itens suficientes para vender nessa loja!",
          "owner-no-has-money": "O dono da loja não possui dinheiro para pagar essa venda!",
          "full-stock": "Essa loja está com o estoque cheio!",
          "sell-user": "<green>Yeah! Você vendeu <white>x{sign_shop_sell_amount} </white><green>itens por {sign_shop_sell_value}</green>.",
          "sell-owner": [
            "<green>Yeah! {sign_shop_sell_user_name_with_tag} <green>vendeu <white>x{sign_shop_sell_amount} </white><green>itens por {sign_shop_sell_value}</green>.</green>"
          ]
        },
        "buy": {
          "not-allowed": "Essa loja não está aceitando compras!",
          "user-no-has-money": "Você não possui dinheiro suficiente realizar essa compra!",
          "empty-stock": "Essa loja está com o estoque vazio!",
          "empty-stock-owner": [
            "<red>Ei! Sua loja está esgotada, por favor reabasteça.</red>"
          ],
          "buy-user": "<green>Yeah! Você comprou <white>x{sign_shop_buy_amount} </white><green>itens por {sign_shop_buy_value}</green>.",
          "buy-owner": [
            "<green>Yeah! {sign_shop_buy_user_name_with_tag} <green>comprou <white>x{sign_shop_buy_amount} </white><green>itens por {sign_shop_buy_value}</green>.</green>"
          ]
        },
        "views": {
          "sign-shop-create": {
            "item-cannot-be-used": "Esse item não pode ser utilizado em lojas!",
            "buy-value": {
              "conversation": {
                "query": "Digite o valor que você deseja que os jogadores comprem na sua loja:"
              }
            },
            "sell-value": {
              "conversation": {
                "query": "Digite o valor que você deseja que os jogadores vendam na sua loja:"
              }
            },
            "item-not-selected": "Você precisa selecionar um item para concluir a loja!",
            "value-not-selected": "Você precisa selecionar um valor de compra ou venda para concluir a loja!",
            "sign-not-found": "A placa em que a loja estava sendo criada foi quebrada!",
            "success": "<green>Loja criada com sucesso!</green>"
          },
          "sign-shop-edit": {
            "item-cannot-be-used": "Esse item não pode ser utilizado em lojas!",
            "buy-value": {
              "conversation": {
                "query": "Digite o valor que você deseja que os jogadores comprem na sua loja:"
              }
            },
            "sell-value": {
              "conversation": {
                "query": "Digite o valor que você deseja que os jogadores vendam na sua loja:"
              }
            },
            "delete": {
              "success": "<green>Loja deletada com sucesso!</green>"
            },
            "state": {
              "opened-success": "A atividade da sua loja foi alterada para <green>aberto</green>",
              "closed-success": "A atividade da sua loja foi alterada para <red>fechado</red>"
            }
          }
        }
      },
      "views": {
        "sign-shop-create": {
          "title": "Configurando sua loja",
          "items": {
            "0": {
              "name": "<red>Erro!</red>",
              "lore": [
                "<gray>Selecione um item primeiro</gray>",
                "<gray>para criar uma loja.</gray>"
              ]
            },
            "1": {
              "name": "<green>Compra</green>",
              "lore": [
                "<gray>Defina um valor que o jogador</gray>",
                "<gray>irá comprar o item na sua loja.</gray>",
                "",
                " <green>▸ </green><white>Valor de compra: {sign_shop_buy_formatted_value}</white>",
                "",
                "<green>Clique para definir o valor.</green>"
              ]
            },
            "2": {
              "name": "<red>Vender</red>",
              "lore": [
                "<gray>Defina um valor que o jogador</gray>",
                "<gray>irá vender o item na sua loja.</gray>",
                "",
                " <red>▸ </red><white>Valor de venda: {sign_shop_sell_formatted_value}</white>",
                "",
                "<red>Clique para definir o valor.</red>"
              ]
            },
            "3": {
              "without": {
                "name": "<red>Erro!</red>",
                "lore": [
                  "<gray>Selecione um item primeiro</gray>",
                  "<gray>para criar uma loja.</gray>"
                ]
              },
              "with": {
                "name": "<green>Confirmação</green>",
                "lore": [
                  "<gray>Clique para criar sua loja!</gray>"
                ]
              }
            }
          }
        },
        "sign-shop-select-currency": {
          "title": "Escolha a sua economia",
          "items": {
            "0": {
              "name": "{sign_shop_currency_color}{sign_shop_currency_name_plural_with_capitalize_first_letter}",
              "lore": [
                "",
                "{sign_shop_currency_color}Clique para selecionar."
              ]
            }
          }
        },
        "sign-shop-edit": {
          "title": "Sua loja",
          "items": {
            "0": {
              "name": "<green>Compra</green>",
              "lore": [
                "<gray>Defina um valor que o jogador</gray>",
                "<gray>irá comprar o item na sua loja.</gray>",
                "",
                " <green>▸ </green><white>Valor de compra: {sign_shop_buy_value_formatted}</white>",
                "",
                "<green>Clique para definir o valor.</green>"
              ]
            },
            "1": {
              "name": "<red>Vender</red>",
              "lore": [
                "<gray>Defina um valor que o jogador</gray>",
                "<gray>irá vender o item na sua loja.</gray>",
                "",
                " <red>▸ </red><white>Valor de venda: {sign_shop_sell_value_formatted}</white>",
                "",
                "<red>Clique para definir o valor.</red>"
              ]
            },
            "2": {
              "name": "<red>Destruir loja</red>",
              "lore": [
                "<gray>Clique para destruir a loja.</gray>"
              ]
            },
            "3": {
              "opened": {
                "name": "<yellow>Atividade da loja</yellow>",
                "lore": [
                  " <white>Estado: </white><green>aberto</green>"
                ]
              },
              "closed": {
                "name": "<yellow>Atividade da loja</yellow>",
                "lore": [
                  " <white>Estado: </white><red>fechado</red>"
                ]
              }
            }
          }
        },
        "sign-shop-visualize": {
          "title": "Informações da Loja",
          "items": {
            "0": {
              "both": {
                "lore": [
                  "",
                  " <dark_gray>► </dark_gray><white>Compra: {sign_item_buy_value_formatted}</white>",
                  " <dark_gray>► </dark_gray><white>Venda: {sign_item_sell_value_formatted}</white>",
                  " <dark_gray>► </dark_gray><white>Quantia: </white><gray>{sign_item_amount}</gray>"
                ]
              },
              "only-buy": {
                "lore": [
                  "",
                  " <dark_gray>► </dark_gray><white>Compra: {sign_item_buy_value_formatted}</white>",
                  " <dark_gray>► </dark_gray><white>Quantia: </white><gray>{sign_item_amount}</gray>"
                ]
              },
              "only-sell": {
                "lore": [
                  "",
                  " <dark_gray>► </dark_gray><white>Venda: {sign_item_sell_value_formatted}</white>",
                  " <dark_gray>► </dark_gray><white>Quantia: </white><gray>{sign_item_amount}</gray>"
                ]
              }
            }
          }
        }
      }
    }
  }
}