{
    "plugins": {
        "machines": {
            "types": {
                "power": {
                    "name": "Máquina de Poder de Compra",
                    "unit": "Poder"
                },
                "supreme": {
                    "name": "Máquina de Poder de Compra Suprema",
                    "unit": "Poder"
                }
            },
            "hologram": [
                "{machine_color}{machine_name} <gray>(x{machine_amount})</gray>",
                "<white>Proprietário: {machine_owner_name_with_tag}</white>",
                "<white>Acumulado: {machine_generation_currency_color}{machine_generation_currency_icon}{machine_display_value}</white>"
            ],
            "permissions": {
                "types": {
                    "machine-add": {
                        "name": "<color:#ff8200>Adicionar máquinas",
                        "description": [
                            "<gray>Com esta permissão o jogador</gray>",
                            "<gray>poderá adicionar mais máquinas.</gray>"
                        ]
                    },
                    "machine-remove": {
                        "name": "<color:#ff8200>Remover máquinas",
                        "description": [
                            "<gray>Com esta permissão o jogador</gray>",
                            "<gray>poderá remover as máquinas.</gray>"
                        ]
                    },
                    "machine-collect": {
                        "name": "<color:#ff8200>Coletar poder",
                        "description": [
                            "<gray>Com esta permissão o jogador</gray>",
                            "<gray>poderá recolher o poder.</gray>"
                        ]
                    },
                    "machine-manage-upgrades": {
                        "name": "<color:#ff8200>Gerenciar evoluções",
                        "description": [
                            "<gray>Com esta permissão o jogador</gray>",
                            "<gray>poderá gerenciar evoluções.</gray>"
                        ]
                    }
                }
            },
            "upgrades": {
                "types": {
                    "machine-speed": {
                        "name": "Velocidade",
                        "description": [
                            "<gray>Diminua o tempo de geração</gray>",
                            "<gray>de Poder da máquina.</gray>"
                        ],
                        "icons": {
                            "max-level": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Velocidade:</white> <gray>{machine_upgrade_actual_value}s</gray>"
                                ]
                            },
                            "upgrade": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Velocidade:</white> <gray><strikethrough>{machine_upgrade_actual_value}s</strikethrough></gray> <dark_gray>➟ </dark_gray><white>{machine_upgrade_next_value}s</white>",
                                    " <dark_gray>▸</dark_gray> <white>Custo:</white> {machine_upgrade_next_cost}"
                                ]
                            }
                        }
                    },
                    "machine-storage": {
                        "name": "Capacidade",
                        "description": [
                            "<gray>Aumente a capacidade máxima</gray>",
                            "<gray>de armazenamento da máquina.</gray>"
                        ],
                        "icons": {
                            "max-level": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Capacidade:</white> <color:#ff8200>∞{machine_upgrade_actual_value}"
                                ]
                            },
                            "upgrade": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Capacidade:</white> <color:#ff8200><strikethrough>∞{machine_upgrade_actual_value}</strikethrough> <dark_gray>➟ </dark_gray><color:#ff8200>∞{machine_upgrade_next_value}",
                                    " <dark_gray>▸</dark_gray> <white>Custo:</white> {machine_upgrade_next_cost}"
                                ]
                            }
                        }
                    },
                    "machine-generation": {
                        "name": "Geração",
                        "description": [
                            "<gray>Aumente a quantidade de poder</gray>",
                            "<gray>gerado pela máquina.</gray>"
                        ],
                        "icons": {
                            "max-level": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Geração:</white> <color:#ff8200>∞{machine_upgrade_actual_value}"
                                ]
                            },
                            "upgrade": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Geração:</white> <color:#ff8200><strikethrough>∞{machine_upgrade_actual_value}</strikethrough> <dark_gray>➟ </dark_gray><color:#ff8200>∞{machine_upgrade_next_value}",
                                    " <dark_gray>▸</dark_gray> <white>Custo:</white> {machine_upgrade_next_cost}"
                                ]
                            }
                        }
                    },
                    "machine-fuel": {
                        "name": "Combustível",
                        "description": [
                            "<gray>Aumente a quantidade máxima de</gray>",
                            "<gray>combustível dentro da máquina.</gray>"
                        ],
                        "icons": {
                            "max-level": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Combustível:</white> <gray>{machine_upgrade_actual_value}</gray>"
                                ]
                            },
                            "upgrade": {
                                "name": "<color:#ff8200>{machine_upgrade_name} <gray>(Nvl. {machine_upgrade_actual_level})</gray>",
                                "lore": [
                                    "{machine_upgrade_description}",
                                    "",
                                    " <dark_gray>▸</dark_gray> <white>Combustível:</white> <gray><strikethrough>{machine_upgrade_actual_value}</strikethrough></gray> <dark_gray>➟ </dark_gray><white>{machine_upgrade_next_value}</white>",
                                    " <dark_gray>▸</dark_gray> <white>Custo:</white> {machine_upgrade_next_cost}"
                                ]
                            }
                        }
                    }
                }
            },
            "items": {
                "machine": {
                    "display-name": "{machine_color}{machine_name}",
                    "name": "{machine_color}{machine_name}",
                    "lore": [
                        "",
                        "{machine_color}Informações sobre a máquina:",
                        "{machine_color}│ <white>Velocidade: </white><gray>{machine_upgrade_speed_value} segundos</gray>",
                        "{machine_color}│ <white>Máximo de Combustível: </white><gray>{machine_upgrade_fuel_value}L</gray>",
                        "{machine_color}│ <white>Geração de Poder: </white><gold>∞{machine_upgrade_generation_value} Poder",
                        "{machine_color}│ <white>Máximo de Poder: </white><gold>∞{machine_upgrade_storage_value} Poder",
                        "",
                        " {machine_color}▸ <white>Máquinas empilhadas: </white><gray>x{machine_amount}</gray>",
                        " {machine_color}▸ <white>Combustível: </white><gray>{machine_fuel}L/{machine_upgrade_fuel_value}L</gray>"
                    ]
                },
                "machine-fuel-infinity": {
                    "display-name": "<color:#ff8200>Combustível Infinito",
                    "name": "<color:#ff8200>Combustível Infinito",
                    "lore": [
                        "<gray>Este item faz sua máquina de poder</gray>",
                        "<gray>nunca mais precisar ser abastecida.</gray>"
                    ]
                },
                "machine-fuel": {
                    "display-name": "<green>Combustível</green>",
                    "name": "<green>Combustível</green>",
                    "lore": [
                        "<gray>Utilize este item para abastecer</gray>",
                        "<gray>sua máquina de poder.</gray>",
                        "",
                        " <dark_gray>│ </dark_gray><white>Quantia: </white><gray>{machine_fuel_amount}L</gray>"
                    ]
                }
            },
            "messages": {
                "permissions": {
                    "not-allowed": {
                        "machine-add": "Você não tem permissão para adicionar mais máquinas a esta máquina.",
                        "machine-remove": "Você não pode remover esta máquina.",
                        "machine-collect": "Você não tem permissão para coletar.",
                        "machine-manage-upgrades": "Você não tem permissão de gerenciar as evoluções dessa máquina.",
                        "machine-manage-friends": "Você não tem permissão de gerenciar os amigos dessa máquina."
                    }
                },
                "items": {
                    "machine-fuel": {
                        "already-full-storage": "Sua máquina já está com o combustível cheio!"
                    },
                    "machine-fuel-infinity": {
                        "already-have": "Você já ativou um Combustível Infinito nessa máquina!",
                        "success": "Você ativou um Combustível Infinito na sua máquina!"
                    }
                },
                "views": {
                    "machine-friend-list": {
                        "friend-add": {
                            "conversation": {
                                "query": "Digite o nome do jogador que você deseja adicionar.",
                                "responses": {
                                    "always-added": "Esse jogador já está adicionado em sua máquina!",
                                    "success": "Jogador adicionado com sucesso a sua máquina!"
                                }
                            }
                        }
                    },
                    "machine-friend-manage": {
                        "remove": {
                            "success": "Você removeu o jogador {machine_target_name} de sua máquina."
                        },
                        "update": {
                            "success": "Permissão alterada com sucesso."
                        }
                    },
                    "machine-upgrade": {
                        "upgrades": {
                            "already-passed-level": "Você já passou por esse nível!",
                            "no-currency": "Você não possui os requisitos para evoluir esse nível!",
                            "success": "Você evoluiu um nível com sucesso!"
                        }
                    },
                    "machine-primary": {
                        "collect": {
                            "empty": "Você não possui nada para coletar nessa máquina :(",
                            "success": "Você coletou {machine_collected_value_formatted} <green>de sua máquina!</green>"
                        }
                    }
                }
            },
            "views": {
                "machine-friend-list": {
                    "title": "Amigos",
                    "items": {
                        "0": {
                            "available-slot": {
                                "name": "<green>Slot disponível!</green>",
                                "lore": [
                                    "<gray>Clique para adicionar e gerenciar</gray>",
                                    "<gray>as permissões de um jogador nos</gray>",
                                    "<gray>seus geradores.</gray>",
                                    "",
                                    "<green>Clique para adicionar.</green>"
                                ]
                            },
                            "manage": {
                                "name": "{machine_permission_target_name_with_tag}",
                                "lore": [
                                    "",
                                    " <dark_gray>▸ </dark_gray><white>Adicionar máquinas: </white>{machine_permission_machine_add}",
                                    " <dark_gray>▸ </dark_gray><white>Remover máquinas: </white>{machine_permission_machine_remove}",
                                    " <dark_gray>▸ </dark_gray><white>Coletar poder: </white>{machine_permission_machine_collect}",
                                    " <dark_gray>▸ </dark_gray><white>Gerenciar evoluções: </white>{machine_permission_machine_manage_upgrades}",
                                    "",
                                    "<green>Clique para gerenciar.</green>"
                                ]
                            }
                        }
                    }
                },
                "machine-friend-manage": {
                    "title": "Permissões ➟ {machine_target_name}",
                    "items": {
                        "0": {
                            "name": "<red>Remover amigo</red>",
                            "lore": [
                                "<gray>Remova este amigo de usar</gray>",
                                "<gray>esta máquina.</gray>",
                                "",
                                "<green>Clique para remover.</green>"
                            ]
                        },
                        "1": {
                            "on": {
                                "name": "<green>{machine_permission_name}</green>",
                                "lore": [
                                    "{machine_permission_description}",
                                    "",
                                    " <dark_gray>▸ </dark_gray><white>Estado: </white><green>Ativado</green>",
                                    "",
                                    "<green>Clique para alternar.</green>"
                                ]
                            },
                            "off": {
                                "name": "<red>{machine_permission_name}</red>",
                                "lore": [
                                    "{machine_permission_description}",
                                    "",
                                    " <dark_gray>▸ </dark_gray><white>Estado: </white><red>Desativado</red>",
                                    "",
                                    "<red>Clique para alternar.</red>"
                                ]
                            }
                        }
                    }
                },
                "machine-upgrade": {
                    "title": "Evoluções",
                    "items": {
                        "0": {
                            "max-level": {
                                "lore": [
                                    "",
                                    "<gray>Você já está no nível máximo!</gray>"
                                ]
                            },
                            "no-currency": {
                                "lore": [
                                    "",
                                    "<red>Você não possui os requisitos!</red>"
                                ]
                            },
                            "allowed": {
                                "lore": [
                                    "",
                                    "<color:#ff8200>Clique para comprar!"
                                ]
                            }
                        }
                    }
                },
                "machine-primary": {
                    "title": "{machine_name}",
                    "items": {
                        "0": {
                            "name": "{machine_color}{machine_name}",
                            "lore": [
                                "",
                                "{machine_color}Informações sobre a máquina:",
                                " {machine_color}│ <white>Velocidade: </white><gray>{machine_upgrade_speed_value} segundos</gray>",
                                " {machine_color}│ <white>Máximo de Combustível: </white><gray>{machine_upgrade_fuel_value}L</gray>",
                                " {machine_color}│ <white>Geração de Poder: </white><gold>∞{machine_upgrade_generation_value} Poder",
                                " {machine_color}│ <white>Máximo de Poder: </white><gold>∞{machine_upgrade_storage_value} Poder",
                                "",
                                " {machine_color}▸ <white>Máquinas empilhadas: </white><gray>x{machine_amount}</gray>",
                                " {machine_color}▸ <white>Combustível: </white><gray>{machine_fuel}L/{machine_upgrade_fuel_value}L</gray>"
                            ]
                        },
                        "1": {
                            "name": "<color:#ff8200>Evoluções",
                            "lore": [
                                "<gray>Confira as evoluções disponíveis</gray>",
                                "<gray>para serem feitas em sua máquina.</gray>",
                                "",
                                "<color:#ff8200>Clique para acessar."
                            ]
                        },
                        "2": {
                            "name": "<yellow>Amigos</yellow>",
                            "lore": [
                                "<gray>Clique para acessar os jogadores</gray>",
                                "<gray>que possuem acesso a sua máquina.</gray>",
                                "",
                                "<yellow>Clique para gerenciar.</yellow>"
                            ]
                        },
                        "3": {
                            "name": "<color:#ff8200>Coletar {machine_unit}",
                            "lore": [
                                "<gray>Clique para coletar o seu</gray>",
                                "<gray>{machine_unit} acumulado.</gray>",
                                "",
                                " <dark_gray>▸ </dark_gray><white>{machine_unit} acumulado: </white><color:#ff8200>∞{machine_storage}",
                                "",
                                "<color:#ff8200>Clique para coletar."
                            ]
                        }
                    }
                }
            }
        }
    }
}