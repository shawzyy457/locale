{
    "plugins": {
        "duels": {
            "modes": {
                "casual": {
                    "icon": {
                        "name": "<color:#ff8200>Casual",
                        "lore": [
                            "<gray>Duele com outro jogador",
                            "<gray>apenas pela diversão.",
                            "",
                            "<color:#ff8200>Clique para duelar!"
                        ]
                    }
                },
                "betting": {
                    "icon": {
                        "name": "<color:#ff8200>Apostando",
                        "lore": [
                            "<gray>Duele com outro jogador",
                            "<gray>valendo coins!",
                            "",
                            "<color:#ff8200>Clique para duelar!"
                        ]
                    }
                },
                "ranked": {
                    "icon": {
                        "name": "<color:#ff8200>Rankeado",
                        "lore": [
                            "<gray>Duele com outro jogador",
                            "<gray>valendo pontos de liga.",
                            "",
                            "<color:#ff8200>Clique para duelar!"
                        ]
                    }
                }
            },
            "views": {
                "primary": {
                    "title": "Central de Duelos",
                    "items": {
                        "0": {
                            "name": "<color:#ff8200>Suas estatísticas",
                            "lore": [
                                "<gray>Confira abaixo as suas",
                                "<gray>estatísticas em duelos.",
                                "",
                                "<color:#ff8200> Estatísticas:",
                                "<white> Abates: <gray>{duel_user_kills}",
                                "<white> Mortes: <gray>{duel_user_deaths}",
                                "<white> K/D: <gray>{duel_user_kdr}",
                                "",
                                "<white> Winstreak: <gray>{duel_user_win_streak}",
                                "<white> Maior Winstreak: <gray>{duel_user_highest_win_streak}",
                                "",
                                "<color:#ff8200>Duelos disputados: <white>{duel_user_duels_amount}"
                            ]
                        },
                        "1": {
                            "name": "<color:#ff8200>Top duelos",
                            "lore": [
                                "<gray>Confira a lista dos",
                                "<gray>jogadores com mais",
                                "<gray>vitórias em duelos.",
                                "",
                                "<color:#ff8200>Clique para acessar."
                            ]
                        }
                    }
                },
                "settings": {
                    "title": "Configurar Duelo",
                    "items": {
                        "0": {
                            "name": "<color:#ff8200>Escolher adversário",
                            "lore": [
                                "<gray>Escolha o adversário",
                                "<gray>que deseja enfrentar.",
                                "",
                                "<color:#ff8200>Clique para escolher!"
                            ]
                        },
                        "1": {
                            "name": "<color:#ff8200>Quantia apostada",
                            "lore": [
                                "<gray>Escolha qual a quantia",
                                "<gray>que deseja apostar.",
                                "",
                                "<dark_gray> ▸ <white>Quantia: <green>$<white>{bet_amount}",
                                "",
                                "<color:#ff8200>Clique para alterar!"
                            ]
                        },
                        "2": {
                            "name": "<color:#ff8200>Adversário aleatório",
                            "lore": [
                                "<gray>Envie uma solicitação de",
                                "<gray>duelo e jogue contra o",
                                "<gray>jogador que aceitar.",
                                "",
                                "<color:#ff8200>Clique para enviar!"
                            ]
                        }
                    }
                }
            },
            "commands": {
                "duels": {
                    "deny": {
                        "arguments": {
                            "player": {
                                "name": "jogador",
                                "description": "Jogador a recusar o pedido"
                            }
                        },
                        "no-invite-available": "Você não possui um pedido de duelo pendente deste jogador."
                    },
                    "accept": {
                        "arguments": {
                            "player": {
                                "name": "jogador",
                                "description": "Jogador a aceitar o pedido"
                            }
                        },
                        "no-invite-available": "Você não possui um pedido de duelo pendente deste jogador.",
                        "insufficient-coins": "Você não possui a quantia de coins para apostar."
                    }
                }
            },
            "messages": {
                "conversation": {
                    "bet-amount": {
                        "query": "Digite a quantia que deseja apostar:",
                        "responses": {
                            "invalid-amount": "A quantia informada é inválida.",
                            "insufficient-coins": "Você não possui coins suficientes para isso."
                        }
                    }
                },
                "on-invite-send": "Seu pedido foi enviado com sucesso.",
                "on-invite-receive": [
                    "",
                    "<color:#ff8200> Você recebeu um pedido de duelo de <white>{player}<color:#ff8200>.",
                    "<color:#ff8200> Clique</color:#ff8200> <hover:show_text:'<gray>Clique aqui para aceitar o pedido.</gray>'><click:run_command:'/duelo aceitar {player}'><color:#ff8200><bold>AQUI</bold></color:#ff8200></click></hover> <color:#ff8200>para aceitar o pedido.</color:#ff8200>",
                    ""
                ],
                "on-invite-expire-sender": "Seu pedido de duelo enviado para {player} expirou.",
                "on-invite-expire-target": "O pedido de duelo enviado por {player} expirou.",
                "on-invite-deny-sender": "{player} recusou seu pedido de duelo.",
                "on-invite-deny-target": "Você recusou o pedido de duelo de {player} com sucesso.",
                "on-invite-accept-sender": "{player} aceitou seu pedido de duelo.",
                "on-invite-accept-target": "Você aceitou o pedido de duelo de {player} com sucesso.",
                "errors": {
                    "no-invite": "Você não tem nenhum convite de duelo desse jogador.",
                    "already-has-invite": "Você já tem um convite de duelo pendente para esse jogador.",
                    "already-in-duel": "Você já está em um duelo.",
                    "not-enough-coins": "Você não tem coins suficientes para apostar essa quantia.",
                    "elo-difference-too-high": "A diferença de elo é grande demais para esse duelo (o máximo é {max_difference} pontos)."
                },
                "on-command": {
                    "not-allowed": "Você não pode usar esse comando durante um duelo."
                },
                "queue": {
                    "joined-casual": "Você entrou na fila de duelo casual.",
                    "joined-ranked": "Você entrou na fila de duelo rankeado.",
                    "joined-betting": "Você entrou na fila de duelo apostado, valendo {amount} coins.",
                    "left": "Você saiu da fila de duelo."
                },
                "success": {
                    "betting-win": "Você venceu o duelo e levou {amount} {currency}!",
                    "ranked-win": "Você venceu o duelo e ganhou {elo} pontos de liga!"
                },
                "error": {
                    "betting-lose": "Você perdeu o duelo e {amount} {currency}.",
                    "ranked-lose": "Você perdeu o duelo e {elo} pontos de liga."
                }
            },
            "conversation": {
                "opponent-select": {
                    "title": "Digite o nome do jogador que você deseja duelar:"
                },
                "bet-amount": {
                    "title": "Digite a quantia de coins que você deseja apostar:"
                }
            }
        }
    }
}
