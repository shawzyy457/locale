{
    "plugins": {
        "server-core": {
            "commands": {
                "global": {
                    "arguments": {
                        "message": {
                            "name": "mensagem",
                            "description": "Mensagem que será enviada no chat"
                        }
                    },
                    "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
                    "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
                    "chat-locked": "O chat global está desabilitado!",
                    "dont-have-requirements": "Você precisa ter no mínimo {chat_message_currency_value_formatted_requirement} para enviar uma mensagem no chat!",
                    "message": {
                        "with-space": {
                            "with-clan": [
                                "",
                                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '>[G]</click></hover></gray> <white><hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/clan info {sender_clan_tag}'>[{sender_clan_tag}]</click></hover></white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>",
                                ""
                            ],
                            "without-clan": [
                                "",
                                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '>[G]</click></hover></gray> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>",
                                ""
                            ]
                        },
                        "without-space": {
                            "with-clan": [
                                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '>[G]</click></hover></gray> <white><hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/clan info {sender_clan_tag}'>[{sender_clan_tag}]</click></hover></white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>"
                            ],
                            "without-clan": [
                                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '>[G]</click></hover></gray> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>"
                            ]
                        }
                    }
                },
                "local": {
                    "arguments": {
                        "message": {
                            "name": "mensagem",
                            "description": "Mensagem que será enviada no chat"
                        }
                    },
                    "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
                    "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
                    "chat-locked": "O chat local está desabilitado!",
                    "dont-have-requirements": "Você precisa ter no mínimo {chat_message_currency_value_formatted_requirement} para enviar uma mensagem no chat!",
                    "without-receivers": "<red>Parece que você está sozinho aqui :(</red>",
                    "message": {
                        "with-space": {
                            "with-clan": [
                                "",
                                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'>[L]</hover></yellow> <white><hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/clan info {sender_clan_tag}'>[{sender_clan_tag}]</click></hover></white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>",
                                ""
                            ],
                            "without-clan": [
                                "",
                                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'>[L]</hover></yellow> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>",
                                ""
                            ]
                        },
                        "without-space": {
                            "with-clan": [
                                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'>[L]</hover></yellow> <white><hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/clan info {sender_clan_tag}'>[{sender_clan_tag}]</click></hover></white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>"
                            ],
                            "without-clan": [
                                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'>[L]</hover></yellow> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>"
                            ]
                        }
                    }
                },
                "superchat": {
                    "arguments": {
                        "message": {
                            "name": "mensagem",
                            "description": "Mensagem que será enviada no chat"
                        }
                    },
                    "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
                    "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
                    "chat-locked": "O chat está desabilitado!",
                    "message": [
                        "",
                        " <aqua>[✉] <bold>TOP CHAT</bold></aqua> <white>de {sender_name_with_tag}!</white>",
                        " <dark_gray>➟</dark_gray> <white>{chat_message}</white>",
                        ""
                    ]
                },
                "toggle-chat": {
                    "arguments": {
                        "type": {
                            "name": "tipo",
                            "description": "Tipo do canal que você deseja mudar o status"
                        }
                    },
                    "chat-type-not-found": "Não foi possivel encontrar um chat com esse id",
                    "success-locked": "O status do chat {chat_type_name} foi alterado para desabilitado.",
                    "success-unlocked": "O status do chat {chat_type_name} foi alterado para habilitado."
                }
            },
            "messages": {
                "chat": {
                    "adapters": {
                        "plot": "<hover:show_text:'<gray>Clique para teleportar para o terreno do jogador</gray>'><click:suggest_command:'/plot h:{plot_index} {plot_owner_name}'>Ir para o Terreno #{plot_index} de {plot_owner_name}</click></hover>",
                        "shop": "<hover:show_text:'<gray>Clique para teleportar para a loja do jogador</gray>'><click:suggest_command:'/lojas {shop_owner_name}'>Ir para a loja de {shop_owner_name}"
                    }
                }
            }
        }
    }
}