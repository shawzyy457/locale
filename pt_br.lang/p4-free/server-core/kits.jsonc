{
  "plugins": {
    "server-core": {
      "kits": {
        "categories": {
          "default": {
            "name": "<green>Kits Básicos</green>",
            "description": [
              "<gray>Acesse os kits que todos</gray>",
              "<gray>os jogadores possuem acesso.</gray>"
            ]
          },
          "vip": {
            "name": "<green>Kits VIPs</green>",
            "description": [
              "<gray>Encontre os kits para jogadores</gray>",
              "<gray>que possuem alguma vantagem.</gray>"
            ]
          }
        },
        "types": {
          "member_1d": {
            "name": "<gray>Kit Básico 1d <white>"
          },
          "member_7d": {
            "name": "<gray>Kit Básico 7d <white>"
          },
          "pro_1d": {
            "name": "<gradient:#FF55FF:#FFADFA>Kit 1d <white></white>"
          },
          "pro_7d": {
            "name": "<gradient:#FF55FF:#FFADFA>Kit 7d <white></white>"
          },
          "mvp_1d": {
            "name": "<gradient:#55FFFF:#D5FFF3>Kit 1d <white></white>"
          },
          "mvp_7d": {
            "name": "<gradient:#55FFFF:#D5FFF3>Kit 7d <white></white>"
          },
          "elite_1d": {
            "name": "<gradient:#AA0000:#FB241D>Kit 1d <white></white>"
          },
          "elite_7d": {
            "name": "<gradient:#AA0000:#FB241D>Kit 7d <white></white>"
          },
          "EXE_1d": {
            "name": "<gradient:#FF8200:#FFF763>EXE 1d <white></white>"
          },
          "EXE_7d": {
            "name": "<gradient:#FF8200:#FFF763>EXE 7d <white></white>"
          }
        }
      },
      "commands": {
        "createkit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será criado"
            }
          },
          "already-have-with-id": "Já existe um kit com esse id criado!",
          "invalid-kit-id-length": "Você não pode usar um id que tem mais de 16 caracteres.",
          "success": "Você criou o kit com sucesso!"
        },
        "deletekit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será deletado"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!",
          "success": "O kit {kit_id} foi deletado com sucesso."
        },
        "editkit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será editado"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!"
        },
        "givekit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será enviado"
            },
            "target": {
              "name": "jogador",
              "description": "Jogador que irá receber o kit"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!",
          "success": "Você deu o kit \"{kit_id}\" para o jogador {target_name}!"
        }
      },
      "messages": {
        "kits": {
          "on-collect": {
            "dont-have-permission": "Você não possui permissão para coletar esse kit.",
            "in-delay": "Você precisa esperar mais {kit_cooldown_remaining} para coletar esse kit.",
            "success": "Kit \"<white>{kit_name}</white>\" coletado!"
          }
        },
        "views": {
          "kit-edit": {
            "update-icon": {
              "conversation": {
                "query": "Você tem certeza que deseja definir o item em sua mão como o icone?",
                "responses": {
                  "need-item-in-hand": "Você precisa segurar o item em sua mão!",
                  "success": "Icone do kit \"{kit_id}\" alterado com sucesso."
                }
              }
            },
            "update-groups": {
              "conversation": {
                "query": "Digite a permissão que deseja para o kit.",
                "responses": {
                  "success": "Grupos do kit \"{kit_id}\" alterados para <white>{kit_groups}</white>."
                }
              }
            },
            "update-items": {
              "conversation": {
                "query": "Você tem certeza que deseja alterar os items do kit para os items de seu inventário.",
                "responses": {
                  "success": "Items do kit \"{kit_id}\" alterados."
                }
              }
            },
            "update-delay": {
              "conversation": {
                "query": "Digite no chat o novo delay para seu kit.",
                "responses": {
                  "success": "Delay do kit \"{kit_id}\" alterado para \"<white>{kit_cooldown}</white>\"."
                }
              }
            }
          }
        }
      },
      "views": {
        "kit-edit": {
          "title": "Editando - {kit_name}",
          "items": {
            "0": {
              "name": "<green>Alterar icon</green>",
              "lore": [
                "<gray>Clique aqui para definir</gray>",
                "<gray>um novo icon para o kit.</gray>"
              ]
            },
            "1": {
              "name": "<green>Alterar permissão</green>",
              "lore": [
                "<gray>Clique aqui para definir</gray>",
                "<gray>uma nome permissão para o kit.</gray>"
              ]
            },
            "2": {
              "name": "<green>Alterar items</green>",
              "lore": [
                "<gray>Clique aqui para definir</gray>",
                "<gray>os items do seu kit.</gray>",
                "",
                "<yellow>Os items serão os que estão em seu inventário.</yellow>"
              ]
            },
            "3": {
              "name": "<green>Alterar segundos</green>",
              "lore": [
                "<gray>Clique aqui para definir</gray>",
                "<gray>o delay do seu kit.</gray>",
                "",
                "<yellow>O delay precisa ser em segundos.</yellow>"
              ]
            }
          }
        },
        "kit-visualization": {
          "title": "{kit_name}"
        },
        "kit-categories": {
          "title": "Categorias de Kits",
          "items": {
            "0": {
              "name": "{kit_category_name}",
              "lore": [
                "{kit_category_description}",
                "",
                "<green>Clique para acessar.</green>"
              ]
            }
          }
        },
        "kit-category": {
          "title": "{kit_category_name_stripped}",
          "items": {
            "0": {
              "name": "{kit_name}",
              "lore": [
                "<gray>Clique direito para </gray><white>ver o conteúdo</white><gray>.</gray>",
                "<gray>Clique esquerdo para </gray><white>coletar.</white>",
                "",
                "<dark_gray>➟ </dark_gray><white>Tempo p/ coletar: </white><gray>{kit_cooldown}</gray>"
              ]
            }
          }
        }
      }
    }
  }
}