                            },
                            "stable": {
                                "name": "<green>Rush estável",
                                "lore": ["<white>[{first_clan}] <gray>{first_players} x {second_players} <white>[{second_clan}]", "", "<gray>Nenhuma virada está sendo confirmada."]
                            },
                            "refresh": {
