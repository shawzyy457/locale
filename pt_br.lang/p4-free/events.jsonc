                                "lore": ["<gray>Volta à central do Gladiador."]
                            }
                        }
                    },
                    "rush-score": {
                        "title": "Placar de Rushes",
                        "items": {
                            "entry": {
                                "name": "<yellow>[{first_clan}] <white>vs <yellow>[{second_clan}]",
                                "lore": ["<white>{first_clan}: <gold>{first_wins} vitórias", "<white>{second_clan}: <gold>{second_wins} vitórias"]
