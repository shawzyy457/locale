                                "name": "<green>Gladiador — {event_date}",
                                "lore": ["<gray>Data: <white>{event_date}", "<gray>Duração: <white>{event_duration}", "<gray>Participantes: <white>{event_players}", "<gray>Clan vencedor: <white>{clan_winner}", "<gray>Mito: <white>{event_myth} <dark_gray>({event_myth_kills} abates)", "", "<yellow>Clique para ver os detalhes!"]
                            },
                            "back": {
                                "name": "<red>Voltar",
                                "lore": ["<gray>Volta à central do Gladiador."]
                            }
                        }
