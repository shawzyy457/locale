                    "history-detail": {
                        "title": "Detalhes do Gladiador",
                        "items": {
                            "overview": {
                                "name": "<gold><bold>Resumo do evento",
                                "lore": ["<gray>ID: <white>{event_id}", "<gray>Estado: <white>{event_status}", "<gray>Clan vencedor: <white>{clan_winner}", "<gray>Mito: <white>{event_myth} <dark_gray>({event_myth_kills} abates)", "<gray>Participantes: <white>{event_players}"]
                            },
