                },
                "classes": {
                    "title": "todas as classes existentes"
                },
                "class-upgrade": {
                    "title": "evolua sua classe",
                    "items": {
                        "0": {
                            "name": "{class_color}Nível concluído!"
                        },
                        "1": {
                            "name": "<red>Nenhuma melhoria disponível.",
                            "lore": [
                                "<gray>selecione uma classe para ver",
                                "<gray>suas melhorias."
                            ]
                        }
                    }
                },
                "select-class": {
                    "title": "escolha a sua classe"
                },
                "change-class": {
                    "title": "mude de classe",
                    "items": {
                        "0": {
                            "name": "<red>remover classe selecionada",
                            "lore": [
                                "<gray>Enjoôu da sua classe ?",
                                "<gray>remova ela agora.",
                                "",
                                "<white><bold> OBS:</bold> você ficara com 5",
                                "<white> minutos de cooldown.",
                                ""
                            ]
                        },
                        "1": {
                            "name": "<red>voltar"
                        },
                        "2": {
                            "lore": {
                                "1": [
                                    "",
                                    "<green>classe selecionada."
                                ],
                                "2": [
                                    "",
                                    "<yellow>clique para selecionar."
                                ],
                                "3": [
                                    "",
                                    " <white>Preço: <green>$<white>{price}",
                                    "",
                                    "<yellow>clique para comprar."
                                ]
                            }
                        }
                    }
                }
            },
            "messages": {
                "is-in-delay": "<red>Você precisa aguardar {cooldown} para usar novamente!",
                "views": {
                    "select-class": {
                        "selected-class": "<yellow><bold>GG!</bold> Você selecionou {class_name}"
                    },
                    "class-upgrade": {
                        "invalid-level": "<red>Você precisa evoluir o nível anterior.",
                        "level-already-completed": "<red>Você já evoluiu esse nível.",
                        "no-has-value": "<red>Você não possui {price} coins para evoluir sua classe.",
                        "buy-class": "<green><bold>GG!</bold> você evoluiu a sua classe para o nível {class_level}."
                    },
                    "change-class": {
                        "remove-class": "<red><bold>YEAH!</bold> você  removeu a sua classe selecionada.",
                        "no-selected-class": "<red>Você já está sem nenhuma classe selecionada.",
                        "is-in-cooldown": "<red>Você precisa aguardar {cooldown} para trocar de classe.",
                        "no-has-value": "<red>Você não possui {price} coins para desbloquear essa classe.",
                        "already-selected": "<red>Você já está com essa classe selecionada.",
                        "select-class": "<yellow>Você selecionou a classe {class_name}.",
                        "buy-class": "<green><bold>GG!</bold> você desbloqueou a classe {class_name}."
                    }
                }
            }
        }
