{
    "plugins": {
        "classes": {
            "classes": {
                "assasin": {
                    "icon": {
                        "name": "<dark_red>assasino",
                        "lore": [
                            "<gray>uma ameaça crescente no",
                            "<gray>campo de batalha.",
                            "",
                            "<dark_red> ▾ habilidade",
                            "<gray>   receba 10% a mais de dano",
                            "<gray>   após conseguir um abate.",
                            "",
                            "<dark_red>sem limite de jogadores."
                        ]
                    },
                    "icon-upgrade": {
                        "name": "<dark_red>assasino <dark_gray>▸ <dark_red>nível {new_level}",
                        "lore": [
                            "<gray>uma ameaça crescente no",
                            "<gray>campo de batalha.",
                            "",
                            "<dark_red> informações:",
                            "<white> dano: <gray>{old_damage}% <dark_gray>➠ <white>{new_damage}%",
                            "<white> cooldown: <gray>{old_cooldown} <dark_gray>➠ <white>{new_cooldown}",
                            "",
                            "<dark_gray> ▸ <dark_red>preço: <dark_green>$<white>{price}",
                            "",
                            "<dark_red>clique para evoluir!"
                        ]
                    }
                },
                "ninja": {
                    "icon": {
                        "name": "<dark_purple>ninja",
                        "lore": [
                            "<gray>especializado em agilidade",
