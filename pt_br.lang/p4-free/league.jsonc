{
    "plugins": {
        "league": {
            "elos": {
                "beginner": {
                    "name": "<dark_gray>iniciante",
                    "description": [
                        "<gray>começou a sua carreira",
                        "<gray>agora hein...",
                        ""
                    ]
                },
                "experient": {
                    "name": "<dark_gray>experiente",
                    "description": [
                        "<gray>já sabe onde fica o",
                        "<gray>botão de atacar.",
                        ""
                    ]
                },
                "veteran": {
                    "name": "<dark_gray>veterano",
                    "description": [
                        "<gray>já tomou porrada o",
                        "<gray>suficiente pra aprender.",
                        ""
                    ]
                },
                "warrior": {
                    "name": "<dark_gray>guerreiro",
                    "description": [
                        "<gray>não entra em duelo",
                        "<gray>sem saber o que faz.",
                        ""
                    ]
                },
                "knight": {
                    "name": "<dark_gray>cavaleiro",
                    "description": [
                        "<gray>a essa altura já dá",
                        "<gray>trabalho pra qualquer um.",
                        ""
                    ]
                },
                "gladiator": {
                    "name": "<dark_gray>gladiador",
                    "description": [
                        "<gray>vive na arena e",
                        "<gray>gosta disso.",
                        ""
                    ]
                },
                "champion": {
                    "name": "<dark_gray>campeão",
                    "description": [
                        "<gray>o resto do servidor já",
                        "<gray>sabe o seu nome.",
                        ""
                    ]
                },
                "myth": {
                    "name": "<dark_gray>mito",
                    "description": [
                        "<gray>poucos chegaram até",
                        "<gray>aqui.",
                        ""
                    ]
                },
                "legend": {
                    "name": "<dark_gray>lenda",
                    "description": [
                        "<gray>o duelo acaba antes",
                        "<gray>de começar.",
                        ""
                    ]
                },
                "immortal": {
                    "name": "<dark_gray>imortal",
                    "description": [
                        "<gray>o topo da liga.",
                        "<gray>não tem pra onde subir.",
                        ""
                    ]
                }
            },
            "views": {
                "league": {
                    "title": "ligas",
                    "items": {
                        "0": {
                            "name": "{elo_name}",
                            "lore": {
                                "all-elos": [
                                    "{elo_color} Informações:",
                                    "<dark_gray> ▸<white> Pontos atuais: <gray>{user_points}",
                                    "<dark_gray> ▸<white> Pontos necessários: <gray>{elo_points}"
                                ],
                                "current-elo": [
                                    "",
                                    "<yellow>Este é o seu elo atual."
                                ]
                            }
                        },
                        "1": {
                            "name": "<yellow>loja de troféus",
                            "lore": [
                                "<gray>Explore e compre uma",
                                "<gray>variedade enorme de",
                                "<gray>itens GOD com troféus.",
                                "",
                                "<yellow>Clique para acessar!"
                            ]
                        },
                        "2": {
                            "name": "<color:#ff8200>sala dos campeões",
                            "lore": [
                                "<gray>Veja as suas estatísticas",
                                "<gray>ou as do seu clã em eventos",
                                "",
                                "<color:#ff8200>clique para acessar!"
                            ]
                        }
                    }
                },
                "league-stats": {
                    "title": "estatísticas",
                    "items": {
                        "0": {
                            "name": "<color:#ff8200>{event_name}",
                            "lore": {
                                "user": [
                                    "<gray>veja as suas estatísticas",
                                    "<gray>no evento {event_name}.",
                                    "",
                                    "<color:#ff8200> Estatísticas:",
                                    "<gray> ▸ <white>jogados: <gray>{event_games_played}",
                                    "<gray> ▸ <white>vitórias: <gray>{event_wins}",
                                    "<gray> ▸ <white>abates: <gray>{event_kills}",
                                    "<gray> ▸ <white>mortes: <gray>{event_deaths}",
                                    "",
                                    "<color:#ff8200>você já ganhou <white>{event_trophies} troféus",
                                    "<color:#ff8200>nesse evento."
                                ],
                                "clan": [
                                    "<gray>veja as estatísticas do seu",
                                    "<gray>clã no evento {event_name}.",
                                    "",
                                    "<color:#ff8200> Estatísticas:",
                                    "<gray> ▸ <white>jogados: <gray>{event_games_played}",
                                    "<gray> ▸ <white>vitórias: <gray>{event_wins}",
                                    "<gray> ▸ <white>abates: <gray>{event_kills}",
                                    "<gray> ▸ <white>mortes: <gray>{event_deaths}",
                                    "",
                                    "<color:#ff8200>você já ganhou <white>{event_trophies} troféus",
                                    "<color:#ff8200>nesse evento."
                                ]
                            }
                        },
                        "1": {
                            "name": "<color:#ff8200>Filtre por",
                            "lore": [
                                "<gray>veja abaixo os filtros",
                                "<gray>disponíveis.",
                                "",
                                "{filter_options}",
                                "",
                                "<color:#ff8200>clique para alterar."
                            ]
                        }
                    }
                }
            }
        }
    }
}