{
    "plugins": {
        "swords": {
            "items": {
                "sword": {
                    "name": "<color:#ff8200>espada evolutiva",
                    "lore": [
                        "{sword_enchantments}",
                        "",
                        "<color:#ff8200> skin equipada:",
                        "<dark_gray> ▸ <gray>{sword_skin}",
                        "",
                        "<color:#ff8200> informações:",
                        "<white> nível: <gray>{sword_level}",
                        "<white> xp: <gray>{sword_xp}",
                        " {sword_xp_progress_bar} <gray>{sword_xp_percentage}%",
                        "",
                        "<color:#ff8200>kills registradas: <white>{sword_kills}",
                        "",
                        "<color:#ff8200>Shift + direito p/ abrir"
                    ]
                }
            },
            "views": {
                "sword-view": {
                    "title": "espada",
                    "items": {
                        "0": {
                            "name": "{enchantment_name}",
                            "lore": {
                                "with-requirements": [
                                    "{enchantment_lore}",
                                    "",
                                    "<color:#ff8200> ▾ custo e informações",
                                    "<white>    custo: {currency_color}{currency_icon}<white>{enchantment_price}",
                                    "<white>    nível: <gray>{enchantment_current_level} / {enchantment_max_level}",
                                    "",
                                    "<color:#ff8200> requisitos",
                                    "<white> você cumpre todos os",
                                    "<white> requisitos.",
                                    "",
                                    "<color:#ff8200>clique para encantar."
                                ],
                                "without-requirements": [
                                    "{enchantment_lore}",
                                    "",
                                    "<color:#ff8200> ▾ custo e informações",
                                    "<white>    custo: {currency_color}{currency_icon}<white>{enchantment_price}",
                                    "<white>    nível: <gray>{enchantment_current_level} / {enchantment_max_level}",
                                    "",
                                    "<color:#ff8200> requisitos",
                                    "{enchantment_requirements}",
                                    "",
                                    "<red>nível insuficiente."
                                ]
                            }
                        },
                        "1": {
                            "name": "{enchantment_name}",
                            "lore": {
                                "with-requirements": [
                                    "{enchantment_lore}",
                                    "",
                                    "<color:#ff8200> ▾ custo e informações",
                                    "<white>    custo: {currency_color}{currency_icon}<white>{enchantment_price}",
                                    "<white>    nível: <gray>{enchantment_current_level} / {enchantment_max_level}",
                                    "<white>    chance: <gray>{enchantment_old_chance}% <dark_gray>▸ <white>{enchantment_new_chance}%",
                                    "",
                                    "<color:#ff8200> requisitos",
                                    "<white> você cumpre todos os",
                                    "<white> requisitos.",
                                    "",
                                    "<color:#ff8200>clique para encantar."
                                ],
                                "without-requirements": [
                                    "{enchantment_lore}",
                                    "",
                                    "<color:#ff8200> ▾ custo e informações",
                                    "<white>    custo: {currency_color}{currency_icon}<white>{enchantment_price}",
                                    "<white>    nível: <gray>{enchantment_current_level} / {enchantment_max_level}",
                                    "<white>    chance: <gray>{enchantment_old_chance}% <dark_gray>▸ <white>{enchantment_new_chance}%",
                                    "",
                                    "<color:#ff8200> requisitos",
                                    "{enchantment_requirements}",
                                    "",
                                    "<red>nível insuficiente."
                                ]
                            }
                        },
                        "2": {
                            "name": "<color:#ff8200>reparar espada",
                            "lore": [
                                "<gray>repare a sua espada por",
                                "<gray>um preço em coins.",
                                "",
                                "<dark_gray> ▸ <white>preço: <green>$<white>{repair_cost}",
                                "",
                                "<color:#ff8200>clique para reparar."
                            ]
                        },
                        "3": {
                            "name": "<color:#ff8200>loja de gold",
                            "lore": [
                                "<gray>uma variedade de itens",
                                "<gray>especiais disponíveis por",
                                "<white>gold<gray>.",
                                "",
                                "<color:#ff8200>clique para acessar."
                            ]
                        },
                        "4": {
                            "name": "<color:#ff8200>knockback",
                            "lore": [
                                "<gray>selecione o nível de",
                                "<gray>knockback.",
                                "",
                                "<color:#ff8200> Níveis:",
                                "{levels}",
                                "",
                                "<color:#ff8200>clique para alterar!"
                            ]
                        }
                    }
                }
            },
            "messages": {
                "sword": {
                    "upgrade-level": "<yellow><bold>GG!</bold> sua espada evoluíu  para o nível <underline>{newer_level}</underline>!"
                },
                "views": {
                    "sword-view": {
                        "invalid-item-in-hand": "<red>Você está segurando uma espada invalida!",
                        "enchantment": {
                            "no-sword-level": "<red>É necessário nível {minimum_level} em sua espada para comprar esse encantamento.",
                            "dont-have-currency": "Você não possui {currency_name} suficientes.",
                            "max-level": "Não é possível encantar a mais que o nível máximo.",
                            "already-max-level": "Esse encantamento já está no nível máximo.",
                            "purchased": "Você comprou {levels} {level_plural} de {enchantment_name}"
                        },
                        "knockback": {
                            "invalid-level": "Você não possui esse nível de knockback."
                        },
                        "repair": {
                            "already-repaired": "<red>A sua espada já está totalmente reparada.",
                            "dont-have-coins": "<red>Você não possui coins suficiente para reparar  a sua espada."
                        }
                    }
                }
            }
        }
    }
}