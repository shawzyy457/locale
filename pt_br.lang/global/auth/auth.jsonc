{
    "plugins": {
        "auth": {
            "commands": {
                "login": {
                    "arguments": {
                        "password": {
                            "name": "senha",
                            "description": "Insira a senha que você utiliza nessa conta"
                        }
                    },
                    "already-logged": [
                        "Você já se encontra autenticado."
                    ],
                    "not-registered": [
                        "Você ainda não está registrado.",
                        "Utilize /registrar <senha> <senha>"
                    ],
                    "invalid-password": [
                        "Senha inválida!",
                        "Utilize /logar <senha>"
                    ],
                    "kick-message": [
                        "<red>Você excedeu o limite de tentativas!</red>"
                    ],
                    "too-many-logged-accounts": [
                        "<red>Você está com muitas contas conectadas!</red>"
                    ],
                    "reserved-name": [
                        "Este nick é reservado para os bots da rede."
                    ]
                },
                "loginstaff": {
                    "arguments": {
                        "code": {
                            "name": "código",
                            "description": "Insira o seu código de loginstaff para se autenticar"
                        }
                    },
                    "already-logged": [
                        "Você já se logou como staff!"
                    ],
                    "not-logged": [
                        "Você precisa se autenticar primeiro!"
                    ],
                    "code-not-registered": [
                        "Código de login staff não registrado!"
                    ],
                    "invalid-password": [
                        "Senha inválida!",
                        "Utilize /logar <senha>"
                    ],
                    "kick-message": [
                        "<red>O codigo de login inserido é invalido.</red>"
                    ]
                },
                "register": {
                    "arguments": {
                        "password": {
                            "name": "senha",
                            "description": "Digite uma senha que você irá se lembrar."
                        },
                        "confirm-password": {
                            "name": "senha",
                            "description": "Confirme sua senha para se registrar."
                        }
                    },
                    "already-registered": [
                        "Você já está registrado!",
                        "Utilize /logar <senha>"
                    ],
                    "password-minimum-length": [
                        "Sua senha deve ter no mínimo 5 letras."
                    ],
                    "password-maximum-length": [
                        "Sua senha deve ter no máximo 32 letras."
                    ],
                    "password-invalid-pattern": [
                        "Você precisa utilizar caracteres válidos em sua senha."
                    ],
                    "passwords-not-equals": [
                        "As senhas não são iguais.",
                        "Confirme a senha corretamente.",
                        "Utilize /registrar <senha> <senha>"
                    ],
                    "too-many-logged-accounts": [
                        "<red>Você está com muitas contas conectadas!</red>"
                    ],
                    "too-many-registered-accounts": [
                        "<red>Você já registrou muitas contas.</red>",
                        "<red>Entre em contato com nossa equipe.</red>",
                        "<red>Discord: </red><white>discord.gg/exe</white>"
                    ],
                    "reserved-name": [
                        "Este nick é reservado para os bots da rede."
                    ]
                }
            },
            "messages": {
                "auth": {
                    "titles": {
                        "request-auth": {
                            "login": {
                                "title": "<color:#FF8200><bold>Rede EXE</bold>",
                                "subtitle": "<white>Utilize /logar <senha></white>"
                            },
                            "register": {
                                "title": "<color:#FF8200><bold>Rede EXE</bold>",
                                "subtitle": "<white>Utilize /registrar <senha> <senha></white>"
                            },
                            "staff": {
                                "title": "<color:#FF8200><bold>Rede EXE</bold>",
                                "subtitle": "<white>Utilize /loginstaff <código></white>"
                            }
                        },
                        "authenticated": {
                            "title": "<color:#FF8200><bold>Autenticado!</bold>",
                            "subtitle": "<white>Seja bem-vindo!</white>"
                        },
                        "queue-wait": {
                            "title": "<color:#FF8200><bold>Rede EXE</bold>",
                            "subtitle": "<white>Aguarde, você está na fila para entrar...</white>"
                        }
                    },
                    "chat": {
                        "request-auth": {
                            "login": [
                                "",
                                " <gold><bold>Rede EXE</bold></gold> <dark_gray>➟ </dark_gray><yellow>Sessão de Autenticação</yellow>",
                                " <gray>Seja bem-vindo ao EXE!</gray>",
                                "",
                                " <white>Utilize </white><gold>/logar <senha></gold><white> para se autenticar.</white>",
                                "",
                                " <white>Acompanhe o nosso discord e fique por dentro de tudo!</white>",
                                " <gold>Discord: </gold><white>discord.gg/exe</white>",
                                ""
                            ],
                            "register": [
                                "",
                                " <gold><bold>Rede EXE</bold></gold> <dark_gray>➟ </dark_gray><yellow>Sessão de Autenticação</yellow>",
                                " <gray>Seja bem-vindo ao EXE!</gray>",
                                "",
                                " <white>Utilize </white><gold>/registrar <senha> <senha></gold><white> para se registrar.</white>",
                                "",
                                " <white>Acompanhe o nosso discord e fique por dentro de tudo!</white>",
                                " <gold>Discord: </gold><white>discord.gg/exe</white>",
                                ""
                            ]
                        }
                    },
                    "timeout": {
                        "kick-message": "<red>Você demorou demais para se autenticar.</red>",
                        "count": {
                            "login": "<#FF5555>Você possui {remaining_time} para se autenticar.</#FF5555>",
                            "register": "<#FF5555>Você possui {remaining_time} para se registrar.</#FF5555>"
                        }
                    },
                    "queue": {
                        "no-lobbies": [
                            "",
                            " <#FF5555>Não foram encontrados lobbies para conexão, você foi colocado na lista de espera!</#FF5555>",
                            ""
                        ]
                    }
                }
            }
        }
    }
}