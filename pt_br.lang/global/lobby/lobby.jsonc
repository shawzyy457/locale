{
  "plugins": {
    "lobby": {
      "servers": {
        "factions": {
          "name": "&cFactions",
          "icon": {
            "name": "{server_name}",
            "description": [
              "&f{server_online_count} jogando.",
              "",
              "&7Crie sua facção, conquiste territórios",
              "&7e enfrente outros jogadores.",
              "",
              "&cClique para conectar!"
            ]
          },
          "hologram": [
            "&c&lFACTIONS",
            "&f{server_online_player_count} jogando...",
            "{server_state}"
          ]
        },
        "prisoneclipse": {
          "name": "&cPrison Eclipse",
          "icon": {
            "name": "{server_name}",
            "description": [
              "&f{server_online_count} jogando.",
              "",
              "&7Evolua, minere e conquiste",
              "&7seu espaço no servidor.",
              "",
              "&cClique para conectar!"
            ]
          },
          "hologram": [
            "&c&lPRISON ECLIPSE",
            "&f{server_online_player_count} jogando...",
            "{server_state}"
          ]
        },
        "academic": {
          "name": "&cAcademic",
          "icon": {
            "name": "{server_name}",
            "description": [
              "&f{server_online_count} jogando.",
              "",
              "&7Descubra sistemas, desafios",
              "&7e uma experiência diferente.",
              "",
              "&cClique para conectar!"
            ]
          }
        },
        "p4free": {
          "name": "&6P4 Free",
          "icon": {
            "name": "{server_name}",
            "description": [
              "&f{server_online_count} jogando.",
              "",
              " &7Um novo modo de jogo com diversos",
              " &7sistemas diferentes e únicos.",
              "",
              " &cConfira algumas novidades:",
              " &c► &fEspada Evolutiva;",
              " &c► &fGladiador;",
              " &c► &fSistema de Ligas;",
              " &c► &fAltar Divino;",
              " &c► &fClasses;",
              " &c► &fHabilidades Dinâmicas;",
              " &c► &fE muito mais!",
              "",
              "&cClique para conectar!"
            ]
          },
          "hologram": [
            "",
            "&c{server_online_player_count} jogando...",
            "{server_state}"
          ]
        }
      },
      "server-state-types": {
        "offline": "&cOffline",
        "stopping": "&cDesligando",
        "restarting": "&cReiniciando",
        "maintenance": "&cEm manutenção",
        "vip": "&cSomente acesso VIP",
        "online": "&aClique para entrar"
      },
      "commands": {
        "fly": {
          "success": "Seu modo de voo foi alterado com sucesso!"
        },
        "join-all-queue": {
          "arguments": {
            "server": {
              "name": "servidor",
              "description": "Servidor que serão redirecionados os jogadores"
            }
          },
          "success": "Todos os jogadores desse lobby foram adicionados a fila do servidor &f{target_server_display_name}!"
        }
      },
      "items": {
        "lobby-servers-item": {
          "name": "&aServidores",
          "lore": [
            "&7Clique com o botão direito para",
            "&7selecionar um servidor."
          ]
        },
        "lobby-hub-selector-item": {
          "name": "&dSelecionar Lobby",
          "lore": [
            "&7Clique com o botão direito para",
            "&7abrir a lista de lobbies."
          ]
        },
        "lobby-profile-item": {
          "name": "&bMeu Perfil",
          "lore": [
            "&7Clique com o botão direito para",
            "&7abrir ao menu de seu perfil."
          ]
        },
        "lobby-hide-players": {
          "name": "&fJogadores: &aON",
          "lore": [
            "&7Clique com o botão direito para",
            "&7mostrar os jogadores do lobby."
          ]
        },
        "lobby-show-players": {
          "name": "&fJogadores: &cOFF",
          "lore": [
            "&7Clique com o botão direito para",
            "&7esconder os jogadores do lobby."
          ]
        }
      },
      "scoreboard": {
        "title": "&c&lEXE",
        "lines": [
          " &7{current_date}",
          "",
          " &f&fCargo: {user_group_name_with_color}",
          " &f&fOnline: &7%network_online-count%",
          " &f&fGold: &6{user_gold_formatted}",
          "",
          "  &6O P4FREE",
          "  &cestá chegando!",
          "",
          "&crede-exe.com"
        ]
      },
      "preferences": {
        "lobby-visibility": {
          "name": "&eVisibilidade de jogadores",
          "description": [
            "&7Mostra ou esconde os outros",
            "&7jogadores no lobby."
          ]
        },
        "lobby-chat": {
          "name": "&eMensagens no chat",
          "description": [
            "&7Mostra ou esconde as",
            "&7mensagens do chat do lobby."
          ]
        },
        "lobby-flying": {
          "name": "&eModo vôo",
          "description": [
            "&7Voe livremente pelo lobby",
            "&7(exclusivo PRO+)."
          ]
        }
      },
      "messages": {
        "chat": {
          "in-delay": "&cVocê precisa esperar &f{remaining_time}&c para falar novamente.",
          "preference-off": "&cVocê não pode enviar mensagens nesse chat pois desabilitou as mensagens.",
          "need-highest-group": "&cVocê precisa ter o grupo &f{required_group_display_tag}&c ou superior para enviar mensagens no chat!",
          "message": "{message_owner_name_with_tag}&7: {message_content}"
        },
        "on-join": {
          "user-notification": "{user_name_with_tag} &eentrou neste lobby!"
        },
        "visibility": {
          "on": "&aAgora todos os jogadores estão visíveis para você.",
          "off": "&cAgora todos os jogadores estão escondidos para você."
        },
        "queue": {
          "actionbar": "&c⏳ &c&lFILA! &fSua posição atual &c➟ &f&l{queue_position}º"
        },
        "views": {
          "lobby-selector": {
            "connect": {
              "already-connected": "&cVocê já está conectado a este lobby.",
              "unavailable": "&cEsse lobby está indisponível no momento.",
              "stopping": "&cEsse lobby está desligando no momento.",
              "restarting": "&cEsse lobby está reiniciando no momento.",
              "maintenance": "&cEsse lobby está em manutenção no momento.",
              "full": "&cEsse lobby está lotado no momento."
            }
          }
        }
      },
      "views": {
        "lobby-selector": {
          "title": "Selecione o lobby",
          "items": {
            "0": {
              "maintenance": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está em manutenção."
                ]
              },
              "stopping": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está desligando."
                ]
              },
              "restarting": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está reiniciando."
                ]
              },
              "current": {
                "name": "&a{app_display_name_stripped}",
                "lore": [
                  "",
                  " &fJogadores: &7{app_online_player_count}",
                  "",
                  "&eVocê está conectado a este lobby."
                ]
              },
              "available": {
                "name": "&a{app_display_name_stripped}",
                "lore": [
                  "",
                  " &fJogadores: &7{app_online_player_count}",
                  "",
                  "&aClique para conectar a este lobby."
                ]
              },
              "unavailable": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está indisponível."
                ]
              }
            }
          }
        },
        "profile": {
          "title": "Meu perfil",
          "discord-none": "Nenhum vinculado",
          "items": {
            "0": {
              "name": "&aSeu perfil",
              "lore": [
                "&fGrupo: &f{user_group_name_with_color}",
                "",
                " &fData de registro: &7{user_registered_date_formated}",
                " &fDiscord: &7{user_discord_name}",
                " &fE-Mail: &7Nenhum vinculado",
                ""
              ]
            },
            "2": {
              "name": "&cJogadores ignorados",
              "lore": [
                "&7Veja os jogadores que você",
                "&7ignorou no servidor."
              ]
            },
            "3": {
              "name": "&aPreferências",
              "lore": [
                "&7Clique para visualizar suas preferências."
              ]
            }
          }
        },
        "servers": {
          "title": "Servidores"
        }
      }
    }
  }
}
