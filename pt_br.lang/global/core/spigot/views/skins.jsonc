{
  "plugins": {
    "core": {
      "messages": {
        "views": {
          "user-skins": {
            "skin-name-select": {
              "query": "Qual é o nick da skin que você deseja utilizar?"
            },
            "skin-already-equipped": "Você já está utilizando essa skin!"
          }
        }
      },
      "views": {
        "user-skins": {
          "title": "Escolha sua skin",
          "items": {
            "0": {
              "name": "&cVocê não possui skins :(",
              "lore": [
                "&7Escolha sua primeira skin",
                "&7utilizando &f/skin <nome>&7."
              ]
            },
            "1": {
              "name": "&eEscolha uma nova skin!",
              "lore": [
                "&7Você pode escolher outra skin",
                "&7para usar em sua conta!",
                "",
                "&7Comando: &f/skin <nick>"
              ]
            },
            "2": {
              "name": "&eRedefinir a sua skin",
              "lore": [
                "&7Clique para redefinir a sua skin!"
              ]
            },
            "3": {
              "equipped": {
                "name": "&a{skin_name}",
                "lore": [
                  "&fUsada pela ultíma vez: &7{skin_last_equipped_date}",
                  "",
                  "&cSelecionado!"
                ]
              },
              "unequipped": {
                "name": "&a{skin_name}",
                "lore": [
                  "&fUsada pela ultíma vez: &7{skin_last_equipped_date}",
                  "",
                  "&aClique para selecionar essa skin!"
                ]
              }
            }
          }
        }
      }
    }
  }
}
