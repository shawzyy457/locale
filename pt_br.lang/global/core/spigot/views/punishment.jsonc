{
  "plugins": {
    "core": {
      "messages": {
        "views": {
          "punishment-create": {
            "punishment-cancelled": "Você cancelou a aplicação da punição do jogador {target_name}",
            "punishment-proof": {
              "query": "&7Digite ou envie as &f&lprovas &7do infrator."
            },
            "punishment-apply": {
              "pending": "Aplicando punição...",
              "success": "Você puniu o jogador {punishment_target_name_with_color} com sucesso!",
              "success-broadcast": [
                "",
                " &c(!) {punishment_target_name_with_tag} &cfoi punido por {punishment_author_name_with_tag}",
                " &c(!) Motivo: {punishment_category_name}",
                ""
              ]
            },
            "punishment-category": {
              "need-highest-group": "Você não possui o grupo mínimo para aplicar essa punição!",
              "pending": "Espere um momento..."
            }
          },
          "punishment-list": {
            "punishment-proof-copy": "&eClique &f&lAQUI &epara copiar a prova.",
            "punishment-proof-update": {
              "query": "&eDigite ou envie as novas &f&lprovas &edo infrator",
              "success": "Você atualizou as provas com sucesso!"
            }
          }
        }
      },
      "views": {
        "punishment-create": {
          "title": "Infrator {target_name_with_color}",
          "items": {
            "0": {
              "name": "&cCancelar",
              "lore": [
                "&7Clique para cancelar"
              ]
            },
            "1": {
              "with-silent": {
                "name": "&cSilenciar punição?",
                "lore": [
                  "&fEstado: &aAtivado"
                ]
              },
              "without-silent": {
                "name": "&cSilenciar punição?",
                "lore": [
                  "&fEstado: &cDesativado"
                ]
              }
            },
            "2": {
              "name": "&cProvas",
              "lore": [
                "&7Clique aqui para adicionar provas",
                "&7sobre esta punição."
              ]
            },
            "3": {
              "can-apply": {
                "name": "&aPunir infrator",
                "lore": [
                  "&7Revise a punição antes de clicar aqui.",
                  "",
                  " &fInfrator: {punishment_target_name_with_color}",
                  " &fPunição: &7{punishment_category_name}",
                  " &fCaso: &7{punishment_case}ª ocorrência",
                  " &fProvas: &7{punishment_proof}",
                  "",
                  "&eClique para punir!"
                ]
              },
              "cannot-apply": {
                "name": "&aPunir infrator",
                "lore": [
                  "&7Revise a punição antes de clicar aqui.",
                  "",
                  " &fInfrator: {punishment_target_name_with_color}",
                  " &fPunição: &7{punishment_category_name}",
                  " &fCaso: &7{punishment_case}ª ocorrência",
                  " &fProvas: &7{punishment_proof}",
                  "",
                  "&cComplete as informações para punir!"
                ]
              }
            },
            "4": {
              "name": "&c{punishment_category_name}",
              "lore": [
                "{punishment_category_description}",
                "",
                " {punishment_category_cases}",
                "",
                "&fGrupo mínimo: {punishment_category_group_display_name}",
                "",
                "&eClique para aplicar esse motivo!"
              ],
              "case-format": {
                "with-expiration": {
                  "with-next": "{punishment_category_case_color}❒ &f{punishment_category_case_index}ª ocorrência em diante: &7{punishment_category_case_type_name} por {punishment_category_case_duration} {punishment_category_case_time}",
                  "without-next": "{punishment_category_case_color}❒ &f{punishment_category_case_index}ª ocorrência: &7{punishment_category_case_type_name} por {punishment_category_case_duration} {punishment_category_case_time}"
                },
                "without-expiration": "{punishment_category_case_color}❒ &f{punishment_category_case_index}ª ocorrência: &7{punishment_category_case_type_name} permanente"
              }
            }
          }
        },
        "punishment-list": {
          "title": "Punições - {punishment_target_name_with_color}",
          "items": {
            "0": {
              "name": "&cEsse jogador não possui registros de punições :)",
              "lore": []
            },
            "1": {
              "with-revoke": {
                "with-expiration": {
                  "name": "&c{punishment_category_name}",
                  "lore": [
                    "&fID da punição: &8#{punishment_id}",
                    "",
                    "&fSessão: &e{punishment_user_session_id}",
                    "",
                    "&fAutor da punição: {punishment_author_name_with_tag}",
                    "&fSessão do autor: &e{punishment_author_session_id}",
                    "",
                    "&fAplicado em: &e{punishment_created_at_date}",
                    "",
                    "&fAutor da revogação: {punishment_author_name_with_tag}",
                    "&fSessão do autor: &e{punishment_author_session_id}",
                    "&fRevogado em: &e{punishment_revoked_at_date}",
                    "",
                    "&fMotivo: &e{punishment_category_name}",
                    "&fDuração: &e{punishment_case_type_name} por {punishment_case_duration} {punishment_case_time}",
                    "&fProva: &e{punishment_proof}",
                    "",
                    "&eClique esquerdo para copiar a prova.",
                    "&eClique direito para alterar a prova."
                  ]
                },
                "without-expiration": {
                  "name": "&c{punishment_category_name}",
                  "lore": [
                    "&fID da punição: &8#{punishment_id}",
                    "",
                    "&fSessão: &e{punishment_user_session_id}",
                    "",
                    "&fAutor da punição: {punishment_author_name_with_tag}",
                    "&fSessão do autor: &e{punishment_author_session_id}",
                    "",
                    "&fAplicado em: &e{punishment_created_at_date}",
                    "",
                    "&fAutor da revogação: {punishment_author_name_with_tag}",
                    "&fSessão do autor: &e{punishment_author_session_id}",
                    "&fRevogado em: &e{punishment_revoked_at_date}",
                    "",
                    "&fMotivo: &e{punishment_category_name}",
                    "&fDuração: &e{punishment_case_type_name} permanente",
                    "&fProva: &e{punishment_proof}",
                    "",
                    "&eClique esquerdo para copiar a prova.",
                    "&eClique direito para alterar a prova."
                  ]
                }
              },
              "without-revoke": {
                "with-expiration": {
                  "name": "&c{punishment_category_name}",
                  "lore": [
                    "&fID da punição: &8#{punishment_id}",
                    "",
                    "&fSessão: &e{punishment_user_session_id}",
                    "",
                    "&fAutor da punição: {punishment_author_name_with_tag}",
                    "&fSessão do autor: &e{punishment_author_session_id}",
                    "",
                    "&fAplicado em: &e{punishment_created_at_date}",
                    "",
                    "&fMotivo: &e{punishment_category_name}",
                    "&fDuração: &e{punishment_case_type_name} por {punishment_case_duration} {punishment_case_time}",
                    "&fProva: &e{punishment_proof}",
                    "",
                    "&eClique esquerdo para copiar a prova.",
                    "&eClique direito para alterar a prova."
                  ]
                },
                "without-expiration": {
                  "name": "&c{punishment_category_name}",
                  "lore": [
                    "&fID da punição: &8#{punishment_id}",
                    "",
                    "&fSessão: &e{punishment_user_session_id}",
                    "",
                    "&fAutor da punição: {punishment_author_name_with_tag}",
                    "&fSessão do autor: &e{punishment_author_session_id}",
                    "",
