{
  "plugins": {
    "core": {
      "messages": {
        "views": {
          "app-action": {
            "need-apps-selection": "Você precisa selecionar os servidores!",
            "maintenance": {},
            "execute-action": {
              "confirmation": {
                "query": "Tem certeza que deseja {action_name} {action_apps_size} servidor(es)?"
              },
              "select-time": {
                "query": "Qual o tempo que você deseja para {action_name} o(s) {action_apps_size} servidor(es)?",
                "invalid-time": "Digite um tempo em segundos de 1s a 120s!"
              },
              "success": "Sua solicitação de {action_name} {action_apps_size} servidor(es) foi enviada com sucesso!"
            }
          },
          "app-nodes-action": {
            "node-offline": "Você não pode acessar um node desabilitado!"
          }
        }
      },
      "views": {
        "app-action": {
          "title": "{app_node_name}",
          "items": {
            "0": {
              "name": "&8&lDefinir manutenção",
              "lore": [
                "&7Clique para definir."
              ]
            },
            "1": {
              "name": "&aLigar",
              "lore": [
                "&7Clique para ligar."
              ]
            },
            "2": {
              "name": "&eReiniciar",
              "lore": [
                "&7Clique para reiniciar."
              ]
            },
            "3": {
              "name": "&cDesligar",
              "lore": [
                "&7Clique para desligar."
              ]
            },
            "4": {
              "online": {
                "selected": {
                  "name": "&a{app_display_name}",
                  "lore": [
                    "&fJogadores: &7{app_connected_users_count}",
                    "",
                    " &fCPU: &7{app_statistic_jvm_cpu_utilization}%",
                    " &fThreads: &7{app_statistic_jvm_thread_count}",
                    " &fMemória: &7{app_statistic_jvm_usage_memory_formatted}/{app_statistic_jvm_max_memory_formatted}",
                    "",
                    " &fUso de memória:",
                    " {app_statistic_jvm_memory_utilization_progress_bar}",
                    "",
                    " &fTPS (5s, 10s, 1m, 5m, 15m):",
                    " &7{app_statistic_tps_0}, {app_statistic_tps_1}, {app_statistic_tps_2}, {app_statistic_tps_3}, {app_statistic_tps_4}",
                    "",
                    "  &fManutenção: &7{app_statistic_maintenance_group_display_name}",
                    "",
                    "&aSelecionado."
                  ]
                },
                "unselected": {
                  "name": "&a{app_display_name}",
                  "lore": [
                    "&fJogadores: &7{app_connected_users_count}",
                    "",
                    " &fCPU: &7{app_statistic_jvm_cpu_utilization}%",
                    " &fThreads: &7{app_statistic_jvm_thread_count}",
                    " &fMemória: &7{app_statistic_jvm_usage_memory_formatted}/{app_statistic_jvm_max_memory_formatted}",
                    "",
                    " &fUso de memória:",
                    " {app_statistic_jvm_memory_utilization_progress_bar}",
                    "",
                    " &fTPS (5s, 10s, 1m, 5m, 15m):",
                    " &7{app_statistic_tps_0}, {app_statistic_tps_1}, {app_statistic_tps_2}, {app_statistic_tps_3}, {app_statistic_tps_4}",
                    "",
                    "  &fManutenção: &7{app_statistic_maintenance_group_display_name}",
                    "",
                    "&eClique para selecionar!"
                  ]
                }
              },
              "offline": {
                "selected": {
                  "name": "&c{app_display_name}",
                  "lore": [
                    "",
                    "&cServidor fechado.",
                    "",
                    "&aSelecionado."
                  ]
                },
                "unselected": {
                  "name": "&c{app_display_name}",
                  "lore": [
                    "",
                    "&cServidor fechado.",
                    "",
                    "&eClique para selecionar!"
                  ]
                }
              }
            }
          }
        },
        "app-nodes-action": {
          "title": "Nodes",
          "items": {
            "0": {
              "online": {
                "name": "&a{app_node_name}",
                "lore": [
                  "&fUptime: &7{app_node_statistic_uptime}",
                  "",
                  " &fOS: &7{app_node_statistic_os_name}",
                  " &fVersion: &7{app_node_statistic_os_version}",
                  "",
                  " &fCPU: &7{app_node_statistic_cpu_utilization}%",
                  " &fMemória: &7{app_node_statistic_usage_memory}/{app_node_statistic_max_memory}",
                  " &fDisco: &7{app_node_statistic_usage_disk}/{app_node_statistic_max_disk}",
                  "",
                  " &fNetwork:",
                  " &fIn: &7{app_node_statistic_network_in_traffic} ({app_node_statistic_network_in_packets_count})",
                  " &fOut: &7{app_node_statistic_network_out_traffic} ({app_node_statistic_network_out_packets_count})",
                  ""
                ]
              },
              "offline": {
                "name": "&c{app_node_name}",
                "lore": [
                  "",
                  "&cNode desligado.",
                  ""
                ]
              }
            }
          }
        }
      }
    }
  }
}
