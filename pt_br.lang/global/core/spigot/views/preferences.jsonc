{
    "plugins": {
        "core": {
            "views": {
                "preference-type-select": {
                    "title": "Preferências",
                    "items": {
                        "0": {
                            "name": "<yellow>{preference_type_name}</yellow>",
                            "lore": [
                                "{preference_type_description}",
                                "",
                                "<yellow>Clique para gerenciar.</yellow>"
                            ]
                        }
                    }
                },
                "preference-switch": {
                    "title": "Preferências",
                    "items": {
                        "boolean": {
                            "name": "<yellow>{preference_name}</yellow>",
                            "lore": [
                                "{preference_description}",
                                "",
                                "<white>Estado:</white> {preference_status}",
                                "",
                                "<yellow>Clique para alternar.</yellow>"
                            ]
                        },
                        "enum": {
                            "name": "<yellow>{preference_name}</yellow>",
                            "lore": [
                                "{preference_description}",
                                "",
                                "{preference_options}",
                                "",
                                "<yellow>Clique para alternar.</yellow>"
                            ],
                            "option": {
                                "selected": "{option} <gray>(selecionado)</gray>",
                                "unselected": "{option}"
                            }
                        }
                    }
                }
            }
        }
    }
}