{
  "plugins": {
    "core": {
      "views": {
        "preference-type-select": {
          "title": "Preferências",
          "items": {
            "0": {
              "name": "&e{preference_type_name}",
              "lore": [
                "{preference_type_description}",
                "",
                "&eClique para gerenciar."
              ]
            }
          }
        },
        "preference-switch": {
          "title": "Preferências",
          "items": {
            "boolean": {
              "name": "&e{preference_name}",
              "lore": [
                "{preference_description}",
                "",
                "&fEstado: {preference_status}",
                "",
                "&eClique para alternar."
              ]
            },
            "enum": {
              "name": "&e{preference_name}",
              "lore": [
                "{preference_description}",
                "",
                "{preference_options}",
                "",
                "&eClique para alternar."
              ],
              "option": {
                "selected": "{option} &7(selecionado)",
                "unselected": "{option}"
              }
            }
          }
        }
      }
    }
  }
}
