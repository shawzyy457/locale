{
  "plugins": {
    "core": {
      "commands": {
        "account": {
          "arguments": {
            "target": {
              "name": "mome ou uuid",
              "description": "Insira o nome ou a uuid do jogador"
            }
          },
          "invalid-uuid-pattern": "Você precisa inserir um formato de uuid válido!",
          "invalid-name-pattern": "Você precisa inserir um formato de nome válido!",
          "message": {
            "identity": [
              "{primary}Informações da conta de &f{account_name}",
              "&fUUID: &7{account_uuid}",
              "&fNome: &7{account_name}"
            ],
            "session": [
              "&fÚltimo login: &7{account_last_login}",
              "&fÚltima saída: &7{account_last_quit}"
            ],
            "still-online": "Ainda online",
            "general": [
              "&fGrupos: &7{account_groups}",
              "&fCadastrado em: &7{account_registered}"
            ],
            "no-groups": "Nenhum.",
            "associated": "&fContas associadas: &7{account_associated}",
            "associated-entry": "{associated_name}",
            "associated-empty": "Nenhuma.",
            "status": [
              "{primary}---- Status ----",
              "&fProxy: &7{account_proxy}",
              "&fLogado em: &7{account_joined}",
              "&fVersão: &7{account_version}"
            ],
            "status-staff": [
              "&fServidor: &7{account_server}",
              "&fIP: &7{account_ip}"
            ]
          }
        },
        "staff-chat": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada"
            }
          },
          "message": "&5 &7({sender_connected_server}) {sender_name_with_tag} &f{sender_message}"
        },
        "staff-high-chat": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada"
            }
          },
          "message": "&c &7({sender_connected_server}) {sender_name_with_tag} &f{sender_message}"
        }
      }
    }
  }
}
