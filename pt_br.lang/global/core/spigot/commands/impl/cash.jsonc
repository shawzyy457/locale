{
  "plugins": {
    "core": {
      "commands": {
        "cash": {
          "visualize": {
            "target": {
              "with-balance": "{cash_target_name_with_color} &apossui &6{cash_formatted_value} Cash&6&a.",
              "without-balance": "{cash_target_name_with_color} &cnão possui&c &6Cash&c."
            },
            "same": {
              "with-balance": "&aVocê possui &6{cash_formatted_value} Cash&6&a.",
              "without-balance": "&cVocê não possui &6Cash&c."
            }
          },
          "pay": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "O jogador que irá receber o saldo"
              },
              "amount": {
                "name": "quantia",
                "description": "A quantidade de Cash que você quer enviar"
              }
            },
            "need-min-cash": "&cVocê precisa enviar um valor mínimo de &61000 Cash&c.",
            "success": "&aVocê enviou &6{cash_formatted_value} Cash &apara {cash_target_name_with_color}&a.",
            "error": "&cSua tentativa de enviar o seu saldo falhou, tente novamente mais tarde!"
          },
          "set": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "O jogador que o saldo será definido"
              },
              "amount": {
                "name": "quantia",
                "description": "A quantidade de Cash que você quer definir"
              }
            },
            "success": "&aVocê definiu o Cash de {cash_target_name_with_color} &apara {cash_formatted_value}.",
            "error": "&cSua tentativa de definir o seu saldo falhou, tente novamente mais tarde!"
          },
          "add": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "O jogador que o saldo será adicionado"
              },
              "amount": {
                "name": "quantia",
                "description": "A quantidade de Cash que você quer adicionar"
              }
            },
            "success": "&aVocê adicionou &6{cash_formatted_value} Cash &apara {cash_target_name_with_color}&a.",
            "error": "&cSua tentativa de definir o seu saldo falhou, tente novamente mais tarde!"
          },
          "remove": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "O jogador que o saldo será removido"
              },
              "amount": {
                "name": "quantia",
                "description": "A quantidade de Cash que você quer remover"
              }
            },
            "success": "&aVocê removeu &6{cash_formatted_value} Cash &ade {cash_target_name_with_color}&a.",
            "error": "&cSua tentativa de definir o seu saldo falhou, tente novamente mais tarde!"
          }
        }
      }
    }
  }
}
