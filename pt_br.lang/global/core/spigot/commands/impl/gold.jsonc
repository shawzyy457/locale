{
    "plugins": {
        "core": {
            "commands": {
                "gold": {
                    "visualize": {
                        "target": {
                            "with-balance": "{gold_target_name_with_color} <green>possui</green> <gold>{gold_formatted_value} Gold<gold><green>.</green>",
                            "without-balance": "{gold_target_name_with_color} <red>não possui<red> <gold>Gold</gold><red>.</red>"
                        },
                        "same": {
                            "with-balance": "<green>Você possui</green> <gold>{gold_formatted_value} Gold<gold><green>.</green>",
                            "without-balance": "<red>Você não possui</red> <gold>Gold</gold><red>.</red>"
                        }
                    },
                    "pay": {
                        "arguments": {
                            "target": {
                                "name": "jogador",
                                "description": "O jogador que irá receber o saldo"
                            },
                            "amount": {
                                "name": "quantia",
                                "description": "A quantidade de Gold que você quer enviar"
                            }
                        },
                        "need-min-gold": "<red>Você precisa enviar um valor mínimo de</red> <gold>1000 Gold</gold><red>.</red>",
                        "success": "<green>Você enviou</green> <gold>{gold_formatted_value} Gold</gold> <green>para</green> {gold_target_name_with_color}<green>.</green>",
                        "error": "<red>Sua tentativa de enviar o seu saldo falhou, tente novamente mais tarde!</red>"
                    },
                    "set": {
                        "arguments": {
                            "target": {
                                "name": "jogador",
                                "description": "O jogador que o saldo será definido"
                            },
                            "amount": {
                                "name": "quantia",
                                "description": "A quantidade de Gold que você quer definir"
                            }
                        },
                        "success": "<green>Você definiu o Gold de</green> {gold_target_name_with_color} <green>para {gold_formatted_value}.</green>",
                        "error": "<red>Sua tentativa de definir o seu saldo falhou, tente novamente mais tarde!</red>"
                    },
                    "add": {
                        "arguments": {
                            "target": {
                                "name": "jogador",
                                "description": "O jogador que o saldo será adicionado"
                            },
                            "amount": {
                                "name": "quantia",
                                "description": "A quantidade de Gold que você quer adicionar"
                            }
                        },
                        "success": "<green>Você adicionou</green> <gold>{gold_formatted_value} Gold</gold> <green>para</green> {gold_target_name_with_color}<green>.</green>",
                        "error": "<red>Sua tentativa de definir o seu saldo falhou, tente novamente mais tarde!</red>"
                    },
                    "remove": {
                        "arguments": {
                            "target": {
                                "name": "jogador",
                                "description": "O jogador que o saldo será removido"
                            },
                            "amount": {
                                "name": "quantia",
                                "description": "A quantidade de Gold que você quer remover"
                            }
                        },
                        "success": "<green>Você removeu</green> <gold>{gold_formatted_value} Gold</gold> <green>de</green> {gold_target_name_with_color}<green>.</green>",
                        "error": "<red>Sua tentativa de definir o seu saldo falhou, tente novamente mais tarde!</red>"
                    }
                }
            }
        }
    }
}