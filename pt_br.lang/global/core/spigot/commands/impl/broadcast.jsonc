{
    "plugins": {
        "core": {
            "commands": {
                "broadcast-announce": {
                    "arguments": {
                        "message": {
                            "name": "mensagem",
                            "description": "Mensagem que deseja ser divulgada."
                        }
                    },
                    "message": [
                        "",
                        "<gold><bold>[ANÚNCIO]</bold></gold> <white>{broadcast_announce_message}</white>",
                        ""
                    ]
                },
                "broadcast-message": {
                    "arguments": {
                        "message": {
                            "name": "mensagem",
                            "description": "Mensagem que deseja enviar."
                        }
                    }
                },
                "broadcast-title": {
                    "arguments": {
                        "message": {
                            "name": "mensagem",
                            "description": "Mensagem que deseja enviar."
                        }
                    }
                }
            }
        }
    }
}