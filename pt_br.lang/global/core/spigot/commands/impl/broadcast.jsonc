{
  "plugins": {
    "core": {
      "commands": {
        "broadcast-announce": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja ser divulgada."
            }
          },
          "message": [
            "&c&l[ANÚNCIO] &f{broadcast_announce_message}"
          ]
        },
        "broadcast-message": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar."
            }
          }
        },
        "broadcast-title": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar."
            }
          }
        }
      }
    }
  }
}
