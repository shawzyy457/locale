{
  "plugins": {
    "core": {
      "preferences": {
        "private-messages": {
          "name": "&eMensagens privadas",
          "description": [
            "&7Permite receber mensagens",
            "&7privadas de outros jogadores."
          ]
        },
        "client-addons": {
          "name": "&eInterações com clientes customizados",
          "description": [
