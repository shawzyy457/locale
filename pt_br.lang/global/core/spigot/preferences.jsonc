            "&7clientes customizados."
          ]
        }
      },
      "preference-registry-types": {
        "global": {
          "name": "Preferências globais",
          "description": [
            "&7Acesse as preferências dos",
            "&7servidores em geral."
          ]
        },
        "server": {
          "name": "Preferências do servidor",
          "description": [
            "&7Acesse as preferências do",
            "&7servidor especifico."
          ]
        }
      }
    }
  }
}
