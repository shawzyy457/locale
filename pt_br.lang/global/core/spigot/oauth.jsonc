{
  "plugins": {
    "core": {
      "oauth": {
        "book": {
          "title": "Solicitação de login",
          "author": "EXE",
          "pages": {
            "0": [
              "&0Nova solicitação de",
              "&0login utilizando o nick",
              "&c{request_user_name} &0detectada.",
              "",
              "&0&lIP: {request_ip_query}",
              "&0&lData: {request_date}",
              "&0&lLocal: {request_ip_city}, {request_ip_region}",
              "",
              "&0Autorizar o login &a✔",
              "",
              "&0Não fui eu, rejeitar &c✖",
              ""
            ]
          }
        }
      },
      "messages": {
        "oauth": {
          "request": {
            "expired": "&cVocê demorou muito para responder, por isso sua solicitação foi negada!",
            "accepted": "&aVocê aceitou a solicitação de login com sucesso, isso foi um erro? Utilize &f/desconectar para sair de todas as sessões.",
            "denied": "&cVocê negou a solicitação de login com sucesso, o usuário foi bloqueado durante 30 minutos!"
          }
        }
      }
    }
  }
}
