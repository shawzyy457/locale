{
  "plugins": {
    "core": {
      "actions": {
        "types": {
          "start": {
            "name": "ligar"
          },
          "cancel": {
            "name": "cancelar"
          },
          "restart": {
            "name": "reiniciar",
            "title": {
              "title": "&c&lREINICIANDO",
              "subtitle": "&fem {action_countdown}"
            },
            "gerund": "reiniciando",
            "past": "reiniciado"
          },
          "stop": {
            "name": "desligar",
            "title": {
              "title": "&c&lDESLIGANDO",
              "subtitle": "&fem {action_countdown}"
            },
            "gerund": "desligando",
            "past": "desligado"
          }
        }
      },
      "messages": {
        "actions": {
          "action-message": [
            "",
            "&eEste servidor será {action_name_past} em {action_countdown}!",
            ""
          ],
          "disabled-actions": [
            "",
            "O servidor está {action_name_gerund} e por isso algumas funções foram desabilitadas.",
            ""
          ],
          "kick": {
            "no-available-apps": [
              "&c&lEXE",
              "",
              "&cNão foi encontrado nenhum servidor para você se conectar."
            ]
          }
        }
      }
    }
  }
}
