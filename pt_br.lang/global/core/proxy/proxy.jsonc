{
  "plugins": {
    "core": {
      "proxy": {
        "messages": {
          "authentication": {
            "need-logged": [
              "&cVocê precisa estar logado para realizar essa ação!"
            ]
          },
          "connection": {
            "name-pattern-invalid": [
              "&c&lEXE&r",
              "",
              "&f{name} &cnão é um nick válido.",
              "&cO nick deve ser formado por letras ou números.",
              "&ce deve ter entre 3 e 16 caracteres."
            ],
            "already-online": [
              "&c&lEXE&r",
              "",
              "&cJá existe um jogador online nessa conta!"
            ],
            "maintenance": [
              "&c&lEXE&r",
              "",
              "&cO servidor se encontra em manutenção, voltamos em breve.",
              "&cFique por dentro de todas as novidades em:",
              "",
              "&f{discord_invite_url}"
            ],
            "no-auth-apps-available": [
              "&c&lEXE&r",
              "",
              "&cNão encontramos nenhum servidor de autenticação.",
              "&cFique por dentro de todas as novidades em:",
              "",
              "&f{discord_invite_url}"
            ],
            "internal-error": [
              "&c&lEXE&r",
              "",
              "&cOcorreu um erro interno inesperado.",
              "&cNossa equipe foi notificada e está trabalhando para resolver o problema.",
              "&cPor favor, tente novamente mais tarde.",
              "",
              "&f{discord_invite_url}"
            ],
            "unsupported-version": [
              "&c&lEXE&r",
              "",
              "&cUtilize a versão &f1.8+ para",
              "&cter uma melhor experiência.",
              "",
              "&f{discord_invite_url}"
            ],
            "too-many-logged-accounts": [
              "&c&lEXE&r",
              "",
              "&cVocê está com muitas contas logadas",
              "&cao mesmo tempo, deslogue das outras para entrar!",
              "",
              "&f{discord_invite_url}"
            ]
          },
          "punishment": {
            "mute-message-permanent": [
              "",
              "&cVocê foi silenciado permanentemente.",
              "",
              "&cAutor: {punishment_author_name}",
              "&cMotivo: {punishment_reason}",
              "",
              "&cSilenciado injustamente?",
              "&cRevise sua punição em &brede-exe.com/p/{punishment_id}"
            ],
            "mute-message-with-expiration": [
              "",
              "&cVocê foi silenciado.",
              "",
              "&cAutor: {punishment_author_name}",
              "&cMotivo: {punishment_reason}",
              "&cExpira em: {punishment_expiration}",
              "",
              "&cSilenciado injustamente?",
              "&cRevise sua punição em &brede-exe.com/p/{punishment_id}"
            ],
            "ban-message-permanent": [
              "&c&lEXE&r",
              "",
              "&cVocê foi banido permanentemente do servidor.",
              "",
              "&cAutor: {punishment_author_name}",
              "&cMotivo: {punishment_reason}",
              "",
              "&cBanido injustamente?",
              "&cRevise sua punição em &brede-exe.com/p/{punishment_id}"
            ],
            "ban-message-with-expiration": [
              "&c&lEXE&r",
              "",
              "&cVocê foi banido do servidor.",
              "",
              "&cAutor: {punishment_author_name}",
              "&cMotivo: {punishment_reason}",
              "&cExpira em: {punishment_expiration}",
              "",
              "&cBanido injustamente?",
              "&cRevise sua punição em &brede-exe.com/p/{punishment_id}"
            ]
          },
          "teleport": {
            "target-app-not-registered": [
              "&cO servidor requisitado não está registrado!"
            ],
            "target-app-offline": [
              "&cO servidor requisitado está offline!"
            ],
            "target-app-restating": [
              "&cO servidor requisitado está reiniciando!"
            ],
            "target-app-stopping": [
              "&cO servidor requisitado está desligando!"
            ],
            "target-app-maintenance": [
              "&cEsse servidor se encontra em manutenção no momento."
            ],
            "connecting": "&7Conectando você ao &f{app_display_name}&7...",
            "already-connected": "&cVocê já está conectado ao &f{app_display_name}&c.",
            "failed": "&cNão foi possível conectar ao &f{app_display_name}&c. Tente novamente em instantes."
          }
        }
      }
    }
  }
}
