{
  "plugins": {
    "core": {
      "punishment": {
        "types": {
          "warn": {
            "name": "&eaviso"
          },
          "mute": {
            "name": "&esilenciamento"
          },
          "ban": {
            "name": "&cbanimento"
          },
          "ban_ip": {
            "name": "&cbanimento por ip"
          }
        },
        "categories": {
          "abuse-bugs": {
            "name": "Abuso de Bugs",
            "description": [
              "&7Aproveitar-se de qualquer",
              "&7maneira de um erro em nossos",
              "&7sistemas para benefício próprio ou ter",
              "&7conhecimento de um erro e não reportá-lo"
            ]
          },
          "account-hacking": {
            "name": "Invasão de contas",
            "description": [
              "&7Invadir contas de outros jogadores",
              "&7Utilizando qualquer metodo"
            ]
          },
          "anti-game": {
            "name": "Anti Jogo",
            "description": [
              "&7Atitudes que podem prejudicar",
              "&7a jogabilidade de outros jogadores",
              "&7dentro de nossos servidores."
            ]
          },
          "blacklist": {
            "name": "Blacklist",
            "description": [
              "&7Este sofrerá pelo eterno",
              "&7Fogo que lhe queimará",
              "&7No banimento do servidor."
            ]
          },
          "business": {
            "name": "Comércio",
            "description": [
              "&7Comércio de itens ou contas em troca",
              "&7de produtos externos, jogos, VIPs ou dinheiro."
            ]
          },
          "chargeback": {
            "name": "Estorno de Compras",
            "description": [
              "&7Tentar realizar estorno da compra",
              "&7de um produto adquirido em nossa rede."
            ]
          },
          "client-alternative": {
            "name": "Cliente Alternativo",
            "description": [
              "&7Fazer uso de clientes alternativos",
              "&7ou modificações que promovam vantagens",
              "&7sobre outros jogadores."
            ]
          },
          "custom": {
            "name": "Customizado",
            "description": [
              "&7Selecionar outro motivo do banimento"
            ]
          },
          "disinformation": {
            "name": "Desinformação",
            "description": [
              "&7Espalhar informações falsas",
              "&7com o intuito de prejudicar outros",
              "&7jogadores ou causar baderna geral."
            ]
          },
          "divulgation": {
            "name": "Divulgação",
            "description": [
              "&7Fazer divulgação de sites,",
              "&7servidores de Discord e vídeos ou",
              "&7canais em plataformas de mídia de forma comedida."
            ]
          },
          "fake-account": {
            "name": "Conta Fake",
            "description": [
              "&7Criar uma conta com intuito",
              "&7de cometer qualquer infração",
              "&7para benefício próprio ou prejuízo da rede."
            ]
          },
          "fake-chat": {
            "name": "Chat Fake",
            "description": [
              "&7Realizar ameaças a outros jogadores",
              "&7com relação à sua pessoa, sua família ou sua conta."
            ]
          },
          "falsification-evidence": {
            "name": "Falsificação de Provas",
            "description": [
              "&7Forjar provas com objetivo",
              "&7de fazer jogadores inocentes",
              "&7serem punidos de forma errada."
            ]
          },
          "inappropriate-build": {
            "name": "Construção Inadequada",
            "description": [
              "&7Fazer uma construção ofensiva",
              "&7ou com símbolos inapropriados em",
              "&7qualquer um dos modos de jogo da rede."
            ]
          },
          "inappropriate-nickname": {
            "name": "Nick Inapropriado",
            "description": [
              "&7Criar uma conta com nickname",
              "&7com mensagem sexual, discriminatória,",
              "&7ofensiva aos jogadores ou ao servidor."
            ]
          },
          "intimidation": {
            "name": "Ameaça",
            "description": [
              "&7Realizar ameaças a outros jogadores",
              "&7com relação à sua pessoa, sua família ou sua conta."
            ]
          },
          "macro": {
            "name": "Abuso de Macros",
            "description": [
              "&7Abuso de macros é uma prática que consiste em utilizar",
              "&7programas ou modificações que automatizam ações no servidor,",
              "&7como por exemplo, utilizar programas que pressionam",
              "&7teclas automaticamente ou que realizam ações de forma automática."
            ]
          },
          "offense": {
            "name": "Ofensa à Jogador",
            "description": [
              "&7Ofender jogadores de qualquer cargo",
              "&7utilizando o chat para enviar xingamentos."
            ]
          },
          "racism": {
            "name": "Racismo / Discriminação",
            "description": [
              "&7Atitudes preconceituosas com outros",
              "&7jogadores motivadas por sua raça, cor, sexo, idade,",
              "&7religião e/ou outros fatores consolidadas",
              "&7através de mensagens no chat."
            ]
          },
          "server-divulgation": {
            "name": "Divulgação de Servidores",
            "description": [
              "&7Fazer divulgação de outros servidores",
              "&7de Minecraft ou lojas do gênero como",
              "&7ferramenta de marketing e de captação de",
              "&7jogadores através do envio de endereços IP e links."
            ]
          },
          "spam-and-flood": {
            "name": "Spam / Flood",
            "description": [
              "&7Fazer o uso de vários caracteres ",
              "&7repetidos na mesma palavra ou",
              "&7enviar várias mensagens iguais."
            ]
          },
          "staff-or-server-offense": {
            "name": "Ofensa à Equipe ou Servidor",
            "description": [
              "&7Ofender membros da equipe de",
              "&7qualquer cargo ou a rede diretamente",
              "&7utilizando o chat para enviar xingamentos."
            ]
          },
          "stealing": {
            "name": "Roubo de itens",
            "description": [
              "&7Enganar jogadores para roubar",
              "&7seus coins ou itens dentro do servidor.",
              "&7Geralmente através de trocas falsas."
            ]
          }
        }
      }
    }
  }
}
