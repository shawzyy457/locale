{
  "plugins": {
    // A espada e o machado especiais do P4Free. Os dois são o mesmo sistema, e a
    // diferença entre eles vive aqui e no config.yml do módulo.
    "weapons": {
      "espada": {
        "item": {
          "name": "&bEspada Especial",
          "investment": "&7Investido: &b{tokens} tokens",
          "enchant-owned": "&8▸ &f{enchant} &b{level}",
          "enchant-missing": "&8▸ &7{enchant}",
          "kills": "&7Abates: &f{kills}"
        },
        "broken": "&cA sua espada especial se partiu."
      },
      "machado": {
        "item": {
          "name": "&cMachado Especial",
          "investment": "&7Investido: &b{tokens} tokens",
          "enchant-owned": "&8▸ &f{enchant} &b{level}",
          "enchant-missing": "&8▸ &7{enchant}",
          "kills": "&7Abates: &f{kills}"
        },
        "broken": "&cO seu machado especial se partiu."
      },
      "commands": {
        "enchant-book": {
          "target-offline": "Esse jogador não está online.",
          "target-inventory-full": "O inventário desse jogador está cheio.",
          "invalid-enchant": "Arma ou encantamento inválido. Use /darencantamento <jogador> <espada|machado> <encantamento> <niveis>",
          "given": "Você deu um livro de {enchant} {levels} a {player}."
        },
        "espada": {
          "inventory-full": "Libere um espaço no inventário antes de resgatar a espada.",
          "already-have": "Você já tem a espada especial na mochila.",
          "cooldown": "Aguarde para resgatar a espada de novo.",
          "retrieved": [
            "",
            " &aVocê resgatou a espada especial!",
            " &7Prestígio &f{prestige}&7, &f{kills}&7 abate(s).",
            " &eShift + botão direito com ela na mão abre a bancada.",
            ""
          ]
        },
        "machado": {
          "inventory-full": "Libere um espaço no inventário antes de resgatar o machado.",
          "already-have": "Você já tem o machado especial na mochila.",
          "cooldown": "Aguarde para resgatar o machado de novo.",
          "retrieved": [
            "",
            " &aVocê resgatou o machado especial!",
            " &7Prestígio &f{prestige}&7, &f{kills}&7 abate(s).",
            " &eShift + botão direito com ele na mão abre a bancada.",
            ""
          ],
        }
      },
      "messages": {
        "duplicates-removed": "Removemos {amount} arma(s) duplicada(s) do seu inventário.",
        "skull-cracker": "&6Crítico! &eQuebra-Crânio ativado.",
        "armor-breaker": {
          "attacker": "&4Quebra-Armadura ativado.",
          "victim": "&cSua armadura está se desgastando mais rápido."
        },
        "drainage": {
          "killer": "&eVocê drenou &a{amount}&e tokens de &f{player}&e.",
          "victim": "&cVocê perdeu &e{amount}&c tokens para &f{player}&c."
        },
        "in-combat": "Você não pode abrir a bancada em combate.",
        "not-in-hand": "Segure a arma na mão para mexer nela.",
        "already-max-level": "Este encantamento já está no nível máximo.",
        "prestige-required": "Este encantamento pede prestígio {prestige}.",
        "not-enough": "Você não tem {currency} suficientes.",
        "enchant-bought": "&a{enchant} &fsubiu para o nível &a{level}&f.",
        "already-repaired": "Esta arma não precisa de conserto.",
        "repaired": "Arma consertada.",
        "cannot-drop": "A arma não se larga no chão.",
        "cannot-move": "A arma não sai do seu inventário.",
        "prestige-maximum": "Esta arma já está no prestígio máximo.",
        "prestige-not-invested": "Você precisa ter {required} tokens investidos nesta arma.",
        "prestige-done": "&aPrestígio &l{prestige}&r&a. Os encantamentos foram zerados.",
        "book-wrong-weapon": "Este livro não é para esta arma.",
        "deleted": "&cSua arma foi excluída."
      },
      // Os filtros do ranking.
      "tops": {
        "kills": "Abates",
        "prestige": "Prestígio",
        "tokens-spent": "Investimento"
      },
      // Os nomes dos encantamentos. Ficam aqui e nao no config.yml porque sao texto
      // visivel: no config saiam sem acento e sem cor.
      "enchants": {
        "sharpening": { "name": "&bAfiação" },
        "unbreakable": { "name": "&bIndestrutível" },
        "fortune": { "name": "&bFortuna" },
        "amplifier": { "name": "&bAmplificador" },
        "repair": { "name": "&bReparador" },
        "efficiency": { "name": "&bEficiência" },
        "drainage": { "name": "&bDrenagem" },
        "skull-cracker": { "name": "&cQuebra-Crânio" },
        "knockback": { "name": "&cRepulsão" },
        "armor-breaker": { "name": "&cQuebra-Armadura" }
      },
      // A bancada, o menu que gasta tokens para subir encantamento.
      "views": {
        "weapon": {
          "title": "{weapon_name}",
          "items": {
            // 0: encantamento que sobe por nível.
            "0": {
              "name": "&f{enchant_name}",
              "lore": [
                "",
                "&7Nível: &f{enchant_level}&7/&f{enchant_max_level}",
                "&7Custo: &b{enchant_price}",
                "",
                "&eClique para evoluir."
              ]
            },
            // 1: encantamento que sobe uma chance.
            "1": {
              "name": "&f{enchant_name}",
              "lore": [
                "",
                "&7Nível: &f{enchant_level}&7/&f{enchant_max_level}",
                "&7Chance: &f{enchant_chance}% &8-> &a{enchant_next_chance}%",
                "&7Custo: &b{enchant_price}",
                "",
                "&eClique para evoluir."
              ]
            },
            // 2: encantamento já no máximo.
            "2": {
              "name": "&f{enchant_name}",
              "lore": [
                "",
                "&7Nível: &a{enchant_level}&7/&a{enchant_max_level}",
                "",
                "&aNo máximo."
              ]
            },
            // 3: o balcão de conserto.
            "3": {
              "name": "&fConsertar",
              "lore": [
                "",
                "&7Zera o desgaste da arma.",
                "&7Custo: &b{repair_cost}",
                "",
                "{repair_state}"
              ]
            },
            // 4: o prestígio.
            "4": {
              "name": "&fPrestígio &a{weapon_prestige}",
              "lore": [
                "",
                "&7Zera todos os encantamentos e",
                "&7desbloqueia os do prestígio seguinte.",
                "",
                "&7Pede &b{prestige_required} &7investidos.",
                "",
                "{prestige_state}"
              ]
            },
            // 6: o que se liga e desliga em vez de se comprar.
            "6": {
              "name": "{enchant_name}",
              "lore": [
                "",
                "&7Nível: &f{enchant_level}&7/&f{enchant_max_level}",
                "",
                "&eClique para alternar."
              ]
            },
            // 7: a exclusão da arma. O texto é neutro porque estes itens são os
            // mesmos para a espada e para o machado.
            "7": {
              "name": "&cExcluir",
              "lore": [
                "",
                "&7Apaga a sua {weapon_name}&7 com todos",
                "&7os encantamentos e o prestígio.",
                "",
                "&cAção irreversível.",
                "",
                "&eClique para excluir."
              ]
            },
            // 8: o encantamento que ainda pede prestígio. Sem ele o ícone convidava a
            // evoluir e só o clique é que dizia que não.
            "8": {
              "name": "&8{enchant_name}",
              "lore": [
                "",
                "&7Nível: &f{enchant_level}&7/&f{enchant_max_level}",
                "",
                "&cPede prestígio &f{enchant_prestige}&c.",
                "&cAinda não dá para evoluir."
              ]
            },
            // 9: o encantamento que dá para evoluir, mas o saldo não chega.
            "9": {
              "name": "&f{enchant_name}",
              "lore": [
                "",
                "&7Nível: &f{enchant_level}&7/&f{enchant_max_level}",
                "&7Custo: &b{enchant_price}",
                "",
                "&cVocê não tem {enchant_currency} suficientes."
              ]
            },
            // 5: o ranking.
            "5": {
              "name": "&fRanking",
              "lore": [
                "",
                "&7As armas com mais abates.",
                "",
                "&eClique para ver."
              ]
            }
          },
          // As últimas linhas do conserto e do prestígio, que mudam com o estado da arma.
          "states": {
            "repair": {
              "ready": "&eClique para consertar.",
              "repaired": "&aA arma não precisa de conserto.",
              "not-enough": "&cVocê não tem o suficiente para consertar."
            },
            "prestige": {
              "ready": "&eClique para prestigiar.",
              "maximum": "&aA arma já está no prestígio máximo.",
              "not-invested": "&cFaltam tokens investidos nesta arma."
            }
          }
        },
        "delete": {
          "title": "Excluir a arma"
        },
        "weapon-top": {
          "title": "Ranking das Armas",
          "items": {
            "0": {
              "name": "&8{position}º &f▸ &f{player}",
              "lore": [
                "",
                "&7{stat}: &f{value}",
                ""
              ]
            },
            "1": {
              "name": "&bEscolha o TOP",
              "lore": [
                "",
                "{tops}",
                "",
                "&bClique para alterar."
              ]
            }
          }
        }
      },
      // O livro de encantamento, o segundo caminho para subir um nível.
      "enchant-book": {
        "item": {
          "name": "&fLivro de &a{enchant}",
          "lore": [
            "",
            "&7Sobe &a{levels} &7nível(is) de",
            "&7&o{enchant}&7 na sua arma.",
            "",
            "&eArraste sobre a arma."
          ]
        }
      },
      // O Reparador, o prêmio do encantamento Reparo da espada.
      "repairer": {
        "item": {
          "name": "&cReparador",
          "lore": [
            "&7Repara a armadura do corpo",
            "&7no clique direito."
          ]
        },
        "announce": [
          "",
          " &eReparador!",
          " &f{killer} &aabateu &f{victim} &acom uma arma especial",
          " &ae recebeu um &lReparador&r&a.",
          ""
        ],
        "repaired": "Armadura reparada.",
        "nothing-to-repair": "Nenhuma peça da sua armadura está danificada.",
        "cannot-move": "O reparador não sai do seu inventário."
      }
    }
  }
}
