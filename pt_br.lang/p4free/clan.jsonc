            "errors": {
              "tag-with-formatting": "&cA tag do clã pode ter cor, mas não formatação (&&l, &&k, &&m, &&n, &&o).",
              "tag-length": "&cA tag precisa ter exatamente 3 caracteres, sem contar as cores.",
              "name-length": "&cO nome do clã precisa ter de 5 a 16 caracteres.",
              "invalid-pattern": "&cA tag e o nome só aceitam letras e números.",
              "tag-in-use": "&cJá existe um clã com essa tag.",
              "name-in-use": "&cJá existe um clã com esse nome."
            },
            "success": "&aVocê criou o clã &7[{clan_colored_tag}&7] {clan_name}&a."
          },
          "help": {
            "arguments": {
              "section": {
                "name": "seção",
                "description": "Seção do guia que você quer abrir"
              }
            },
            "index": [
              "",
              " &eEscolha a seção e clique para abrir o guia:",
              ""
            ],
            "index-entry": " &8• &b{section_name}",
            "index-entry-hover": "&eClique para abrir esta seção.",
            "sections": {
              "clan-player-name": "Comandos clã, jogador",
              "clan-player": [
                "",
                " &bComandos clã, jogador",
                "",
                "  &e/clan convidar [jogador]&7: convidar um jogador para o clã",
                "  &e/clan promover [jogador]&7: promover um membro a capitão",
                "  &e/clan rebaixar [jogador]&7: rebaixar um capitão a membro",
                "  &e/clan expulsar [jogador]&7: expulsar um jogador do clã",
                "  &e/clan transferir [jogador]&7: passar a liderança para outro membro",
                ""
              ],
              "player-clan-name": "Comandos jogador, clã",
              "player-clan": [
                "",
                " &bComandos jogador, clã",
                "",
                "  &e/clan convites&7: os convites que você recebeu",
                "  &e/clan entrar [tag]&7: aceitar um convite",
                "  &e/clan negar [tag]&7: negar um convite",
                "  &e/clan sair&7: sair do clã",
                "  &e/clan info [tag]&7: informações de um clã",
                "  &e/clan perfil [jogador]&7: informações de um jogador",
                "  &e/clan membros [tag]&7: os membros de um clã",
                "  &e/clan top&7: o ranking dos clãs",
                "  &e/clan boletim&7: o histórico de mudanças do seu clã",
                ""
              ],
              "clan-admin-name": "Comandos clã, liderança",
              "clan-admin": [
                "",
                " &bComandos clã, liderança",
                "",
                "  &e/clan desfazer&7: desfazer o clã",
                "  &e/clan modtag [tag]&7: mudar as cores da tag",
                "  &e/clan fogoamigo on/off&7: fogo amigo entre membros",
                "  &e/clan listar&7: todos os clãs criados",
                "  &e/. [mensagem]&7: falar no chat do clã",
                ""
              ],
              "admin-clan-name": "Comandos administração",
              "admin-clan": [
                "",
                " &bComandos administração",
                "",
                "  &e/clan espiao&7: ver o chat de todos os clãs",
                "  &e/clan autorizar [tag]&7: liberar o clã para os eventos",
                "  &e/clan desautorizar [tag]&7: tirar o clã dos eventos",
                "  &e/clan excluir [tag]&7: apagar um clã",
                "  &e/clan adicionar [jogador] [tag]&7: pôr um jogador num clã",
                "  &e/clan remover [jogador]&7: tirar um jogador do clã dele",
                "  &e/clan setarlider [jogador]&7: pôr um jogador como líder do clã dele",
                "  &e/clan pontos [pontos] [tag]&7: somar pontos a um clã",
                "  &e/clan removerpontos [pontos] [tag]&7: tirar pontos de um clã",
                ""
              ]
