{
  "plugins": {
    "clans": {
      "roles": {
        "leader": {
          "name": "Líder",
          "prefix": "#"
        },
        "vice_leader": {
          "name": "Vice Líder",
          "prefix": "@"
        },
        "captain": {
          "name": "Capitão",
          "prefix": "*"
        },
        "member": {
          "name": "Membro",
          "prefix": "+"
        },
        "recruit": {
          "name": "Recruta",
          "prefix": "-"
        },
        "none": {
          "name": "Nenhum",
          "prefix": ""
        }
      },
      "storage": {
        "actions": {
          "increment": {
            "name": "adicionou"
          },
          "decrement": {
            "name": "removeu"
          }
        }
      },
      "items": {
        "member-head": {
          "name": "{member_name_with_tag}",
          "lore": [
            "",
            "&eSuas informações:",
            " &8▸ &fCargo: &7{member_role_prefix}{member_role_name}",
            " &8▸ &fKDR: &7{member_kdr}",
            " &8▸ &fAbates: &7{member_deaths}",
            " &8▸ &fMortes: &7{member_kills}"
          ]
        },
        "clan-banner": {
          "name": "{clan_color_tag_code}[{clan_tag}] {clan_name}",
          "lore": [
            "",
            " {clan_color_tag_code}Informações do clã:",
            " &8▸ &fLíder: &7{clan_leader_name_with_tag}",
            " &8▸ &fMembros: &7({clan_members_size}/{clan_max_members_size}) {clan_online_members_size} online",
            " &8▸ &fKDR: &7{clan_kdr}",
            " &8▸ &fAbates: &7{clan_deaths}",
            " &8▸ &fMortes: &7{clan_kills}"
          ]
        },
        "empty-item": {
          "name": "&cVazio!",
          "lore": [
            "&7Nada encontrado por aqui :("
          ]
        }
      },
      "commands": {
        "restrict": {
          "clan-command-restrict": {
            "error": "&cVocê não faz parte de um clã."
          },
          "clan-out-command-restrict": {
            "error": "&cVocê já faz parte de um clã."
          }
        },
        "clan": {
          "create": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Defina a tag que você deseja dar ao seu clã"
              },
              "name": {
                "name": "nome",
                "description": "Defina o nome que você deseja dar ao seu clã"
              }
            },
            "errors": {
              "tag-length": "&cVocê precisa escolher uma tag de 3 caracteres!",
              "name-length": "&cVocê precisa escolher um nome de 5 a 24 caracteres!",
              "invalid-pattern": "&cVocê só pode utilizar letras e numeros para a tag e o nome.",
              "tag-in-use": "&cVocê precisa escolher uma tag que nenhum outro clã esteja usando!",
              "name-in-use": "&cVocê precisa escolher um nome que nenhum outro clã esteja usando!"
            },
            "success": "&aVocê criou seu clã com sucesso!"
          },
          "demote": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja rebaixar"
              }
            },
            "errors": {
              "not-same-clan": "&cVocê só pode rebaixar jogadores que estão em seu próprio clã!",
              "need-more-role": "&cVocê não tem um cargo alto o suficiente para rebaixar esse jogador!",
              "target-in-lowest-role": "&cEsse jogador já está no cargo mais baixo!"
            },
            "success": "&aVocê rebaixou o jogador {target_name} para {target_role_name} com sucesso!"
          },
          "disband": {
            "errors": {
              "need-leader-role": "&cVocê precisa ser o líder do clã para poder desfaze-lo!"
            }
          },
          "info": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você deseja buscar"
              }
            },
            "member-format": {
              "online": "&a{target_role_prefix}{target_name_with_color}",
              "offline": "&c{target_role_prefix}{target_name_with_color}"
            },
            "success": [
              "",
              " &eInformações do clã:",
              "",
              "  &fClã: {clan_color_tag_code}[{clan_tag}] {clan_name}",
              "  &fLíder: {clan_leader_name_with_tag}",
              "  &fMembros: &7{clan_members_size}/{clan_max_members_size} ({clan_online_members_size} online)",
              "  {clan_members}",
              "",
              "  &fKDR: &7{clan_kdr}",
              "  &fMortes: &7{clan_deaths}",
              "  &fAbates: &7{clan_kills}",
              ""
            ]
          },
          "invitation": {
            "accept": {
              "arguments": {
                "tag": {
                  "name": "tag",
                  "description": "Tag do clã que você deseja aceitar o convite"
                }
              },
              "errors": {
                "clan-not-found": "&cNão foi possível encontrar um clã com essa tag!",
                "clan-not-invited": "&cVocê não possui nenhum convite de entrada desse clã!",
                "clan-max-members-exceeded": "&cO clã que te convidou está cheio!"
              },
              "success": "&aVocê se juntou ao clã {clan_color_tag_code}[{clan_tag}]"
            },
            "deny": {
              "arguments": {
                "tag": {
                  "name": "tag",
                  "description": "Tag do clã que você deseja aceitar o convite"
                }
              },
              "errors": {
                "clan-not-found": "&cNão foi possível encontrar um clã com essa tag!",
                "clan-not-invited": "&cVocê não possui nenhum convite de entrada desse clã!"
              },
              "success": "&aVocê negou o pedido do clã {clan_color_tag_code}[{clan_tag}]"
            }
          },
          "invite": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "jogador que deseja convidar para seu clã"
              }
            },
            "errors": {
              "target-always-have-clan": "&cEsse jogador já possui um clã.",
              "already-invited": "&cVocê já enviou um pedido para esse jogador!"
            },
            "success": "&aVocê convidou o jogador {target_name} para o seu clã."
          },
          "join": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você deseja entrar"
              }
            },
            "errors": {
              "already-in-clan": "&cVocê já faz parte de um clã.",
              "clan-not-found": "&cNão existe nenhum clã com essa tag."
            },
            "success": "&aVocê se juntou ao clã {clan_color_tag_code}[{clan_tag}]"
          },
          "kick": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja expulsar"
              }
            },
            "errors": {
              "not-same-clan": "&cVocê só pode expulsar jogadores que estão em seu próprio clã!",
              "need-more-role": "&cVocê não tem um cargo alto o suficiente para expulsar esse jogador!"
            },
            "success": "&aVocê expulsou o jogador {target_name}"
          },
          "leave": {
            "errors": {
              "is-leader": "&cO líder do clã não pode abandoná-lo. Caso queira deletá-lo utilize /clan desfazer."
            }
          },
          "members": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã cujos membros você deseja ver"
              }
            }
          },
          "profile": {
            "arguments": {
              "name": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja consultar"
              }
            },
            "success-with-clan": [
              "",
              " &eInformações do jogador:",
              "",
              "  &fJogador: {target_name_with_tag}",
              "  &fClã: &7{target_clan_tag}",
              "  &fCargo: &7{target_role_name}",
              "  &fKDR: &7{target_kdr}",
              "  &fMortes: &7{target_deaths}",
              "  &fAbates: &7{target_kills}",
              ""
            ],
            "success-without-clan": [
              "",
              " &eInformações do jogador:",
              "",
              "  &fJogador: {target_name_with_tag}",
              "  &fClã: &7Sem clã.",
              "  &fKDR: &7{target_kdr}",
              "  &fMortes: &7{target_deaths}",
              "  &fAbates: &7{target_kills}",
              ""
            ]
          },
          "promote": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja promover"
              }
            },
            "errors": {
              "not-same-clan": "&cVocê só pode promover jogadores que estão em seu próprio clã!",
              "need-more-role": "&cVocê não tem um cargo alto o suficiente para promover esse jogador!",
              "target-in-upper-role": "&cEsse jogador já está no cargo mais alto!"
            },
            "success": "&aVocê promoveu o jogador {target_name} para {target_role_name} com sucesso!"
          },
          "transfer": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você transferir o clã"
              }
            },
            "errors": {
              "not-leader": "&cSomente o líder pode transferir a liderança do clã.",
              "not-same-clan": "&cVocê só pode transferir jogadores que estão em seu próprio clã!"
            },
            "success": "&aVocê transferiu a liderança do clã para {target_name} com sucesso."
          }
        }
      },
      "messages": {
        "clan": {
          "new-leader": [
            "",
            "{user_name_with_tag} &aé o novo líder do clã!",
            ""
          ],
          "on-member-chat": [
            "&a[{user_clan_tag}] &7{user_role_prefix}{user_name}&f: &a{user_chat_message}"
