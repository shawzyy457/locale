{
  "plugins": {
    "essentials": {
      "kits": {
        "categories": {
          "default": {
            "name": "<green>Kits Básicos</green>",
            "description": [
              "<gray>Acesse os kits que todos</gray>",
              "<gray>os jogadores possuem acesso.</gray>"
            ]
          },
          "vip": {
            "name": "<green>Kits VIPs</green>",
            "description": [
              "<gray>Encontre os kits para jogadores</gray>",
              "<gray>que possuem alguma vantagem.</gray>"
            ]
          },
          "beta": {
            "name": "<green>Kits BETA</green>",
            "description": [
              "<gray>Kit exclusivo closed beta.</gray>"
            ]
          }
        },
        "types": {
          "noob_15m": {
            "name": "<gray>Kit 15m <white>"
          },
          "noob_1d": {
            "name": "<gray>Kit 1d <white>"
          },
          "noob_5d": {
            "name": "<gray>Kit 5d <white>"
          },
          "pro_1d": {
            "name": "<gradient:#FF55FF:#FFADFA>Kit 1d <white>"
          },
          "pro_7d": {
            "name": "<gradient:#FF55FF:#FFADFA>Kit 7d <white>"
          },
          "pro_5d": {
            "name": "<gradient:#FF55FF:#FFADFA>Kit 5d <white>"
          },
          "mvp_1d": {
            "name": "<gradient:#55FFFF:#D5FFF3>Kit 1d <white>"
          },
          "mvp_7d": {
            "name": "<gradient:#55FFFF:#D5FFF3>Kit 7d <white>"
          },
          "mvp_5d": {
            "name": "<gradient:#55FFFF:#D5FFF3>Kit 5d <white>"
          },
          "elite_1d": {
            "name": "<gradient:#AA0000:#FB241D>Kit 1d <white>"
          },
          "elite_7d": {
            "name": "<gradient:#AA0000:#FB241D>Kit 7d <white>"
          },
          "EXE_1d": {
            "name": "<gradient:#FF8200:#FFF763>Kit 1d <white>"
          },
          "EXE_7d": {
            "name": "<gradient:#FF8200:#FFF763>Kit 7d <white>"
          },
          "EXE_5d": {
            "name": "<gradient:#FF8200:#FFF763>Kit 5d <white>"
          },
          "beta_1": {
            "name": "<gradient:#FF8200:#FFF763>Kit Beta"
          },
          "beta_2": {
            "name": "<gradient:#FF8200:#FFF763>Kit Beta 2"
          },
          "beta_3": {
            "name": "<gradient:#FF8200:#FFF763>Kit Beta 3"
          }
        }
      },
      "commands": {
        "createkit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será criado"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!"
        },
        "deletekit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será deletado"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!",
          "success": "O kit {kit_id} foi deletado com sucesso."
        },
        "editkit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será editado"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!"
        },
        "givekit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será enviado"
            },
            "target": {
              "name": "jogador",
              "description": "Jogador que irá receber o kit"
            }
          },
          "cannot-find-with-id": "Não foi possivel encontrar um kit com esse id!",
          "success": "Você deu o kit \"{kit_id}\" para o jogador {target_name}!"
        }
      },
      "messages": {
        "kits": {
          "on-collect": {
            "dont-have-permission": "Você não possui permissão para coletar esse kit.",
            "in-delay": "Você precisa esperar mais {kit_cooldown_remaining} para coletar esse kit.",
            "success": "Kit \"<white>{kit_name}</white>\" coletado!"
          }
        },
        "views": {
          "kit-edit": {
            "update-items": {
              "success": "Items do kit \"{kit_id}\" alterados."
            }
          }
        }
      },
      "views": {
        "kit-edit": {
          "title": "Editando - {kit_name}"
        },
        "kit-visualization": {
          "title": "{kit_name}"
        },
        "kit-categories": {
          "title": "Categorias de Kits",
          "items": {
            "0": {
              "name": "{kit_category_name}",
              "lore": [
                "{kit_category_description}",
                "",
                "<green>Clique para acessar.</green>"
              ]
            }
          }
        },
        "kit-category": {
          "title": "{kit_category_name_stripped}",
          "items": {
            "0": {
              "name": "{kit_name}",
              "lore": [
                "<gray>Clique direito para </gray><white>ver o conteúdo</white><gray>.</gray>",
                "<gray>Clique esquerdo para </gray><white>coletar.</white>",
                "",
                "<dark_gray>➟ </dark_gray><white>Tempo p/ coletar: </white><gray>{kit_cooldown}</gray>"
              ]
            }
          }
        }
      }
    }
  }
}
