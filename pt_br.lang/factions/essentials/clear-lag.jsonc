{
    "plugins": {
        "essentials": {
            "commands": {
                "clearlag": {
                    "request-sent": "<green>♼ Pedido de limpeza enviado ao servidor principal."
                }
            },
            "messages": {
                "clear-lag": {
                    "countdown": "<green>♻ O chão será limpo em <bold>{countdown}<reset><green>...",
                    "clean": "<green>♻ {count}<green> itens foram limpos do chão."
                }
            }
        }
    }
}
