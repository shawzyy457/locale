{
  "plugins": {
    "enchantments": {
      "commands": {
        "enchantment": {
          "animation-running": "Uma animação de encantamento já está em execução.",
          "apply": {
            "arguments": {
              "enchantment": {
                "name": "encantamento",
                "description": "Encantamento a aplicar"
              },
              "level": {
                "name": "nível",
                "description": "Nível do encantamento"
              }
            },
            "unsupported-item": "Este item não suporta encantamentos.",
            "unsupported-enchantment": "Este encantamento não pode ser aplicado neste item.",
            "unsupported-level": "Este nível de encantamento é inválido.",
            "success": "Encantamento aplicado com sucesso!"
          }
        }
      },
      "items": {
        "experience-flask": {
          "display-name": "<color:#00acff>Frasco de Experiência",
          "name": "<color:#00acff>Frasco de Experiência",
          "lore": [
            "<gray>Armazena sua experiência",
            "<gray>para usar mais tarde.",
            "",
            "<white>Conteúdo: <color:#00acff>{experience_flask_amount} XP",
            "",
            "<color:#00acff>Clique direito para consumir."
          ]
        },
        "ascended-book": {
          "display-name": "<color:#FF69B4>{ascended_enchantment_name}",
          "name": "<color:#FF69B4>{ascended_enchantment_name}",
          "lore": [
            "{ascended_enchantment_description}"
          ]
        },
        "enchantment-book": {
          "display-name": "<color:#00acff>Livro: </color>{enchantment_name} <white>{enchantment_level_roman}",
          "name": "<color:#00acff>Livro: </color>{enchantment_name} <white>{enchantment_level_roman}",
          "lore": [
            "{enchantment_description}",
            "",
            "<color:#00acff> 📖 Nível: <white>{enchantment_level_roman}",
            "",
            "<color:#00acff>Arraste o livro em um item compatível."
          ]
        }
      },
      "types": {
        "efficiency": {
          "name": "<color:#00acff>Eficiência",
          "description": [
            "<gray>Aumenta a velocidade de",
            "<gray>quebrar um bloco."
          ]
        },
        "unbreaking": {
          "name": "<color:#00acff>Inquebrável",
          "description": [
            "<gray>Reduz a chance de gastar",
            "<gray>durabilidade."
          ]
        },
        "hot-touch": {
          "name": "<color:#00acff>Toque quente",
          "description": [
            "<gray>Derrete minérios automaticamente",
            "<gray>ao quebra-los."
          ]
        },
        "fortune": {
          "name": "<color:#00acff>Fortuna",
          "description": [
            "<gray>Aumenta a quantidade de drops",
            "<gray>de minérios e outros blocos."
          ]
        },
        "silk-touch": {
          "name": "<color:#00acff>Toque Suave",
          "description": [
            "<gray>Permite coletar blocos em",
            "<gray>seu estado natural."
          ]
        },
        "protection": {
          "name": "<color:#00acff>Proteção",
          "description": [
            "<gray>Reduz o dano recebido de",
            "<gray>diversas fontes."
          ]
        },
        "sharpness": {
          "name": "<color:#00acff>Afiação",
          "description": [
            "<gray>Aumenta o dano causado em",
            "<gray>ataques corpo a corpo."
          ]
        },
        "looting": {
          "name": "<color:#00acff>Pilhagem",
          "description": [
            "<gray>Aumenta a quantidade e chance",
            "<gray>de drops de mobs."
          ]
        },
        "knockback": {
          "name": "<color:#00acff>Repulsão",
          "description": [
            "<gray>Empurra inimigos para trás ao atacá-los.",
            "<gray>Bom para manter distância."
          ]
        },
        "feather-falling": {
          "name": "<color:#00acff>Peso Pena",
          "description": [
            "<gray>Reduz o dano de queda.",
            "<gray>Essencial para botas."
          ]
        },
        "respiration": {
          "name": "<color:#00acff>Respiração",
          "description": [
            "<gray>Aumenta o tempo de respiração debaixo d'água.",
            "<gray>Útil para explorar oceanos."
          ]
        },
        "depth-strider": {
          "name": "<color:#00acff>Passos Profundos",
          "description": [
            "<gray>Aumenta a velocidade de movimento na água.",
            "<gray>Perfeito para botas."
          ]
        },
        "aqua-affinity": {
          "name": "<color:#00acff>Afinidade Aquática",
          "description": [
            "<gray>Aumenta a velocidade de mineração debaixo d'água.",
            "<gray>Facilita construções aquáticas."
          ]
        },
        "quick-charge": {
          "name": "<color:#00acff>Carga Rápida",
          "description": [
            "<gray>Recarrega a besta mais rápido."
          ]
        },
        "piercing": {
          "name": "<color:#00acff>Perfuração",
          "description": [
            "<gray>A mesma flecha pode atingir",
            "<gray>multiplos inimigos em linha."
          ]
        },
        "multishot": {
          "name": "<color:#00acff>Tiro Múltiplo",
          "description": [
            "<gray>Dispara <white>3 flechas <gray>ao mesmo tempo."
          ]
        },
        "power": {
          "name": "<color:#00acff>Força",
          "description": [
            "<gray>Aumenta o dano causado por flechas."
          ]
        },
        "punch": {
          "name": "<color:#00acff>Impacto",
          "description": [
            "<gray>Aumenta o empurrão causado por flechas."
          ]
        },
        "super-area": {
          "name": "<gradient:#C9659C:#ACA2C0>Livro Ascendido",
          "description": [
            "<gray>Quebra blocos em",
            "<gray>um raio de <white>5x5<gray>.",
            "",
            "<gradient:#C9659C:#ACA2C0> 📖 Tipo: <white>Super área",
            "<gradient:#C9659C:#ACA2C0> ⛏ Compatível: <white>Picareta",
            "",
            "<gradient:#C9659C:#ACA2C0>Arraste o livro em uma Picareta. "
          ]
        },
        "heavy-touch": {
          "name": "<gradient:#2D184C:#8D57B8>Livro Ascendido",
          "description": [
            "<gray>Quebra blocos de",
            "<gray>proteção <white>5x <gray>mais rápido.",
            "",
            "<gradient:#2D184C:#8D57B8> 📖 Tipo: <white>Toque Pesado",
            "<gradient:#2D184C:#8D57B8> ⛏ Compatível: <white>Picareta",
            "",
            "<gradient:#2D184C:#8D57B8>Arraste o livro em uma Picareta."
          ]
        },
        "freeze": {
          "name": "<gradient:#7BCAE4:#F1EFFF>Livro Ascendido",
          "description": [
            "<gray>Possui a chance de",
            "<aqua>congelar <gray>um inimigo por<white> 10s<gray>.",
            "",
            "<gradient:#7BCAE4:#F1EFFF> 📖 Tipo: <white>Congelamento",
            "<gradient:#7BCAE4:#F1EFFF> 🗡 Compatível: <white>Espada",
            "",
            "<gradient:#7BCAE4:#F1EFFF>Arraste o livro em uma Espada."
          ]
        },
        "cut": {
          "name": "<gradient:#D13451:#3C1C73>Livro Ascendido",
          "description": [
            "<gray>Causa <white>+2 de dano <gray>em jogadores",
            "<gray>que estão <white>sangrando<gray>.",
            "",
            "<gradient:#D13451:#3C1C73> 📖 Tipo: <white>Corte",
            "<gradient:#D13451:#3C1C73> 🗡 Compatível: <white>Espada",
            "",
            "<gradient:#D13451:#3C1C73>Arraste o livro em uma Espada."
          ]
        },
        "deep-cut": {
          "name": "<gradient:#35315A:#625191>Livro Ascendido",
          "description": [
            "<gray>Seu <white>sangramento <gray>também",
            "<gray>causa <white>lentidão II <gray>no inimigo.",
            "",
            "<gradient:#35315A:#625191> 📖 Tipo: <white>Corte profundo",
            "<gradient:#35315A:#625191> 🗡 Compatível: <white>Espada",
            "",
            "<gradient:#35315A:#625191>Arraste o livro em uma Espada."
          ]
        },
        "sharp-shadow": {
          "name": "<gradient:#3D227D:#C36A76>Livro Ascendido",
          "description": [
            "<gray>Causa <white>+5 de dano<gray> ao atacar",
            "<gray>um inimigo pelas costas",
            "",
            "<gradient:#3D227D:#C36A76> 📖 Tipo: <white>Sombra Afiada",
            "<gradient:#3D227D:#C36A76> 🗡 Compatível: <white>Espada",
            "",
            "<gradient:#3D227D:#C36A76>Arraste o livro em uma Espada."
          ]
        },
        "duel": {
          "name": "<gradient:#CA2955:#D0887C>Livro Ascendido",
          "description": [
            "<gray>Causa <white>+3 de dano<gray> em",
            "<gray>situações de <white>1v1<gray>.",
            "",
            "<gradient:#CA2955:#D0887C> 📖 Tipo: <white>Duelo",
            "<gradient:#CA2955:#D0887C> 🪓 Compatível: <white>Machado e Espada",
            "",
            "<gradient:#CA2955:#D0887C>Arraste o livro em uma arma."
          ]
        },
        "skull-crush": {
          "name": "<gradient:#68376F:#A13D45>Livro Ascendido",
          "description": [
            "<gray>Causa <white>+2 de dano <gray>em",
            "<gray>jogadores sem capacete.",
            "",
            "<gradient:#68376F:#A13D45> 📖 Tipo: <white>Quebra Crânio",
            "<gradient:#68376F:#A13D45> 🪓 Compatível: <white>Machado",
            "",
            "<gradient:#68376F:#A13D45>Arraste o livro em um machado."
          ]
        },
        "iceberg": {
          "name": "<gradient:#4888B5:#A9FEDB>Livro Ascendido",
          "description": [
            "<gray>Possui <white>2x</white> mais <white>chance</white> <gray>de aplicar ",
            "<white>quebra <gray>em inimigos <white>congelados.",
            "",
            "<gradient:#4888B5:#A9FEDB> 📖 Tipo: <white>Iceberg",
            "<gradient:#4888B5:#A9FEDB> 🪓 Compatível: <white>Machado",
            "",
            "<gradient:#4888B5:#A9FEDB>Arraste o livro em um machado."
          ]
        },
        "conductivity": {
          "name": "<gradient:#2D2678:#77C9FA>Livro Ascendido",
          "description": [
            "<gray>Possui a chance de invocar um <white>raio",
            "<gray>ao golpear, causando <white>10 de dano</white>",
            "<gray>na armadura mais elevada do inimigo.",
            "",
            "<gradient:#2D2678:#77C9FA> 📖 Tipo: <white>Condutividade",
            "<gradient:#2D2678:#77C9FA> 🪓 Compatível: <white>Machado",
            "",
            "<gradient:#2D2678:#77C9FA>Arraste o livro em um machado."
          ]
        },
        "execution": {
          "name": "<gradient:#922F6C:#431A3E>Livro Ascendido",
          "description": [
            "<gray>Causa <white>+4 de dano <gray> em jogadores",
            "<gray>com menos de <white>50% da vida<gray>.",
            "",
            "<gradient:#922F6C:#431A3E> 📖 Tipo: <white>Execução",
            "<gradient:#922F6C:#431A3E> 🪓 Compatível: <white>Machado",
            "",
            "<gradient:#922F6C:#431A3E>Arraste o livro em um machado."
          ]
        },
        "viking": {
          "name": "<gradient:#924984:#4E91C3>Livro Ascendido",
          "description": [
            "<gray>Não perde <white>durabilidade",
            "<gray>para golpes de machados.",
            "",
            "<gradient:#924984:#4E91C3> 📖 Tipo: <white>Viking",
            "<gradient:#924984:#4E91C3> ⛨ Compatível: <white>Capacete",
            "",
            "<gradient:#924984:#4E91C3>Arraste o livro em um Capacete."
          ]
        },
        "explosive": {
          "name": "<gradient:#CD2A5D:#D7C0E8>Livro Ascendido",
          "description": [
            "<gray>A cada <white>1 minuto<gray> pode causar",
            "<gray>uma explosão ao ser golpeado,",
            "<gray>consumindo <white>50 de durabilidade</white><gray>.",
            "",
            "<gradient:#CD2A5D:#D7C0E8> 📖 Tipo: <white>Explosivo",
            "<gradient:#CD2A5D:#D7C0E8> ⛨ Compatível: <white>Capacete",
            "",
            "<gradient:#CD2A5D:#D7C0E8>Arraste o livro em um Capacete."
          ]
        },
        "tenacity": {
          "name": "<gradient:#8E2F39:#E7B670>Livro Ascendido",
          "description": [
            "<gray>Reduz o tempo de efeitos",
            "<gray>negativos recebidos em <white>1s<gray>.",
            "",
            "<gradient:#8E2F39:#E7B670> 📖 Tipo: <white>Tenacidade",
            "<gradient:#8E2F39:#E7B670> ⛨ Compatível: <white>Armadura",
            "",
            "<gradient:#8E2F39:#E7B670>Arraste o livro em uma Armadura."
          ]
        },
        "reinforcement": {
          "name": "<gradient:#4A378E:#7E3C53>Livro Ascendido",
          "description": [
            "<gray>Sua armadura recebe",
            "<white>+1 de proteção<gray>.",
            "",
            "<gradient:#4A378E:#7E3C53> 📖 Tipo: <white>Reforço",
            "<gradient:#4A378E:#7E3C53> ⛨ Compatível: <white>Armadura",
            "",
            "<gradient:#4A378E:#7E3C53>Arraste o livro em uma Armadura."
          ]
        },
        "indestructible": {
          "name": "<gradient:#4F308E:#A68CE6>Livro Ascendido",
          "description": [
            "<gray>Não perde durabilidade para",
            "<white>golpes<gray>, <gray>porém, ao ser <white>eliminado<gray>,",
            "<gray>perde <white>40% da durabilidade<gray>.",
            "",
            "<gradient:#4F308E:#A68CE6> 📖 Tipo: <white>Indestrutível",
            "<gradient:#4F308E:#A68CE6> ⛨ Compatível: <white>Peitoral",
            "",
            "<gradient:#4F308E:#A68CE6>Arraste o livro em um Peitoral."
          ]
        },
        "armored": {
          "name": "<gradient:#703C62:#6D6489>Livro Ascendido",
          "description": [
            "<gray>Torne-se imune a dano e ",
            "<gray>repulsão de <white>projetéis<gray>.",
            "",
            "<gradient:#703C62:#6D6489> 📖 Tipo: <white>Blindado",
            "<gradient:#703C62:#6D6489> ⛨ Compatível: <white>Peitoral",
            "",
            "<gradient:#703C62:#6D6489>Arraste o livro em um Peitoral."
          ]
        },
        "stealth": {
          "name": "<gradient:#8D6DC4:#24377D>Livro Ascendido",
          "description": [
            "<gray>Aumenta sua <white>velocidade <gray>de",
            "<gray>corrida ao se movimentar <white>agachado.",
            "",
            "<gradient:#8D6DC4:#24377D> 📖 Tipo: <white>Furtividade",
            "<gradient:#8D6DC4:#24377D> ⛨ Compatível: <white>Calça",
            "",
            "<gradient:#8D6DC4:#24377D>Arraste o livro em uma Calça."
          ]
        },
        "warmer": {
          "name": "<gradient:#AC4061:#FFB078>Livro Ascendido",
          "description": [
            "<gray>Diminui em <white>50%<gray> o tempo do",
            "<white>congelamento<gray> recebido.",
            "",
            "<gradient:#AC4061:#FFB078> 📖 Tipo: <white>Aquecimento",
            "<gradient:#AC4061:#FFB078> ⛨ Compatível: <white>Calça",
            "",
            "<gradient:#AC4061:#FFB078>Arraste o livro em uma Calça."
          ]
        },
        "anchor": {
          "name": "<gradient:#B96075:#3B1650>Livro Ascendido",
          "description": [
            "<gray>Torna-se imune a <white>respulsão<gray>,",
            "<gray>porém, receba <white>lentidão III <gray>.",
            "",
            "<gradient:#B96075:#3B1650> 📖 Tipo: <white>âncora",
            "<gradient:#B96075:#3B1650> ⛨ Compatível: <white>Botas",
            "",
            "<gradient:#B96075:#3B1650>Arraste o livro em uma Bota."
          ]
        },
        "swap": {
          "name": "<gradient:#67C4D1:#B9BACB>Livro Ascendido",
          "description": [
            "<gray>Ao atingir um inimigo com a",
            "<gray>vara de pesca e puxar, <white>troca",
            "<white>de posição <gray>com ele.",
            "",
            "<gradient:#67C4D1:#B9BACB> 📖 Tipo: <white>Troca",
            "<gradient:#67C4D1:#B9BACB> 🎣 Compatível: <white>Vara de Pesca",
            "",
            "<gradient:#67C4D1:#B9BACB>Arraste o livro em uma Vara."
          ]
        },
        "recomposition": {
          "name": "<gradient:#2F267B:#EBE1FF>Livro Ascendido",
          "description": [
            "<gray>Ao ser golpeado, possui a",
            "<gray>chance de recuperar",
            "<white>2 de durabilidade <gray>da armadura.",
            "",
            "<gradient:#2F267B:#EBE1FF> 📖 Tipo: <white>Recomposição",
            "<gradient:#2F267B:#EBE1FF> ⛨ Compatível: <white>Armadura",
            "",
            "<gradient:#2F267B:#EBE1FF>Arraste o livro em uma Armadura."
          ]
        }
      },
      "item-types": {
        "diamond": "<white>Itens de Diamante",
        "netherite": "<white>Itens de Netherite",
        "glacite": "<white>Itens de Glacite"
      },
      "messages": {
        "on-interact": {
          "enchantment": {
            "animation-running": "Uma animação de encantamento já está em execução."
          }
        },
        "ascended-book": {
          "incompatible-enchantment": "Este encantamento não é compatível com este item.",
          "conflict": "Este encantamento conflita com {enchantment_conflict_name} já presente no item."
        },
        "enchantment-book": {
          "incompatible-enchantment": "Este encantamento não é compatível com este item.",
          "already-applied": "O item já possui este nível de encantamento.",
          "cannot-apply-in-this-item": "Este encantamento não pode ser aplicado neste item.",
          "conflict": "Este encantamento conflita com {enchantment_conflict_name} já presente no item.",
          "apply-success": "Encantamento aplicado com sucesso!"
        },
        "views": {
          "enchantment-level": {
            "already-have-level": "O item já possui este nível de encantamento.",
            "need-before": "Você precisa aplicar o nível anterior antes deste encantamento.",
            "cannot-apply-in-this-item": "Este encantamento não pode ser aplicado neste item.",
            "conflict": "Este encantamento conflita com {enchantment_conflict_name} já presente no item.",
            "need-unlock-requirements": "Você não possui os requisitos de desbloqueio necessários.",
            "dont-have-requirements": "Você não possui os requisitos necessários para este encantamento.",
            "apply-success": "Encantamento aplicado com sucesso!",
            "far-from-the-table": "Você está muito longe da mesa de encantamentos."
          },
          "enchantment-recycle": {
            "recycle-with-experience": "Reciclar encantamento e recuperar experiência.",
            "recycle-without-experience": "Reciclar encantamento sem recuperar experiência."
          },
          "enchantment-wizard": {
            "withdraw-one": {
              "not-enough-experience": "Você não possui experiência suficiente para retirar este encantamento."
            },
            "withdraw-all": {
              "not-enough-experience": "Você não possui experiência suficiente para retirar todos os encantamentos."
            }
          },
          "enchantment-ascension": {
            "already-ascended": "Este item já foi ascendido.",
            "cannot-be-ascended": "Este item não pode ser ascendido.",
            "need-enchanting-level": "Você precisa de nível {required_level} de encantador para ascender.",
            "dont-have-requirements": "Você não possui os recursos necessários para ascender.",
            "apply-failed": "Falha ao aplicar a ascensão. Os recursos foram consumidos.",
            "apply-success": "Ascensão aplicada com sucesso!"
          },
          "enchantment-ascension-box": {
            "need-enchanting-level": "Você precisa de nível {required_level} de encantador para comprar a caixa ascendida.",
            "not-enough-experience": "Você não possui experiência suficiente. Custo: {ascension_box_cost} XP.",
            "purchase-success": "Você comprou uma Caixa Ascendida por {ascension_box_cost} XP!"
          }
        }
      },
      "views": {
        "enchantment-level": {
          "title": "Encantar",
          "items": {
            "info": {
              "name": "<color:#00acff>Selecione o Item",
              "lore": [
                "<gray>Clique no item do seu",
                "<gray>inventário que deseja",
                "<gray>encantar.",
                "",
                "<color:#00acff>Clique em um item."
              ]
            },
            "recycle": {
              "name": "<color:#00acff>Reciclagem",
              "lore": [
                "<gray>Recicle itens e receba XP",
                "<gray>e materiais em troca.",
                "",
                "<color:#00acff>Clique para acessar."
              ]
            },
            "wizard": {
              "name": "<color:#00acff>Feiticeiro",
              "lore": [
                "<gray>Transforme seu XP em frascos",
                "<gray>para utilizar mais tarde.",
                "",
                "<color:#00acff>Clique para acessar."
              ]
            },
            "level": {
              "already-applied": {
                "name": "{enchantment_type_name} {enchantment_level}",
                "lore": [
                  "{enchantment_type_description}",
                  "{enchantment_level_unlock_requirements}",
                  "",
                  "<color:#00acff>Você já possui este nível."
                ]
              },
              "need-before": {
                "name": "{enchantment_type_name} {enchantment_level}",
                "lore": [
                  "{enchantment_type_description}",
                  "{enchantment_level_unlock_requirements}",
                  "",
                  "<color:#00acff>Encante o nível anterior."
                ]
              },
              "cannot-apply-in-this-item": {
                "name": "{enchantment_type_name} {enchantment_level}",
                "lore": [
                  "{enchantment_type_description}",
                  "{enchantment_level_unlock_requirements}",
                  "",
                  "<red>Encantamento restrito para",
                  "{enchantment_level_needed_item_type}"
                ]
              },
              "conflict": {
                "name": "{enchantment_type_name} {enchantment_level}",
                "lore": [
                  "{enchantment_type_description}",
                  "{enchantment_level_unlock_requirements}",
                  "",
                  "<red>Conflita com {enchantment_conflict_name}",
                  "<red>já presente no item."
                ]
              },
              "has-requirements": {
                "name": "{enchantment_type_name} {enchantment_level}",
                "lore": [
                  "{enchantment_type_description}",
                  "{enchantment_level_unlock_requirements}",
