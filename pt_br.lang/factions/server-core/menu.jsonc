{
    "plugins": {
        "server-core": {
            "messages": {
                "menu": {
                    "not-found": "<red>O menu não está disponível no momento.</red>",
                    "premium-required": "<red>Você precisa de um VIP para acessar este item.</red>",
                    "submenu-not-found": "<red>Este submenu não está disponível no momento.</red>"
                }
            },
            "views": {
                "menu": {
                    "title": "Menu",
                    "shop": {
                        "title": "Loja"
                    },
                    "vip-shop": {
                        "title": "Loja - VIPs"
                    },
                    "events": {
                        "title": "Eventos"
                    },
                    "warps": {
                        "title": "Warps"
                    },
                    "items": {
                        "player-head": {
                            "name": "<green>{user_name_with_tag}",
                            "lore": [
                                "<gray>Clique para abrir o seu perfil.</gray>"
                            ]
                        },
                        "correio": {
                            "name": "<green>Correio</green>",
                            "lore": [
                                "<gray>Receba e envie itens através</gray>",
                                "<gray>do correio, de uma forma",
                                "<gray>simples e prática.</gray>",
                                "",
                                "<green>Clique para acessar."
                            ]
                        },
                        "pet": {
                            "name": "<green>Pets</green>",
                            "lore": [
                                "<gray>Consiga bônus e habilidades</gray>",
                                "<gray>utilizando os pets!",
                                "",
                                "<green> Como evoluir o nível?",
                                "<gray> Você pode evoluir o seu pet",
                                "<gray> dando a comida favorita para",
                                "<gray> ele, que aparece na descrição do pet.",
                                "",
                                "<green> Como evoluir a raridade?",
                                "<gray> Você pode evoluir a raridade do",
                                "<gray> seu pet num NPC da /vip ou mina",
                                "<gray> de ametista, com ametista refinada.",
                                "",
                                "<green>Clique para acessar."
                            ]
                        },
                        "kit": {
                            "name": "<green>Kits</green>",
                            "lore": [
                                "<gray>Consiga itens grátis ou</gray>",
                                "<gray>itens especiais de vip apenas</gray>",
                                "<gray>em um clique!</gray>",
                                "",
                                "<green>Clique para acessar."
                            ]
                        },
                        "faction-banner": {
                            "name": "<green>Facção</green>",
                            "lore": [
                                "<gray>Crie uma facção e domine o",
                                "<gray>servidor com seus companheiros!</gray>",
                                "",
                                "<green> Sua Facção: <white>{faction_tag}</white>",
                                "",
                                "<green>Clique para acessar."
                            ]
                        },
                        "ender-chest": {
                            "name": "<green>Ender Chest</green>",
                            "lore": [
                                "<gray>Armazene itens de forma segura",
                                "<gray>em seu ender chest pessoal.</gray>",
                                "",
                                "<green>Clique para acessar."
                            ]
                        },
                        "baus": {
                            "name": "<green>Baú</green>",
                            "lore": [
                                "<gray>Armazene itens de forma segura",
                                "<gray>nos seus baús pessoais.</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "enchant": {
                            "name": "<green>Encantamentos</green>",
                            "lore": [
                                "<gray>Encante seus itens apenas</gray>",
                                "<gray>com um clique!",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "recipes": {
                            "name": "<green>Receitas</green>",
                            "lore": [
                                "<gray>Descubra todas as receitas</gray>",
                                "<gray>de itens do servidor.</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "skills": {
                            "name": "<green>Skills</green>",
                            "lore": [
                                "<gray>Evolua as suas skills e</gray>",
                                "<gray>desbloqueie melhorias e habilidades.</gray>",
                                "<gray>De 5 em 5 níveis até nível 15, você",
                                "<gray>desbloqueia uma classe, limitada a 3",
                                "<gray>classes por jogador.</gray>",
                                "",
                                "<green> Como evoluir skills?</green>",
                                "<gray> Você pode evoluir as suas skills</gray>",
                                "<gray> ao realizar ações no servidor como</gray>",
                                "<gray> minerar, matar mobs, matar jogadores,",
                                "<gray> entre outros.</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "passe": {
                            "name": "<green>Passe</green>",
                            "lore": [
                                "<gray>O passe oferece recompensas</gray>",
                                "<gray>em itens a cada 5 níveis que</gray>",
                                "<gray>você alcançar nas skills</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "home": {
                            "name": "<green>Homes</green>",
                            "lore": [
                                "<gray>Teleporte até localizações</gray>",
                                "<gray>salvas por você mesmo.</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "rank": {
                            "name": "<green>Rankings</green>",
                            "lore": [
                                "<gray>Veja o ranking de melhores</gray>",
                                "<gray>jogadores do servidor</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "shop": {
                            "name": "<green>Loja</green>",
                            "lore": [
                                "<gray>Compre e venda itens diversos</gray>",
                                "<gray>na loja do servidor.</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "warps-menu": {
                            "name": "<green>Warps</green>",
                            "lore": [
                                "<gray>Teleporte-se para todos os</gray>",
                                "<gray>diferentes lugares do servidor.</gray>",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "cosmeticos": {
                            "name": "<green>Cosméticos</green>",
                            "lore": [
                                "<gray>Personalize seu personagem.</gray>",
                                "<gray>com diversos cosméticos",
                                "",
                                "<green>Clique para acessar.</green>"
                            ]
                        },
                        "vip-shop-button": {
