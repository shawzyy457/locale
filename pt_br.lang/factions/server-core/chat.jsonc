{
  "plugins": {
    "server-core": {
      "commands": {
        "global": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada no chat"
            }
          },
          "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
          "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
          "chat-locked": "O chat global está desabilitado!",
          "dont-have-requirements": "Você precisa de no mínimo {chat_message_currency_value_formatted_requirement} ou nível de conta {required_account_level} para enviar uma mensagem no chat global!",
          "message": {
            "staff": {
              "with-faction": [
                "",
                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '></click></hover></gray> <hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/faction info {sender_faction_tag}'><gray>{sender_faction_tag_colored}</gray></click></hover> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>",
                ""
              ],
              "without-faction": [
                "",
                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '></click></hover></gray> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>",
                ""
              ]
            },
            "vip": {
              "with-faction": [
                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '></click></hover></gray> <hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/faction info {sender_faction_tag}'><gray>{sender_faction_tag_colored}</gray></click></hover> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>"
              ],
              "without-faction": [
                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '></click></hover></gray> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>"
              ]
            },
            "member": {
              "with-faction": [
                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '></click></hover></gray> <hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/faction info {sender_faction_tag}'><gray>{sender_faction_tag_colored}</gray></click></hover> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>"
              ],
              "without-faction": [
                "<gray><hover:show_text:'<dark_gray>Chat global</dark_gray>'><click:suggest_command:'/g '></click></hover></gray> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <gray>{chat_message}</gray>"
              ]
            }
          }
        },
        "local": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada no chat"
            }
          },
          "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
          "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
          "chat-locked": "O chat local está desabilitado!",
          "dont-have-requirements": "Você precisa de nível de conta {required_account_level} para enviar uma mensagem no chat local!",
          "without-receivers": "<red>Parece que você está sozinho aqui :(</red>",
          "message": {
            "staff": {
              "with-faction": [
                "",
                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'></hover></yellow> <hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/faction info {sender_faction_tag}'><gray>{sender_faction_tag_colored}</gray></click></hover> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>",
                ""
              ],
              "without-faction": [
                "",
                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'></hover></yellow> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>",
                ""
              ]
            },
            "vip": {
              "with-faction": [
                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'></hover></yellow> <hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/faction info {sender_faction_tag}'><gray>{sender_faction_tag_colored}</gray></click></hover> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>"
              ],
              "without-faction": [
                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'></hover></yellow> <white>{sender_rank_emblem}</white> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>"
              ]
            },
            "member": {
              "with-faction": [
                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'></hover></yellow> <hover:show_text:'<yellow>Clique para ver as informações!</yellow>'><click:suggest_command:'/faction info {sender_faction_tag}'><gray>{sender_faction_tag_colored}</gray></click></hover> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>"
              ],
              "without-faction": [
                "<yellow><hover:show_text:'<dark_gray>Chat local</dark_gray>'></hover></yellow> %currency-coins_top-tag%<white><hover:show_text:'<yellow>Clique para enviar uma mensagem!</yellow>'><click:suggest_command:'/tell {sender_name}'>{sender_name_with_tag}</click></hover></white><white>:</white> <yellow>{chat_message}</yellow>"
              ]
            }
          }
        },
        "toggle-chat": {
          "arguments": {
            "type": {
              "name": "tipo",
              "description": "Tipo do canal que você deseja mudar o status"
            }
          },
          "chat-type-not-found": "Não foi possivel encontrar um chat com esse id",
          "success-locked": "O status do chat {chat_type_name} foi alterado para desabilitado.",
          "success-unlocked": "O status do chat {chat_type_name} foi alterado para habilitado."
        }
      },
      "messages": {
        "chat": {
          "adapters": {
            "plot": "<hover:show_text:'<gray>Clique para teleportar para o terreno do jogador</gray>'><click:suggest_command:'/plot h:{plot_index} {plot_owner_name}'>Ir para o Terreno #{plot_index} de {plot_owner_name}</click></hover>",
            "shop": "<hover:show_text:'<gray>Clique para teleportar para a loja do jogador</gray>'><click:suggest_command:'/lojas {shop_owner_name}'>Ir para a loja de {shop_owner_name}"
          }
        }
      },
      "chat": {
        "preferences": {
          "global": {
            "name": "<yellow>Chat Global",
            "description": [
              "<gray>Receber as mensagens do",
              "<gray>chat global do servidor."
            ],
            "options": {
              "true": "<green>Ativado",
              "false": "<red>Desativado"
            }
          },
          "local": {
            "name": "<yellow>Chat Local",
            "description": [
              "<gray>Receber as mensagens do",
              "<gray>chat local (próximo a você)."
            ],
            "options": {
              "true": "<green>Ativado",
              "false": "<red>Desativado"
            }
          }
        }
      }
    }
  }
}
