{
    "plugins": {
        "server-core": {
            "commands": {
                "growth": {
                    "usage": "<yellow>Use <white>/growth info<yellow>, <white>/growth scan [raio]<yellow> ou <white>/growth stats<yellow>.",
                    "info": {
                        "no-target": "<red>Mire num bloco para ver o crescimento dele.",
                        "not-a-crop": "<red><growth_block_type> não é um cultivo configurado.",
                        "not-tracked": "<red>Este <growth_crop_id> não está sendo acompanhado. Use <white>/growth scan<red> para varrer a chunk.",
                        "excluded": "<red>Este <growth_crop_id> está na região <white><growth_region_id><red>, onde a plantação não cresce.",
                        "tracked": "<yellow><growth_crop_id> <gray>(<growth_crop_type>)<yellow> — próximo estágio em <white><growth_remaining_seconds>s<yellow>, ciclo de <white><growth_min_seconds>s<yellow> a <white><growth_max_seconds>s<yellow>."
                    },
                    "scan": {
                        "unavailable": "<red>Esta chunk não está sendo acompanhada pelo módulo de crescimento.",
                        "queued": "<green>Chunk <white><growth_chunk_x>, <growth_chunk_z><green> na fila de varredura.",
                        "queued-radius": "<green><white><growth_chunk_count><green> chunks num raio de <white><growth_scan_radius><green> na fila de varredura."
                    },
                    "stats": "<yellow>Crescimento: <white><growth_tracked_crops><yellow> plantas em <white><growth_loaded_chunks><yellow> chunks, <white><growth_registered_crops><yellow> cultivos configurados, <white><growth_discovery_queue><yellow> chunks na fila de varredura, <white><growth_excluded_regions><yellow> regiões bloqueadas."
                }
            }
        }
    }
}
