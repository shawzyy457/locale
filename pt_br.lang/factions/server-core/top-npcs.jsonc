{
  "plugins": {
    "server-core": {
      "top-npcs": {
        "coins": {
          "hologram": [
            "<gradient:#7ABAFF:#9FE2FF:#7ABAFF><bold> COINS TOP{position} </bold></gradient>",
            "{player}",
            "<gray>Coins:</gray>  <color:#fbca15>{amount}</color>"
          ]
        },
        "faction-points": {
          "hologram": [
            "<bold> <white>{position}º <gradient:#7ABAFF:#9FE2FF:#7ABAFF>[{faction_tag}] {faction_name}",
            "<white>Pontos: <gray>{points}</gray>",
            "<white>Líder: {leader}"
          ]
        }
      }
    }
  }
}
