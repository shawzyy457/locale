{
  "plugins": {
    "pets": {
      "rarities": {
        "common": {
          "name": "<white></white>"
        },
        "rare": {
          "name": "<white></white>"
        },
        "epic": {
          "name": "<white></white>"
        },
        "legendary": {
          "name": "<white></white>"
        },
        "divine": {
          "name": "<white></white>"
        }
      },
      "preferences": {
        "visibility": {
          "name": "<yellow>Visibilidade de pets",
          "description": [
            "<gray>Controla quais pets",
            "<gray>você enxerga no mundo."
          ],
          "options": {
            "all": "<green>Todos",
            "own": "<yellow>Só os meus",
            "none": "<red>Ninguém"
          }
        }
      },
      "types": {
        "morcego": {
          "name": "Morcego",
          "description": [
            "<gray>Aumenta em <white>{pet_chance}%</white> a chance</gray>",
            "<gray>de ativar <white>sangramento.",
            "",
            "{pet_rarity_color} Evolução:",
            " {pet_rarity_color}✘<white> Próx. Nível: <gray><strikethrough>{pet_chance}%</strikethrough> <dark_gray>▸ <white>{pet_next_chance}%",
            " {pet_rarity_color}◇<white> Nível 3: <gray>+1s Sangramento"
          ],
          "divine-description": [
            "<red> Forma divina: <gray>sangramento",
            "<gray> drasticamente ampliado."
          ]
        },
        "lobo": {
          "name": "Lobo",
          "description": [
            "<gray>Aumenta em <white>{pet_chance}%</white> a chance</gray>",
            "<gray>de ativar <white>sangramento.",
            "",
            "{pet_rarity_color} Evolução:",
            " {pet_rarity_color}✘<white> Próx. Nível: <gray><strikethrough>{pet_chance}%</strikethrough> <dark_gray>▸ <white>{pet_next_chance}%",
            " {pet_rarity_color}◇<white> Nível 4: <gray>+1s sangramento"
          ]
        },
        "piglin_bruto": {
          "name": "Piglin",
          "description": [
            "<gray>Aumenta em <white>{pet_chance}%</white> a chance</gray>",
            "<gray>de ativar <white>quebra.",
            "",
            "{pet_rarity_color} Evolução:",
            " {pet_rarity_color}✘<white> Próx. Nível: <gray><strikethrough>{pet_chance}%</strikethrough> <dark_gray>▸ <white>{pet_next_chance}%",
            " {pet_rarity_color}◇<white> Nível 5: <gray>+1 dano Quebra"
          ],
          "divine-description": [
            "<red> Forma divina: <gray>quebra",
            "<gray> adicional no auge."
          ]
        },
        "hoglin": {
          "name": "Hoglin",
          "description": [
            "<gray>Aumenta em <white>{pet_chance}%</white> a chance</gray>",
            "<gray>de ativar <white>quebra.",
            "",
            "{pet_rarity_color} Evolução:",
            " {pet_rarity_color}✘<white> Próx. Nível: <gray><strikethrough>{pet_chance}%</strikethrough> <dark_gray>▸ <white>{pet_next_chance}%",
            " {pet_rarity_color}◇<white> Nível 5: <gray>+1 dano Quebra"
          ]
        },
        "traca": {
          "name": "Traça",
          "description": [
            "<gray>Aumenta em <white>{pet_chance}%</white> a chance</gray>",
            "<gray>de ativar <white>quebra sísmica.",
            "",
            "{pet_rarity_color} Evolução:",
            " {pet_rarity_color}✘<white> Próx. Nível: <gray><strikethrough>{pet_chance}%</strikethrough> <dark_gray>▸ <white>{pet_next_chance}%",
            " {pet_rarity_color}◇<white> Nível 5: <gray>+1 bloco de quebra"
          ],
          "divine-description": [
            "<red> Forma divina: <gray>ao ativar a",
