          },
          "0": {
            "selected": [
              "",
              "{pet_rarity_color}Botão esquerdo <dark_gray>➟ </dark_gray><white>Desequipar</white>",
              "{pet_rarity_color}Botão direito <dark_gray>➟ </dark_gray><white>Recolher</white>"
            ],
            "unselected": [
              "",
              "{pet_rarity_color}Botão esquerdo <dark_gray>➟ </dark_gray><white>Equipar</white>",
              "{pet_rarity_color}Botão direito <dark_gray>➟ </dark_gray><white>Recolher</white>"
            ]
          }
        },
        "pet-server-select": {
          "title": "Pets por servidor",
          "items": {
            "spawn": {
              "name": "<gradient:#03C400:#04FF00>Overworld",
              "lore": [
                "<gray>Selecione o pet que ficará</gray>",
                "<gray>ativo no servidor do mundo</gray>",
                "<gray>normal.</gray>"
              ]
            },
            "mining": {
              "name": "<gradient:#161616:#797979>Cavernas",
              "lore": [
                "<gray>Selecione o pet que ficará</gray>",
                "<gray>ativo nas cavernas."
              ]
            },
            "amethyst": {
              "name": "<gradient:#a855f7:#6366f1>Mina de Ametista",
              "lore": [
                "<gray>Selecione o pet que ficará</gray>",
                "<gray>ativo na mina de Ametista.</gray>"
              ]
            },
            "ice": {
              "name": "<gradient:#8FD9FF:#E8F9FF>Mina de Glacite",
              "lore": [
                "<gray>Selecione o pet que ficará</gray>",
                "<gray>ativo na mina de Glacite.</gray>"
              ]
            },
            "bone": {
              "name": "<yellow>Central de Pets</yellow>",
              "lore": [
                "<gray>Gerencie os pets ativos</gray>",
                "<gray>em cada servidor.</gray>"
              ]
            },
            "empty-pet": {
              "name": "<gray>Nenhum pet equipado</gray>",
              "lore": [
                "<dark_gray>▸ </dark_gray><white>Clique para escolher.</white>"
              ]
            },
            "pet": {
              "lore": [
                "",
                "{pet_rarity_color}Raridade: {pet_rarity_name}",
                "{pet_rarity_color}Nível: <gray>{pet_level}</gray>",
                "",
                "<dark_gray>▸ </dark_gray><white>Clique para escolher.</white>"
              ]
            }
          }
        }
      },
      "npc": {
        "hologram": [
          "<gradient:#00acff:#00f2ff><bold>Pet",
          "<white>Clique para evoluir!"
        ]
      }
