      "commands": {
        "cosmetics": {
          "admin": {
            "arguments": {
              "action": {
                "name": "ação",
                "description": "list/unlock/unlockall/activate/deactivate/status"
              },
              "target": {
                "name": "jogador",
                "description": "Nome do jogador"
              },
              "value": {
                "name": "valor",
                "description": "ID do cosmético ou tipo"
              }
            },
            "errors": {
              "player-not-found": "<red>Jogador não encontrado.</red>"
            },
            "list": {
              "usage": "<red>Uso: /cosmetics admin list <jogador></red>",
              "header": "<yellow>═══ Cosméticos de {target} ═══</yellow>",
              "type-header": "<yellow>▸ {type}:</yellow>",
              "status": {
                "active": "<yellow>[ATIVO]</yellow>",
                "unlocked": "<aqua>[DESBLOQUEADO]</aqua>",
                "locked": "<red>[BLOQUEADO]</red>"
              },
              "cosmetic": "  <gray>- {id}: {name} ({rarity}) {status}</gray>"
            },
            "unlock": {
              "usage": "<red>Uso: /cosmetics admin unlock <jogador> <id></red>",
              "not-found": "<red>Cosmético '{id}' não encontrado.</red>",
              "already-unlocked": "<red>Cosmético '{id}' já está desbloqueado para {target}.</red>",
              "success": "<yellow>Cosmético '{cosmetic}' desbloqueado para {target}!</yellow>",
              "failed": "<red>Falha ao desbloquear o cosmético.</red>"
            },
            "unlockall": {
              "usage": "<red>Uso: /cosmetics admin unlockall <jogador></red>",
              "success": "<yellow>{count} cosméticos desbloqueados para {target}!</yellow>"
            },
            "activate": {
              "usage": "<red>Uso: /cosmetics admin activate <jogador> <id></red>",
              "not-found": "<red>Cosmético '{id}' não encontrado.</red>",
              "not-unlocked": "<red>Cosmético '{id}' não está desbloqueado para {target}.</red>",
              "success": "<yellow>Cosmético '{cosmetic}' ({type}) ativado para {target}!</yellow>",
              "failed": "<red>Falha ao ativar o cosmético.</red>"
            },
            "deactivate": {
              "usage": "<red>Uso: /cosmetics admin deactivate <jogador> <tipo></red>",
              "invalid-type": "<red>Tipo '{type}' inválido. Use: DEATH_PARTICLE, TRAIL_PARTICLE, AURA_PARTICLE, ARROW_PARTICLE</red>",
              "success": "<yellow>Cosmético do tipo '{type}' desativado para {target}!</yellow>"
            },
            "status": {
              "usage": "<red>Uso: /cosmetics admin status <jogador></red>",
              "header": "<yellow>═══ Status de {target} ═══</yellow>",
              "unlocked-count": "<gray>Cosméticos desbloqueados: {count}</gray>",
              "active-cosmetic": "<gray>{type}: {cosmetic}</gray>",
              "none": "<gray>{type}: Nenhum</gray>"
            }
          }
        }
      },
      "messages": {
        "skin-removed": "<yellow>Skin removida com sucesso!</yellow>",
        "skin-locked": "<red>Você não tem acesso a esta skin! Requer: {cosmetic_skin_required_group}</red>",
        "skin-selected": "<yellow>Skin <white>{cosmetic_skin_name}</white> selecionada!</yellow>",
        "trim-removed": "<yellow>Trim removido com sucesso!</yellow>",
        "trim-pattern-locked": "<red>Você não tem acesso a este padrão! Requer: {cosmetic_trim_pattern_required_group}</red>",
        "trim-pattern-selected": "<yellow>Padrão <white>{cosmetic_trim_pattern_name}</white> selecionado! Agora escolha a cor.</yellow>",
        "trim-material-locked": "<red>Você não tem acesso a esta cor! Requer: {cosmetic_trim_material_required_group}</red>",
        "trim-material-selected": "<yellow>Trim aplicado: <white>{cosmetic_trim_pattern_name}</white> + <white>{cosmetic_trim_material_name}</white>!</yellow>",
        "particle-removed": "<yellow>Partícula removida com sucesso!</yellow>",
        "particle-locked": "<red>Você não desbloqueou este cosmético! Custo: {cosmetic_rarity}</red>",
        "particle-group-locked": "<red>Você não tem acesso a este cosmético! Requer: {cosmetic_required_group}</red>",
        "particle-selected": "<yellow>Partícula <white>{cosmetic_name}</white> selecionada!</yellow>",
        "preview-started": "<yellow>Mostrando <white>{cosmetic_name}</white> em instantes...</yellow>",
        "purchase": {
          "success": "<yellow>Você comprou <white>{cosmetic_name}</white> por <gold>{cosmetic_price} gold</gold>!</yellow>",
          "failed": "<red>Ocorreu um erro ao processar a compra. Tente novamente.</red>",
          "cancelled": "<gray>Compra cancelada.</gray>",
          "insufficient-gold": "<red>Você não tem gold suficiente!",
          "already-owned": "<red>Você já possui este cosmético!</red>"
        },
        "refund": {
          "success": "<yellow>Reembolso realizado! Você recebeu <gold>{cosmetic_price} gold</gold> de volta.</yellow>",
          "failed": "<red>Ocorreu um erro ao processar o reembolso. Tente novamente.</red>",
          "cancelled": "<gray>Reembolso cancelado.</gray>",
          "expired": "<red>O período de reembolso expirou! Você só pode reembolsar dentro de 1 hora após a compra.</red>"
        }
      },
