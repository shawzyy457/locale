{
  "plugins": {
    "events": {
      "arena-loot": {
        "chat-start": [
          "",
          " <gradient:#f7b733:#fc4a1a>⚡ <bold>Baús Trancados",
          " <gray>Baús misteriosos apareceram na arena.",
          "",
          " <gradient:#f7b733:#fc4a1a>▶ <white>Vida por baú: <white></white><color:#F22F46>1000",
          " <gradient:#f7b733:#fc4a1a>▶ <white>Duração: <gray>30 minutos",
          "",
          " <gradient:#f7b733:#fc4a1a><click:run_command:'/arena'>Clique <hover:show_text:'<gray>Clique para participar do evento. <white>[Evento ocorre na Arena]'><bold>AQUI</bold></hover> para entrar no evento!</click>",
          ""
        ],
        "chat-end": [
          "",
          " <gradient:#f7b733:#fc4a1a>⚡ <bold>Baús Trancados",
          " <gray>Os baús trancados desapareceram da arena.</gray>",
          "",
          " <gradient:#f7b733:#fc4a1a>Mais eventos surgirão em breve. Aguarde!",
          ""
        ],
        "bossbar": [
          "<gradient:#f7b733:#fc4a1a>🗡 <bold>Baú trancado ativo! </bold><white>Duração: <color:#BDC3C7>{time}"
        ],
        "chest-name": [
            "<gradient:#f7b733:#fc4a1a><bold>🔒 baú trancado! <gray><red></bold><bold>{chest_health}</bold><white></white><white>/<red><bold>{chest_max_health}</bold><white></white>"
        ]
      
      },
      "preferences": {
        "arena-loot-global": {
          "name": "<gradient:#f7b733:#fc4a1a>Evento de Baus (Arena)</gradient>",
          "description": [
            "<gray>Receba avisos globais do evento.</gray>",
            "<gray>Se desativado, so aparece no spawn.</gray>"
          ],
          "options": {
            "true": "<green>Ativado",
            "false": "<red>Desativado"
          }
        }
      },
      "commands": {
        "events": {
          "force": {
            "usage": "<dark_gray>[ADM] <red>Uso: /eventos force <evento>.",
            "target-missing": "<dark_gray>[ADM] <red>Mire em um bloco válido para forçar o evento.</red>",
            "requires-mine": "<dark_gray>[ADM] <red>Você precisa estar na mina, mirando um local, para forçar </red><white>{event}</white><red>.</red>",
            "failed": "<dark_gray>[ADM] <red>Não foi possível forçar:</red> <white>{event}</white><red>.</red>",
            "no-server": "<dark_gray>[ADM] <red>Nenhum servidor responsável por </red><white>{event}</white><red> está disponível no momento.</red>",
            "timeout": "<dark_gray>[ADM] <red>O servidor responsável por </red><white>{event}</white><red> não respondeu a tempo.</red>",
            "sniffer": "<dark_gray>[ADM] <green>Evento - Farejador Congelado forçado com sucesso.",
            "lost-chest": "<dark_gray>[ADM] <green>Evento - Pote Perdido forçado com sucesso.",
            "arena-loot": {
              "started": "<dark_gray>[ADM] <green>Evento - Baús da Arena iniciado com sucesso.",
              "already-active": "<dark_gray>ADM] <red>Já existe um evento de Baús da Arena em andamento."
            },
            "ore-vein-global": {
              "started": "<dark_gray>[ADM] <green>Evento - Jazida Global gerada com sucesso"
            },
            "core-lair": {
              "started": "<dark_gray>[ADM] <green>Evento - Covil de Núcleo iniciado com sucesso.",
              "already-active": "<dark_gray>[ADM] <red>Já existe um <bold>Covil de Núcleo</bold> em andamento."
            },
            "amethyst-order": {
              "started": "<dark_gray>[ADM] <green>Evento - Encomenda de Ametistas iniciado com sucesso.",
              "already-active": "<dark_gray>[ADM] <red>Já existe um evento da <bold>Mina de Ametista</bold> em andamento."
            },
            "joint-mining": {
              "started": "<dark_gray>[ADM] <green>Evento - Mineração Conjunta iniciado com sucesso.",
              "already-active": "<dark_gray>[ADM] <red>Já existe um evento da <bold>Mina de Ametista</bold> em andamento."
            },
            "spider-lair": {
              "started": "<dark_gray>[ADM] <green>Evento - Covil de Aranhas iniciado com sucesso.",
              "already-active": "<dark_gray>[ADM] <red>Já existe um evento da <bold>Mina de Ametista</bold> em andamento."
            }
          },
          "stop": {
            "usage": "<dark_gray>[ADM] <red>Uso:</red> <white>/eventos stop</white> <gray><evento></gray>",
            "requires-mine": "<dark_gray>[ADM] <red>Você precisa estar na mina para cancelar </red><white>{event}</white><red>.</red>",
            "failed": "<dark_gray>[ADM] <red>Não foi possível cacenlar:</red> <white>{event}</white><red>.</red>",
            "no-server": "<dark_gray>[ADM] <red>Nenhum servidor responsável por </red><white>{event}</white><red> está disponível no momento.</red>",
            "timeout": "<dark_gray>[ADM] <red>O servidor responsável por </red><white>{event}</white><red> não respondeu a tempo.</red>",
            "sniffer": "<dark_gray>[ADM] <red>Evento Farejadores Congelados removidos.",
            "lost-chest": "<dark_gray>[ADM] <red>Evento Pote Perdido interrompido.",
            "arena-loot": {
              "stopped": "<dark_gray>[ADM] <red>Evento Baús da Arena interrompidos.",
              "not-active": "<dark_gray>[ADM] <red>Não há evento de <bold>Baús da Arena</bold> em andamento."
            },
            "arena-loot-clean": {
              "cleaned": "<dark_gray>[ADM] <green>Evento - Baús da Arena limpeza concluída (</gray><white>{amount}</white><gray> entidades).</gray>",
              "nothing": "<red>Nenhum baú da arena para limpar.</red>"
            },
            "ore-vein-global": {
              "stopped": "<dark_gray>[ADM] <red>Jazida Global interrompida <gray>(strays removidos)<red>.",
              "not-active": "<dark_gray>[ADM] <red>Não há Jazida Global<red> ativa.</red>"
            },
            "core-lair": {
              "stopped": "<dark_gray>[ADM] <red>Covil de Núcleo interrompido.",
              "not-active": "<dark_gray>[ADM] <red>Não há Covil de Núcleo em andamento."
            },
            "amethyst-order": {
              "stopped": "<dark_gray>[ADM] <red>Evento Encomenda de Ametistas interrompido.",
              "not-active": "<dark_gray>[ADM] <red>Não há <bold>Encomenda de Ametistas</bold> em andamento."
            },
            "joint-mining": {
              "stopped": "<dark_gray>[ADM] <red>Evento Mineração Conjunta interrompido.",
              "not-active": "<dark_gray>[ADM] <red>Não há <bold>Mineração Conjunta</bold> em andamento."
            },
            "spider-lair": {
              "stopped": "<dark_gray>[ADM] <red>Evento Covil de Aranhas interrompido.",
              "not-active": "<dark_gray>[ADM] <red>Não há <bold>Covil de Aranhas</bold> em andamento."
