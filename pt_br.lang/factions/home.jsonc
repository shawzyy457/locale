{
  "plugins": {
    "homes": {
      "commands": {
        "home": {
          "arguments": {
            "name": {
              "name": "nome",
              "description": "Nome da home que você deseja teleportar"
            },
            "player": {
              "name": "jogador",
              "description": "Nome do jogador dono da home"
            }
          },
          "errors": {
            "cooldown": "<red>Aguarde antes de teleportar novamente.</red>",
            "teleport-pending": "<red>Você já possui um teleporte em andamento.</red>",
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>",
            "not-public": "<red>Esta home não é pública.</red>",
            "app-not-available": "<red>O servidor de destino não está disponível.</red>",
            "teleport-cancelled-move": "<red>Teleporte cancelado! Você se moveu.</red>"
          },
          "on-teleport-countdown": "<yellow>Teleportando em <white>{home_seconds}s</white>...</yellow>"
        },
        "homes": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Nome do jogador cujas homes públicas você deseja ver"
            }
          },
          "errors": {
            "no-homes": "<red>O jogador {target_name_with_tag} não possui nenhuma home.</red>"
          },
          "list": "<green>Homes de {target_name_with_tag}:</green> <gray>{homes}</gray>"
        },
        "sethome": {
          "arguments": {
            "name": {
              "name": "nome",
              "description": "Nome que você deseja dar para sua home"
            }
          },
          "errors": {
            "limit-reached": "<red>Você atingiu o limite de homes.</red>",
            "name-too-long": "<red>O nome da home deve ter no máximo 24 caracteres.</red>",
            "invalid-characters": "<red>O nome da home contém caracteres inválidos.</red>",
            "already-exists": "<red>Você já possui uma home com o nome <yellow>{home_name}</yellow>.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> criada com sucesso!</green>"
        },
        "delhome": {
          "arguments": {
            "home": {
              "name": "home",
              "description": "Nome da home que você deseja deletar"
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home}</yellow> não encontrada.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> deletada com sucesso!</green>"
        },
        "public": {
          "arguments": {
            "home": {
              "name": "home",
              "description": "Nome da home que você deseja tornar pública"
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>",
            "already-public": "<red>A home <yellow>{home_name}</yellow> já é pública.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> agora é pública!</green>"
        },
        "private": {
          "arguments": {
            "home": {
              "name": "home",
              "description": "Nome da home que você deseja tornar privada"
            }
          },
          "errors": {
            "not-found": "<red>Home <yellow>{home_name}</yellow> não encontrada.</red>",
            "already-private": "<red>A home <yellow>{home_name}</yellow> já é privada.</red>"
          },
          "success": "<green>Home <yellow>{home_name}</yellow> agora é privada!</green>"
        }
      },
      "views": {
        "list": {
          "title": "Suas Homes",
          "items": {
            "empty": {
              "name": "<color:#3ef7aa>Slot disponível</color>",
              "lore": [
                "<gray>Este slot está disponível para</gray>",
                "<gray>você criar uma nova home.</gray>",
                "",
                "<color:#3ef7aa>Use /sethome para criar.</color>"
              ]
            },
            "empty-unavailable": {
              "name": "<red>Slot bloqueado</red>",
              "lore": [
                "<gray>Este slot está bloqueado.</gray>",
                "",
                " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{slot_position}</gray>",
                " <dark_gray>▸</dark_gray> <white>Grupo necessário:</white> <gray>{required_group}</gray>",
                "",
                "<red>Adquira um grupo para desbloquear.</red>"
              ]
            },
            "home": {
              "published": {
                "name": "<color:#3ef7aa>{home_name}</color>",
                "lore": [
                  "",
                  " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{home_position}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Estado:</white> <color:#3ef7aa>Pública</color>",
                  "",
                  "<color:#3ef7aa>Clique para gerenciar.</color>"
                ]
              },
              "not-published": {
                "name": "<yellow>{home_name}</yellow>",
                "lore": [
                  "",
                  " <dark_gray>▸</dark_gray> <white>Posição:</white> <gray>{home_position}</gray>",
                  " <dark_gray>▸</dark_gray> <white>Estado:</white> <red>Privada</red>",
                  "",
                  "<yellow>Clique para gerenciar.</yellow>"
                ]
              }
            }
          }
        },
        "action": {
          "title": "Home: {home_name}",
          "items": {
            "icon": {
              "name": "<color:#3ef7aa>Ícone da Home</color>",
              "lore": [
                "<gray>Este é o ícone atual da home.</gray>",
                "",
                "<color:#3ef7aa>Clique em um item para alterar.</color>"
              ]
            },
            "move": {
              "name": "<color:#3ef7aa>Mover posição</color>",
              "lore": [
                "",
                " <dark_gray>▸</dark_gray> <white>Posição atual:</white> <gray>{home_position}</gray>",
                "",
                "<color:#3ef7aa>Botão esquerdo:<white>Avançar posição</white>",
                "<color:#3ef7aa>Botão direito: <white>Voltar posição</white>"
              ]
            },
            "publish": {
              "published": {
                "name": "<color:#3ef7aa>Home pública</color>",
                "lore": [
                  "<gray>Sua home está visível para</gray>",
                  "<gray>outros jogadores.</gray>",
                  "",
                  "<color:#3ef7aa>Clique para tornar privada.</color>"
                ]
              },
              "not-published": {
                "name": "<red>Home privada</red>",
                "lore": [
                  "<gray>Sua home está oculta para</gray>",
                  "<gray>outros jogadores.</gray>",
                  "",
                  "<red>Clique para tornar pública.</red>"
                ]
              }
            },
            "delete": {
              "name": "<red>Deletar home</red>",
              "lore": [
                "<gray>Remove permanentemente esta home.</gray>",
                "",
                "<red>Clique para deletar.</red>"
              ]
            }
          }
        }
      },
      "messages": {
        "teleport-cancelled-damage": "<red>Teleporte cancelado! Você levou dano.</red>",
        "views": {
          "action": {
            "icon-update": {
              "success": "<green>Ícone da home <white>{home_name}</white> atualizado!</green>"
            },
            "position-moved": {
              "success": "<green>Home <white>{home_name}</white> movida para a posição <yellow>{home_position}</yellow>!</green>"
            },
            "home-published": {
              "success": "<green>Home <white>{home_name}</white> agora é pública!</green>"
            },
            "home-unpublished": {
              "success": "<green>Home <white>{home_name}</white> agora é privada!</green>"
            },
            "home-deleted": {
              "success": "<green>Home <white>{home_name}</white> deletada com sucesso!</green>"
            }
          }
        }
      }
    }
  }
}