                "<gray>do servidor.</gray>",
                "",
                "<color:#ff8200>Clique para visualizar."
              ]
            }
          }
        },
        "member-invites": {
          "title": "Convites",
          "items": {
            "0": {
              "name": "<green>Convite de [{faction_tag}] {faction_name}</green>",
              "lore": [
                "<gray>Botão esquerdo: </gray><white>Entrar na facção</white>",
                "<gray>Botão direito: </gray><white>Negar convite</white>"
              ]
            }
          }
        },
        "member-leave-confirmation": {
          "title": "Deseja mesmo sair?",
          "items": {}
        },
        "faction-levels": {
          "title": "[{faction_tag}] Níveis",
          "status": {
            "completed": [
              "",
              "<green>✔ Nível concluído.</green>"
            ],
            "current": [
              "",
              "<yellow>Pontos:</yellow> <white>{level_points_current}</white><gray>/</gray><white>{level_points_required}</white>",
              "<yellow>Progresso:</yellow> {level_progress_bar} <gray>{level_progress_percent}%</gray>"
            ],
            "locked": [
              "",
              "<yellow>Pontos:</yellow> <white>{level_points_current}</white><gray>/</gray><white>{level_points_required}</white>",
              "<yellow>Progresso:</yellow> {level_progress_bar} <gray>{level_progress_percent}%</gray>"
            ],
            "max": [
              "",
              "<green>✔ Nível máximo alcançado.</green>",
              "<yellow>Pontos:</yellow> <white>{level_points}</white>",
              "<gray>Dispute o topo em </gray><yellow>/f top</yellow><gray>.</gray>"
            ]
          },
          "items": {
            "info": {
              "name": "<gold>Sobre os pontos...</gold>",
              "lore": [
                "<gray>Os pontos são um sistema sem</gray>",
                "<gray>limite, você nunca vai parar</gray>",
                "<gray>de os acumular, como se fosse</gray>",
                "<gray>o XP da facção.</gray>",
                "",
                "<yellow>Como ganhar pontos?</yellow>",
                " <dark_gray>◇ </dark_gray><gray>Eliminando criaturas;</gray>",
                " <dark_gray>◇ </dark_gray><gray>Invadindo bases;</gray>",
                " <dark_gray>◇ </dark_gray><gray>Defendendo a sua base.</gray>",
                "",
                "<yellow>Subida de níveis</yellow>",
                "<gray>No fundo, para subir de nível</gray>",
                "<gray>só é preciso acumular pontos.</gray>",
                "",
                "<yellow>Cheguei no nível máximo, e agora?</yellow>",
                "<gray>Os pontos acumulam infinitamente</gray>",
                "<gray>e você disputa pelo topo em</gray>",
                "<yellow>/f top</yellow> <gray>de pontos.</gray>"
              ]
            },
            "1": {
              "name": "<yellow>Nível 1</yellow>",
              "lore": [
                "<gray>Ganhe pontos para evoluir</gray>",
                "<gray>o nível da sua facção.</gray>",
                "",
                "<yellow>Benefícios:</yellow>",
                " <dark_gray>▸ </dark_gray><gray>Gerador de Cabra</gray>",
                "{level_status}"
              ]
            },
            "2": {
              "name": "<yellow>Nível 2</yellow>",
              "lore": [
                "<gray>Ganhe pontos para evoluir</gray>",
                "<gray>o nível da sua facção.</gray>",
                "",
                "<yellow>Benefícios:</yellow>",
                " <dark_gray>▸ </dark_gray><gray>Gerador de Slime</gray>",
                "{level_status}"
              ]
            },
            "3": {
              "name": "<yellow>Nível 3</yellow>",
              "lore": [
                "<gray>Ganhe pontos para evoluir</gray>",
                "<gray>o nível da sua facção.</gray>",
                "",
                "<yellow>Benefícios:</yellow>",
                " <dark_gray>▸ </dark_gray><gray>Gerador de Bruxa</gray>",
                " <dark_gray>▸ </dark_gray><gray>Gerador de Breeze</gray>",
                "{level_status}"
              ]
            },
            "4": {
              "name": "<yellow>Nível 4</yellow>",
              "lore": [
                "<gray>Ganhe pontos para evoluir</gray>",
                "<gray>o nível da sua facção.</gray>",
                "",
                "<yellow>Benefícios:</yellow>",
                " <dark_gray>▸ </dark_gray><gray>Gerador de Urso Polar</gray>",
                "{level_status}"
              ]
            },
            "5": {
              "name": "<yellow>Nível 5</yellow>",
              "lore": [
                "<gray>Ganhe pontos para evoluir</gray>",
                "<gray>o nível da sua facção.</gray>",
                "",
                "<yellow>Benefícios:</yellow>",
                " <dark_gray>▸ </dark_gray><gray>Gerador de Golem de Ferro</gray>",
                " <dark_gray>▸ </dark_gray><gray>Invade facções de qualquer nível</gray>",
                "{level_status}"
              ]
            }
          }
        },
        "faction-spawners-list": {
          "title": "[{faction_tag}] Geradores",
          "items": {
            "spawner": {
              "name": "<yellow>{spawner_name}</yellow>",
              "lore": [
                " <dark_gray>▸ </dark_gray><white>Quantidade:</white> <gray>{spawner_count}</gray>",
                " <dark_gray>▸ </dark_gray><white>Preço unitário:</white> <gray>${spawner_price}</gray>",
                " <dark_gray>▸ </dark_gray><white>Valor total:</white> <gray>${spawner_total_value}</gray>"
              ]
            },
            "empty": {
              "name": "<red>Nenhum gerador</red>",
              "lore": [
                "<gray>Esta facção não possui geradores.</gray>"
              ]
            },
            "logs": {
              "name": "<yellow>Logs do Armazém</yellow>",
              "lore": [
                "<gray>Veja o histórico de depósitos</gray>",
                "<gray>e retiradas do armazém.</gray>",
                "",
                "<yellow>Clique para visualizar.</yellow>"
              ]
            },
            "storage-all": {
              "name": "<gold>Armazenar tudo</gold>",
              "lore": [
                "<gray>Envie todos os geradores</gray>",
                "<gray>do inventário para o armazém.</gray>",
                "",
                "<gold>Clique para armazenar.</gold>"
              ]
            }
          }
        },
        "faction-role-permissions": {
          "title": "[{faction_tag}] - Permissões: {role_name}"
        },
        "faction-select-role-permissions": {
          "title": "[{faction_tag}] - Selecione um Cargo",
          "items": {
            "role": {
              "name": "<yellow>{role_name}</yellow>",
              "lore": [
                "<gray>Prefixo:</gray> <white>{role_prefix}</white>",
                "",
                "<green>Clique para gerenciar.</green>"
              ]
            }
          }
        },
        "faction-ranking": {
          "title": "Ranking de Facções",
          "coordinates": [
            "",
            "<color:#ff8200>Localização:</color>",
            " <dark_gray>▸ </dark_gray><white>Mundo:</white> <gray>{ranking_coordinates_world}</gray>",
            " <dark_gray>▸ </dark_gray><white>X:</white> <gray>{ranking_coordinates_x}</gray>",
            " <dark_gray>▸ </dark_gray><white>Z:</white> <gray>{ranking_coordinates_z}</gray>"
          ],
          "categories": {
            "selected": {
              "name": "<color:#3ef7aa>► {faction_ranking_type_name} ◄</color>",
              "lore": [
                "{faction_ranking_type_description}",
                "",
                "<color:#3ef7aa>Selecionado!</color>"
              ]
            },
            "unselected": {
              "name": "<color:#ff8200>{faction_ranking_type_name}</color>",
              "lore": [
                "{faction_ranking_type_description}",
                "",
                "<color:#ff8200>Clique para visualizar.</color>"
              ]
            }
          },
          "items": {
            "spawner-entry": {
              "name": "{ranking_position_color}#{ranking_position} <color:#ff8200>[{ranking_faction_tag}] {ranking_faction_name}</color>",
              "lore": [
                "<color:#ff8200>Informações:</color>",
                " <dark_gray>▸ </dark_gray><white>Valor total:</white> <green>$<white>{ranking_value}",
                " <dark_gray>▸ </dark_gray><white>Geradores colocados:</white> <gray>{spawner_placed_count} <white>(<green>$<white>{spawner_placed_value})",
                " <dark_gray>▸ </dark_gray><white>Geradores armazenados:</white> <gray>{spawner_storage_count} <white>(<green>$<white>${spawner_storage_value})</gray>",
                "",
                "<color:#ff8200>Detalhes:</color>",
                "{spawner_details}",
                "{ranking_coordinates}"
              ],
              "detail-format": " <dark_gray>▸ </dark_gray><white>{spawner_name}:</white> <gray>{spawner_count}</gray>"
            },
            "points-entry": {
              "name": "{ranking_position_color}#{ranking_position} <yellow>[{ranking_faction_tag}] {ranking_faction_name}</yellow>",
              "lore": [
                "<yellow>Informações:</yellow>",
                " <dark_gray>▸ </dark_gray><white>Pontos:</white> <gray>{ranking_value}</gray>",
                "{ranking_coordinates}"
              ]
            },
            "coins-entry": {
              "name": "{ranking_position_color}#{ranking_position} <color:#fbca15>[{ranking_faction_tag}] {ranking_faction_name}</color>",
              "lore": [
                "<color:#fbca15>Informações:</color>",
                " <dark_gray>▸ </dark_gray><white>Total de coins:</white> <green>$<white>{ranking_value}",
                " <dark_gray>▸ </dark_gray><white>Membros com coins:</white> <gray>{coins_member_count}</gray>",
                "",
                "<color:#fbca15>Por membro:</color>",
                "{coins_details}",
                "{coins_hidden_members}",
                "{ranking_coordinates}"
              ],
              "detail-format": " <dark_gray>▸ </dark_gray><white>{member_name}:</white> <green>$<white>{member_value}",
              "hidden-members": [
                " <dark_gray>▸ </dark_gray><gray>e mais {member_count} membro(s).</gray>"
              ],
              "unknown-member": "<gray>Desconhecido</gray>"
            },
            "invasion_wins-entry": {
              "name": "{ranking_position_color}#{ranking_position} <yellow>[{ranking_faction_tag}] {ranking_faction_name}</yellow>",
              "lore": [
                "<yellow>Informações:</yellow>",
                " <dark_gray>▸ </dark_gray><white>Vitórias:</white> <gray>{ranking_value}</gray>",
                "{ranking_coordinates}"
              ]
            },
            "general-entry": {
              "name": "{ranking_position_color}#{ranking_position} <yellow>[{ranking_faction_tag}] {ranking_faction_name}</yellow>",
              "lore": [
                "<yellow>Informações:</yellow>",
                " <dark_gray>▸ </dark_gray><white>Pontos gerais:</white> <gray>{ranking_value}</gray>",
                "{ranking_coordinates}"
              ]
            }
          }
        },
        "faction-tax-history": {
          "title": "Histórico de Taxas - [{faction_tag}]",
          "items": {
            "tax": {
              "active": {
                "name": "<yellow>[{faction_tag}] - {created_at}</yellow>",
                "lore": [
                  "<yellow>Informações:</yellow>",
                  " <dark_gray>▸ </dark_gray><white>Staff:</white> <gray>{staff_name_with_tag}</gray>",
                  " <dark_gray>▸ </dark_gray><white>Porcentagem:</white> <gray>{percentage}%</gray>",
                  " <dark_gray>▸ </dark_gray><white>Coins removidos:</white> <gray>{coins_removed}</gray>",
                  " <dark_gray>▸ </dark_gray><white>Geradores removidos:</white> <gray>{spawners_removed}</gray>",
                  "",
                  "<red>Clique para reverter.</red>"
                ]
              },
              "reverted": {
                "name": "<gray>[{faction_tag}] - {created_at}</gray>",
                "lore": [
                  "<yellow>Informações:</yellow>",
                  " <dark_gray>▸ </dark_gray><white>Staff:</white> <gray>{staff_name_with_tag}</gray>",
                  " <dark_gray>▸ </dark_gray><white>Porcentagem:</white> <gray>{percentage}%</gray>",
                  " <dark_gray>▸ </dark_gray><white>Coins removidos:</white> <gray>{coins_removed}</gray>",
                  " <dark_gray>▸ </dark_gray><white>Geradores removidos:</white> <gray>{spawners_removed}</gray>",
                  "",
                  " <dark_gray>▸ </dark_gray><white>Revertido em:</white> <gray>{reverted_at}</gray>",
                  "",
                  "<gray>Esta taxa já foi revertida.</gray>"
                ]
              }
            }
          }
        },
        "faction-tax-revert": {
          "title": "Reverter Taxa?",
          "items": {
            "tax": {
              "name": "<yellow>[{faction_tag}] - {created_at}</yellow>",
              "lore": [
                "<yellow>Informações da taxa:</yellow>",
                " <dark_gray>▸ </dark_gray><white>Staff:</white> <gray>{staff_name_with_tag}</gray>",
                " <dark_gray>▸ </dark_gray><white>Porcentagem:</white> <gray>{percentage}%</gray>",
                " <dark_gray>▸ </dark_gray><white>Coins removidos:</white> <gray>{coins_removed}</gray>",
                " <dark_gray>▸ </dark_gray><white>Geradores removidos:</white> <gray>{spawners_removed}</gray>",
                "",
                "<gray>Ao reverter, os coins serão</gray>",
                "<gray>devolvidos aos jogadores e os</gray>",
                "<gray>geradores ao armazém da facção.</gray>"
              ]
            }
          }
        },
        "faction-tax-apply": {
          "title": "Aplicar Taxa?",
          "items": {
            "info": {
              "name": "<yellow>[{faction_tag}] {faction_name}</yellow>",
              "lore": [
                "<yellow>Informações:</yellow>",
                " <dark_gray>▸ </dark_gray><white>Facção:</white> <gray>[{faction_tag}] {faction_name}</gray>",
                " <dark_gray>▸ </dark_gray><white>Membros:</white> <gray>{members_count}</gray>",
                " <dark_gray>▸ </dark_gray><white>Porcentagem:</white> <gray>{percentage}%</gray>",
                "",
                "<gray>Ao confirmar, {percentage}% dos coins</gray>",
                "<gray>e geradores serão removidos</gray>",
                "<gray>da facção e seus membros.</gray>"
              ]
            }
          }
        }
      }
    }
  }
}