{
  "plugins": {
    "factions": {
      "roles": {
        "leader": {
          "name": "Líder",
          "prefix": ""
        },
        "captain": {
          "name": "Capitão",
          "prefix": ""
        },
        "member": {
          "name": "Membro",
          "prefix": ""
        },
        "recruit": {
          "name": "Recruta",
          "prefix": ""
        },
        "none": {
          "name": "Nenhum",
          "prefix": ""
        }
      },
      "experience": {
        "spawner-kill-gain": "<color:#3ef7aa><bold>+{experience_amount}</bold></color> <white>pontos"
      },
      "ranking": {
        "types": {
          "spawners": {
            "name": "Spawners",
            "description": [
              "<gray>Ranking baseado no valor</gray>",
              "<gray>total de geradores.</gray>"
            ]
          },
          "points": {
            "name": "Pontos",
            "description": [
              "<gray>Ranking baseado nos pontos</gray>",
              "<gray>acumulados pela facção.</gray>"
            ]
          },
          "coins": {
            "name": "Coins",
            "description": [
              "<gray>Ranking baseado na soma das</gray>",
              "<gray>coins de todos os membros.</gray>"
            ]
          },
          "invasion_wins": {
            "name": "Vitórias em Invasão",
            "description": [
              "<gray>Ranking baseado nas vitórias</gray>",
              "<gray>em invasões.</gray>"
            ]
          },
          "general": {
            "name": "Geral",
            "description": [
              "<gray>Ranking geral, somando os pontos</gray>",
              "<gray>da colocação nos demais rankings.</gray>"
            ]
          }
        }
      },
      "storage": {
        "actions": {
          "increment": {
            "name": "Adicionou"
          },
          "decrement": {
            "name": "Removeu"
          }
        }
      },
      "faction-permissions": {
        "icon": {
          "enabled": {
            "name": "<green>{permission_name}</green>",
            "lore": [
              "<gray>{permission_description}</gray>",
              "",
              "<dark_gray>▸ </dark_gray><white>Estado: </white><green>Habilitado</green>",
              "",
              "<red>Clique para desabilitar.</red>"
            ]
          },
          "disabled": {
            "name": "<red>{permission_name}</red>",
            "lore": [
              "<gray>{permission_description}</gray>",
              "",
              "<dark_gray>▸ </dark_gray><white>Estado: </white><red>Desabilitado</red>",
              "",
              "<green>Clique para habilitar.</green>"
            ]
          }
        },
        "open_containers": {
          "name": "Abrir Containers",
          "description": [
            "Permite abrir baús, fornalhas",
            "e outros containers."
          ],
          "action": "abrir containers no território desta facção"
        },
        "break_place_blocks": {
          "name": "Quebrar/Colocar Blocos",
          "description": [
            "Permite quebrar e colocar",
            "blocos no território."
          ],
          "action": "construir no território desta facção"
        },
        "use_home": {
          "name": "Usar Home",
          "description": [
            "Permite usar o comando",
            "/f home para teleportar."
          ],
          "action": "usar a home da facção"
        },
        "accept_tpa": {
          "name": "Aceitar TPA",
          "description": [
            "Permite aceitar solicitações",
            "de teleporte de aliados."
          ],
          "action": "aceitar TPAs na facção"
        },
        "break_spawners": {
          "name": "Quebrar Geradores",
          "description": [
            "Permite quebrar geradores",
            "no território da facção."
          ],
          "action": "quebrar geradores da facção"
        },
        "manage_generator_storage": {
          "name": "Gerenciar Armazém",
          "description": [
            "Permite retirar geradores",
            "do armazém da facção."
          ],
          "action": "retirar do armazém da facção"
        },
        "manage_spawn": {
          "name": "Gerenciar Spawn de Mobs",
          "description": [
            "Permite definir e remover os",
            "pontos de spawn de mobs."
          ],
          "action": "gerenciar os spawns de mobs da facção"
        },
        "manage_beacon": {
          "name": "Gerenciar Sinalizador",
          "description": [
            "Permite colocar, abrir e",
            "remover o sinalizador."
          ],
          "action": "gerenciar o sinalizador da facção"
        },
        "use_interactables": {
          "name": "Usar Interativos",
          "description": [
            "Permite usar botões, alavancas,",
            "portas e outros interativos."
          ],
          "action": "interagir no território desta facção"
        }
      },
      "items": {
        "member-head": {
          "name": "{member_name_with_tag}",
          "lore": [
            "",
            "<color:#3ef7aa>Suas informações:",
            " <dark_gray>▸</dark_gray> <white>Cargo:</white> <gray>{member_role_prefix}{member_role_name}</gray>",
            " <dark_gray>▸</dark_gray> <white>KDR:</white> <gray>{member_stats_kdr}</gray>",
            " <dark_gray>▸</dark_gray> <white>Abates:</white> <gray>{member_stats_deaths}</gray>",
            " <dark_gray>▸</dark_gray> <white>Mortes:</white> <gray>{member_stats_kills}</gray>"
          ]
        },
        "faction-banner": {
          "name": "[{faction_tag}] {faction_name}",
          "lore": [
            "",
            " <color:#3ef7aa>Informações da facção:",
            " <dark_gray>▸</dark_gray> <white>Líder:</white> <gray>{faction_leader_name_with_tag}</gray>",
            " <dark_gray>▸</dark_gray> <white>Membros:</white> <gray>({faction_members_size}/{faction_max_members_size}) {faction_online_members_size} online</gray>",
            " <dark_gray>▸</dark_gray> <white>Nível:</white> <gray>{faction_level}</gray>",
            " <dark_gray>▸</dark_gray> <white>Experiência:</white> <gray>{faction_experience}</gray>",
            " <dark_gray>▸</dark_gray> <white>KDR:</white> <gray>{faction_stats_kdr}</gray>",
            " <dark_gray>▸</dark_gray> <white>Abates:</white> <gray>{faction_stats_deaths}</gray>",
            " <dark_gray>▸</dark_gray> <white>Mortes:</white> <gray>{faction_stats_kills}</gray>"
          ]
        },
        "empty-item": {
          "name": "<red>Vazio!</red>",
          "lore": [
            "<gray>Nada encontrado por aqui :(</gray>"
          ]
        }
      },
      "commands": {
        "restrict": {
          "faction-command-restrict": {
            "error": "<red>Você não faz parte de uma facção.</red>"
          },
          "faction-out-command-restrict": {
            "error": "<red>Você já faz parte de uma facção.</red>"
          }
        },
        "faction": {
          "create": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Defina a tag que você deseja dar a sua facção"
              },
              "name": {
                "name": "nome",
                "description": "Defina o nome que você deseja dar a sua facção"
              }
            },
            "errors": {
              "tag-length": "<red>Você precisa escolher uma tag de 3 caracteres!</red>",
              "name-length": "<red>Você precisa escolher um nome de 5 a 24 caracteres!</red>",
              "invalid-pattern": "<red>Você só pode utilizar letras e numeros para a tag e o nome.</red>",
              "tag-in-use": "<red>Você precisa escolher uma tag que nenhuma outra facção esteja usando!</red>",
              "name-in-use": "<red>Você precisa escolher um nome que nenhuma outra facção esteja usando!</red>"
            },
            "success": "<green>Você criou sua facção com sucesso!</green>"
          },
          "tag": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Nova tag da facção (3 caracteres)"
              }
            },
            "errors": {
              "not-leader": "<red>Apenas o líder da facção pode alterar a tag!</red>",
              "cooldown": "<red>Você precisa esperar <yellow>{time}</yellow> para alterar a tag novamente!</red>",
              "tag-length": "<red>A tag precisa ter exatamente 3 caracteres!</red>",
              "invalid-pattern": "<red>A tag só pode conter letras e números!</red>",
              "tag-in-use": "<red>Esta tag já está sendo utilizada por outra facção!</red>"
            },
            "success": "<green>A tag da sua facção foi alterada para <yellow>[{tag}]</yellow> com sucesso!</green>"
          },
          "name": {
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Novo nome da facção (5 a 24 caracteres)"
              }
            },
            "errors": {
              "not-leader": "<red>Apenas o líder da facção pode alterar o nome!</red>",
              "cooldown": "<red>Você precisa esperar <yellow>{time}</yellow> para alterar o nome novamente!</red>",
              "name-length": "<red>O nome precisa ter entre 5 e 24 caracteres!</red>",
              "invalid-pattern": "<red>O nome só pode conter letras, números e espaços!</red>",
              "name-in-use": "<red>Este nome já está sendo utilizado por outra facção!</red>"
            },
            "success": "<green>O nome da sua facção foi alterado para <yellow>{name}</yellow> com sucesso!</green>"
          },
          "home": {
            "errors": {
              "cooldown": "<red>Aguarde alguns segundos antes de teleportar novamente.</red>",
              "no-home": "<red>Sua facção não possui uma home definida.</red>",
              "server-unavailable": "<red>O servidor onde a home está localizada não está disponível.</red>"
            },
            "success": "<green>Teleportando para a home da facção...</green>"
          },
          "sethome": {
            "errors": {
              "insufficient-role": "<red>Apenas capitães ou superiores podem definir a home da facção.</red>",
              "not-in-territory": "<red>Você precisa estar no território da sua facção para definir a home.</red>"
            },
            "success": "<green>Home da facção definida com sucesso!</green>"
          },
          "delhome": {
            "errors": {
              "insufficient-role": "<red>Apenas capitães ou superiores podem remover a home da facção.</red>",
              "no-home": "<red>Sua facção não possui uma home definida.</red>"
            },
            "success": "<green>Home da facção removida com sucesso!</green>"
          },
          "fly": {
            "errors": {
              "not-in-territory": "<red>Você precisa estar no território da sua facção ou em terreno temporário para voar.</red>",
              "in-combat": "<red>Você não pode voar enquanto está em combate.</red>",
              "invasion-active": "<red>Você não pode voar enquanto sua facção está em invasão.</red>"
            },
            "enabled": "<green>Voo ativado! Você pode voar dentro do território.</green>",
            "disabled": "<green>Voo desativado.</green>",
            "disabled-combat": "<red>Seu voo foi desativado porque você entrou em combate!</red>",
            "disabled-territory": "<red>Seu voo foi desativado porque você saiu do território permitido.</red>",
            "disabled-invasion": "<red>Seu voo foi desativado porque sua facção entrou em invasão!</red>"
          },
          "claim": {
            "not-allowed-out-free-zone": "<red>Você não pode dominar terras fora da zona livre.</red>",
            "already-claimed": "<red>Este terreno já pertence a uma facção.</red>",
            "near-other-faction": "<red>Você não pode dominar terras tão próximas de outra facção.</red>",
            "separate-claims": "<red>Suas terras devem estar conectadas.</red>",
            "success": "<green>Terreno dominado com sucesso!</green>"
          },
          "back": {
            "need-location": "<red>Não há nenhuma localização anterior.</red>"
          },
          "unclaim": {
            "not-allowed-zone": "<red>Você não pode abandonar terras em zonas especiais.</red>",
            "not-your-claim": "<red>Este terreno não pertence à sua facção.</red>",
            "under-attack": "<red>Você não pode abandonar terras enquanto está sob ataque.</red>",
            "has-spawner": "<red>Você não pode abandonar terras que possuem geradores.</red>",
            "split-territory": "<red>Abandonar este terreno dividiria seu território.</red>",
            "success-one": "<green>Terreno abandonado com sucesso!</green>"
          },
          "map": {
            "arguments": {
              "state": {
                "name": "estado",
                "description": "Ativar ou desativar o mapa automático (on/off)"
              }
            },
            "success-auto-map-on": "<green>Mapa automático ativado!</green>",
            "success-auto-map-off": "<green>Mapa automático desativado!</green>"
          },
          "demote": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja rebaixar"
              }
            },
            "errors": {
              "not-same-faction": "<red>Você só pode rebaixar jogadores que estão em sua própria facção!</red>",
              "need-more-role": "<red>Você não tem um cargo alto o suficiente para rebaixar esse jogador!</red>",
              "target-in-lowest-role": "<red>Esse jogador já está no cargo mais baixo!</red>",
              "insufficient-role": "<red>Você não tem permissão para rebaixar membros.</red>"
            },
            "success": "<green>Você rebaixou o jogador {target_name} para {target_role_name} com sucesso!</green>"
          },
          "permissions": {
            "errors": {
              "insufficient-role": "<red>Apenas o líder da facção pode gerenciar permissões.</red>"
            }
          },
          "disband": {
            "errors": {
              "need-leader-role": "<red>Você precisa ser o líder da facção para poder desfaze-lo!</red>"
            }
          },
          "info": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag da facção que você deseja buscar"
              }
            },
            "invalid-faction": "<red>Facção não encontrada.</red>",
            "member-format": {
              "online": "<green>{target_role_prefix}{target_name_with_color}</green> ",
              "offline": "<red>{target_role_prefix}{target_name_with_color}</red> "
            },
            "success": [
              "",
              " <yellow>Informações da facção:</yellow>",
              "",
              "  <white>Facção:</white> [{faction_tag}] {faction_name}",
              "  <white>Líder:</white> {faction_leader_name_with_tag}",
              "  <white>Nível:</white> <gray>{faction_level} ({faction_experience} XP)</gray>",
              "  <white>Membros:</white> <gray>{faction_members_size}/{faction_max_members_size} ({faction_online_members_size} online)</gray>",
              "  {faction_members}",
              "",
              "  <white>KDR:</white> <gray>{faction_stats_kdr}</gray>",
              "  <white>Mortes:</white> <gray>{faction_stats_deaths}</gray>",
              "  <white>Abates:</white> <gray>{faction_stats_kills}</gray>",
              ""
            ]
          },
          "invitation": {
            "accept": {
              "arguments": {
                "tag": {
                  "name": "tag",
                  "description": "Tag da facção que você deseja aceitar o convite"
                }
              },
              "errors": {
                "faction-not-found": "<red>Não foi possível encontrar uma facção com essa tag!</red>",
                "faction-not-invited": "<red>Você não possui nenhum convite de entrada dessa facção!</red>",
                "faction-max-members-exceeded": "<red>A facção que te convidou está cheia!</red>",
                "is-reserve": "<red>Você está no banco de reservas de uma facção. Use /f sair antes de aceitar um convite.</red>"
              },
              "success": "<green>Você se juntou a facção [{faction_tag}]</green>"
            },
            "deny": {
              "arguments": {
                "tag": {
                  "name": "tag",
                  "description": "Tag da facção que você deseja aceitar o convite"
                }
              },
              "errors": {
                "faction-not-found": "<red>Não foi possível encontrar uma facção com essa tag!</red>",
                "faction-not-invited": "<red>Você não possui nenhum convite de entrada dessa facção!</red>"
              },
              "success": "<green>Você negou o pedido da facção [{faction_tag}]</green>"
            }
          },
          "invite": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que deseja convidar para sua facção"
              }
            },
            "errors": {
              "insufficient-role": "<red>Você não tem permissão para convidar jogadores.</red>",
              "target-always-have-faction": "<red>Esse jogador já possui uma facção.</red>",
              "target-is-reserve": "<red>Esse jogador está no banco de reservas de uma facção.</red>",
              "already-invited": "<red>Você já enviou um pedido para esse jogador!</red>",
              "max-invites-reached": "<red>Sua facção já possui 10 convites pendentes. Aguarde ou cancele algum convite.</red>",
              "active-invasion": "<red>Não é possível convidar jogadores durante uma invasão.</red>"
            },
            "success": "<green>Você convidou o jogador {target_name} para a sua facção.</green>"
          },
          "kick": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja expulsar"
              }
            },
            "errors": {
              "insufficient-role": "<red>Você não tem permissão para expulsar membros.</red>",
              "not-same-faction": "<red>Você só pode expulsar jogadores que estão em sua própria facção!</red>",
              "need-more-role": "<red>Você não tem um cargo alto o suficiente para expulsar esse jogador!</red>"
            },
            "success": "<green>Você expulsou o jogador {target_name}</green>"
          },
          "leave": {
            "errors": {
              "is-leader": "<red>O líder da facção não pode abandoná-lo. Caso queira deletá-lo utilize /faction desfazer.</red>",
              "not-in-faction": "<red>Você não está em nenhuma facção.</red>"
            },
            "reserve-left": "<green>Você saiu do banco de reservas da facção [{faction_tag}].</green>"
          },
          "reserve-status": "<red>Você está no banco de reservas da facção [{faction_tag}]. Use <bold>/f entrar</bold> para assumir uma vaga ou <bold>/f sair</bold> para deixar o banco.</red>",
          "enter": {
            "errors": {
              "not-a-reserve": "<red>Você não está no banco de reservas de nenhuma facção.</red>",
              "nobody-offline": "<red>Não há nenhum membro offline para você substituir no momento.</red>"
            }
          },
          "roster": {
            "empty": "<yellow>O banco de reservas da sua facção está vazio. Use <bold>/f roster add <jogador></bold> para adicionar alguém.</yellow>",
            "add": {
              "arguments": {
                "target": {
                  "name": "jogador",
                  "description": "Jogador que você deseja adicionar ao banco de reservas"
                }
              },
              "errors": {
                "insufficient-role": "<red>Você não tem permissão para gerenciar o banco de reservas.</red>",
                "target-not-free": "<red>Esse jogador já possui uma facção ou já está em um banco de reservas.</red>",
                "reserve-full": "<red>O banco de reservas da sua facção está cheio.</red>"
              },
              "success": "<green>Você adicionou {target_name} ao banco de reservas.</green>"
            },
            "remove": {
              "arguments": {
                "target": {
                  "name": "jogador",
                  "description": "Jogador que você deseja remover do banco de reservas"
                }
              },
              "errors": {
                "insufficient-role": "<red>Você não tem permissão para gerenciar o banco de reservas.</red>",
                "not-a-reserve": "<red>Esse jogador não está no banco de reservas da sua facção.</red>"
              },
              "success": "<green>Você removeu {target_name} do banco de reservas.</green>"
            }
          },
          "profile": {
            "arguments": {
              "name": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja ver o perfil"
              }
            },
            "success-with-faction": [
              "",
              " <yellow>Informações do jogador:</yellow>",
              "",
              "  <white>Jogador:</white> {target_name_with_tag}",
              "  <white>Facção:</white> <gray>{target_faction_tag}</gray>",
              "  <white>Cargo:</white> <gray>{target_role_name}</gray>",
              "  <white>KDR:</white> <gray>{target_stats_kdr}</gray>",
              "  <white>Mortes:</white> <gray>{target_stats_deaths}</gray>",
              "  <white>Abates:</white> <gray>{target_stats_kills}</gray>",
              ""
            ],
            "success-without-faction": [
              "",
              " <yellow>Informações do jogador:</yellow>",
              "",
              "  <white>Jogador:</white> {target_name_with_tag}",
              "  <white>Facção:</white> <gray>Sem facção</gray>",
              "  <white>KDR:</white> <gray>{target_stats_kdr}</gray>",
              "  <white>Mortes:</white> <gray>{target_stats_deaths}</gray>",
              "  <white>Abates:</white> <gray>{target_stats_kills}</gray>",
              ""
            ]
          },
          "members": {
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag da facção que você deseja ver os membros"
              }
            }
          },
          "ranking": {
            "arguments": {
              "category": {
                "name": "categoria",
                "description": "Categoria do ranking (ex: spawners, kills)"
              }
            }
          },
          "c": {
            "arguments": {
              "message": {
                "name": "mensagem",
                "description": "Mensagem para enviar no chat da facção"
              }
            }
          },
          "promote": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você deseja promover"
              }
            },
            "errors": {
              "insufficient-role": "<red>Você não tem permissão para promover membros.</red>",
              "not-same-faction": "<red>Você só pode promover jogadores que estão em sua própria facção!</red>",
              "need-more-role": "<red>Você não tem um cargo alto o suficiente para promover esse jogador!</red>",
              "target-in-upper-role": "<red>Esse jogador já está no cargo mais alto!</red>"
            },
            "success": "<green>Você promoveu o jogador {target_name} para {target_role_name} com sucesso!</green>"
          },
          "see-chunks": {
            "success-enabled": "Você ativou a visualização de chunks.",
            "success-disabled": "Você desativou a visualização de chunks."
          },
          "super-jump": {
            "success-enabled": "<green>Você ativou o super pulo durante invasões no seu território.</green>",
            "success-disabled": "<red>Você desativou o super pulo durante invasões no seu território.</red>"
          },
          "transfer": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Nome do jogador que você transferir a facção"
              }
            },
            "errors": {
              "not-leader": "<red>Somente o líder pode transferir a liderança da facção.</red>",
              "not-same-faction": "<red>Você só pode transferir jogadores que estão em sua propria facção!</red>"
            },
            "success": "<green>Você transferiu a liderança da facção para {target_name} com sucesso.</green>"
          },
          "invasions": {
            "errors": {}
          },
          "invade": {
            "arguments": {
              "faction": {
                "name": "facção",
                "description": "Tag ou nome da facção que você deseja invadir"
              }
            },
            "errors": {
              "not-leader": "<red>Apenas o líder ou capitão da facção pode iniciar uma invasão.</red>",
              "faction-not-found": "<red>Facção não encontrada.</red>",
