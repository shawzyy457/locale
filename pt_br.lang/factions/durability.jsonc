{
  "plugins": {
    "durability": {
      "tnt": {
        "normal": {
          "name": "<dark_red>TNT",
          "description": [
            "<gray>TNT com capacidade de",
            "<gray>uma grande explosão"
          ]
        },
        "frozen": {
          "name": "<color:#00acff>TNT Congelada <white></white>",
          "description": [
            "<gray>TNT a temperaturas negativas,",
            "<gray>capaz de <aqua>congelar <gray>a zona em",
            "<gray>sua volta, <white>reduzindo a",
            "<white>durabilidade dos blocos<gray>."
          ]
        },
        "impulse": {
          "name": "<dark_red>TNT de Impulsão",
          "description": [
            "<gray>TNT com capacidade maior",
            "<gray>de impulsionar TNTs próximas."
          ]
        },
        "drill": {
          "name": "<gold>TNT Broca",
          "description": [
            "<gray>TNT de escavação, com um",
            "<gray>alcance muito maior que o",
            "<gray>de uma TNT comum.",
            "",
            "<gold> Propriedades:",
            "<gold> ▸ <white>Não é empurrada por <gray>nenhuma TNT",
            "<gold> ▸ <white>Cai reto <gray>de onde foi colocada",
            "",
            "<gold>Só funciona no território da sua facção."
          ]
        }
      },
      "messages": {
        "items": {
          "durability-repair-brush": {
            "success": "<green>Você restaurou <white>1</white> <green>de durabilidade do bloco, e agora ele está com <white>{durability_current_durability}<gray>/<white>{durability_max_durability} <green>de durabilidade!"
          }
        },
        "block-durability": "<gray>Durabilidade do bloco: <white>{durability_current_durability}</white>/<white>{durability_max_durability}</white>",
        "light-blue-glass-blocked": "<red>Você não pode posicionar <white>Vidro Azul-claro</white> aqui.",
        "lodestone-generator-too-close": "<red>Você não pode posicionar um <white>Gerador de Pedra</white> tão perto de outro.",
        "lodestone-generator-break-delay": "<red>Aguarde <white>{time}</white> para poder quebrar este <white>Gerador de Pedra</white>.",
        "tnt-territory-restricted": "<red>Esta TNT só funciona dentro do território da sua facção."
      },
      "holograms": {
        "protector-allay": "<color:#00acff>Allay Protetor <gray>(</gray><red>❤</red> <white>{hearts}</white><gray>)</gray>"
      },
      "items": {
        "durability-block-end-stone-bricks": {
          "name": "<color:#00acff>Tijolos de Pedra do Fim",
          "lore": [
            "<gray>Bloco estrutural resistente",
            "<gray>feito de Pedra do Fim.",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade: <gray>{durability_block_max_durability}",
            "<color:#00acff>",
            "<color:#00acff>Frágil a congelamentos. <white>"
          ]
        },
        "durability-block-frozen-rock": {
          "name": "<color:#00acff>Rocha Congelada",
          "lore": [
            "<gray>Uma rocha gelada e extremamente",
            "<gray>compacta, difícil de quebrar.",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade: <gray>{durability_block_max_durability}",
            "",
            "<color:#035efc>Resistente a congelamentos."
          ]
        },
        "durability-block-protective-rock": {
          "name": "<color:#00acff>Rocha Protetora",
          "lore": [
            "<gray>Material denso, excelente para",
            "<gray>reforçar áreas vulneráveis.",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade: <gray>{durability_block_max_durability}",
            "",
            "<color:#035efc>Resistente a congelamentos."
          ]
        },
        "durability-block-glacite-block": {
          "name": "<color:#00acff>Bloco de Glacite",
          "lore": [
            "<gray>Compósito cristalino de",
            "<gray>alta rigidez",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade: <gray>{durability_block_max_durability}",
            "",
            "<color:#035efc>Resistente a congelamentos."
          ]
        },
        "durability-block-barricade": {
          "name": "<color:#00acff>Barricada",
          "lore": [
            "<gray>Bloco defensivo temporário com",
            "<gray>alta durabilidade.",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade: <gray>1000",
            "<color:#00acff>",
            "<color:#00acff>Frágil a congelamentos. <white>"
          ]
        },
        "durability-block-tinted-glass": {
          "name": "<color:#00acff>Vidro Blindado",
          "lore": [
            "<gray>Estético e funcional em",
            "<gray>estruturas defensivas.",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade: <gray>{durability_block_max_durability}",
            "<color:#00acff> ▸ <white>Uso perto de spawner: <GREEN>Sim",
            "",
            "<color:#00acff>Frágil a congelamentos. <white>"
          ]
        },
        "durability-creeper-normal": {
          "name": "<green>Creeper",
          "lore": [
            "<gray>Ao explodir, causa <white>1 de",
            "<white>dano <gray>aos blocos em redor."
          ]
        },
        "durability-creeper-frozen": {
          "name": "<color:#00acff>Creeper Congelado <white></white>",
          "lore": [
            "<gray>Ao explodir, a zona em sua",
            "<gray>volta é <aqua>congelada<gray>, <white>reduzindo a",
            "<gray><white>durabilidade<gray>"
          ]
        },
        "durability-creeper-super": {
          "name": "<gradient:#2f900f:#3bedc7>Super creeper",
          "lore": [
            "<gray>Ao explodir, causa <white>5 de",
            "<white>dano<gray> aos blocos em redor.",
            "",
            "<gradient:#2f900f:#3bedc7>+10% drop de spawners"
          ]
        },
        "durability-dispenser": {
          "display-name": "<red>Ejetor",
          "without-items": {
            "name": "<red>Ejetor",
            "lore": [
              "<gray>Este ejetor pode armazenar",
              "<gray>até <white>9 packs <gray>de diferentes",
              "<gray>tipos de TNT."
            ]
          },
          "with-items": {
            "name": "<red>Ejetor",
            "lore": [
              "<gray>Este ejetor pode armazenar",
              "<gray>até <white>9 packs <gray>de diferentes",
              "<gray>tipos de TNT.",
              "",
              "<red>TNTs armazenadas:",
              " <dark_gray>▸ </dark_gray>{durability_dispenser_content}"
            ],
            "content": "{durability_tnt_name} <white>x{durability_tnt_amount}"
          }
        },
        "durability-tnt": {
          "name": "{durability_tnt_name}",
          "lore": [
            "{durability_tnt_description}"
          ]
        },
        "durability-stone-generator": {
          "name": "<color:#00acff>Gerador de Pedra",
          "lore": [
            "<gray>Gera 15 pedras para baixo de",
            "<gray>forma contínua até ser",
            "<gray>destruído ou congelado.",
            "",
            "<color:#00acff> Propriedades:",
            "<color:#00acff> ▸ <white>Durabilidade Gerador: <gray>20",
            "<color:#00acff> ▸ <white>Durabilidade Pedra: <gray>1",
            "",
            "<color:#00acff>Frágil a congelamentos. <white>"
          ]
        },
        "durability-protector-heart": {
          "name": "<color:#00acff>Coração Protetor",
          "lore": [
            "<gray>Ao explodir, invoca",
            "<gray>allays protetores que",
            "<gray>adicionam barricadas nas",
            "<gray>proximidades.",
            "",
            "<color:#00acff> Duração e Durabilidade:",
            "<color:#00acff> ▸<white> Duração: <gray>5m",
            "<color:#00acff> ▸<white> Barricada: <gray>1000",
            "",
            "<color:#00acff>Barricadas são Congeláveis. <white>"
          ]
        },
        "durability-wither-head": {
          "name": "<color:#00acff>Cabeça de Wither <white></white>",
          "lore": [
            "<gray>Uma cabeça de wither versátil,",
            "<gray>congelante e explosiva.",
            "",
            "<color:#00acff>Congelamento:",
            "<gray>Ao colidir com o bloco, a zona em",
            "<gray>volta é <aqua>congelada<gray>, <white>reduzindo a sua",
            "<gray><white>durabilidade<gray>",
            "",
            "<color:#00acff>Explosão:",
            "<gray>Causa <white>5 de dano <gray>ao colidir com blocos.",
            "",
            "<color:#00acff>Botão Esquerdo <dark_gray>▸ <white>Congelar",
            "<color:#00acff>Botão Direito <dark_gray>▸ <white>Explodir"
          ]
        },
        "durability-repair-brush": {
          "name": "<color:#00acff>Pincel de Reparos",
          "lore": [
            "<gray>Restaura a durabilidade de",
            "<gray>blocos de proteção após <white>8s<gray>.",
            "",
            "<color:#00acff>Segure botão direito."
          ]
        }
      }
    }
  }
}