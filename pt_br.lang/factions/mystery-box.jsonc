{
  "plugins": {
    "mystery-box": {
      "types": {
        "pet-common-egg": {
          "name": "<white></white> {mystery_box_color}Ovo de Pet",
          "description": [
            "<gray>Abra essa caixa e desbloqueie,",
            "<gray>pets com diferentes bônus!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Ovo de Pet",
            "<white>Clique para abrir!"
          ]
        },
        "pet-rare-egg": {
          "name": "<white></white> {mystery_box_color}Ovo de Pet",
          "description": [
            "<gray>Abra essa caixa e desbloqueie,",
            "<gray>pets com diferentes bônus!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Ovo de Pet",
            "<white>Clique para abrir!"
          ]
        },
        "common": {
          "name": "<white></white> {mystery_box_color}Caixa Misteriosa",
          "description": [
            "<gray>Além de conter prêmios,",
            "<gray>essa caixa tem a chance",
            "<gray>de evoluir a raridade!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Caixa Misteriosa",
            "<white>Clique para abrir!"
          ]
        },
        "rare": {
          "name": "<white></white> {mystery_box_color}Caixa Misteriosa",
          "description": [
            "<gray>Além de conter prêmios,",
            "<gray>essa caixa tem a chance",
            "<gray>de evoluir a raridade!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Caixa Misteriosa",
            "<white>Clique para abrir!"
          ]
        },
        "epic": {
          "name": "<white></white> {mystery_box_color}Caixa Misteriosa",
          "description": [
            "<gray>Além de conter prêmios,",
            "<gray>essa caixa tem a chance",
            "<gray>de evoluir a raridade!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Caixa Misteriosa",
            "<white>Clique para abrir!"
          ]
        },
        "frozen-orb": {
          "name": "<white> {mystery_box_color}Caixa Congelada",
          "description": [
            "<gray>Abra esta caixa e desbloqueie",
            "<gray>itens gelados e exclusivos!"
          ],
          "stars-hologram": [
            "<white> {mystery_box_color}Caixa Congelada",
            "<white>Clique para abrir!"
          ]
        },
        "magic-orb": {
          "name": "{mystery_box_color}✦ Caixa Mágica",
          "description": [
            "<gray>Abra esta caixa e desbloqueie",
            "<gray>itens de netherite e muito mais!"
          ],
          "stars-hologram": [
            "{mystery_box_color}✦ Caixa Mágica",
            "<white>Clique para abrir!"
          ]
        },
        "ascended-orb": {
          "name": "{mystery_box_color}☆ Caixa Ascendida",
          "description": [
            "<gray>Abra esta caixa e desbloqueie",
            "<gray>encantamentos ascendidos!"
          ],
          "stars-hologram": [
            "{mystery_box_color}☆ Caixa Ascendida",
            "<white>Clique para abrir!"
          ]
        },
        "legendary": {
          "name": "<white></white> {mystery_box_color}Caixa Misteriosa",
          "description": [
            "<gray>Além de conter prêmios,",
            "<gray>essa caixa tem a chance",
            "<gray>de evoluir a raridade!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Caixa Misteriosa",
            "<white>Clique para abrir!"
          ]
        },
        "divine": {
          "name": "<white></white> {mystery_box_color}Caixa Misteriosa",
          "description": [
            "<gray>Além de conter prêmios,",
            "<gray>essa caixa tem a chance",
            "<gray>de evoluir a raridade!"
          ],
          "stars-hologram": [
            "<white></white> {mystery_box_color}Caixa Misteriosa",
            "<white>Clique para abrir!"
          ]
        }
      },
      "rewards": {
        "common": {
          "name": "<white></white>"
        },
        "rare": {
          "name": "<white></white>"
        },
        "epic": {
          "name": "<white></white>"
        },
        "legendary": {
          "name": "<white></white>"
        },
        "divine": {
          "name": "<white></white>"
        }
      },
      "items": {
        "mystery-box": {
          "display-name": "{mystery_box_name}",
          "name": "{mystery_box_name}",
          "lore": [
            "{mystery_box_description}"
          ],
          "lore-inventory": [
            "",
            "{mystery_box_color}Clique para abrir!"
          ]
        }
      },
      "commands": {
        "mystery-box": {
          "give": {
            "arguments": {
              "type": {
                "name": "tipo",
                "description": "Tipo da caixa que será enviada"
              },
              "target": {
                "name": "all / player",
                "description": "Jogador que irá receber as caixas"
              },
              "amount": {
                "name": "quantidade",
                "description": "Quantidade de caixas que você deseja enviar"
              }
            },
            "mystery-box-not-found": "Não foi possivel encontrar nenhuma caixa com esse id!",
            "success-all": "Foram enviadas {mystery_box_amount} caixas para todos os jogadores online",
            "success-one": "Foram enviadas {mystery_box_amount} caixas para o jogador {mystery_box_target_name} caso ele esteja online no servidor!"
          }
        }
      },
      "messages": {
        "rewards": {
          "mail": "Inventário cheio! A recompensa foi enviada para o seu correio."
        },
        "items": {
          "mystery-box": {
            "need-space": "Você precisa de pelo menos 3 blocos livres para colocar a caixa.",
            "already-have-box": "Já existe uma caixa neste local.",
            "need-click-box": "Clique com o botão direito no chão para abrir a caixa!",
            "placed-limit-reached": "Você atingiu o limite de {mystery_box_placed_limit} caixas colocadas no chão. Abra alguma antes de colocar outra.",
            "in-combat": "Você não pode colocar caixas durante o combate."
          }
        },
        "open": {
          "broadcast": [
            "{mystery_box_owner_name_with_tag} <gray><hover:show_text:'{mystery_box_reward_item}'><white>ganhou um item {mystery_box_reward_rarity}<white> em uma <gradient:#00acff:#00f2ff>Caixa Misteriosa<white>!"
          ]
        }
      },
      "views": {
        "mystery-box-preview": {
          "title": "{mystery_box_name}",
          "items": {
            "upgrade-box": {
              "name": "{mystery_box_color}{mystery_box_name}",
              "lore": [
                "{mystery_box_description}",
                "",
                "{mystery_box_color}chance: <gray>{mystery_box_upgrade_chance}%"
              ]
            }
          }
        }
      }
    }
  }
}