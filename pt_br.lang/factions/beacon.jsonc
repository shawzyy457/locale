{
    "plugins": {
        "beacon": {
            "effects": {
                "regeneration": {
                    "display-name": "<red>Regeneração</red>"
                },
                "speed": {
                    "display-name": "<aqua>Velocidade</aqua>"
                },
                "resistance": {
                    "display-name": "<gray>Resistência</gray>"
                },
                "haste": {
                    "display-name": "<green>Pressa</green>"
                },
                "strength": {
                    "display-name": "<dark_red>Força</dark_red>"
                }
            },
            "modes": {
                "attack": {
                    "name": "<green>Modo Ataque</green>",
                    "lore": [
                        "<gray>Aumente o poder ofensivo</gray>",
                        "<gray>da sua facção durante invasões.</gray>",
                        "",
                        "<green> Habilidades disponíveis:</green>",
                        "<dark_gray> •<gray> TNTs Poderosas</gray>",
                        "<dark_gray> •<gray> Poder Invasor</gray>",
                        "<dark_gray> •<gray> Canhão Reforçado</gray>"
                    ]
                },
                "defense": {
                    "name": "<green>Modo Defesa</green>",
                    "lore": [
                        "<gray>Proteja sua base contra</gray>",
                        "<gray>invasões inimigas.</gray>",
                        "",
                        "<green> Habilidades disponíveis:</green>",
                        "<dark_gray> •<gray> Terra Quente</gray>",
                        "<dark_gray> •<gray> Proteção Eficiente</gray>",
                        "<dark_gray> •<gray> Geradores Seguros</gray>"
                    ]
                },
                "generator": {
                    "name": "<green>Modo Gerador</green>",
                    "lore": [
                        "<gray>Aumente a produção dos</gray>",
                        "<gray>seus geradores e spawners.</gray>",
                        "",
                        "<green> Habilidades disponíveis:</green>",
                        "<dark_gray> •<gray> Overclock</gray>",
                        "<dark_gray> •<gray> Saque Extra</gray>",
                        "<dark_gray> •<gray> Mais Criaturas</gray>"
                    ]
                }
            },
            "duration": {
                "whole-invasion": "toda a invasão"
            },
            "perks": {
                "overclock": {
                    "name": "<green>Overclock</green>",
                    "lore": [
                        "<gray>Aumenta em <white>10% o XP<gray> obtido",
                        "<gray>de <white>Espadas e Machado<gray>.</gray>"
                    ]
                },
                "extra-looting": {
                    "name": "<green>Saque Extra</green>",
                    "lore": [
                        "<gray>Aumenta em<white> +1 <gray>o efeito</gray>",
                        "<gray>de <white>looting<gray> no seu território.</gray>"
                    ]
                },
                "more-creature": {
                    "name": "<green>Mais Criaturas</green>",
                    "lore": [
                        "<gray>Aumenta a quantidade máxima</gray>",
                        "<gray>de criaturas agrupadas em <white>2x<gray>.</gray>"
                    ]
                },
                "warm-land": {
                    "name": "<green>Terra Quente</green>",
                    "lore": [
                        "<gray>Seu território fica</gray>",
                        "<gray>protegido contra congelamentos.</gray>"
                    ]
                },
                "efficient-protection": {
                    "name": "<green>Proteção Eficiente</green>",
                    "lore": [
                        "<gray>Aumenta a durabilidade de todos</gray>",
                        "<gray>os blocos de proteção da sua base</gray>",
                        "<gray>em <white>10<gray>."
                    ]
                },
                "security-generators": {
                    "name": "<green>Geradores Seguros</green>",
                    "lore": [
                        "<gray>Aumenta em <white>10% de chance",
                        "<gray>de spawners explodidos voltarem</gray>",
                        "<gray>para o <white>/f geradores<gray>."
                    ]
                },
                "powerful-tnt": {
                    "name": "<green>TNTs Poderosas",
                    "lore": [
                        "<gray>Durante uma invasão, suas</gray>",
                        "<gray>TNTs têm <white>10% chance<gray> de ",
                        "<gray>causarem o dobro de dano."
                    ]
                },
                "reinforced-cannon": {
                    "name": "<green>Canhão Reforçado",
                    "lore": [
                        "<gray>Componentes do canhão agora</gray>",
                        "<gray>possuem <white>10 <gray>de durabilidade.</gray>"
                    ]
                },
                "invader-power": {
                    "name": "<green>Força Invasora",
                    "lore": [
                        "<gray>Ativa <white>Força II<gray> em um</gray>",
                        "<gray>território de invasão</gray>" 
                    ]
                }
            },
            "items": {
                "beacon-nether-star": {
                    "name": "<gradient:#a855f7:#6366f1>Estrela do Nether",
                    "lore": [
                        "<gray>Use para evoluir o</gray>",
                        "<gray>beacon da sua facção.</gray>",
                        "",
                        "<gradient:#a855f7:#6366f1>Clique com SHIFT no beacon."
                    ],
                    "display-name": "<gradient:#a855f7:#6366f1>Estrela do Nether"
                },
                "perk": {
                    "name": "{beacon_perk_name}",
                    "lore": [
                        "{beacon_perk_description}",
                        "",
                        "<green>SHIFT + clique no beacon p/ armazenar."
                    ]
                }
            },
            "views": {
                "beacon": {
                    "title": "Beacon da Facção",
                    "items": {
                        "effect-active": {
                            "name": "<green>Ativo</green>",
                            "lore": [
                                "<gray>Este efeito está ativo.</gray>",
                                "",
                                "<green>Clique para desativar.</green>"
                            ]
                        },
                        "effect-inactive": {
                            "name": "<red>Desativado</red>",
                            "lore": [
                                "<gray>Este efeito está desativado.</gray>",
                                "",
                                "<red>Clique para ativar.</red>"
                            ]
                        },
                        "effect-locked": {
                            "name": "<red>Bloqueado</red>",
                            "lore": [
                                "<gray>Você precisa evoluir o beacon</gray>",
                                "<gray>para desbloquear este efeito.</gray>"
                            ]
                        },
                        "effect-name": {
                            "name": "<green>Efeito de {effect_name}</green>",
                            "lore": [
                            ]
                        },
                        "select-mode": {
                            "name": "<green>Selecionar Modo</green>",
                            "lore": [
                                "<gray>Nenhum modo selecionado.</gray>",
                                "",
                                "<green>Clique para selecionar.</green>"
                            ]
                        },
                        "mode-locked": {
                            "name": "<red>Modo Bloqueado</red>",
                            "lore": [
                                "<gray>Evolua o beacon para o</gray>",
                                "<gray>nível 6 para desbloquear.</gray>"
                            ]
                        },
                        "select-perk": {
                            "name": "<red>Selecionar habilidade</red>",
                            "lore": [
                                "<gray>Nenhuma habilidade selecionada.</gray>",
                                "",
                                "<red>Clique para selecionar.</red>"
                            ]
                        },
                        "active-perk": {
                            "name": "{beacon_perk_name}",
                            "lore": [
                                "{beacon_perk_description}",
                                "",
                                "<green> Perk ativa:</green>",
                                "<green> Termina em</green> <white>{beacon_perk_remaining_time}</white>"
                            ]
                        },
                        "perk-locked": {
                            "name": "<red>Perk Bloqueada</red>",
                            "lore": [
                                "<gray>Evolua o beacon para o</gray>",
                                "<gray>nível <bold>6</bold> para desbloquear.</gray>"
                            ]
                        },
                        "beacon-info": {
                            "info": {
                                "name": "<green><bold>Beacon da Facção</green>",
                                "lore": [
                                    "<gray>Trate este beacon como</gray>",
                                    "<gray>uma joia da sua facção.</gray>",
                                    "",
                                    "<green> 🔥 Nível:</green> <white>{beacon_level}</white>",
                                    "<green> ⭐ Estrelas armazen.:</green> <white>{beacon_storaged_stars}/{beacon_stars_per_level}</white>",
                                    "",
                                    " <gray>⚠ Para evoluir o beacon,",
                                    " <gray>   é necessário utilizar o item ",
                                    " <gray>   Estrela do Nether.",
                                    "",
                                    "<green>⌚ Tempo p/ troca do modo:</green> <white>{beacon_change_mode_cooldown}</white>"
                                ]
                            },
                            "max-level": {
                                "name": "<green><bold>Beacon da Facção</green>",
                                "lore": [
                                    "<gray>Trate este beacon como</gray>",
                                    "<gray>uma joia da sua facção.</gray>",
                                    "",
                                    "<green> 🔥 Nível:</green> <white>Máx</white>",
                                    "",
                                    "<green>⌚ Tempo p/ troca do modo:</green> <white>{beacon_change_mode_cooldown}</white>"
                                ]
                            }
                        },
                        "withdraw-perks": {
                            "name": "<green>Retirar habilidades</green>",
                            "lore": [
                                "<gray>Retire as Habilidades armazenadas</gray>",
                                "<gray>no beacon de volta ao inventário.</gray>",
                                "",
                                "<green>Clique para abrir.</green>"
                            ]
                        }
                    }
                },
                "select-mode": {
                    "title": "Selecionar Modo",
                    "items": {
                        "current-mode": {
                            "lore": [
                                "",
                                "<green>Modo atual selecionado.</green>"
                            ]
                        },
                        "available-mode": {
                            "lore": [
                                "",
                                "<green>Clique para selecionar.</green>"
                            ]
                        }
                    }
                },
                "select-perk": {
                    "title": "Selecionar habilidade",
                    "items": {
                        "current-perk": {
                            "name": "{beacon_perk_name}",
                            "lore": [
                                "{beacon_perk_description}",
                                "",
                                "<green>Perk atual ativa.</green>",
                                "<green> ⌚ Termina em:</green> <white>{beacon_perk_remaining_time}</white>"
                            ]
                        },
                        "available-perk": {
                            "name": "{beacon_perk_name}",
                            "lore": [
                                "{beacon_perk_description}",
                                "",
                                "<green> ⌚ Duração total:</green> <white>{beacon_perk_duration}</white>",
                                "<green> 📦 Armazenadas:</green> <white>{beacon_perk_stored_amount}</white>",
                                "",
                                "<green>Clique para ativar.</green>"
                            ]
                        }
                    }
                },
                "withdraw-perk": {
                    "title": "Retirar habilidades",
                    "items": {
                        "perk": {
                            "name": "{beacon_perk_name}",
                            "lore": [
                                "{beacon_perk_description}",
                                "",
                                "<green> 📦 Armazenadas:</green> <white>{beacon_perk_stored_amount}</white>",
                                "",
                                "<green>Clique para retirar 1.</green>",
                                "<green>SHIFT + clique para retirar tudo.</green>"
                            ]
                        },
                        "empty-perk": {
                            "name": "<gray>{beacon_perk_name}",
                            "lore": [
                                "{beacon_perk_description}",
                                "",
                                "<dark_gray>Sem estoque desta habilidade."
                            ]
                        }
                    }
                },
                "beacon-destroyed": {
                    "title": "Beacon Destruído",
                    "items": {
                        "rebuild": {
                            "name": "<red>Reconstruir Beacon</red>",
                            "lore": [
                                "<gray>O beacon da sua facção</gray>",
                                "<gray>foi destruído!</gray>",
                                "",
                                "<red> ⏷ Custo para reconstruir:",
                                "   <white>{rebuild_requirements}",
                                "",
                                "<gray>O beacon será reconstruído</gray>",
                                "<gray>na posição em que você está.</gray>",
                                "",
                                "<red>Clique para reconstruir.</red>"
                            ]
                        }
                    }
                },
                "create": {
                    "title": "Criar Beacon",
                    "items": {
                        "confirm": {
                            "name": "<green>Criar Beacon</green>",
                            "lore": [
                                "<gray>Você irá criar o beacon</gray>",
                                "<gray>da facção neste local.</gray>",
                                "",
                                "<red> ⚠ Esta ação é irreversível! ⚠</red>",
                                "",
                                "<green>Clique para confirmar.</green>"
                            ],
                            "need-purchase-requirements": {
                                "name": "<green>Comprar Beacon</green>",
                                "lore": [
                                    "<gray>Para colocar o beacon pela</gray>",
                                    "<gray>primeira vez, é necessário pagar:</gray>",
                                    "",
                                    "{purchase_requirements}",
                                    "",
                                    "<green>Clique para confirmar a compra.</green>"
                                ]
                            }
                        }
                    }
                }
            },
            "messages": {
                "commands": {
                    "place-beacon": {
                        "without-faction": "<red>Você precisa estar em uma facção para usar o beacon.</red>",
                        "internal-error": "<red>Ocorreu um erro interno. Tente novamente.</red>",
                        "only-in-overworld": "<red>O beacon só pode ser colocado no Overworld.</red>",
                        "with-cooldown": "<red>Aguarde {cooldown} para colocar o beacon novamente.</red>",
                        "during-invasion": "<red>Você não pode colocar o beacon durante uma invasão.</red>",
                        "is-flying": "<red>Você não pode colocar o beacon enquanto está voando.</red>",
                        "already-placed": "<red>O beacon da sua facção já foi colocado.</red>",
                        "outside-own-land": "<red>Você só pode colocar o beacon no território da sua facção.</red>",
                        "obstructed-above": "<red>Há blocos acima do local bloqueando o feixe. Só vidro comum pode ficar acima do beacon.</red>",
                        "unavaliable-space": "<red>Não há espaço suficiente para colocar o beacon aqui.</red>",
                        "need-purchase-requirements": "<red>Você não tem os requisitos necessários para comprar o beacon.</red>",
                        "cancelled": "<green>Criação do beacon cancelada.</green>"
                    }
                },
                "views": {
                    "beacon": {
                        "unsuficient-level": "<red>Você precisa evoluir o beacon para o <bold>Nível 06</bold>.</red>",
                        "no-mode-selected": "<red>Você precisa selecionar um modo primeiro.</red>",
                        "obstructed": "<red>O feixe do beacon está bloqueado. Deixe a coluna acima dele livre (só vidro comum) para usar efeitos e habilidades.</red>"
                    },
                    "select-mode": {
                        "cooldown": "<red>Aguarde {cooldown} para trocar de modo.</red>",
                        "change-mode-cooldown": "<red>Aguarde {cooldown} para trocar de modo novamente.</red>",
                        "already-selected": "<red>Este modo já está selecionado.</red>",
                        "changed-mode": "<green>Modo alterado para {mode}<green>!</green>"
                    },
                    "select-perk": {
                        "already-active-perk": "<red>Você já possui uma habilidade ativa.</red>",
                        "not-in-invasion": "<red>Esta habilidade só pode ser ativada durante uma invasão.</red>",
                        "not-in-defense": "<red>Esta habilidade só pode ser ativada enquanto sua facção estiver sendo invadida.</red>",
                        "no-stored-perk": "<red>Você não tem essa habilidade armazenada. Armazene clicando no beacon com o item da habilidade.</red>",
                        "success": "<green>GG! habilidade ativada com sucesso!</green>"
                    }
                },
                "upgrade-level": {
                    "need-sneaking": "<red>Segure SHIFT + Direito para adicionar estrelas ao beacon.</red>",
                    "max-level": "<red>O beacon já está no nível máximo.</red>",
                    "success": "<green>Beacon evoluído do nível <bold>{old_level}</bold> para o nível <bold>{new_level}</bold>!</green>"
                },
                "destroyed-beacon": {
                    "broadcast": [
                    "",
                    " <red>⚠ <bold>Beacon Destruído</bold> <red>⚠</red>",
                    "<red> O beacon da sua facção foi destruído!</red>",
                    ""
                    ],
                    "during-invasion": "<red>Você não pode reconstruir o beacon durante uma invasão.</red>",
                    "insufficient-items": "<red>Você não possui itens suficientes para reconstruir o beacon.</red>",
                    "success": "<green>Sucesso! Beacon reconstruído com sucesso!</green>"
                },
                "unclaim-land": {
                    "with-placed-beacon": "<red>Você não pode remover o claim enquanto o beacon estiver colocado.</red>"
                },
                "abandon-territory": {
                    "with-placed-beacon": "<red>Você não pode abandonar o território enquanto o beacon estiver colocado.</red>"
                },
                "reduce-territory": {
                    "with-placed-beacon": "<red>Você não pode reduzir o território: o beacon está na área que seria removida.</red>"
                },
                "disband-faction": {
                    "with-placed-beacon": "<red>Você não pode desfazer a facção enquanto o beacon estiver colocado.</red>"
                },
                "perk-disabled": "<green>A habilidade do beacon foi desativada devido ao fim da invasão.</green>",
                "store-perk": {
                    "need-sneaking": "<red>Segure SHIFT + Direito para armazenar a habilidade no beacon.</red>",
                    "success": "<green>Você armazenou <white>{amount}x</white> {beacon_perk_name} <green>no beacon! Total: <white>{total}</white>.</green>"
                },
                "withdraw-perk": {
                    "in-use": "<red>Alguém da sua facção já está retirando Habilidades no momento.</red>",
                    "success": "<green>Você retirou <white>{amount}x</white> {beacon_perk_name}<green>.</green>"
                },
                "listeners": {
                    "block-interact": {
                        "place-block-near": "<red>Você não pode colocar blocos próximo ao beacon.</red>",
                        "remove-beacon": {
                            "inactive": "<red>O beacon está inativo e não pode ser removido.</red>",
                            "with-cooldown": "<red>Aguarde {cooldown} para remover o beacon novamente.</red>",
                            "without-pickaxe": "<red>Você precisa usar uma picareta para remover o beacon.</red>",
                            "without-silktouch-pickaxe": "<red>Você precisa usar uma picareta com Toque Suave.</red>",
                            "need-sneaking": "<red>Segure SHIFT + Picareta (Toque Suave) para remover o beacon.</red>",
                            "during-invasion": "<red>Você não pode remover o beacon durante uma invasão.</red>",
                            "has-stored-perks": "<red>Retire as Habilidades armazenadas antes de destruir o beacon.</red>"
                        }
                    },
                    "beacon-block": {
                        "place-block-near": "<red>Você não pode colocar blocos na área do beacon.</red>",
                        "only-glass-above-beacon": "<red>Acima do beacon só pode vidro comum — qualquer outro bloco corta o feixe.</red>"
                    }
                }
            }
        }
    }
}