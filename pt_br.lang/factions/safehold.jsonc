{
  "plugins": {
    "safehold": {
      "npc": {
        "hologram": [
          "<gradient:#00acff:#00f2ff><bold>Cofre",
          "<white>Clique para ir!"
        ]
      },
      "commands": {
        "chest": {
          "arguments": {
            "index": {
              "name": "número",
              "description": "Número do baú que deseja abrir"
            }
          }
        }
      },
      "views": {
        "safehold-purchase": {
          "title": "Comprar Cofre",
          "items": {
            "0": {
              "with-requirements": {
                "name": "<color:#ff8200>Comprar Cofre",
                "lore": [
                  "<gray>Adquira acesso ao seu",
                  "<gray>cofre pessoal e proteja",
                  "<gray>seus itens mais valiosos!",
                  "",
                  "<white> Custo: {safehold_cost}",
                  "",
                  "<green>Clique para comprar!"
                ]
              },
              "without-requirements": {
                "name": "<red>Comprar Cofre",
                "lore": [
                  "<gray>Adquira acesso ao seu",
                  "<gray>cofre pessoal e proteja",
                  "<gray>seus itens mais valiosos!",
                  "",
                  "<white> Custo: <red>{safehold_cost}",
                  "",
                  "<red>Você não possui saldo suficiente!",
                  ""
                ]
              }
            }
          }
        },
        "safehold-select-currency": {
          "title": "Selecione a Moeda",
          "items": {
            "0": {
              "name": "{safehold_currency_color}{safehold_currency_name_singular_with_capitalize_first_letter}",
              "lore": [
                "",
                "<gray>Pague com {safehold_currency_color}{safehold_currency_name_plural}",
                "<gray>para liberar seu cofre.",
                "",
                "<white>Custo: <yellow>{safehold_cost}",
                "",
                "<gradient:#03C400:#04FF00>Clique para selecionar!"
              ]
            }
          }
        },
        "safehold-chest-list": {
          "title": "Seus Baús",
          "items": {
            "0": {
              "available": {
                "name": "<color:#ff8200>Baú #{safehold_chest_number}",
                "lore": [
                  "<gray>Baú disponível para uso.",
                  "",
                  "<color:#ff8200>esquerdo <dark_gray>▸ <white>Abrir baú",
                  "<color:#ff8200>direito <dark_gray>▸ <white>Configurações"
                ]
              },
              "locked": {
                "name": "<red>Baú #{safehold_chest_number}",
                "lore": [
                  "<gray>Este baú está trancado.",
                  "",
                  "<red>Clique para comprar!"
                ]
              },
              "not-next-available": {
                "name": "<red>Baú #{safehold_chest_number}",
                "lore": [
                  "<gray>Desbloqueie o baú anterior",
                  "<gray>primeiro!",
                  "",
                  "<red>Requisitos insuficientes."
                ]
              }
            }
          }
        },
        "safehold-chest": {
          "title": "Baú #{safehold_chest_number}"
        },
        "safehold-chest-options": {
          "title": "Opções do Baú",
          "items": {
            "chest": {
              "name": "<color:#ff8200>Baú #{safehold_chest_number}",
              "lore": [
                "<gray>Esse é o ícone atual",
                "<gray>do seu baú."
              ]
            },
            "change-icon": {
              "name": "<color:#ff8200>Trocar Ícone",
              "lore": [
                "<gray>Clique em qualquer item",
                "<gray>do seu inventário para",
                "<gray>definir como ícone do baú.",
                "",
                "<color:#ff8200>Clique em um item!"
              ]
            },
            "rename": {
              "name": "<color:#ff8200>Renomear Baú",
              "lore": [
                "<gray>Renomeie este baú para",
                "<gray>uma melhor organização.",
                "",
                "<color:#ff8200>Clique para renomear."
              ]
            }
          }
        },
        "safehold-chest-purchase": {
          "title": "Comprar Baú",
          "items": {
            "0": {
              "with-requirements": {
                "name": "<color:#ff8200>Desbloquear Baú",
                "lore": [
                  "<gray>Desbloqueie este baú",
                  "<gray>para armazenar mais itens!",
                  "",
                  "<white> Custo: {safehold_chest_cost}",
                  "",
                  "<color:#ff8200>Clique para comprar!"
                ]
              },
              "without-requirements": {
                "name": "<gradient:#7A0202:#DD1616>Desbloquear Baú",
                "lore": [
                  "",
                  "<gray>Desbloqueie este baú",
                  "<gray>para armazenar mais itens!",
                  "",
                  "<white>Custo: <red>{safehold_chest_cost}",
                  "<red>Você não possui saldo suficiente!",
                  ""
                ]
              }
            }
          }
        },
        "safehold-chest-select-currency": {
          "title": "Selecione a Moeda",
          "items": {
            "0": {
              "name": "{safehold_chest_currency_color}{safehold_chest_currency_name_singular_with_capitalize_first_letter}",
              "lore": [
                "",
                "<gray>Pague com {safehold_chest_currency_color}{safehold_chest_currency_name_plural}",
                "<gray>para desbloquear o baú.",
                "",
                "<white>Custo: <yellow>{safehold_chest_cost}",
                "",
                "<gradient:#03C400:#04FF00>Clique para selecionar!"
              ]
            }
          }
        }
      },
      "messages": {
        "join": {
          "title": {
            "title": "<color:#ff8200><bold>Bem-vindo ao seu Cofre!",
            "subtitle": "<white>Gerencie seus itens com segurança"
          }
        },
        "connection": {
          "initializing": "<gray>Conectando ao seu cofre...",
          "errors": {
            "in-connection-delay": "<gray>Aguarde <yellow>{remaining_time}s <gray>para se conectar novamente.",
            "already-have-request": "<gray>Você já possui uma solicitação de conexão em andamento.",
            "safehold-locked": "<red>Seu cofre está temporariamente bloqueado. Tente novamente mais tarde.",
            "not-available-apps": "<red>Nenhum servidor de cofre disponível no momento. Tente novamente mais tarde.",
            "internal": "<red>Ocorreu um erro interno. Tente novamente mais tarde."
          }
        },
        "chest": {
          "not-allowed-here": "<red>Você não pode usar este comando aqui.",
          "safehold-not-purchased": "<red>Você precisa comprar o cofre primeiro! Use <white>/cofre<red>.",
          "invalid-index": "<red>Índice de baú inválido.",
          "not-available": "<red>Este baú não está disponível.",
          "not-next-available": "<red>Você precisa desbloquear os baús anteriores primeiro."
        },
        "views": {
          "safehold-purchase": {
            "purchase": {
              "already-purchased": "<yellow>Você já possui acesso ao cofre!",
              "not-enough-currency": "<red>Você não possui saldo suficiente para esta compra.",
              "failed": "<red>Ocorreu um erro ao processar a compra. Tente novamente.",
              "success": "<green>Cofre adquirido com sucesso! Use <white>/cofre <green>para acessar."
            }
          },
          "safehold-chest": {
            "item-not-allowed": "<red>Este item não pode ser armazenado no baú."
          },
          "safehold-chest-purchase": {
            "chest": {
              "already-unlocked": "<yellow>Este baú já está desbloqueado!",
              "not-enough-currency": "<red>Você não possui saldo suficiente para desbloquear este baú.",
              "purchase-failed": "<red>Ocorreu um erro ao processar a compra. Tente novamente.",
              "unlocked": "<green>Baú desbloqueado com sucesso!"
            }
          },
          "safehold-chest-options": {
            "name-changed": "<green>Nome do baú alterado com sucesso!",
            "icon-changed": "<green>Ícone do baú alterado com sucesso!",
            "rename": {
              "conversation":{
                "query": "<yellow>Qual o nome que deseja para o seu baú?"
              }
            }
          }
        }
      }
    }
  }
}