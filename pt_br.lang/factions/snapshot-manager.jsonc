{
  "plugins": {
    "snapshot-manager": {
      "commands": {
        "snapshot-manager": {
          "arguments": {
            "key": {
              "name": "chave",
              "description": "chave que você deseja buscar"
            }
          },
          "search-queued": "<yellow>Sua busca pela key \"{search_key}\" foi iniciada</yellow>",
          "search-empty": "<yellow>Sua busca pela key \"{search_key}\" não teve nenhum resultado :(</yellow>"
        }
      },
      "messages": {
        "views": {
          "snapshot-instance-list": {
            "search-queued": "<yellow>Buscando essa instância em nossa database...</yellow>",
            "search-success": "<yellow>Instância carregada com sucesso!</yellow>",
            "search-adapter-not-found": "<yellow>Não foi possível carregar o sistema dessa instância!</yellow>",
            "success-preview": "<yellow>Visualização da instância de \"{snapshot_instance_key}\" da data \"{snapshot_instance_date}\" em andamento!</yellow>",
            "success-load": "<yellow>Carregamento da instância de \"{snapshot_instance_key}\" da data \"{snapshot_instance_date}\" concluído!</yellow>"
          }
        }
      },
      "views": {
        "snapshot-instance-list": {
          "title": "Resultado da busca",
          "items": {
            "0": {
              "name": "<yellow>{snapshot_instance_key}</yellow>",
              "lore": [
                "<gray>Key: <white>{snapshot_instance_key}</white></gray>",
                "<gray>Sistema: <white>{snapshot_instance_adapter_id}</white></gray>",
                "<gray>Data: <white>{snapshot_instance_date}</white></gray>",
                "",
                "<yellow>Clique com o botão direito para carregar</yellow>",
                "<yellow>Clique com o botão esquerdo para visualizar</yellow>"
              ]
            },
            "1": {
              "name": "<yellow>{snapshot_instance_key}</yellow>",
              "lore": [
                "<gray>Key: <white>{snapshot_instance_key}</white></gray>",
                "<gray>Sistema: <white>{snapshot_instance_adapter_id}</white></gray>",
                "<gray>Data: <white>{snapshot_instance_date}</white></gray>",
                "",
                "<gray>Ao confirmar você definirá o sistema para</gray>",
                "<gray>essa snapshot, essa ação é irreversível!!</gray>"
              ]
            }
          }
        }
      }
    }
  }
}
