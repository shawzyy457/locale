        },
        "protector": {
          "unlock-cobblestone-generator": "<white>Desbloqueia Gerador de Pedra",
          "unlock-repair-brush": "<white>Desbloqueia Escova de Reparo",
          "unlock-protector-heart": "<white>Desbloqueia Coração de Protetor",
          "hardness": "<white>+{amount} Dureza",
          "mastery": [
            "<white>A cada 60 segundos, seu próximo bloco de",
            "<white>proteção terá durabilidade máxima ao ser colocado."
          ]
        },
        "enchanting": {
          "magic-affinity": "<white>+{amount}% Afinidade Mágica",
          "mastery": "<white>Maestria de Encantador",
          "unlock-hot-touch": "<white>Desbloqueia Encantamento Toque Quente",
          "unlock-fortune-iv": "<white>Desbloqueia Encantamento Fortuna IV",
          "unlock-fortune-v": "<white>Desbloqueia Encantamento Fortuna V",
          "unlock-fortune-vi": "<white>Desbloqueia Encantamento Fortuna VI",
