        },
        "excavation": {
          "magic-collect-chance": "<white>+{amount}% de Coleta Mágica",
          "mastery": "<white>Maestria de Escavação",
          "unlock-sugar-cane": "<white>Desbloqueia Cana de Açúcar",
          "unlock-cactus": "<white>Desbloqueia Cacto",
