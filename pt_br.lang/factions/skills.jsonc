        },
        "alchemist": {
          "chemical-amplifier": "<white>+{amount}s Amplificador Químico",
          "mastery": [
            "<white>Ao tomar uma poção, compartilha 50% da duração",
            "<white>do seu efeito com aliados próximos em um raio de 5 blocos."
          ]
        },
        "mercenary": {
          "theft": "<white>+{amount}% de chance de Roubo",
          "mastery": "<white>Maestria de Mercenário"
        },
        "blacksmith": {
          "double-leather-repair": "<white>Repara 2x mais Couro",
          "unlock-gold": "<white>Pode reparar Ouro",
          "double-gold-repair": "<white>Repara 2x mais Ouro",
          "instant-repair-recipe": "<white>Receita Reparador Instantâneo",
          "unlock-iron": "<white>Pode reparar Ferro",
          "obsidian-chestplate-recipe": "<white>Receita Peitoral de Obsidiana",
          "unlock-diamond": "<white>Pode reparar Diamante",
          "unlock-netherite": "<white>Pode reparar Netherite",
          "unlock-glacite": "<white>Pode reparar Glacite",
          "unbreaking-vi": "<white>Encantamento Inquebrável VI",
          "mastery": "<white>Maestria de Ferreiro",
          "save-chance": "<white>Reparo de Ferreiro"
        }
      },
      "items": {
        "booster": {
          "name": "<yellow>Booster de Habilidades",
          "lore": [
            "<gray>Escolha uma habilidade qualquer",
            "<gray>para ganhar XP adicional.",
            "",
            "<white> Duração: <gray>{booster_duration}",
            "<white> Bônus: <gray>{booster_multiplier}%"
          ],
          "lore-inventory": [
            "",
            "<yellow>Clique para escolher."
          ]
        }
      },
      "commands": {
        "arguments": {
          "skill": {
            "not-found": "<red>A skill <white>{skill_id}</white> não foi encontrada."
          }
        },
        "skill": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que você deseja ver as informações"
            }
          },
          "reset": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que terá as skills resetadas"
              }
            },
            "success": "Você resetou as skills de {target_name_with_tag}."
          },
          "add-experience": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador a adicionar o XP"
              },
              "skill": {
                "name": "skill",
                "description": "ID da skill a adicionar o XP"
              },
              "experience": {
                "name": "quantia",
                "description": "Quantia de XP a adicionar"
              }
            },
            "success": "XP adicionado com sucesso."
          },
          "set-level": {
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador a definir o nível"
              },
              "skill": {
                "name": "skill",
                "description": "ID da skill a definir o nível"
              },
              "level": {
                "name": "nível",
                "description": "Novo nível da skill"
              }
            },
            "success": "Você definiu o nível de {target_name_with_tag} em {skill_name} para <white>{level}."
          }
        }
      },
      "messages": {
        "perks": {
          "swords": {
            "bleed-apply": "<red>🗡 Sangramento <gray>aplicado em <white>{player_name} <gray>por <white>{duration}s<gray>."
          },
          "axes": {
            "break-apply": "<dark_red>🪓 Quebra <gray>aplicada em <white>{player_name}<gray>, causando <white>{damage} <gray>de dano na armadura."
          },
          "mercenary": {
            "theft-success": "<green>🗡 Você roubou $<white>{stolen_amount} <green>coins de {victim_name_with_tag}<green>."
          },
          "mining": {
            "seismic-activate": "<green>⛏ Você ativou <white>quebra sísmica<green> e quebrou <white>{broken_blocks} <green>blocos. <dark_gray>(/skills)"
          },
          "collect": {
            "harvest-activate": "<green>🌾 Você ativou <white>Colheita<green> e obteve <white>{item_name}<green>. <dark_gray>(/skills)"
          },
          "excavation": {
            "magic-collect-activate": "<green>🪏 Você ativou <white>Coleta Mágica<green> e obteve <white>{item_name}<green>. <dark_gray>(/skills)"
          },
          "fisherman": {
            "deep-fishing-activate": "<aqua>🎣 Você ativou <white>Pesca Profunda<aqua> e fisgou <white>{item_name}<aqua>. <dark_gray>(/skills)"
          },
          "enchanting": {
            "magic-affinity-activate": "<aqua>✦ Você ativou <white>Afinidade Mágica<aqua> e recebeu <white>+{bonus_level} <aqua>nível de encantamento. <dark_gray>(/skills)"
          },
          "alchemist": {
            "chemical-amplifier-activate": "<light_purple>⚗ Você ativou <white>Amplificador Químico<light_purple> e adicionou <white>{duration}s <light_purple>à poção. <dark_gray>(/skills)"
          },
          "blacksmith": {
            "requires-proficiency": "<red>Você precisa ter a proficiência de Ferreiro equipada para reparar este item. <dark_gray>(/skills)",
            "insufficient-level": "<red>Você precisa de nível <white>{required_level}</white> em Ferreiro para reparar este item. <dark_gray>(/skills)",
            "in-combat": "<red>Você não pode reparar itens enquanto está em combate.",
            "already-full": "<red>Este item já está com durabilidade máxima.",
            "no-materials": "<red>Você não tem os materiais necessários para reparar este item.",
            "repair-saved": "<green>🔨 Sorte de Ferreiro! Você não gastou materiais neste reparo.",
            "repair-wear": "<yellow>🔨 Este reparo desgastou <red>{durability_penalty}</red> de durabilidade máxima do item.",
            "repair-refined-amethyst": "<green>🔨 <light_purple>Ametista Refinada</light_purple>: este reparo não desgastou a durabilidade máxima do item."
          }
        },
        "views": {
          "main": {
            "locked-slot": "<red>Este slot ainda está bloqueado."
          },
          "focus-confirm": {
            "already-have-focus": "<red>Você já possui um foco selecionado.",
            "focus-selected": "<green>Você selecionou seu foco com sucesso."
          },
          "proficiencies": {
            "proficiency-already-equipped": "<red>Esta classe já está equipada."
          },
          "proficiency-confirm": {
            "max-proficiencies": "<red>Você já tem o máximo de classes equipadas.",
            "proficiency-already-equipped": "<red>Esta classe já está equipada.",
            "proficiency-equipped": "<green>Classe equipada com sucesso.",
            "insufficient-currency": "<red>Você não tem saldo suficiente para isso."
          },
          "change-confirm": {
            "insufficient-currency": "<red>Você não tem saldo suficiente para isso.",
            "skill-changed": "<green>Habilidade alterada com sucesso."
          },
          "booster": {
            "without-focus-selected": "<red>Você não possui um foco selecionado.",
            "booster-activated": "<yellow>Você ativou um booster de <white>{booster_bonus}% <yellow>em {skill_name} <yellow>por <white>{booster_time}<yellow>.",
            "already-have-booster": "<red>Você já tem um booster nessa habilidade.",
            "booster-expired": "<red>Seu booster de <white>{booster_bonus}% <red>em  {skill_name} <red>expirou."
          }
        },
        "on-experience-gain": {
          "action-bar": "<color:#E7CF8A>+{skill_received_experience} ▴ </color><white>{skill_name}</white> <color:#E7CF8A>({skill_level_experience}/{skill_next_level_experience})</color>",
          "action-bar.snowstorm": "<color:#E7CF8A>+{skill_received_experience} ▴ </color><white>{skill_name}</white> <color:#E7CF8A>({skill_level_experience}/{skill_next_level_experience}) nevasca</color>"
        },
        "on-level-up": {
          "without-rewards": {
            "title": {
              "title": "<gradient:#5EDFFF:#DFF6FF>{skill_icon} <bold>{skill_name}",
              "subtitle": "<white>Novo Nível <dark_gray>➟ <white><bold>{skill_level}"
            }
          },
          "with-rewards": {
            "title": {
              "title": "<gradient:#5EDFFF:#DFF6FF>{skill_icon} <bold>{skill_name}",
              "subtitle": "<white>Nível <bold>{skill_level}</bold> <dark_gray>➟</dark_gray> <white>Recompensa desbloqueada!"
            },
            "chat": [
              "",
              " <gradient:#2EAD62:#6EDC8C>🗡 <bold>Habilidade evoluida!",
              " <gray>Você evoluiu de nível de</gray><white> {skill_name}</white><gray>!",
              "",
              " <white>Novo Nível</white><gradient:#2EAD62:#6EDC8C> ➟</gradient> <gray><bold>{skill_level}",
              "",
              " <white><gradient:#2EAD62:#6EDC8C><bold>Desbloqueado:",
              " <gradient:#2EAD62:#6EDC8C>▶ <gray>{skill_rewards}",
              ""
            ]
          }
        },
        "hooks": {
          "requirement": {
            "global": "<red>Você precisa ter nível total de skills <white>{skill_level}</white> para isso.",
            "combat": "<red>Você precisa ter nível <white>{skill_level}</white> na sua skill de combate selecionada para isso."
          },
          "core": {
            "requirement": "<red>Você precisa ter nível <white>{skill_level}</white> em {skill_name} para isso."
          }
        }
      },
      "views": {
        "main": {
          "title": "Habilidades",
          "items": {
            "profile": {
              "name": "{user_name_with_tag}",
              "lore": [
                "<white>Nível: <gray>{user_level}",
                "",
                "<white>Sua posição: <gray>{user_position}",
                "<white>1º colocado: <gray>{first_place_name_with_tag}"
              ]
            },
            "ranking": {
              "name": "<color:#ff8200>Ranking de Skills",
              "lore": [
                "<gray>Confira o ranking de skills",
                "<gray>dos jogadores.",
                "",
                "<color:#ff8200>Clique para abrir."
              ]
            },
            "combat-empty": {
              "name": "<gradient:#00acff:#00f2ff>Combate",
              "lore": [
                "<white>Nível: <gray>0",
                "",
                "<gradient:#00acff:#00f2ff>Clique para escolher seu foco."
              ]
            },
            "skill": {
              "name": "<gradient:#00acff:#00f2ff>{skill_name}",
              "lore": [
                "<gradient:#00acff:#00f2ff>Nível: <white>{skill_user_level}",
                "<gradient:#00acff:#00f2ff>Progresso: <white>{skill_user_experience}/{skill_user_required_experience}",
                "",
                "{skill_perk_description}",
                "",
                "{skill_perk_display_name}",
                "",
                "<white>Sua posição: <gray>{skill_user_position}",
                "<white>1º colocado: <gray>{first_place_name_with_tag}"
              ]
            },
            "booster-empty": {
              "name": "<gradient:#00acff:#00f2ff>Boosters",
              "lore": [
                "<gray>Você não tem nenhum",
                "<gray>booster ativo no momento."
              ]
            },
            "booster-active": {
              "name": "<yellow>Boosters",
              "lore": [
                "<gray>Confira seus boosters",
                "<gray>ativos no momento.",
                "",
                "{skill_booster_lines}"
              ],
              "booster-format": "<dark_gray> ▸ {skill_name}: <gray>+{booster_bonus}% [{booster_remaining_time}]"
            },
            "proficiency-locked": {
              "name": "<red>Classe {slot_index}",
              "lore": [
                "<gray>Desbloqueada no nível <white>{required_level}<gray>.",
                "",
                "<red>Bloqueado."
              ]
            },
            "proficiency-equipped": {
              "name": "{skill_name}",
              "lore": [
                "<gradient:#00acff:#00f2ff>Nível: <white>{skill_user_level}",
                "<gradient:#00acff:#00f2ff>Progresso: <white>{skill_user_experience}/{skill_user_required_experience}",
                "",
                "{skill_perk_description}",
                "",
                "{skill_perk_display_name}",
                "",
                "<white>Sua posição: <gray>{skill_user_position}",
                "<white>1º colocado: <gray>{first_place_name_with_tag}",
                "",
                "<gradient:#00acff:#00f2ff>Botão <white>esquerdo <gradient:#00acff:#00f2ff>para ver as recompensas.",
                "<gradient:#00acff:#00f2ff>Botão <white>direito <gradient:#00acff:#00f2ff>para trocar de classe."
              ]
            },
            "proficiency-empty": {
              "name": "<gradient:#00acff:#00f2ff>Classe {slot_index}",
              "lore": [
                "<gray>Escolha a classe que mais",
                "<gray>combina com o seu estilo.",
                "",
                "<gradient:#00acff:#00f2ff>Clique para escolher."
              ]
            }
          }
        },
        "ranking": {
          "title": "Rank de Habilidades",
          "items": {
            "skill": {
              "name": "<gradient:#00acff:#00f2ff>Ranking de {skill_name}",
              "lore": [
                "<gray>Confira a lista dos melhores",
                "<gray>jogadores em cada skill.",
                "",
                " {skill_ranking_lines}",
                "",
                "<gradient:#00acff:#00f2ff>Sua posição: <white>{user_position}º"
              ],
              "user-format": "<white>{user_position}º </white>{user_name_with_color}<dark_gray> ▸ {user_level_color}{user_level}"
            }
          }
        },
        "talents": {
          "title": "Talentos",
          "items": {
            "talent": {
              "name": "<gradient:#00acff:#00f2ff>{skill_name}",
              "lore": [
                "{talent_description}"
              ]
            }
          }
        },
        "focus": {
          "title": "Escolha seu foco",
          "items": {
            "swords": {
              "name": "<gradient:#00acff:#00f2ff>Espadas",
              "lore": [
                "<gray>Ao escolher o foco em",
                "<gray>espadas, você recebe o ",
                "<gray>talento <red>Sangramento<gray>.",
                "",
                "<gradient:#00acff:#00f2ff>Clique para escolher."
              ]
            },
            "axes": {
              "name": "<gradient:#00acff:#00f2ff>Machados",
              "lore": [
                "<gray>Ao escolher o foco em",
                "<gray>machados, você recebe o ",
                "<gray>talento <dark_red>Quebra<gray>.",
                "",
                "<gradient:#00acff:#00f2ff>Clique para escolher."
              ]
            }
          }
        },
        "focus-confirm": {
          "title": "Você tem certeza?",
          "items": {
            "skill-info": {
              "name": "{skill_name}",
              "lore": [
                "{skill_description}",
                "",
                "<gradient:#00acff:#00f2ff>Verde para confirmar."
              ]
            }
          }
        },
        "rewards": {
          "title": "{skill_name} - Recompensas",
          "items": {
            "skill-info": {
              "name": "<gradient:#00acff:#00f2ff>{skill_name}",
              "lore": [
                "<gradient:#00acff:#00f2ff>Nível: <white>{skill_user_level}",
                "<gradient:#00acff:#00f2ff>Progresso: <white>{skill_user_experience}/{skill_user_required_experience}",
                "",
                "{skill_perk_description}",
                "",
                "{skill_perk_display_name}",
                ""
              ]
            },
            "skill-info-with-booster": {
              "name": "<gradient:#00acff:#00f2ff>{skill_name}",
              "lore": [
                "<gradient:#00acff:#00f2ff>Nível: <white>{skill_user_level}",
                "<gradient:#00acff:#00f2ff>Progresso: <white>{skill_user_experience}/{skill_user_required_experience}",
                "",
                "{skill_perk_description}",
                "",
                "<white>Booster: <gray>{skill_booster_multiplier}% [{skill_booster_remaining_time}]",
                "",
                "{skill_perk_display_name}",
                ""
              ]
            },
            "level-unlocked": {
              "name": "<green>Nível {level}",
              "lore": [
                "",
                "{rewards}",
                "",
                "<green>Desbloqueado."
              ]
            },
            "level-locked": {
              "name": "<red>Nível {level}",
              "lore": [
                "<gray>{skill_description}",
                "",
                "<red> Recompensas:",
                " {rewards}",
                "",
                "<red>Bloqueado."
              ]
            }
          }
        },
        "proficiencies": {
          "title": "Proficiências",
          "items": {
            "skill": {
              "name": "{skill_name}",
              "lore": [
                "{skill_description}",
                "",
                "<gradient:#00acff:#00f2ff>Clique <white>esquerdo<gradient:#00acff:#00f2ff> para selecionar.",
                "<gradient:#00acff:#00f2ff>Clique <white>direito<gradient:#00acff:#00f2ff> para visualizar."
              ]
            },
            "confirm": {
              "name": "<green>Confirmar",
              "lore": [
                "<gray>Clique para confirmar."
              ]
            }
          }
        },
        "proficiency-confirm": {
          "title": "Você tem certeza?",
          "items": {
            "skill-info": {
              "with-old-skill": {
                "name": "{skill_name}",
                "lore": [
                  "{skill_description}",
                  "",
                  "<white>Custo: <gold>{skill_proficiency_change_cost} Gold",
                  ""
                ]
              },
              "without-old-skill": {
                "name": "{skill_name}",
                "lore": [
                  "{skill_description}",
                  "",
                  "<green>Gratuito!",
                  ""
                ]
              }
            }
          }
        },
        "change-select": {
          "title": "Trocar Habilidade",
          "items": {
            "proficiency-unavailable":{
              "name": "<red>Habilidade Bloqueada!",
              "lore":[
                "<gray>Você não pode trocar para",
                "<gray>uma habilidade já selecionada."
              ]
            },
            "skill": {
              "name": "{skill_name}",
              "lore": [
                "{skill_description}",
                "",
                "<gradient:#00acff:#00f2ff>Clique para selecionar."
              ]
            }
          }
        },
        "change-confirm": {
          "title": "Confirmar Troca",
          "items": {
            "skill-info": {
              "free": {
                "name": "{skill_name}",
                "lore": [
                  "{skill_description}",
                  "",
                  "<green>Gratuito!",
                  ""
                ]
              },
              "paid": {
                "name": "{skill_name}",
                "lore": [
                  "{skill_description}",
                  "",
                  "<white>Custo: <gold>{change_cost} Gold",
                  ""
                ]
              }
            }
          }
        },
        "booster": {
          "title": "Escolha uma Habilidade",
          "items": {
            "combat-empty": {
              "name": "<red>Combate",
              "lore": [
                "<gray>Você deve escolher um foco",
                "<gray>para ativar um booster nessa",
                "<gray>habilidade."
              ]
            },
            "skill": {
              "name": "{skill_name}",
              "lore": [
                "<gray>Clique para ativar um booster de",
                "<gray>experiência nessa habilidade.",
                "",
                "<white> Duração: <gray>{skill_booster_duration}",
                "<white> Bônus: <gray>{skill_booster_multiplier}%",
                ""
              ]
            }
          }
        }
      }
    }
  }
}
