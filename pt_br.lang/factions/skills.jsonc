{
  "plugins": {
    "skills": {
      "types": {
        "swords": {
          "name": "<gradient:#00acff:#00f2ff>Espadas",
          "icon": "🗡",
          "description": [
            "<gray>Evolua ao matar mobs",
            "<gray>e jogadores"
          ]
        },
        "axes": {
          "name": "<gradient:#00acff:#00f2ff>Machados",
          "icon": "🪓",
          "description": [
            "<gray>Evolua ao matar mobs",
            "<gray>e jogadores"
          ]
        },
        "mining": {
          "name": "<gradient:#00acff:#00f2ff>Mineração",
          "icon": "⛏",
          "description": [
            "<gray>Evolua ao quebrar!",
            "<gray>minérios!"
          ]
        },
        "collect": {
          "name": "<gradient:#00acff:#00f2ff>Coleta",
          "icon": "🌿",
          "description": [
            "<gray>Evolua ao quebrar folhas",
            "<gray>e plantações!"
          ]
        },
        "excavation": {
          "name": "<gradient:#00acff:#00f2ff>Escavação",
          "icon": "🪏",
          "description": [
            "<gray>Evolua ao escavar!"
          ]
        },
        "protector": {
          "name": "<gradient:#00acff:#00f2ff>Protetor",
          "icon": "❤",
          "description": [
            "<gray>Evolua ao colocar",
            "<gray>blocos de proteção!"
          ]
        },
        "blacksmith": {
          "name": "<gradient:#00acff:#00f2ff>Ferreiro",
          "icon": "🔨",
          "description": [
            "<gray>Evolua ao reparar itens!"
          ]
        },
        "enchanting": {
          "name": "<gradient:#00acff:#00f2ff>Encantador",
          "icon": "☆",
          "description": [
            "<gray>Evolua ao encantar itens!"
          ]
        },
        "mercenary": {
          "name": "<gradient:#00acff:#00f2ff>Mercenário",
          "icon": "🗡",
          "description": [
            "<gray>Evolua ao eliminar jogadores!"
          ]
        },
        "alchemist": {
          "name": "<gradient:#00acff:#00f2ff>Alquimista",
          "icon": "⚗",
          "description": [
            "<gray>Evolua ao criar poções!"
          ]
        },
        "fisherman": {
          "name": "<gradient:#00acff:#00f2ff>Pescador",
          "icon": "🎣",
          "description": [
            "<gray>Evolua ao pescar peixes!"
          ]
        }
      },
      "perks": {
        "bleed": {
          "name": "<gradient:#00acff:#00f2ff>Sangramento",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Sangramento",
            " <gray>Ao atacar um jogador, você tem",
            " <gray>chance de causar <red>Sangramento<gray>,",
            " <gray>aplicando dano contínuo ao",
            " <gray>alvo por alguns segundos."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%",
            " <gradient:#00acff:#00f2ff>⌚<white> Duração: <gray>{perk_duration}s",
            " <gradient:#00acff:#00f2ff>🗡<white> Dano: <gray>{perk_modifier}"
          ]
        },
        "break": {
          "name": "<gradient:#00acff:#00f2ff>Quebra",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Quebra",
            " <gray>Ao atacar um jogador você tem",
            " <gray>chance de causar <dark_red>Quebra<gray>,",
            " <gray>danificando a armadura do alvo.",
            " <gray>Essa chance dobra em jogadores",
            " <gray>que estão afetados por <red>Sangramento</red><gray>."
          ],
          "display-name": [
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%",
            " <gradient:#00acff:#00f2ff>🗡<white> Dano: <gray>{perk_modifier}"
          ]
        },
        "seismic-break": {
          "name": "<gradient:#00acff:#00f2ff>Quebra Sísmica",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Quebra Sísmica",
            " <gray>Ao quebrar um minério, você tem",
            " <gray>chance de quebrar minérios",
            " <gray>adjacentes automaticamente."
          ],
          "chance-bonus": " <light_purple>(+{perk_bonus_value}%)</light_purple>",
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%{perk_chance_bonus}",
            " <gradient:#00acff:#00f2ff>💥<white> Blocos: <gray>{perk_modifier}"
          ]
        },
        "magic-collect": {
          "name": "<gradient:#00acff:#00f2ff>Coleta Mágica",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Coleta Mágica",
            " <gray>Ao escavar blocos, você tem",
            " <gray>chance de obter itens raros."

          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%"
          ]
        },
        "harvest": {
          "name": "<gradient:#00acff:#00f2ff>Colheita",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Colheita",
            " <gray>Ao coletar recursos, você tem",
            " <gray>chance de obter itens raros."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%"
          ]
        },
        "hardness": {
          "name": "<gradient:#00acff:#00f2ff>Dureza",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Dureza",
            " <gray>Coloque blocos de proteção",
            " <gray>com mais vida inicial."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>❤<white> Dureza: <gray>{perk_modifier}"
          ]
        },
        "magic-affinity": {
          "name": "<gradient:#00acff:#00f2ff>Afinidade Mágica",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Afinidade Mágica",
            " <gray>Chance de aplicar encantamentos",
            " <gray>de nível mais alto. (Ex: encanta",
            " <gray>com nível 1 e vem nível 2).",
            " <gray>Tem acesso a caixas ascendidas",
            " <gray>no <white>/encantar<gray> por XP."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%"
          ]
        },
        "chemical-amplifier": {
          "name": "<gradient:#00acff:#00f2ff>Amplificador Químico",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Amplificador Químico",
            " <gray>Crie poções com mais",
            " <gray>duração"
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>⏱<white> Duração: <gray>{perk_duration}s"
          ]
        },
        "blacksmith-repair": {
          "name": "<gradient:#00acff:#00f2ff>Reparo de Ferreiro",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Reparo de Ferreiro",
            " <gray>Habilidade de reparar itens",
            " <gray>de materiais melhores e chance",
            " <gray>de não gastar recursos."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%"
          ]
        },
        "mercenary-theft": {
          "name": "<gradient:#00acff:#00f2ff>Roubo",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Roubo",
            " <gray>Chance de roubar <white>10% dos",
            " <white>coins <gray>ao eliminar inimigos.",
            " <gray>Recebe Velocidade e Força",
            " <gray>durante a nevasca."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%"
          ]
        },
        "deep-fishing": {
          "name": "<gradient:#00acff:#00f2ff>Pesca Profunda",
          "description": [
            " <gradient:#00acff:#00f2ff>Talento: Pesca Profunda",
            " <gray>Ao pescar, você tem chance de",
            " <gray>fisgar um item raro das",
            " <gray>profundezas. Se o inventário",
            " <gray>estiver cheio, vai pro correio."
          ],
          "display-name": [
            " {perk_name}<gradient:#00acff:#00f2ff>:",
            " <gradient:#00acff:#00f2ff>🎲<white> Chance: <gray>{perk_chance}%"
          ]
        }
      },
      "rewards": {
        "swords": {
          "bleed-chance": "<white>+{amount}% chance de Sangramento",
          "bleed-duration": "<white>+{amount}s duração de Sangramento",
