            "items": {
                "armory-item": {
                    "display-name": "{armory_name}",
                    "worn-suffix": [
                        " <red>(desgastado)"
                    ],
                    "kill-counter": [
                        "{armory_color} ☠ Abates: <gray>{count}</gray>",
                        ""
                    ],
                    "with-enchantments": {
                        "name": "{armory_name}{armory_worn_suffix}",
                        "lore": [
                            "{armory_description}",
                            "",
                            "{armory_color} Encantamentos:",
                            "<gray> {armory_enchantments}",
                            "",
                            "{armory_kill_counter}",
                            "{armory_reforge_name}"
                        ]
                    },
                    "without-enchantments": {
                        "name": "{armory_name}{armory_worn_suffix}",
                        "lore": [
                            "{armory_description}",
                            "",
                            "{armory_kill_counter}",
                            "{armory_reforge_name}"
                        ]
                    }
                },
                "armory-kill-counter-activator": {
                    "display-name": "<red>Contador de Abates",
                    "name": "<red>Contador de Abates",
                    "lore": [
                        "<gray>Arraste este item sobre uma",
                        "<gray>espada ou machado para ativar",
                        "<gray>um contador de abates permanente.",
                        "",
                        "<dark_gray>O contador nunca é perdido."
                    ]
                }
            },
            "messages": {
                "kill-counter": {
                    "applied": "<green>Contador de abates ativado na arma!",
                    "already-applied": "<red>Esta arma já possui um contador de abates.",
                    "not-a-weapon": "<red>Você só pode ativar o contador em espadas ou machados."
                },
                "requirements": {
                    "cannot-use": [
                        "Você ainda não pode usar {armory_name}<red>. Requisitos:",
                        "{armory_requirements}"
                    ]
                },
                "reforge": {
                    "apply-success": "<green>Item forjado com sucesso!",
                    "already-reforged": "<red>Este item já está forjado com este forjamento."
                }
            },
            "reforge": {
                "refined-amethyst": {
                    "message": [
                        "{armory_color}Fundido em {custom_item_display_name}<gray>,",
                        "{armory_color}não desgasta ao reparar."
                    ]
                }
            }
