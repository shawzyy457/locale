{
  "plugins": {
    "market": {
      "status": {
        "active": "Ativo",
        "sold": "Vendido",
        "cancelled": "Cancelado",
        "expired": "Expirado"
      },
      "currency": {
        "coins": {
          "name": "Coins"
        },
        "real": {
          "name": "Dinheiro",
          "visualization": "<green>R$ {market_price_value}</green>"
        }
      },
      "views": {
        "market-primary": {
          "title": "Mercado",
          "items": {
            "browse": {
              "name": "<gradient:#00acff:#00f2ff>Ver Anúncios",
              "lore": [
                "<gray>Navegue por todos os itens</gray>",
                "<gray>disponíveis no mercado.</gray>",
                "",
                "<gradient:#00acff:#00f2ff>Clique para visualizar."
              ]
            },
            "my-listings": {
              "name": "<gradient:#00acff:#00f2ff>Meus Anúncios",
              "lore": [
                "<gray>Gerencie os itens que você</gray>",
                "<gray>colocou à venda.</gray>",
                "",
                "<gradient:#00acff:#00f2ff>Clique para visualizar."
              ]
            },
            "personal-offers": {
              "name": "<gradient:#00acff:#00f2ff>Ofertas Pessoais",
              "lore": [
                "<gray>Veja os itens que outros jogadores</gray>",
                "<gray>colocaram à venda para você.</gray>",
                "",
                "<gradient:#00acff:#00f2ff>Clique para visualizar."
              ]
            }
          }
        },
        "market-list": {
          "title": "Mercado - Anúncios",
          "sort": {
            "expiry_desc": "▸ Expira [depois]",
            "expiry_asc": "▸ Expira [antes]",
            "price_desc": "▸ Preço [maior]",
            "price_asc": "▸ Preço [menor]"
          },
          "items": {
            "empty": {
              "name": "<red>Nenhum anúncio!</red>",
              "lore": [
                "<gray>Não há itens à venda no momento.</gray>"
              ]
            },
            "listing": {
              "lore": [
                "",
                "<yellow>Vendedor:</yellow> <gray>{listing_seller_name_with_tag}</gray>",
                "<yellow>Preço:</yellow> <gray>{listing_price_formatted}</gray>",
                "<yellow>Expira em:</yellow> <gray>{listing_time_remaining}</gray>",
                "",
                "<green>Clique para comprar.</green>"
              ]
            },
            "filter": {
              "equipment": {
                "name": "<gradient:#00acff:#00f2ff>Ferramentas e Armaduras",
                "lore": [
                  "<gray>Filtre por espadas, armaduras,</gray>",
                  "<gray>picaretas e outros equipamentos.</gray>",
                  "",
                  "<gradient:#00acff:#00f2ff>Clique para filtrar."
                ]
              },
              "generators": {
                "name": "<gradient:#540bd1:#9506FC>Geradores",
                "lore": [
                  "<gray>Filtre por geradores</gray>",
                  "<gray>e spawners.</gray>",
                  "",
                  "<gradient:#540bd1:#9506FC>Clique para filtrar."
                ]
              },
              "invasion": {
                "name": "<gradient:#7A0202:#DD1616>Itens de Invasão",
                "lore": [
                  "<gray>Filtre por TNT, escadas,</gray>",
                  "<gray>ender pearls e outros itens.</gray>",
                  "",
                  "<gradient:#7A0202:#DD1616>Clique para filtrar."
                ]
              },
              "consumables": {
                "name": "<gradient:#FF6F00:#ff9d00>Consumíveis",
                "lore": [
                  "<gray>Filtre por maçãs douradas,</gray>",
                  "<gray>poções e outros consumíveis.</gray>",
                  "",
                  "<gradient:#FF6F00:#ff9d00>Clique para filtrar."
                ]
              },
              "pets": {
                "name": "<gradient:#03C400:#04FF00>Pets e Ametista",
                "lore": [
                  "<gray>Filtre por pets e</gray>",
                  "<gray>ametista refinada.</gray>",
                  "",
                  "<gradient:#03C400:#04FF00>Clique para filtrar."
                ]
              },
              "other": {
                "name": "<gradient:#179764:#21CD7D>Outros Itens",
                "lore": [
                  "<gray>Filtre por itens que não</gray>",
                  "<gray>não se encaixam nas outras</gray>",
                  "<gray>categorias.</gray>",
                  "",
                  "<gradient:#179764:#21CD7D>Clique para filtrar."
                ]
              }
            },
            "search": {
              "name": "<yellow>Pesquisar</yellow>",
              "lore": [
                "<gray>Busque itens por nome.</gray>",
                "",
                "<yellow>Clique para pesquisar.</yellow>"
              ],
              "active": {
                "name": "<green>Pesquisando:</green> <white>{search_query}</white>",
                "lore": [
                  "",
                  "<gray>Mostrando resultados para</gray>",
                  "<gray>a busca atual.</gray>",
                  "",
                  "<yellow>Clique esquerdo:</yellow> <gray>Nova busca</gray>",
                  "<red>Clique direito:</red> <gray>Limpar busca</gray>"
                ]
              }
            },
            "sort": {
              "name": "<aqua>Ordenar",
              "lore": [
                "",
                "{sort_options}",
                "",
                "<aqua>Clique para alterar."
              ]
            },
            "currency": {
              "name": "<aqua>Moeda",
              "all": "Todas",
              "lore": [
                "",
                "{currency_options}",
                "",
                "<aqua>Clique para alterar."
              ]
            }
          }
        },
        "market-self-list": {
          "title": "Meus Anúncios",
          "items": {
            "empty": {
              "name": "<red>Nenhum anúncio!</red>",
              "lore": [
                "<gray>Você não possui itens à venda.</gray>"
              ]
            },
            "listing": {
              "active": {
                "lore": [
                  "",
                  "<yellow>Preço:</yellow> <gray>{listing_price_formatted}</gray>",
                  "<yellow>Status:</yellow> <green>{listing_status}</green>",
                  "<yellow>Expira em:</yellow> <gray>{listing_time_remaining}</gray>",
                  "",
                  "<red>Clique para cancelar.</red>"
                ]
              },
              "inactive": {
                "lore": [
                  "",
                  "<yellow>Preço:</yellow> <gray>{listing_price_formatted}</gray>",
                  "<yellow>Status:</yellow> <red>{listing_status}</red>",
                  "",
                  "<gray>Este anúncio não está mais ativo.</gray>"
                ]
              }
            }
          }
        },
        "market-personal-list": {
          "title": "Ofertas Pessoais",
          "items": {
            "empty": {
              "name": "<red>Nenhuma oferta!</red>",
              "lore": [
                "<gray>Você não possui ofertas pessoais.</gray>"
              ]
            },
            "listing": {
              "lore": [
                "",
                "<yellow>Vendedor:</yellow> <gray>{listing_seller_name_with_tag}</gray>",
                "<yellow>Preço:</yellow> <gray>{listing_price_formatted}</gray>",
                "<yellow>Expira em:</yellow> <gray>{listing_time_remaining}</gray>",
                "",
                "<gold>Esta oferta foi feita para você!</gold>",
                "",
                "<green>Clique para comprar.</green>"
              ]
            }
          }
        },
        "market-buy-confirmation": {
          "title": "Confirmar Compra",
          "items": {
            "confirm": {
              "name": "<yellow>Confirmar Compra</yellow>",
              "lore": [
                "",
                "<gray>Você irá comprar este item por</gray>",
                "<gray>{listing_price_formatted}</gray>",
                "",
                "<green>Clique para confirmar.</green>"
              ]
            }
          }
        },
        "market-create-confirmation": {
          "title": "Confirmar Anúncio",
          "items": {
            "confirm": {
              "name": "<yellow>Criar Anúncio</yellow>",
              "lore": [
                "",
                "<yellow>Item:</yellow> <gray>{market_create_item_display_name}</gray>",
                "<yellow>Preço:</yellow> <gray>{market_create_price}</gray>",
                "<yellow>Duração:</yellow> <gray>{market_create_duration}</gray>",
                "",
                "<gray>Você está prestes a colocar</gray>",
                "<gray>este item à venda.</gray>",
                "",
                "<green>Clique para confirmar.</green>"
              ]
            }
          }
        },
        "market-sell-currency": {
          "title": "Forma de Venda",
          "items": {
            "coins": {
              "name": "<gradient:#00acff:#00f2ff>Vender em Coins",
              "lore": [
                "<gray>O comprador paga em coins do jogo.</gray>",
                "",
                "<yellow>Preço:</yellow> <gray>{market_create_price}</gray>",
                "",
                "<gradient:#00acff:#00f2ff>Clique para selecionar."
              ]
            },
            "real": {
              "name": "<gradient:#03C400:#04FF00>Vender em Dinheiro",
              "lore": [
                "<gray>O comprador paga em dinheiro real e</gray>",
                "<gray>você recebe no saldo da sua conta,</gray>",
                "<gray>já descontada a taxa da rede.</gray>",
                "",
                "<yellow>Preço:</yellow> <gray>{market_create_price}</gray>",
                "",
                "<gradient:#03C400:#04FF00>Clique para selecionar."
              ]
            }
          }
        }
      },
      "commands": {
        "market": {
          "sell": {
            "arguments": {
              "price": {
                "name": "preço",
                "description": "Preço do item (a moeda é escolhida em seguida)"
              },
              "duration": {
                "name": "tempo",
                "description": "Duração do anúncio (ex: 1h, 12h, 48h)"
              },
              "target": {
                "name": "jogador",
                "description": "Jogador para venda privada (opcional)"
              }
            },
            "no-item-in-hand": "<red>Você precisa segurar um item na mão para vendê-lo.</red>",
            "invalid-item": "<red>Este item não pode ser vendido.</red>",
            "invalid-duration": "<red>Duração inválida. O tempo deve ser entre 5 minutos e 48 horas.</red>",
            "not-enough-items": "<red>Você não possui itens suficientes.</red>",
            "success": "<green>Anúncio criado com sucesso!</green>",
            "success-personal": "<green>Anúncio pessoal criado para {target_buyer_name_with_tag}<green>!</green>",
            "cancelled": "<red>Criação do anúncio cancelada.</red>"
          }
        }
      },
      "messages": {
        "buy": {
          "insufficient-funds": {
            "coins": "<red>Você não possui coins suficientes para esta compra.</red>",
            "real": [
              "",
              " <red>Você não possui saldo suficiente para esta compra.</red>",
              " <click:open_url:'{market_topup_url}'><hover:show_text:'<gray>Abrir a página de recarga'><green>Clique <bold>AQUI</bold> <green>para adicionar saldo!</green></hover></click>",
              ""
            ],
            "real-no-link": "<red>Você não possui saldo suficiente. Recarregue pelo site da rede.</red>"
          }
        },
        "currency": {
          "coins": {
            "invalid-price": "<red>O preço mínimo em coins é <white>1</white>.</red>"
          },
          "real": {
            "invalid-price": "<red>Preço inválido — em dinheiro, use no máximo 2 casas decimais (ex: 49.90).</red>",
            "below-minimum": "<red>O preço em dinheiro está abaixo do mínimo permitido.</red>",
            "above-maximum": "<red>O preço em dinheiro está acima do máximo permitido.</red>"
          }
        },
        "views": {
          "market-list": {
            "cannot-buy-own": "<red>Você não pode comprar seu próprio item.</red>",
            "already-sold": "<red>Este item já foi vendido.</red>",
            "expired": "<red>Este anúncio expirou.</red>",
            "buy-failed": "<red>Falha ao comprar o item. Tente novamente.</red>",
            "buy-success": "<green>Item comprado com sucesso!</green>",
            "buy-cancelled": "<red>Compra cancelada.</red>",
            "search-applied": "<green>Pesquisando por:</green> <white>{search_query}</white>",
            "search-cleared": "<yellow>Pesquisa removida.</yellow>",
            "search": {
              "conversation": {
                "query": "<yellow>Digite o nome do item que deseja buscar:</yellow>"
              }
            }
          },
          "market-self-list": {
            "create": {
              "market-disabled": "<red>O mercado está temporariamente desabilitado.</red>",
              "limit-exceeded": "<red>Você atingiu o limite de anúncios ativos.</red>"
            },
            "cancel": {
              "not-active": "<red>Este anúncio não está mais ativo.</red>",
              "conversation": {
                "query": "<yellow>Deseja cancelar este anúncio?</yellow> <gray>(sim/não)</gray>",
                "error": "<red>Falha ao cancelar o anúncio. Tente novamente.</red>",
                "success": "<green>Anúncio cancelado com sucesso! O item foi devolvido ao seu correio.</green>"
              }
            }
          }
        },
        "listing": {
          "on-cancel": "<green>Seu anúncio foi cancelado. O item foi devolvido ao seu correio.</green>",
          "on-create": [
            "",
            " <hover:show_text:'{listing_item_description}'>{listing_seller_name_with_tag} <yellow>colocou um item à venda no mercado!</yellow>",
            ""
          ],
          "on-personal-create": [
            "",
            " <gold><bold>OFERTA PESSOAL!</bold></gold>",
            " {listing_seller_name_with_tag} <yellow>colocou um item à venda para você!</yellow>",
            "",
            " <hover:show_text:'{listing_item_description}'><gray>Preço:</gray> <white>{listing_price_formatted}</white></hover>",
            " <click:run_command:'/mercado ver'><hover:show_text:'<gray>/mercado ver'><yellow>Clique <bold>AQUI</bold> <yellow>para visualizar a venda.",
            ""
          ],
          "on-sold": {
            "seller": "<green>Seu item foi vendido para {listing_buyer_name_with_tag} <green>por</green> <white>{listing_price_formatted}</white><green>!</green>",
            "buyer": "<green>Compra realizada com sucesso! O item foi adicionado ao seu inventário.</green>"
          }
        }
      },
      "npc": {
        "hologram": [
          "<gradient:#00acff:#00f2ff><bold>Mercado",
          "<white>Clique para acessar"
        ]
      }
    }
  }
}